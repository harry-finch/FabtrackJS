{
  "name": "fabtrackjs",
  "version": "1.5.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "lint": "eslint .",
    "i18n:export": "node scripts/i18n-csv.js export",
    "i18n:import": "node scripts/i18n-csv.js import",
    "setup": "node scripts/setup.js",
    "db:migrate": "node scripts/migrate.js",
    "rgpd:anonymize": "node scripts/rgpd-anonymize.js",
    "seed:activity": "node scripts/seed-adaptive-activity.js",
    "postinstall": "prisma generate",
    "test:unit": "jest --selectProjects unit --forceExit",
    "test:integration": "jest --selectProjects integration --runInBand --forceExit",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.6.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.0",
    "i18n": "^0.15.4",
    "moment": "^2.31.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "eslint": "^10.15.0",
    "jest": "^30.5.1",
    "nodemon": "^3.1.9",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "effect": "^3.22.5",
    "tar": "^7.5.22",
    "qs": "^6.16.0",
    "test-exclude": "^8.0.0",
    "deepmerge-ts": "^8.0.2",
    "mariadb": "^3.4.7",
    "mysql2": "^3.24.4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
