# ==============================================================================
# FabtrackJS — Configuration d'environnement (.env.example)
# Copier vers `.env` et renseigner les valeurs adaptées à votre instance.
# ==============================================================================

# Environnement d'exécution ("development" | "production")
NODE_ENV="development"

# Port HTTP du serveur Express (défaut: 8080)
PORT=8080

# Fuseau horaire métier pour les bornes de dates, statistiques et clôture auto
APP_TIMEZONE="Europe/Paris"

# Clôture automatique des visites oubliées de la veille (format HH:mm)
VISIT_AUTO_CLOSE_TIME="18:30"

# ==============================================================================
# Base de données MariaDB / MySQL (Prisma ORM v7)
# ==============================================================================
DATABASE_URL="mysql://fabtrack:change_me@localhost:3306/fabtrack"

# Base dédiée aux tests d'intégration (doit impérativement se terminer par _test)
DATABASE_URL_TEST="mysql://fabtrack:change_me@localhost:3306/fabtrack_test"

# Compte MariaDB en LECTURE SEULE (SELECT uniquement) — obligatoire en prod si IA NL2SQL activée
# DATABASE_URL_AI_RO="mysql://fabtrack_ai_ro:strong_ro_password@localhost:3306/fabtrack"

# ==============================================================================
# Sécurité, Sessions & Reverse Proxy
# ==============================================================================
# OBLIGATOIRE en production : chaîne aléatoire forte (ex: `openssl rand -hex 32`)
SECRET="change-me-with-a-strong-random-secret"

# Durée de session en millisecondes (défaut: 86400000 = 24h)
SESSION_DURATION=86400000

# Store de session : MariaDB par défaut (mettre "memory" uniquement en test local)
# SESSION_STORE="mariadb"

# Nombre de sauts reverse proxy ("1" derrière Nginx/Apache, "false" en accès direct)
TRUST_PROXY=1

# Activer les cookies Secure et HSTS en production HTTPS réelle
ENABLE_HTTPS="false"

# URL publique canonique de l'application (obligatoire en prod pour les liens d'e-mail)
HOSTURL="http://localhost:8080"

# Sous-chemin optionnel derrière Nginx (ex: "/fabtrack" ; laisser vide à la racine)
# APP_BASE_PATH="/fabtrack"

# Clé AES-256-GCM optionnelle (64 caractères hex) pour chiffrer au repos les clés API/SMTP en base
# SETTINGS_ENCRYPTION_KEY=""

# ==============================================================================
# API Machines / NFC & Allowlists SSRF
# ==============================================================================
# Jeton Bearer / X-API-Key pour l'API /api/machines/* (fail-closed si absent)
# FABTRACK_API_KEY=""

# Hôtes internes autorisés pour Ollama local ou BookStack auto-hébergé (séparés par des virgules)
# AI_LOCAL_ALLOWED_HOSTS="localhost:11434"
# BOOKSTACK_ALLOWED_HOSTS=""

# ==============================================================================
# Messagerie SMTP (valeurs par défaut ; également configurable dans /admin/emails)
# ==============================================================================
ADMIN="admin@example.com"
MAILFROM="Fabtrack <noreply@fabtrack.local>"
HOST=""
SMTP_PORT=587
USR=""
PASSWD=""

# ==============================================================================
# Logs structurés (production)
# ==============================================================================
# Niveau minimum : debug | info | warn | error
LOG_LEVEL="info"
