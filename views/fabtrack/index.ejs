<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="" />
        <meta name="author" content="Stéphane Muller" />
        <title><%= __('nav.kiosk') %> • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

        <%- include('../includes/pagehead.html') %>

        <script src="javascripts/autocomplete.js"></script>
        <link rel="stylesheet" href="stylesheets/autocomplete.css" />
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <% const isBorneRole = typeof role !== 'undefined' && role === 'staff'; %>
            <h1 class="visually-hidden"><%= isBorneRole ? 'Borne de pointage individuel' : __('kiosk.register_user_title') %></h1>

            <% if (isBorneRole) { %>
            <!-- R-036: Dedicated self-service badge-only borne interface (role === 'staff') -->
            <section id="borneKioskShell" data-borne-mode="true" data-workspace-id="<%= (typeof selectedWorkspace !== 'undefined' && selectedWorkspace) ? selectedWorkspace.id : '' %>" class="my-3">
                <!-- Standby view -->
                <div id="borneStandbyView" class="card border mx-auto" style="max-width: 720px;">
                    <div class="card-header bg-body-tertiary d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 px-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-id-card text-primary" aria-hidden="true"></i>
                            <span class="fw-semibold small">Borne de pointage individuel</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <% if (typeof selectedWorkspace !== 'undefined' && selectedWorkspace) { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                                <i class="fa-solid fa-circle fa-2xs text-success me-1" aria-hidden="true"></i><%= selectedWorkspace.name %>
                            </span>
                            <% } %>
                            <% if (typeof isPluginRfidEnabled !== 'undefined' && isPluginRfidEnabled) { %>
                            <span id="rfidReaderStatusBadge" class="badge bg-success-subtle text-success border border-success-subtle">
                                <i class="fa-solid fa-wifi me-1" aria-hidden="true"></i> Lecteur prêt
                            </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="card-body p-4 p-md-5 text-center">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary border border-primary-subtle mb-3" style="width: 72px; height: 72px;">
                            <i class="fa-solid fa-id-card-clip fa-2x" aria-hidden="true"></i>
                        </div>
                        <h2 class="h4 fw-bold mb-2">Passez votre badge pour pointer</h2>
                        <p class="text-muted mb-4">
                            Présentez votre carte ou badge sur le lecteur pour enregistrer votre <strong>entrée</strong> ou votre <strong>sortie</strong> du fablab.
                        </p>

                        <% if (typeof isPluginRfidEnabled === 'undefined' || !isPluginRfidEnabled) { %>
                        <div class="alert alert-warning border border-warning-subtle text-start mb-4" role="alert">
                            <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>
                            Le plugin RFID est actuellement désactivé. Demandez à un administrateur de l'activer pour utiliser la borne.
                        </div>
                        <% } %>

                        <div class="alert alert-secondary border text-start d-flex align-items-start gap-3 mb-0" role="note" id="borneWelcomeDeskNotice">
                            <span class="fab-kpi-icon flex-shrink-0" aria-hidden="true">
                                <i class="fa-solid fa-circle-info"></i>
                            </span>
                            <div>
                                <div class="fw-semibold text-body small mb-1">Première visite ou badge oublié ?</div>
                                <div class="small text-muted">
                                    Adressez-vous à l'accueil auprès d'un membre de l'équipe : il créera votre fiche, associera votre badge ou enregistrera votre passage.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Self check-in confirmation view (shown only after known badge with accepted charter) -->
                <div id="borneCheckinView" class="card border mx-auto" style="max-width: 720px; display: none;">
                    <div class="card-header bg-body-tertiary d-flex flex-wrap align-items-center justify-content-between gap-2 py-3 px-4">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <i class="fa-solid fa-door-open text-primary" aria-hidden="true"></i>
                            <h2 class="h6 fw-bold mb-0">Bonjour <span id="borneUserName"></span></h2>
                            <span id="borneUserType" class="badge bg-body-secondary text-secondary-emphasis border d-none"></span>
                        </div>
                        <% if (typeof selectedWorkspace !== 'undefined' && selectedWorkspace) { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                            <i class="fa-solid fa-circle fa-2xs text-success me-1" aria-hidden="true"></i><%= selectedWorkspace.name %>
                        </span>
                        <% } %>
                    </div>
                    <form id="borneCheckinForm" novalidate>
                        <input type="hidden" id="borneRfidInput" name="rfid" value="" />
                        <input type="hidden" id="borneWorkspaceIdInput" name="workspaceId" value="<%= (typeof selectedWorkspace !== 'undefined' && selectedWorkspace) ? selectedWorkspace.id : '' %>" />
                        <div class="card-body p-4">
                            <p class="text-muted small mb-3">
                                Précisez le motif de votre visite et votre projet, puis confirmez votre entrée.
                            </p>

                            <div id="borneCheckinError" class="alert alert-danger border d-none mb-3" role="alert"></div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="form-floating">
                                        <select class="form-select" id="borneProjecttype" name="projecttype" required>
                                            <option value="" disabled selected>Choisir un motif...</option>
                                            <% projecttypes.forEach(function(projecttype) { %>
                                            <option value="<%= projecttype.id %>"><%= projecttype.name %></option>
                                            <% }); %>
                                        </select>
                                        <label for="borneProjecttype"><%= __('kiosk.field_project_type') %></label>
                                    </div>
                                </div>

                                <div class="col-12" id="borneProjectSection">
                                    <div class="form-floating mb-2">
                                        <select class="form-select" id="borneProjectSelect" name="projectid"></select>
                                        <label for="borneProjectSelect">Projet concerné</label>
                                    </div>
                                    <div id="borneNewDocWrap" style="display: none;">
                                        <div class="form-floating">
                                            <input type="text" class="form-control" id="borneDocumentation" name="documentation" autocomplete="off" placeholder="https://..." />
                                            <label for="borneDocumentation">Lien vers la documentation du nouveau projet</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12" id="borneRepairCol" style="display: none;">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="borneRepairObject" name="repairObject" autocomplete="off" placeholder="Objet à réparer" />
                                        <label for="borneRepairObject">Objet à réparer</label>
                                    </div>
                                </div>

                                <div class="col-12" id="borneWorkshopCol" style="display: none;">
                                    <div class="form-floating">
                                        <select class="form-select" id="borneWorkshopId" name="workshopId">
                                            <option value="" selected disabled>Choisir un atelier...</option>
                                            <% if (typeof availableWorkshops !== 'undefined' && availableWorkshops) { %>
                                                <% availableWorkshops.forEach(function(ws) { %>
                                                <option value="<%= ws.id %>"><%= ws.name %></option>
                                                <% }); %>
                                            <% } %>
                                        </select>
                                        <label for="borneWorkshopId">Atelier suivi</label>
                                    </div>
                                </div>

                                <% if (typeof isPluginUeEnabled !== 'undefined' && isPluginUeEnabled) { %>
                                <div class="col-12" id="borneUeRow" style="display: none;">
                                    <div class="form-floating">
                                        <select class="form-select" id="borneTeachingUnitId" name="teachingUnitId">
                                            <option value="" selected disabled>Choisir une UE habilitée...</option>
                                            <% teachingUnits.forEach(function(ue) { %>
                                            <option value="<%= ue.id %>"><%= ue.code %> — <%= ue.name %></option>
                                            <% }); %>
                                            <option value="unregistered">UE non-enregistrée</option>
                                        </select>
                                        <label for="borneTeachingUnitId">Unité d'Enseignement (UE)</label>
                                    </div>
                                </div>
                                <div class="col-12" id="borneUnregisteredUeRow" style="display: none;">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" id="borneUnregisteredUeName" name="unregisteredUeName" placeholder="Intitulé ou code UE" />
                                                <label for="borneUnregisteredUeName">Intitulé ou Code de l'UE</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-floating">
                                                <input type="text" class="form-control" id="borneUnregisteredUeContact" name="unregisteredUeContact" placeholder="Enseignant responsable" />
                                                <label for="borneUnregisteredUeContact">Contact / Enseignant responsable</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% } %>

                                <% if (typeof isPluginSorbonneEnabled !== 'undefined' && isPluginSorbonneEnabled) { %>
                                <div class="col-12" id="borneSorbonneRow" style="display: none;">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="borneSorbonneEntity" name="sorbonneEntity" autocomplete="off" placeholder="UFR ou entité Sorbonne" />
                                        <label for="borneSorbonneEntity">Entité ou UFR de rattachement</label>
                                    </div>
                                </div>
                                <% } %>

                                <div class="col-12">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="borneComments" name="comments" style="height: 84px" placeholder="Commentaire facultatif"></textarea>
                                        <label for="borneComments"><%= __('kiosk.field_comments') %> (facultatif)</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-body-tertiary py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <button type="button" id="borneCancelBtn" class="btn btn-outline-secondary px-4 py-2">
                                <i class="fa-solid fa-xmark me-1" aria-hidden="true"></i> <%= __('common.cancel') %>
                            </button>
                            <button type="submit" id="borneConfirmBtn" class="btn btn-primary px-4 py-2">
                                <i class="fa-solid fa-check me-1" aria-hidden="true"></i> Confirmer mon entrée
                            </button>
                        </div>
                    </form>
                </div>
            </section>
            <% } else { %>

            <% if (typeof isPluginRfidEnabled !== 'undefined' && isPluginRfidEnabled) { %>
            <!-- RFID Kiosk Status Banner -->
            <div class="fab-rfid-bar d-flex flex-wrap align-items-center justify-content-between gap-2" data-workspace-id="<%= (typeof selectedWorkspace !== 'undefined' && selectedWorkspace) ? selectedWorkspace.id : '' %>">
                <div class="d-flex align-items-center gap-2">
                    <span class="fab-kpi-icon" aria-hidden="true">
                        <i class="fa-solid fa-id-card text-info"></i>
                    </span>
                    <div>
                        <div class="fw-semibold small text-body">Borne RFID active</div>
                        <div class="text-muted small">Passez votre badge sur le lecteur pour enregistrer votre entrée ou sortie.</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="manualRfidBtn" class="btn btn-outline-secondary btn-sm">
                        <i class="fa-solid fa-keyboard me-1" aria-hidden="true"></i> Tester un badge
                    </button>
                    <span id="rfidReaderStatusBadge" class="badge bg-success-subtle text-success border border-success-subtle">
                        <i class="fa-solid fa-wifi me-1" aria-hidden="true"></i> Prêt pour scan
                    </span>
                </div>
            </div>
            <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
                async function promptManualRfid() {
                    if (typeof window.fabtrackPrompt !== "function") return;
                    const code = await window.fabtrackPrompt({
                        title: "Simuler un scan RFID",
                        message: "Saisissez le numéro de badge (UID) à simuler :",
                        placeholder: "Ex : 04A1B2C3D4",
                        confirmLabel: "Simuler le scan",
                        variant: "primary",
                    });
                    if (code && code.trim() && window.triggerKioskRfidScan) {
                        window.triggerKioskRfidScan(code.trim());
                    }
                }
                window.promptManualRfid = promptManualRfid;
                const manualRfidBtn = document.getElementById("manualRfidBtn");
                if (manualRfidBtn) {
                    manualRfidBtn.addEventListener("click", promptManualRfid);
                }
            </script>
            <% } %>

            <!-- Registering form -->
            <div id="register">
                <section class="card border mb-4" aria-labelledby="kioskRegisterHeading">
                    <div class="card-header bg-body-tertiary d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 px-4">
                        <div class="d-flex align-items-center gap-2">
                            <a class="jsButton fs-5 text-primary d-inline-flex align-items-center justify-content-center" id="registerbutton" role="button" tabindex="0" style="text-decoration: none; min-width: 44px; min-height: 44px;" title="<%= __('kiosk.switch_to_create') %>" aria-label="<%= __('kiosk.switch_to_create') %>"><i class="fa fa-toggle-on" aria-hidden="true"></i></a>
                            <div>
                                <h2 class="h6 fw-bold mb-0" id="kioskRegisterHeading"><%= __('kiosk.register_user_title') %></h2>
                                <small class="text-muted"><%= __('kiosk.register_user_subtitle') %></small>
                            </div>
                        </div>
                        <% if (typeof selectedWorkspace !== 'undefined' && selectedWorkspace) { %>
                        <!-- Workspace Indicator Badge -->
                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                            <i class="fa-solid fa-circle fa-2xs text-success me-1" aria-hidden="true"></i><%= selectedWorkspace.name %>
                        </span>
                        <% } %>
                    </div>
                    <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>history/create" method="post" data-ajax-kiosk="true" data-reset-on-success="true">
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="form-floating d-grid d-flex">
                                        <input type='hidden' id="userid" name='userid' value='null' />
                                        <input type="text" class="form-control input-group-icon" id="name" name="name" placeholder="<%= __('kiosk.field_name') %>" autocomplete="off" required />
                                        <label for="name"><%= __('kiosk.field_name') %></label>
                                        <a id="urlprofile" href="#" aria-label="Voir la fiche contributeur">
                                            <span class="formbutton input-group-text"><i class="fa fa-user fa-lg" aria-hidden="true"></i></span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-3" id="charterWarningRow" style="display: none;">
                                <div class="col-12">
                                    <div class="alert alert-warning border border-warning-subtle d-flex align-items-center justify-content-between flex-wrap gap-2 mb-0 py-2 px-3 rounded-2" role="alert" id="charterWarningAlert">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fs-5 text-warning" aria-hidden="true"><i class="fa-solid fa-triangle-exclamation"></i></span>
                                            <div>
                                                <div class="fw-bold text-body">Charte d'utilisation non signée</div>
                                                <small class="text-body-secondary" id="charterWarningMsg">Ce contributeur n'a pas encore validé la charte du fablab. L'inscription au lab est bloquée tant que la charte n'est pas acceptée.</small>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <a id="charterProfileBtn" href="#" class="btn btn-sm btn-outline-warning">
                                                <i class="fa-solid fa-user-pen me-1" aria-hidden="true"></i> Valider sur la fiche contributeur
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row g-3 mt-0">
                                <div class="col-md-8" id="documentationCol">
                                    <div class="form-floating d-grid d-flex">
                                        <input type='hidden' id="projectid" name='projectid' value='null' />
                                        <input type='hidden' id="userprojectid" name='userprojectid' value='null' />
                                        <input type="text" class="form-control input-group-icon" id="documentation" name="documentation" autocomplete="off" placeholder="<%= __('kiosk.field_documentation') %>" required />
                                        <label for="documentation"><%= __('kiosk.field_documentation') %></label>
                                        <a id="urldocumentation" href="" target="_blank" rel="noopener noreferrer" aria-label="Consulter la documentation du projet">
                                            <span class="formbutton input-group-text" id="docStatusBtn" title="Consulter la documentation du projet"><i class="fa-solid fa-book-open fa-lg" aria-hidden="true"></i></span>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-md-8" id="repairObjectCol" style="display: none;">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="repairObject" name="repairObject" autocomplete="off" placeholder="Objet à réparer" />
                                        <label for="repairObject"><i class="fa-solid fa-screwdriver-wrench text-warning me-1"></i> Objet à réparer (ex: Cafetière Seb, Fer à repasser, Lampe...)</label>
                                    </div>
                                </div>
                                <div class="col-md-8" id="workshopCol" style="display: none;">
                                    <div class="form-floating">
                                        <select class="form-select" id="workshopId" name="workshopId">
                                            <option value="" selected disabled>Choisir un atelier...</option>
                                            <% if (typeof availableWorkshops !== 'undefined' && availableWorkshops) { %>
                                                <% availableWorkshops.forEach(function(ws) { %>
                                                <option value="<%= ws.id %>">
                                                    <%= ws.name %><% if (ws.badge) { %> (Badge : <%= ws.badge.name %>)<% } %>
                                                </option>
                                                <% }); %>
                                            <% } %>
                                        </select>
                                        <label for="workshopId"><i class="fa-solid fa-graduation-cap text-primary me-1"></i> Atelier suivi (badge attribué automatiquement)</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating">
                                        <select class="form-select" id="projecttype" name="projecttype">
                                            <option selected></option>
                                            <% projecttypes.forEach(function(projecttype) { %>
                                            <option value="<%= projecttype.id %>"><%= projecttype.name %></option>
                                            <% }); %>
                                        </select>
                                        <label for="projecttype"><%= __('kiosk.field_project_type') %></label>
                                    </div>
                                </div>
                            </div>

                            <% if (typeof isPluginUeEnabled !== 'undefined' && isPluginUeEnabled) { %>
                            <div class="row g-3 mt-0" id="ueRow" style="display: none;">
                                <div class="col-12">
                                    <div class="form-floating">
                                        <select class="form-select" id="teachingUnitId" name="teachingUnitId">
                                            <option value="" selected disabled>Choisir une UE habilitée (Sorbonne Université)...</option>
                                            <% teachingUnits.forEach(function(ue) { %>
                                            <option value="<%= ue.id %>">
                                                <%= ue.code %> — <%= ue.name %> (<%= ue.department || 'Sorbonne Université' %>)
                                            </option>
                                            <% }); %>
                                            <option value="unregistered" class="text-danger fw-semibold">⚠️ UE non-enregistrée</option>
                                        </select>
                                        <label for="teachingUnitId">
                                            <i class="fa-solid fa-graduation-cap text-primary me-1"></i> Unité d'Enseignement (UE rattachée)
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Dynamic fields for unregistered UE -->
                            <div class="row g-3 mt-0" id="unregisteredUeRow" style="display: none;">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="unregisteredUeName" name="unregisteredUeName" placeholder="ex: LU2PY001 ou Atelier Robotique">
                                        <label for="unregisteredUeName">
                                            <i class="fa-solid fa-tag text-warning me-1"></i> Intitulé ou Code de l'UE *
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="unregisteredUeContact" name="unregisteredUeContact" placeholder="ex: prof.responsable@sorbonne-universite.fr">
                                        <label for="unregisteredUeContact">
                                            <i class="fa-solid fa-user-tie text-info me-1"></i> Contact / Enseignant responsable
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <% } %>

                            <% if (typeof isPluginSorbonneEnabled !== 'undefined' && isPluginSorbonneEnabled) { %>
                            <div class="row g-3 mt-0" id="sorbonneRow" style="display: none;">
                                <div class="col-12">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="sorbonneEntity" name="sorbonneEntity" placeholder="ex: UFR de Physique, LIP6, UFR 929..." autocomplete="off">
                                        <label for="sorbonneEntity">
                                            <i class="fa-solid fa-landmark text-primary me-1"></i> Entité ou UFR de rattachement
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                            <div class="row g-3 mt-0">
                                <div class="col">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="comments" name="comments" style="height: 88px"></textarea>
                                        <label for="comments"><%= __('kiosk.field_comments') %></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-body-tertiary py-3 px-4 d-flex flex-wrap align-items-center justify-content-end gap-2">
                            <button class="btn btn-primary btn-sm px-4 py-2" type="submit" id="registerSubmitBtn">
                                <i class="fa-solid fa-check me-1"></i> <%= __('kiosk.btn_register') %>
                            </button>
                        </div>
                    </form>
                </section>

                <!-- Lab activity table (partial extracted for AJAX & SSE live refresh — R-032) -->
                <div id="kioskPresentContainer" data-live-channel="kiosk">
                    <%- include('./partials/present-table') %>
                </div>

                <!-- Modal to view/edit/add comments on a user session -->
                <div class="modal fade" id="modalComment" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalCommentLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>history/update-comment" method="post" id="formComment" data-ajax-kiosk="true">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="modalCommentLabel">
                                        <i class="fa-solid fa-comment-dots text-primary me-2" aria-hidden="true"></i><%= __('kiosk.modal_comment_title') %>
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= __('common.close') %>"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3 p-3 bg-body-tertiary rounded-2 border">
                                        <div class="small text-muted mb-1"><%= __('kiosk.modal_comment_user') %></div>
                                        <div class="fw-semibold fs-6" id="commentModalUserName">-</div>
                                    </div>

                                    <input type="hidden" name="historyid" id="commentModalHistoryId" value="">

                                    <div class="mb-2">
                                        <label for="commentModalText" class="form-label fw-semibold small">
                                            <%= __('kiosk.modal_comment_label') %>
                                        </label>
                                        <textarea class="form-control" id="commentModalText" name="comments" rows="4" placeholder="<%= __('kiosk.modal_comment_placeholder') %>"></textarea>
                                        <div class="form-text text-muted small">
                                            <%= __('kiosk.modal_comment_help') %>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer bg-body-tertiary d-flex justify-content-between">
                                    <button type="button" class="btn btn-outline-danger btn-sm" id="commentModalClearBtn" title="<%= __('kiosk.modal_comment_clear') %>">
                                        <i class="fa-solid fa-eraser me-1" aria-hidden="true"></i><%= __('kiosk.modal_comment_clear') %>
                                    </button>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal"><%= __('common.cancel') %></button>
                                        <button type="submit" class="btn btn-primary btn-sm">
                                            <i class="fa-solid fa-check me-1" aria-hidden="true"></i><%= __('kiosk.modal_comment_save') %>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Modal to clear balance -->
                <div class="modal fade" id="clearBalance" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="clearBalanceLabel" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title" id="clearBalanceLabel"><i class="fa-solid fa-money-bill-wave text-success me-2" aria-hidden="true"></i>Régler le solde</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                      </div>
                      <div class="modal-body">
                        <p>Confirmez-vous la remise à zéro du solde de ce contributeur ?</p>
                        <code class="ms-3"></code>
                      </div>
                      <div class="modal-footer bg-body-tertiary">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
                        <form method="POST" action="" id="clearBalanceForm" class="d-inline m-0">
                          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                          <button type="submit" class="btn btn-primary btn-sm">Solder le compte</button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Modal to deactivate warnings -->
                <div class="modal fade" id="warningDeactivator" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="warningDeactivatorLabel" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title" id="warningDeactivatorLabel"><i class="fa-solid fa-triangle-exclamation text-warning me-2" aria-hidden="true"></i>Avertissement</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                      </div>
                      <div class="modal-body">
                        <p>Confirmez-vous la résolution de cet avertissement ?</p>
                        <code class="ms-3"></code>
                      </div>
                      <div class="modal-footer bg-body-tertiary">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
                        <form method="POST" action="" id="warningDeactivatorForm" class="d-inline m-0">
                          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                          <button type="submit" class="btn btn-primary btn-sm">Résoudre l'avertissement</button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Modal to add activities/machines/payment to a user history -->
                <div class="modal fade" id="activityManager" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="activityManagerLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content">
                        <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>history/activity" method="post">
                            <div class="modal-header">
                                <h5 class="modal-title" id="activityManagerLabel"><i class="fa-solid fa-layer-group text-primary me-2" aria-hidden="true"></i><%= __('kiosk.modal_activity_title') %></h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                            </div>
                            <div class="modal-body">
                                <input type='hidden' id="activityhistoryid" name='activityhistoryid' value='null' />
                                <input type='hidden' id="activityuserid" name='activityuserid' value='null' />
                                <input type='hidden' id="cost" name='cost' value='null' />
                                <div class="row align-items-center mb-3">
                                    <div class="col-2 text-secondary">
                                        Utiliser
                                    </div>
                                    <div class="col-10">
                                        <div class="form-floating">
                                            <select class="form-select" id="machineId" name="machineId">
                                                <option value="" selected></option>
                                                <% machines.forEach(function(machine) { %>
                                                <option value="<%= machine.id %>"><%= machine.name %></option>
                                                <% }); %>
                                            </select>
                                            <label for="machineId">Machine</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row align-items-center mb-3">
                                    <div class="col-2 text-secondary">
                                        Emprunter
                                    </div>
                                    <div class="col-6">
                                        <div class="form-floating position-relative">
                                            <input type="hidden" id="equipmentId" name="equipmentId" value="" />
                                            <input
                                                type="text"
                                                class="form-control"
                                                id="equipmentSearch"
                                                placeholder="Taper pour rechercher un équipement / outil..."
                                                autocomplete="off"
                                            />
                                            <label for="equipmentSearch">
                                                <i class="fa-solid fa-toolbox me-1 text-muted"></i> Équipement / Outil
                                            </label>
                                            <button
                                                type="button"
                                                class="btn btn-link text-secondary position-absolute top-50 end-0 translate-middle-y me-2 p-1"
                                                id="clearEquipmentBtn"
                                                style="display: none; z-index: 5;"
                                                title="Effacer la sélection"
                                                aria-label="Effacer la sélection"
                                            >
                                                <i class="fa-solid fa-xmark fa-lg" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="form-floating position-relative">
                                            <select class="form-select" id="borrowDurationDays" name="borrowDurationDays">
                                                <option value="1">1 jour (24h)</option>
                                                <option value="3">3 jours</option>
                                                <option value="7" selected>7 jours (1 sem.)</option>
                                                <option value="14">14 jours (2 sem.)</option>
                                                <option value="30">30 jours (1 mois)</option>
                                            </select>
                                            <label for="borrowDurationDays">
                                                <i class="fa-regular fa-clock me-1 text-muted"></i> Durée d'emprunt
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-n2 mb-3" id="borrowReturnDateNotice" style="display: none;">
                                    <div class="col-2"></div>
                                    <div class="col-10">
                                        <div class="d-flex align-items-center small text-primary bg-primary-subtle border border-primary-subtle px-3 py-1 rounded-2">
                                            <i class="fa-solid fa-calendar-check me-2" aria-hidden="true"></i>
                                            <span>Retour attendu le : <strong id="borrowCalculatedDateText">-</strong></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row align-items-center mb-3">
                                    <div class="col-2 text-secondary">
                                        Consommer
                                    </div>
                                    <div class="col-7">
                                        <div class="form-floating position-relative">
                                            <input type="hidden" id="consumable" name="consumable" value="" />
                                            <input
                                                type="text"
                                                class="form-control"
                                                id="consumableSearch"
                                                placeholder="Taper pour rechercher un consommable..."
                                                autocomplete="off"
                                            />
                                            <label for="consumableSearch">
                                                <i class="fa-solid fa-magnifying-glass me-1 text-muted"></i> Consommable / Matériau (taper pour rechercher)
                                            </label>
                                            <button
                                                type="button"
                                                class="btn btn-link text-secondary position-absolute top-50 end-0 translate-middle-y me-2 p-1"
                                                id="clearConsumableBtn"
                                                style="display: none; z-index: 5;"
                                                title="Effacer la sélection"
                                                aria-label="Effacer la sélection"
                                            >
                                                <i class="fa-solid fa-xmark fa-lg" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="form-floating">
                                            <input type="number" class="form-control input-group-icon" id="quantity" name="quantity" min="1" value="1" />
                                            <label for="quantity" id="quantityLabel">Quantité</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mb-3" id="consumableLiveCostRow" style="display: none;">
                                    <div class="col-2"></div>
                                    <div class="col-10">
                                        <div class="alert alert-secondary py-2 px-3 mb-0 small d-flex justify-content-between align-items-center">
                                            <span><i class="fa-solid fa-coins text-warning me-1" aria-hidden="true"></i> Total estimé à débiter : <strong id="liveCostAmount" class="text-danger">0.00 €</strong></span>
                                            <span class="text-muted" id="liveUnitPrice">0.00 € / u</span>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="modal-footer bg-body-tertiary">
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal"><%= __('common.cancel') %></button>
                                <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-check me-1" aria-hidden="true"></i>Enregistrer</button>
                            </div>
                        </form>
                    </div>
                    </div>
                </div>

            </div>

            <% if (typeof role !== 'undefined' && role === 'staff') { %>
            <div class="card border mt-4 mb-4 bg-body-tertiary">
                <div class="card-body p-3 text-center text-muted">
                    <i class="fa-solid fa-user-shield text-info me-2" aria-hidden="true"></i>
                    <%= __('kiosk.kiosk_touch_mode') %>
                </div>
            </div>
            <% } else { %>
            <!-- New user creation form -->
            <div id="newuser">
                <section class="card border mb-4" aria-labelledby="kioskNewUserHeading">
                    <div class="card-header bg-body-tertiary d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 px-4">
                        <div class="d-flex align-items-center gap-2">
                            <a class="jsButton fs-5 text-secondary d-inline-flex align-items-center justify-content-center" id="newuserbutton" role="button" tabindex="0" style="text-decoration: none; min-width: 44px; min-height: 44px;" title="<%= __('kiosk.switch_to_search') %>" aria-label="<%= __('kiosk.switch_to_search') %>"><i class="fa fa-toggle-off" aria-hidden="true"></i></a>
                            <div>
                                <h2 class="h6 fw-bold mb-0" id="kioskNewUserHeading"><%= __('kiosk.create_user_title') %></h2>
                                <small class="text-muted"><%= __('kiosk.create_user_subtitle') %></small>
                            </div>
                        </div>
                        <% if (typeof selectedWorkspace !== 'undefined' && selectedWorkspace) { %>
                        <!-- Workspace Indicator Badge -->
                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                            <i class="fa-solid fa-circle fa-2xs text-success me-1" aria-hidden="true"></i><%= selectedWorkspace.name %>
                        </span>
                        <% } %>
                    </div>
                    <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>users/create" method="post">
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="newname" name="newname" placeholder="<%= __('kiosk.new_name') %>" required />
                                        <label for="newname"><%= __('kiosk.new_name') %></label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="newsurname" name="newsurname" placeholder="<%= __('kiosk.new_surname') %>" required />
                                        <label for="newsurname"><%= __('kiosk.new_surname') %></label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="newbirthyear" name="newbirthyear" placeholder="<%= __('kiosk.new_birthyear') %>" />
                                        <label for="newbirthyear"><%= __('kiosk.new_birthyear') %></label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input type="email" name="newemail" class="form-control" id="newemail" placeholder="<%= __('kiosk.new_email') %>" required />
                                        <label for="newemail"><%= __('kiosk.new_email') %></label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <select class="form-select" id="newusertype" name="newusertype">
                                            <option selected></option>
                                            <% usertypes.forEach(function(usertype) { %>
                                            <option value="<%= usertype.id %>"><%= usertype.name %></option>
                                            <% }); %>
                                        </select>
                                        <label for="newusertype"><%= __('kiosk.new_usertype') %></label>
                                    </div>
                                </div>
                                <% if (typeof isPluginRfidEnabled !== 'undefined' && isPluginRfidEnabled) { %>
                                <div class="col-12">
                                    <div class="form-floating">
                                        <input type="text" class="form-control font-monospace" id="newrfid" name="newrfid" placeholder="Badge RFID" autocomplete="off" />
                                        <label for="newrfid"><i class="fa-solid fa-id-card me-1 text-muted"></i> <%= __('kiosk.new_rfid') %></label>
                                    </div>
                                </div>
                                <% } %>
                                <div class="col-12">
                                    <div class="form-floating">
                                        <textarea class="form-control" id="newcomments" name="newcomments" style="height: 88px"></textarea>
                                        <label for="newcomments"><%= __('kiosk.field_comments') %></label>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-4 opacity-25" />

                            <div class="form-check form-switch p-3 bg-body-tertiary rounded-2 border">
                                <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" id="newnewsletter" name="newnewsletter" value="true">
                                <label class="form-check-label fw-semibold" for="newnewsletter">
                                    <i class="fa-solid fa-envelope-open-text text-muted me-1"></i> <%= __('kiosk.new_newsletter') %>
                                </label>
                                <div class="form-text small text-muted ms-1">
                                    <%= __('kiosk.new_newsletter_desc') %>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-body-tertiary py-3 px-4 d-flex flex-wrap align-items-center justify-content-end gap-2">
                            <button class="btn btn-primary btn-sm px-4 py-2" type="submit">
                                <i class="fa-solid fa-user-plus me-1"></i> <%= __('kiosk.btn_create_user') %>
                            </button>
                        </div>
                    </form>
                </section>
            </div>
            <% } %>

            <!-- Modal Repair Café: Exit evaluation & outcome popup -->
            <div class="modal fade" id="modalRepairCheckout" tabindex="-1" aria-labelledby="modalRepairCheckoutLabel" aria-hidden="true" data-bs-backdrop="static">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>history/exit-repair" method="POST">
                            <input type="hidden" name="historyid" id="repairExitHistoryId" value="" />
                            <div class="modal-header">
                                <h5 class="modal-title" id="modalRepairCheckoutLabel">
                                    <i class="fa-solid fa-wrench text-warning me-2" aria-hidden="true"></i>Bilan Repair Café — Clôture de visite
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                            </div>
                            <div class="modal-body">
                                <div class="p-3 bg-body-tertiary border rounded-2 d-flex align-items-center gap-3 mb-3">
                                    <span class="fab-kpi-icon" aria-hidden="true">
                                        <i class="fa-solid fa-screwdriver-wrench text-warning"></i>
                                    </span>
                                    <div>
                                        <div class="fw-bold text-body-emphasis fs-6" id="repairExitUserName">Contributeur</div>
                                        <div class="text-muted small">Objet : <strong id="repairExitObjectName" class="text-primary">-</strong></div>
                                    </div>
                                </div>

                                <label class="form-label fw-semibold small mb-2">Quel est le résultat de la réparation ? <span class="text-danger">*</span></label>
                                <div class="d-flex flex-column gap-2 mb-3">
                                    <div class="form-check p-2 border rounded-2 bg-body-tertiary">
                                        <input class="form-check-input ms-1 me-2" type="radio" name="repairStatus" id="statusRepaired" value="REPAIRED" required checked>
                                        <label class="form-check-label fw-semibold text-success" for="statusRepaired">
                                            <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i> Réparé
                                            <div class="text-muted small fw-normal ms-4">L'objet fonctionne à nouveau parfaitement</div>
                                        </label>
                                    </div>
                                    <div class="form-check p-2 border rounded-2 bg-body-tertiary">
                                        <input class="form-check-input ms-1 me-2" type="radio" name="repairStatus" id="statusPartially" value="PARTIALLY_REPAIRED">
                                        <label class="form-check-label fw-semibold text-info" for="statusPartially">
                                            <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i> Partiellement réparé
                                            <div class="text-muted small fw-normal ms-4">Certaines fonctions réparées ou utilisation possible avec restrictions</div>
                                        </label>
                                    </div>
                                    <div class="form-check p-2 border rounded-2 bg-body-tertiary">
                                        <input class="form-check-input ms-1 me-2" type="radio" name="repairStatus" id="statusNotRepaired" value="NOT_REPAIRED">
                                        <label class="form-check-label fw-semibold text-danger" for="statusNotRepaired">
                                            <i class="fa-solid fa-circle-xmark me-1" aria-hidden="true"></i> Non réparé
                                            <div class="text-muted small fw-normal ms-4">L'objet n'a pas pu être réparé (composant HS, irréparable...)</div>
                                        </label>
                                    </div>
                                    <div class="form-check p-2 border rounded-2 bg-body-tertiary">
                                        <input class="form-check-input ms-1 me-2" type="radio" name="repairStatus" id="statusNeedsReturn" value="NEEDS_RETURN">
                                        <label class="form-check-label fw-semibold text-warning-emphasis" for="statusNeedsReturn">
                                            <i class="fa-solid fa-rotate-right me-1" aria-hidden="true"></i> À poursuivre / Doit revenir pour finir
                                            <div class="text-muted small fw-normal ms-4">Réparation en cours, pièce commandée ou session à terminer</div>
                                        </label>
                                    </div>
                                </div>

                                <div class="mb-1">
                                    <label for="repairExitNotes" class="form-label fw-semibold small">Remarques / Pièces à prévoir (optionnel)</label>
                                    <textarea class="form-control" placeholder="Remarques éventuelles" id="repairExitNotes" name="repairNotes" rows="3"></textarea>
                                </div>
                            </div>
                            <div class="modal-footer bg-body-tertiary">
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="fa-solid fa-check me-1" aria-hidden="true"></i> Valider la sortie
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <% } %>

            <%- include('../includes/footer.html') %>

        <% if (!isBorneRole) { %>
        <script id="consumablesData" type="application/json">
            <%- safeJson(consumables.map(function(c) {
                return {
                    id: c.id,
                    name: c.name,
                    cost: Number(c.cost),
                    unit: c.unit || 'u',
                    stock: c.stock,
                    stockUnit: c.stockUnit || '',
                    unitsPerPack: Number(c.unitsPerPack || 1),
                    categoryName: c.category ? c.category.name : ''
                };
            })) %>
        </script>

        <script id="equipmentData" type="application/json">
            <%- safeJson((typeof equipment !== 'undefined' ? equipment : []).map(function(eq) {
                return {
                    id: eq.id,
                    name: eq.name,
                    workspaceId: eq.workspaceId,
                    workspaceName: eq.workspace ? eq.workspace.name : ''
                };
            })) %>
        </script>
        <% } %>
        <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
            window.bookstackConfig = {
                enabled: <%= (typeof isPluginBookstackEnabled !== 'undefined' && isPluginBookstackEnabled) ? 'true' : 'false' %>,
                baseUrl: <%- safeJson(typeof bookstackBaseUrl !== 'undefined' ? bookstackBaseUrl : 'https://wiki.fablab.sorbonne-universite.fr/BookStack/') %>,
                autoPrefill: <%= (typeof bookstackAutoPrefill !== 'undefined' && bookstackAutoPrefill) ? 'true' : 'false' %>
            };
            window.repairCafeConfig = {
                enabled: <%= (typeof isPluginRepairCafeEnabled !== 'undefined' && isPluginRepairCafeEnabled) ? 'true' : 'false' %>,
                projectTypeName: <%- safeJson(typeof repairCafeProjectTypeName !== 'undefined' ? repairCafeProjectTypeName : 'Repair Café') %>
            };
            window.workshopConfig = {
                enabled: <%= (typeof isPluginWorkshopEnabled !== 'undefined' && isPluginWorkshopEnabled) ? 'true' : 'false' %>,
                projectTypeName: <%- safeJson(typeof workshopProjectTypeName !== 'undefined' ? workshopProjectTypeName : 'Atelier') %>
            };
            window.ueConfig = {
                enabled: <%= (typeof isPluginUeEnabled !== 'undefined' && isPluginUeEnabled) ? 'true' : 'false' %>,
                projectTypeName: <%- safeJson(typeof ueProjectTypeName !== 'undefined' ? ueProjectTypeName : 'Academic') %>
            };
            window.sorbonneConfig = {
                enabled: <%= (typeof isPluginSorbonneEnabled !== 'undefined' && isPluginSorbonneEnabled) ? 'true' : 'false' %>,
                projectTypeName: <%- safeJson(typeof sorbonneProjectTypeName !== 'undefined' ? sorbonneProjectTypeName : 'Sorbonne') %>
            };
            window.rfidConfig = {
                enabled: <%= (typeof isPluginRfidEnabled !== 'undefined' && isPluginRfidEnabled) ? 'true' : 'false' %>,
                acr122uEnabled: <%= (typeof rfidAcr122uEnabled !== 'undefined' && rfidAcr122uEnabled) ? 'true' : 'false' %>,
                bridgePort: <%= (typeof rfidBridgePort !== 'undefined' && rfidBridgePort) ? Number(rfidBridgePort) : 8765 %>
            };
        </script>

        <% if (isBorneRole) { %>
        <script src="javascripts/borne-checkin.js"></script>
        <% } else { %>
        <script src="javascripts/fabtrack.js"></script>
        <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
            (function () {
                ["registerbutton", "newuserbutton"].forEach(function (btnId) {
                    const el = document.getElementById(btnId);
                    if (!el) return;
                    el.addEventListener("keydown", function (event) {
                        if (event.key === "Enter" || event.key === " ") {
                            event.preventDefault();
                            el.click();
                        }
                    });
                });
            })();
        </script>
        <% } %>
        <% if (typeof isPluginRfidEnabled !== 'undefined' && isPluginRfidEnabled) { %>
        <script src="javascripts/rfid-listener.js"></script>
        <% } %>

    </body>
</html>
