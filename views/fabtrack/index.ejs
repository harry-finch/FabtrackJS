<!doctype html>
<html lang="en" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="" />
        <meta name="author" content="Stéphane Muller" />
        <title>Fabtrack administration panel</title>

        <%- include('../includes/pagehead.html') %>

        <script src="/javascripts/autocomplete.js"></script>
        <link rel="stylesheet" href="/stylesheets/autocomplete.css" />
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <% if (typeof isPluginRfidEnabled !== 'undefined' && isPluginRfidEnabled) { %>
            <!-- RFID Kiosk Status Banner -->
            <div class="card border-0 shadow-sm mb-4 bg-info-subtle border border-info-subtle rounded-3" data-workspace-id="<%= (typeof selectedWorkspace !== 'undefined' && selectedWorkspace) ? selectedWorkspace.id : '' %>">
                <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-info text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px; font-size: 1.25rem;">
                            <i class="fa-solid fa-id-card"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-body">Borne RFID Active</h6>
                            <small class="text-muted">Passez votre badge sur le lecteur pour enregistrer votre entrée ou sortie automatiquement.</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3" onclick="promptManualRfid()">
                            <i class="fa-solid fa-keyboard me-1"></i> Tester un badge
                        </button>
                        <span class="badge bg-info text-white px-3 py-2 rounded-pill">
                            <i class="fa-solid fa-wifi me-1"></i> Prêt pour scan
                        </span>
                    </div>
                </div>
            </div>
            <script>
                function promptManualRfid() {
                    const code = prompt("Simuler le scan d'une carte RFID (numéro de badge / UID) :");
                    if (code && code.trim() && window.triggerKioskRfidScan) {
                        window.triggerKioskRfidScan(code.trim());
                    }
                }
            </script>
            <% } %>

            <!-- Registering form -->
            <div id="register">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="d-flex align-items-center gap-2">
                        <a class="jsButton fs-4 text-primary" id="registerbutton" style="text-decoration: none;" title="<%= __('kiosk.switch_to_create') %>"><i class="fa fa-toggle-on"></i></a>
                        <div>
                            <h4 class="fw-bold mb-0"><%= __('kiosk.register_user_title') %></h4>
                            <small class="text-muted"><%= __('kiosk.register_user_subtitle') %></small>
                        </div>
                    </div>
                </div>
                <form action="/history/create" method="post">
                    <div class="row">
                        <div class="col-12">
                            <div class="form-floating mb-3 d-grid d-flex">
                                <input type='hidden' id="userid" name='userid' value='null' />
                                <input type="text" class="form-control input-group-icon" id="name" name="name" placeholder="<%= __('kiosk.field_name') %>" autocomplete="off" required />
                                <label for="name"><%= __('kiosk.field_name') %></label>
                                <a id="urlprofile" href="">
                                    <span class="formbutton input-group-text"><i class="fa fa-user fa-lg" aria-hidden="true"></i></span>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="row" id="charterWarningRow" style="display: none;">
                        <div class="col-12">
                            <div class="alert alert-warning border border-warning-subtle d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 py-2 px-3 rounded-3 shadow-sm" role="alert" id="charterWarningAlert">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fs-4 text-warning"><i class="fa-solid fa-triangle-exclamation"></i></span>
                                    <div>
                                        <div class="fw-bold text-body">Charte d'utilisation non signée</div>
                                        <small class="text-body-secondary" id="charterWarningMsg">Cet usager n'a pas encore validé la charte du fablab. L'inscription au lab est bloquée tant que la charte n'est pas acceptée.</small>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <a id="charterProfileBtn" href="" class="btn btn-sm btn-outline-warning rounded-pill">
                                        <i class="fa-solid fa-user-pen me-1"></i> Valider sur la fiche usager
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-8" id="documentationCol">
                            <div class="form-floating mb-3 d-grid d-flex">
                                <input type='hidden' id="projectid" name='projectid' value='null' />
                                <input type='hidden' id="userprojectid" name='userprojectid' value='null' />
                                <input type="text" class="form-control input-group-icon" id="documentation" name="documentation" autocomplete="off" placeholder="<%= __('kiosk.field_documentation') %>" required />
                                <label for="documentation"><%= __('kiosk.field_documentation') %></label>
                                <a id="urldocumentation" href="" target="_blank" rel="noopener noreferrer">
                                    <span class="formbutton input-group-text" id="docStatusBtn" title="Consulter la documentation du projet"><i class="fa-solid fa-book-circle-arrow-right fa-lg"></i></span>
                                </a>
                            </div>
                        </div>
                        <div class="col-8" id="repairObjectCol" style="display: none;">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="repairObject" name="repairObject" autocomplete="off" placeholder="Objet à réparer" />
                                <label for="repairObject"><i class="fa-solid fa-screwdriver-wrench text-warning me-1"></i> Objet à réparer (ex: Cafetière Seb, Fer à repasser, Lampe...)</label>
                            </div>
                        </div>
                        <div class="col-8" id="workshopCol" style="display: none;">
                            <div class="form-floating mb-3">
                                <select class="form-select" id="workshopId" name="workshopId">
                                    <option value="" selected disabled>Choisir un atelier...</option>
                                    <% if (typeof availableWorkshops !== 'undefined' && availableWorkshops) { %>
                                        <% availableWorkshops.forEach(function(ws) { %>
                                        <option value="<%= ws.id %>">
                                            <%= ws.name %><% if (ws.badge) { %> (Badge : <%= ws.badge.name %>)<% } %>
                                        </option>
                                        <% }); %>
                                    <% } %>
                                </select>
                                <label for="workshopId"><i class="fa-solid fa-graduation-cap text-primary me-1"></i> Atelier suivi (badge attribué automatiquement)</label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-floating mb-3">
                                <select class="form-select" id="projecttype" name="projecttype">
                                    <option selected></option>
                                    <% projecttypes.forEach(function(projecttype) { %>
                                    <option value="<%= projecttype.id %>"><%= projecttype.name %></option>
                                    <% }); %>
                                </select>
                                <label for="projecttype"><%= __('kiosk.field_project_type') %></label>
                            </div>
                        </div>
                    </div>

                    <% if (typeof isPluginUeEnabled !== 'undefined' && isPluginUeEnabled) { %>
                    <div class="row" id="ueRow" style="display: none;">
                        <div class="col-12">
                            <div class="form-floating mb-3">
                                <select class="form-select" id="teachingUnitId" name="teachingUnitId">
                                    <option value="" selected disabled>Choisir une UE habilitée (Sorbonne Université)...</option>
                                    <% teachingUnits.forEach(function(ue) { %>
                                    <option value="<%= ue.id %>">
                                        <%= ue.code %> — <%= ue.name %> (<%= ue.department || 'Sorbonne Université' %>)
                                    </option>
                                    <% }); %>
                                    <option value="unregistered" class="text-danger fw-semibold">⚠️ UE non-enregistrée</option>
                                </select>
                                <label for="teachingUnitId">
                                    <i class="fa-solid fa-graduation-cap text-primary me-1"></i> Unité d'Enseignement (UE rattachée)
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Dynamic fields for unregistered UE -->
                    <div class="row" id="unregisteredUeRow" style="display: none;">
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="unregisteredUeName" name="unregisteredUeName" placeholder="ex: LU2PY001 ou Atelier Robotique">
                                <label for="unregisteredUeName">
                                    <i class="fa-solid fa-tag text-warning me-1"></i> Intitulé ou Code de l'UE *
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="unregisteredUeContact" name="unregisteredUeContact" placeholder="ex: prof.responsable@sorbonne-universite.fr">
                                <label for="unregisteredUeContact">
                                    <i class="fa-solid fa-user-tie text-info me-1"></i> Contact / Enseignant responsable
                                </label>
                            </div>
                        </div>
                    </div>
                    <% } %>
                    <div class="row">
                        <div class="col">
                            <div class="form-floating mb-3">
                                <textarea class="form-control" id="comments" name="comments" style="height: 100px"></textarea>
                                <label for="comments"><%= __('kiosk.field_comments') %></label>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <button class="btn btn-primary w-100 mb-2 py-2 rounded-pill shadow-sm" type="submit" id="registerSubmitBtn">
                                <i class="fa-solid fa-check me-1"></i> <%= __('kiosk.btn_register') %>
                            </button>
                        </div>
                    </div>
                </form>

                <!-- Lab activity table (only shown if people are actually in the lab) -->

                <% if( Object.entries(history).length ) { %>
                <div class="card border-0 shadow-sm mt-5 mb-4">
                    <div class="card-header bg-transparent border-0 pt-3 pb-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="icon-box bg-success-subtle text-success" style="width: 38px; height: 38px; font-size: 1.1rem;">
                                <i class="fa-solid fa-users"></i>
                            </span>
                            <h5 class="fw-bold mb-0"><%- Object.entries(history).length %> <%= __('kiosk.users_present') %></h5>
                        </div>

                        <!-- Static Workspace Badge -->
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-semibold">
                            <i class="fa-solid fa-circle fa-2xs text-success me-1"></i><%= selectedWorkspace.name %>
                        </span>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th onclick="sortTable(1)" scope="col" class="ps-3"><%= __('kiosk.th_arrival') %></th>
                                        <th onclick="sortTable(2)" scope="col"><%= __('kiosk.th_user') %></th>
                                        <th scope="col" class="text-center"><%= __('kiosk.th_warnings_balance') %></th>
                                        <th scope="col" class="text-center"><%= __('kiosk.th_comments') %></th>
                                        <th scope="col" class="text-center"><%= __('kiosk.th_activity') %></th>
                                        <th scope="col" class="text-end pe-3"><%= __('kiosk.th_exit') %></th>
                                    </tr>
                                </thead>
                                <tbody id="table-content">
                                    <% history.forEach(function(entry) { 
                                        const isStaffRole = typeof role !== 'undefined' && role === 'staff';
                                     %>
                                    <tr>
                                        <td scope="row" class="ps-3 text-muted">
                                            <i class="fa-regular fa-clock fa-xs me-1"></i><%= entry.arrival %>
                                        </td>
                                        <td>
                                            <% if (isStaffRole) { %>
                                                <span class="fw-semibold"><%= entry.user.name %> <%= entry.user.surname ? entry.user.surname.charAt(0) + '.' : '' %></span>
                                            <% } else { %>
                                                <a href="/users/edit/<%= entry.userId %>" class="fw-semibold text-decoration-none">
                                                    <%= entry.user.name %> <%= entry.user.surname %>
                                                </a>
                                            <% } %>
                                            <% if (entry.user.isExpert) { %>
                                                <span class="badge bg-warning text-dark border border-warning-subtle ms-1 rounded-pill" data-bs-toggle="tooltip" title="<%= __('kiosk.expert_badge') %>">
                                                    <i class="fa-solid fa-star fa-2xs"></i> <%= __('kiosk.expert_badge') %>
                                                </span>
                                            <% } %>
                                            <% if (entry.repairObject) { %>
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1 rounded-pill" data-bs-toggle="tooltip" title="Objet en réparation : <%= entry.repairObject %>">
                                                    <i class="fa-solid fa-wrench fa-2xs"></i> <%= entry.repairObject %>
                                                </span>
                                            <% } %>
                                            <% if (entry.workshop) { %>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1 rounded-pill" data-bs-toggle="tooltip" title="Atelier : <%= entry.workshop.name %>">
                                                    <i class="fa-solid fa-graduation-cap fa-2xs"></i> <%= entry.workshop.name %>
                                                </span>
                                            <% } %>
                                            <% if (entry.activeLoans && entry.activeLoans.length > 0) { %>
                                                <% 
                                                    const loanDetails = entry.activeLoans.map(function(l) { 
                                                        const dueStr = l.expectedReturnAt ? ' (retour prévu: ' + new Date(l.expectedReturnAt).toLocaleDateString('fr-FR') + ')' : '';
                                                        return l.equipmentName + dueStr; 
                                                    }).join(', ');
                                                %>
                                                <% if (entry.hasOverdueLoans) { %>
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1 rounded-pill" data-bs-toggle="tooltip" title="Emprunt EN RETARD : <%= loanDetails %>">
                                                        <i class="fa-solid fa-toolbox fa-2xs"></i> <i class="fa-solid fa-clock-rotate-left fa-2xs"></i> <%= entry.activeLoans.length %> emprunt(s)
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle ms-1 rounded-pill" data-bs-toggle="tooltip" title="Matériel emprunté : <%= loanDetails %>">
                                                        <i class="fa-solid fa-toolbox fa-2xs"></i> <%= entry.activeLoans.length %> emprunt(s)
                                                    </span>
                                                <% } %>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <% if (isStaffRole) { %>
                                                <span class="text-muted small">-</span>
                                            <% } else { %>
                                                <% if ( Object.entries(entry.warnings).length ) { %>
                                                    <% entry.warnings.forEach(function(warning) { %>
                                                    <a href="#" data-bs-toggle="modal" style="text-decoration: none;"
                                                                data-bs-target="#warningDeactivator"
                                                                data-bs-warningid="<%= warning.id %>"
                                                                data-bs-warningtype="<%= warning.warningtype.id %>"
                                                                data-bs-warningcomments="<%= warning.comments %>"
                                                                data-bs-userid="<%= entry.user.id %>"
                                                                data-bs-warninguser="<%= entry.user.name %> <%= entry.user.surname %>">
                                                        <span   data-bs-toggle="tooltip"
                                                                data-bs-placement="right"
                                                                data-bs-custom-class="custom-tooltip"
                                                                data-bs-title="<%= warning.comments %>"><%- warning.warningtype.icon %></span>
                                                    </a>
                                                    <% }); %>
                                                <% } %>
                                                <% if (entry.user.balance != 0) { %>
                                                  <% if (entry.user.balance < 0) { %>
                                                    <a href="#" data-bs-toggle="modal" style="text-decoration: none;"
                                                                data-bs-target="#clearBalance"
                                                                data-bs-balance="<%= entry.user.balance %>"
                                                                data-bs-userid="<%= entry.user.id %>"
                                                                data-bs-username="<%= entry.user.name %> <%= entry.user.surname %>">
                                                  <% } %>
                                                        <span   data-bs-toggle="tooltip"
                                                                data-bs-placement="right"
                                                                data-bs-custom-class="custom-tooltip"
                                                                data-bs-title="<%= entry.user.balance %> €"><i class="fa-solid fa-money-bill-wave" style="color: #009600"></i></span>
                                                    </a>
                                                <% } %>
                                                <% if ( !Object.entries(entry.warnings).length && !(entry.user.balance != 0) ) { %>
                                                <span   data-bs-toggle="tooltip" data-bs-placement="right"
                                                            data-bs-custom-class="custom-tooltip"
                                                            data-bs-title="All clear">-</span>
                                                <% } %>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <% if (isStaffRole) { %>
                                                <span class="text-muted small">-</span>
                                            <% } else { %>
                                                <a href="#" 
                                                   class="comment-action-btn text-decoration-none"
                                                   data-bs-toggle="modal" 
                                                   data-bs-target="#modalComment"
                                                   data-bs-historyid="<%= entry.id %>"
                                                   data-bs-user="<%= entry.user.name %> <%= entry.user.surname %>"
                                                   data-bs-comment="<%- encodeURIComponent(entry.comments || '') %>">
                                                    <% if ( entry.comments ) { %>
                                                        <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-custom-class="custom-tooltip" data-bs-title="<%= __('kiosk.tooltip_edit_comment') %> : <%= entry.comments %>">
                                                            <i class="fa-solid fa-comment-dots text-primary fs-5"></i>
                                                        </span>
                                                    <% } else { %>
                                                        <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-custom-class="custom-tooltip" data-bs-title="<%= __('kiosk.tooltip_add_comment') %>">
                                                            <i class="fa-regular fa-comment text-secondary opacity-50 comment-empty-icon fs-5"></i>
                                                        </span>
                                                    <% } %>
                                                </a>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <% if (isStaffRole) { %>
                                                <span class="text-muted small" title="Ajout d'activité réservé aux médiateurs">
                                                    <i class="fa-solid fa-lock text-body-tertiary"></i>
                                                </span>
                                            <% } else { %>
                                                <a href="#" data-bs-toggle="modal"
                                                            data-bs-target="#activityManager"
                                                            data-bs-user="<%= entry.user.name %> <%= entry.user.surname %>"
                                                            data-bs-userid="<%= entry.user.id %>"
                                                            data-bs-historyid="<%= entry.id %>"
                                                            class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1"
                                                            title="<%= __('kiosk.btn_activity') %>">
                                                    <i class="fa-solid fa-plus me-1"></i><%= __('kiosk.btn_activity') %>
                                                </a>
                                            <% } %>
                                        </td>
                                        <td class="text-end pe-3">
                                            <% if (typeof isPluginRepairCafeEnabled !== 'undefined' && isPluginRepairCafeEnabled && entry.repairObject) { %>
                                                <button type="button" 
                                                        class="btn btn-sm btn-outline-warning rounded-pill px-2 py-1 btn-repair-exit" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#modalRepairCheckout"
                                                        data-bs-historyid="<%= entry.id %>"
                                                        data-bs-user="<%= entry.user.name %> <%= entry.user.surname %>"
                                                        data-bs-repairobject="<%= entry.repairObject %>"
                                                        title="<%= __('kiosk.btn_exit') %>">
                                                    <i class="fa-solid fa-screwdriver-wrench me-1"></i><%= __('kiosk.btn_exit') %>
                                                </button>
                                            <% } else { %>
                                                <a href="/history/exit/<%= entry.id %>" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" title="<%= __('kiosk.btn_exit') %>">
                                                    <i class="fa-solid fa-person-walking-arrow-right me-1"></i><%= __('kiosk.btn_exit') %>
                                                </a>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <% } %>

                <!-- Modal to view/edit/add comments on a user session -->
                <div class="modal fade" id="modalComment" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalCommentLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                            <form action="/history/update-comment" method="post" id="formComment">
                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold" id="modalCommentLabel">
                                        <i class="fa-solid fa-comment-dots text-primary me-2"></i><%= __('kiosk.modal_comment_title') %>
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= __('common.close') %>"></button>
                                </div>
                                <div class="modal-body pt-3">
                                    <div class="mb-3 p-3 bg-body-tertiary rounded-3 border">
                                        <div class="small text-muted mb-1"><%= __('kiosk.modal_comment_user') %></div>
                                        <div class="fw-semibold fs-6" id="commentModalUserName">-</div>
                                    </div>

                                    <input type="hidden" name="historyid" id="commentModalHistoryId" value="">

                                    <div class="mb-2">
                                        <label for="commentModalText" class="form-label fw-semibold small">
                                            <%= __('kiosk.modal_comment_label') %>
                                        </label>
                                        <textarea class="form-control" id="commentModalText" name="comments" rows="4" placeholder="<%= __('kiosk.modal_comment_placeholder') %>"></textarea>
                                        <div class="form-text text-muted small">
                                            <%= __('kiosk.modal_comment_help') %>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer border-0 pt-0 d-flex justify-content-between">
                                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill" id="commentModalClearBtn" title="<%= __('kiosk.modal_comment_clear') %>">
                                        <i class="fa-solid fa-eraser me-1"></i><%= __('kiosk.modal_comment_clear') %>
                                    </button>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal"><%= __('common.cancel') %></button>
                                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                                            <i class="fa-solid fa-check me-1"></i><%= __('kiosk.modal_comment_save') %>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Modal to clear balance -->
                <div class="modal fade" id="clearBalance" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title"><i class="fa-solid fa-money-bill-wave"></i> Pay off debt</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body">
                        <p>Are you sure you want to clear that user's debt?</p>
                        <code class="ms-3"></code>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <a href="" class="btn btn-primary">Clear debt</a>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Modal to deactivate warnings -->
                <div class="modal fade" id="warningDeactivator" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title"><i class="fa-solid fa-triangle-exclamation"></i> Warning</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body">
                        <p>Are you sure you want to resolve the following warning?</p>
                        <code class="ms-3"></code>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <a href="" class="btn btn-primary">Resolve warning</a>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Modal to add activities/machines/payment to a user history -->
                <div class="modal fade" id="activityManager" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                        <h1 class="modal-title fs-5" id="staticBackdropLabel"><i class="fa-solid fa-layer-group text-primary me-2"></i><%= __('kiosk.modal_activity_title') %></h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form action="/history/activity" method="post">
                                <input type='hidden' id="activityhistoryid" name='activityhistoryid' value='null' />
                                <input type='hidden' id="activityuserid" name='activityuserid' value='null' />
                                <input type='hidden' id="cost" name='cost' value='null' />
                                <div class="row align-items-center mb-3">
                                    <div class="col-2 text-secondary">
                                        Utiliser
                                    </div>
                                    <div class="col-10">
                                        <div class="form-floating">
                                            <select class="form-select" id="machineId" name="machineId">
                                                <option value="" selected></option>
                                                <% machines.forEach(function(machine) { %>
                                                <option value="<%= machine.id %>"><%= machine.name %></option>
                                                <% }); %>
                                            </select>
                                            <label for="machineId">Machine</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row align-items-center mb-3">
                                    <div class="col-2 text-secondary">
                                        Emprunter
                                    </div>
                                    <div class="col-6">
                                        <div class="form-floating position-relative">
                                            <input type="hidden" id="equipmentId" name="equipmentId" value="" />
                                            <input
                                                type="text"
                                                class="form-control"
                                                id="equipmentSearch"
                                                placeholder="Taper pour rechercher un équipement / outil..."
                                                autocomplete="off"
                                            />
                                            <label for="equipmentSearch">
                                                <i class="fa-solid fa-toolbox me-1 text-muted"></i> Équipement / Outil
                                            </label>
                                            <button
                                                type="button"
                                                class="btn btn-link text-secondary position-absolute top-50 end-0 translate-middle-y me-2 p-1"
                                                id="clearEquipmentBtn"
                                                style="display: none; z-index: 5;"
                                                title="Effacer la sélection"
                                            >
                                                <i class="fa-solid fa-xmark fa-lg"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="form-floating position-relative">
                                            <select class="form-select" id="borrowDurationDays" name="borrowDurationDays">
                                                <option value="1">1 jour (24h)</option>
                                                <option value="3">3 jours</option>
                                                <option value="7" selected>7 jours (1 sem.)</option>
                                                <option value="14">14 jours (2 sem.)</option>
                                                <option value="30">30 jours (1 mois)</option>
                                            </select>
                                            <label for="borrowDurationDays">
                                                <i class="fa-regular fa-clock me-1 text-muted"></i> Durée d'emprunt
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-n2 mb-3" id="borrowReturnDateNotice" style="display: none;">
                                    <div class="col-2"></div>
                                    <div class="col-10">
                                        <div class="d-flex align-items-center small text-primary bg-primary-subtle px-3 py-1 rounded-pill">
                                            <i class="fa-solid fa-calendar-check me-2"></i>
                                            <span>Retour attendu le : <strong id="borrowCalculatedDateText">-</strong></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row align-items-center mb-3">
                                    <div class="col-2 text-secondary">
                                        Consommer
                                    </div>
                                    <div class="col-7">
                                        <div class="form-floating position-relative">
                                            <input type="hidden" id="consumable" name="consumable" value="" />
                                            <input
                                                type="text"
                                                class="form-control"
                                                id="consumableSearch"
                                                placeholder="Taper pour rechercher un consommable..."
                                                autocomplete="off"
                                            />
                                            <label for="consumableSearch">
                                                <i class="fa-solid fa-magnifying-glass me-1 text-muted"></i> Consommable / Matériau (taper pour rechercher)
                                            </label>
                                            <button
                                                type="button"
                                                class="btn btn-link text-secondary position-absolute top-50 end-0 translate-middle-y me-2 p-1"
                                                id="clearConsumableBtn"
                                                style="display: none; z-index: 5;"
                                                title="Effacer la sélection"
                                            >
                                                <i class="fa-solid fa-xmark fa-lg"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="form-floating">
                                            <input type="number" class="form-control input-group-icon" id="quantity" name="quantity" min="1" value="1" />
                                            <label for="quantity" id="quantityLabel">Quantité</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mb-3" id="consumableLiveCostRow" style="display: none;">
                                    <div class="col-2"></div>
                                    <div class="col-10">
                                        <div class="alert alert-secondary py-2 px-3 mb-0 small d-flex justify-content-between align-items-center">
                                            <span><i class="fa-solid fa-coins text-warning me-1"></i> Total estimé à débiter : <strong id="liveCostAmount" class="text-danger">0.00 €</strong></span>
                                            <span class="text-muted" id="liveUnitPrice">0.00 € / u</span>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal"><%= __('common.cancel') %></button>
                                <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="fa-solid fa-check me-1"></i>Enregistrer</button>
                            </div>
                        </form>
                    </div>
                    </div>
                </div>

            </div>

            <% if (typeof role !== 'undefined' && role === 'staff') { %>
            <div class="card border-0 shadow-sm mt-4 mb-4 bg-body-tertiary border">
                <div class="card-body p-3 text-center text-muted">
                    <i class="fa-solid fa-user-shield text-info me-2"></i>
                    <%= __('kiosk.kiosk_touch_mode') %>
                </div>
            </div>
            <% } else { %>
            <!-- New user creation form -->
            <div id="newuser">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="d-flex align-items-center gap-2">
                        <a class="jsButton fs-4 text-secondary" id="newuserbutton" style="text-decoration: none;" title="<%= __('kiosk.switch_to_search') %>"><i class="fa fa-toggle-off"></i></a>
                        <div>
                            <h4 class="fw-bold mb-0"><%= __('kiosk.create_user_title') %></h4>
                            <small class="text-muted"><%= __('kiosk.create_user_subtitle') %></small>
                        </div>
                    </div>
                </div>
                <form action="/users/create" method="post">
                    <div class="row">
                        <div class="col-4">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="newname" name="newname" placeholder="<%= __('kiosk.new_name') %>" required />
                                <label for="newname"><%= __('kiosk.new_name') %></label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="newsurname" name="newsurname" placeholder="<%= __('kiosk.new_surname') %>" required />
                                <label for="newsurname"><%= __('kiosk.new_surname') %></label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="newbirthyear" name="newbirthyear" placeholder="<%= __('kiosk.new_birthyear') %>" />
                                <label for="newbirthyear"><%= __('kiosk.new_birthyear') %></label>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="form-floating mb-3">
                                <input type="email" name="newemail" class="form-control" id="newemail" placeholder="<%= __('kiosk.new_email') %>" required />
                                <label for="newemail"><%= __('kiosk.new_email') %></label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-floating mb-3">
                                <select class="form-select" id="newusertype" name="newusertype">
                                    <option selected></option>
                                    <% usertypes.forEach(function(usertype) { %>
                                    <option value="<%= usertype.id %>"><%= usertype.name %></option>
                                    <% }); %>
                                </select>
                                <label for="newusertype"><%= __('kiosk.new_usertype') %></label>
                            </div>
                        </div>
                    </div>
                    <% if (typeof isPluginRfidEnabled !== 'undefined' && isPluginRfidEnabled) { %>
                    <div class="row">
                        <div class="col-12">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control font-monospace" id="newrfid" name="newrfid" placeholder="Badge RFID" autocomplete="off" />
                                <label for="newrfid"><i class="fa-solid fa-id-card me-1 text-primary"></i> <%= __('kiosk.new_rfid') %></label>
                            </div>
                        </div>
                    </div>
                    <% } %>
                    <div class="row">
                        <div class="col">
                            <div class="form-floating mb-3">
                                <textarea class="form-control" id="newcomments" name="newcomments" style="height: 100px"></textarea>
                                <label for="newcomments"><%= __('kiosk.field_comments') %></label>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <div class="form-check form-switch p-3 bg-body-tertiary rounded-3 border">
                                <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" id="newnewsletter" name="newnewsletter" value="true">
                                <label class="form-check-label fw-semibold" for="newnewsletter">
                                    <i class="fa-solid fa-envelope-open-text text-primary me-1"></i> <%= __('kiosk.new_newsletter') %>
                                </label>
                                <div class="form-text small text-muted ms-1">
                                    <%= __('kiosk.new_newsletter_desc') %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <button class="btn btn-primary w-100 mb-2 py-2 rounded-pill shadow-sm" type="submit">
                                <i class="fa-solid fa-user-plus me-1"></i> <%= __('kiosk.btn_create_user') %>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            <% } %>

            <!-- Modal Repair Café: Exit evaluation & outcome popup -->
            <div class="modal fade" id="modalRepairCheckout" tabindex="-1" aria-labelledby="modalRepairCheckoutLabel" aria-hidden="true" data-bs-backdrop="static">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow">
                        <form action="/history/exit-repair" method="POST">
                            <input type="hidden" name="historyid" id="repairExitHistoryId" value="" />
                            <div class="modal-header bg-warning-subtle text-dark border-0">
                                <h5 class="modal-title fw-bold" id="modalRepairCheckoutLabel">
                                    <i class="fa-solid fa-wrench me-2"></i>Bilan Repair Café — Clôture de visite
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                            </div>
                            <div class="modal-body p-4">
                                <div class="alert alert-light border d-flex align-items-center gap-3 mb-4">
                                    <div class="rounded-circle bg-warning bg-opacity-25 p-3 text-warning">
                                        <i class="fa-solid fa-screwdriver-wrench fa-xl"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark fs-6" id="repairExitUserName">Usager</div>
                                        <div class="text-muted small">Objet : <strong id="repairExitObjectName" class="text-primary">-</strong></div>
                                    </div>
                                </div>

                                <label class="form-label fw-bold mb-2">Quel est le résultat de la réparation ? <span class="text-danger">*</span></label>
                                <div class="d-flex flex-column gap-2 mb-3">
                                    <div class="form-check p-2 border rounded-3 bg-body-tertiary">
                                        <input class="form-check-input ms-1 me-2" type="radio" name="repairStatus" id="statusRepaired" value="REPAIRED" required checked>
                                        <label class="form-check-label fw-semibold text-success" for="statusRepaired">
                                            <i class="fa-solid fa-circle-check me-1"></i> Réparé
                                            <div class="text-muted small fw-normal ms-4">L'objet fonctionne à nouveau parfaitement</div>
                                        </label>
                                    </div>
                                    <div class="form-check p-2 border rounded-3 bg-body-tertiary">
                                        <input class="form-check-input ms-1 me-2" type="radio" name="repairStatus" id="statusPartially" value="PARTIALLY_REPAIRED">
                                        <label class="form-check-label fw-semibold text-info" for="statusPartially">
                                            <i class="fa-solid fa-triangle-exclamation me-1"></i> Partiellement réparé
                                            <div class="text-muted small fw-normal ms-4">Certaines fonctions réparées ou utilisation possible avec restrictions</div>
                                        </label>
                                    </div>
                                    <div class="form-check p-2 border rounded-3 bg-body-tertiary">
                                        <input class="form-check-input ms-1 me-2" type="radio" name="repairStatus" id="statusNotRepaired" value="NOT_REPAIRED">
                                        <label class="form-check-label fw-semibold text-danger" for="statusNotRepaired">
                                            <i class="fa-solid fa-circle-xmark me-1"></i> Non réparé
                                            <div class="text-muted small fw-normal ms-4">L'objet n'a pas pu être réparé (composant HS, irréparable...)</div>
                                        </label>
                                    </div>
                                    <div class="form-check p-2 border rounded-3 bg-body-tertiary">
                                        <input class="form-check-input ms-1 me-2" type="radio" name="repairStatus" id="statusNeedsReturn" value="NEEDS_RETURN">
                                        <label class="form-check-label fw-semibold text-warning-emphasis" for="statusNeedsReturn">
                                            <i class="fa-solid fa-rotate-right me-1"></i> À poursuivre / Doit revenir pour finir
                                            <div class="text-muted small fw-normal ms-4">Réparation en cours, pièce commandée ou session à terminer</div>
                                        </label>
                                    </div>
                                </div>

                                <div class="form-floating">
                                    <textarea class="form-control" placeholder="Remarques éventuelles" id="repairExitNotes" name="repairNotes" style="height: 80px"></textarea>
                                    <label for="repairExitNotes">Remarques / Pièces à prévoir (optionnel)</label>
                                </div>
                            </div>
                            <div class="modal-footer border-0 pt-0">
                                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                                    <i class="fa-solid fa-check me-1"></i> Valider la sortie
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <%- include('../includes/footer.html') %>

        <script id="consumablesData" type="application/json">
            <%- JSON.stringify(consumables.map(function(c) {
                return {
                    id: c.id,
                    name: c.name,
                    cost: Number(c.cost),
                    unit: c.unit || 'u',
                    stock: c.stock,
                    stockUnit: c.stockUnit || '',
                    unitsPerPack: Number(c.unitsPerPack || 1),
                    categoryName: c.category ? c.category.name : ''
                };
            })) %>
        </script>

        <script id="equipmentData" type="application/json">
            <%- JSON.stringify((typeof equipment !== 'undefined' ? equipment : []).map(function(eq) {
                return {
                    id: eq.id,
                    name: eq.name,
                    workspaceId: eq.workspaceId,
                    workspaceName: eq.workspace ? eq.workspace.name : ''
                };
            })) %>
        </script>
        <script>
            window.bookstackConfig = {
                enabled: <%= (typeof isPluginBookstackEnabled !== 'undefined' && isPluginBookstackEnabled) ? 'true' : 'false' %>,
                baseUrl: "<%= typeof bookstackBaseUrl !== 'undefined' ? bookstackBaseUrl : 'https://wiki.fablab.sorbonne-universite.fr/BookStack/' %>",
                autoPrefill: <%= (typeof bookstackAutoPrefill !== 'undefined' && bookstackAutoPrefill) ? 'true' : 'false' %>
            };
            window.repairCafeConfig = {
                enabled: <%= (typeof isPluginRepairCafeEnabled !== 'undefined' && isPluginRepairCafeEnabled) ? 'true' : 'false' %>,
                projectTypeName: "<%= typeof repairCafeProjectTypeName !== 'undefined' ? repairCafeProjectTypeName : 'Repair Café' %>"
            };
            window.workshopConfig = {
                enabled: <%= (typeof isPluginWorkshopEnabled !== 'undefined' && isPluginWorkshopEnabled) ? 'true' : 'false' %>,
                projectTypeName: "<%= typeof workshopProjectTypeName !== 'undefined' ? workshopProjectTypeName : 'Atelier' %>"
            };
            window.ueConfig = {
                enabled: <%= (typeof isPluginUeEnabled !== 'undefined' && isPluginUeEnabled) ? 'true' : 'false' %>,
                projectTypeName: "<%= typeof ueProjectTypeName !== 'undefined' ? ueProjectTypeName : 'Academic' %>"
            };
        </script>

        <script src="/javascripts/fabtrack.js"></script>
        <% if (typeof isPluginRfidEnabled !== 'undefined' && isPluginRfidEnabled) { %>
        <script src="/javascripts/rfid-listener.js"></script>
        <% } %>

    </body>
</html>
