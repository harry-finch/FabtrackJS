<!doctype html>
<html lang="en" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="" />
        <meta name="author" content="Stéphane Muller" />
        <title>Fabtrack administration panel</title>

        <%- include('../includes/pagehead.html') %>
        <script src="/javascripts/pagination.js"></script>
        <style>
            .user-accordion-btn {
                background-color: var(--bs-body-bg);
                color: var(--bs-body-color);
                box-shadow: none !important;
                border: none;
                transition: background-color 0.2s ease;
            }
            .user-accordion-btn:hover {
                background-color: var(--bs-tertiary-bg);
            }
            .user-accordion-btn:not(.collapsed) {
                background-color: var(--bs-tertiary-bg);
                color: var(--bs-body-color);
                box-shadow: none !important;
            }
            .user-accordion-btn:focus {
                box-shadow: none !important;
            }
        </style>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Page Header -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.25rem;">
                            <i class="fa-solid fa-user-pen"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h4 class="fw-bold mb-0"><%= user.name %> <%= user.surname %></h4>
                                <% if (user.isExpert) { %>
                                    <span class="badge bg-warning text-dark border border-warning-subtle rounded-pill" style="font-size: 0.72rem;">
                                        <i class="fa-solid fa-star fa-2xs"></i> Expert
                                    </span>
                                <% } %>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" style="font-size: 0.72rem;">
                                    <%= user.usertype ? user.usertype.name : 'Usager' %>
                                </span>
                            </div>
                            <p class="text-muted small mb-0"><i class="fa-regular fa-calendar-check me-1"></i><%= typeof __ !== 'undefined' ? __('profile.account_created_on') : 'Compte créé le' %> <%= user.accountCreationDate %></p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="/fabtrack" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            <i class="fa-solid fa-desktop me-1"></i> <%= typeof __ !== 'undefined' ? __('nav.kiosk') : 'Kiosque Fabtrack' %>
                        </a>
                    </div>
                </div>
            </div>
            <form action="/users/update/<%= user.id %>" method="post">
                <div class="row">
                    <div class="col-4">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="name" name="name" value="<%= user.name %>" required />
                            <label for="name"><%= typeof __ !== 'undefined' ? __('profile.first_name') : 'Prénom' %></label>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="surname" name="surname" value="<%= user.surname %>" required />
                            <label for="surname"><%= typeof __ !== 'undefined' ? __('profile.last_name') : 'Nom' %></label>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="birthyear" name="birthyear" value="<%= user.birthYear %>" />
                            <label for="birthyear"><%= typeof __ !== 'undefined' ? __('profile.birth_year') : 'Année de naissance' %></label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="form-floating mb-3">
                            <input type="email" name="email" class="form-control" id="email" value="<%= user.email %>" required />
                            <label for="email"><%= typeof __ !== 'undefined' ? __('profile.email') : 'Adresse e-mail' %></label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-floating mb-3">
                            <select class="form-select" id="usertype" name="usertype">
                                <% usertypes.forEach(function(usertype) { %>
                                <option value="<%= usertype.id %>" <% if (usertype.id == user.usertypeId) { %> selected <% } %>><%= usertype.name %></option>
                                <% }); %>
                            </select>
                            <label for="usertype"><%= typeof __ !== 'undefined' ? __('profile.user_type') : "Type d'usager" %></label>
                        </div>
                    </div>
                </div>
                <% if (typeof isPluginRfidEnabled !== 'undefined' && isPluginRfidEnabled) { %>
                <div class="row">
                    <div class="col-12">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control font-monospace" id="rfid" name="rfid" value="<%= user.rfid || '' %>" placeholder="Badge RFID" autocomplete="off" />
                            <label for="rfid"><i class="fa-solid fa-id-card me-1 text-primary"></i> <%= typeof __ !== 'undefined' ? __('profile.rfid_badge') : 'Numéro de badge RFID (UID)' %></label>
                        </div>
                    </div>
                </div>
                <% } %>
                <div class="row">
                    <div class="col">
                        <div class="form-floating mb-3">
                            <textarea class="form-control" id="comments" name="comments" style="height: 100px"><%= user.comment %></textarea>
                            <label for="comments"><%= typeof __ !== 'undefined' ? __('profile.comments') : 'Commentaires' %></label>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col">
                        <div class="form-check form-switch p-3 bg-body-tertiary rounded-3 border">
                            <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" id="newsletter" name="newsletter" value="true" <%= user.newsletter ? 'checked' : '' %>>
                            <label class="form-check-label fw-bold" for="newsletter">
                                <i class="fa-solid fa-envelope-open-text text-primary me-1"></i> <%= typeof __ !== 'undefined' ? __('profile.newsletter') : 'Inscription à la newsletter' %>
                            </label>
                            <div class="form-text small text-muted ms-1">
                                <%= typeof __ !== 'undefined' ? __('profile.newsletter_desc') : 'Recevoir la newsletter et les actualités du Fablab par e-mail.' %>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col">
                        <div class="form-check form-switch p-3 bg-body-tertiary rounded-3 border">
                            <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" id="isExpert" name="isExpert" value="true" <%= user.isExpert ? 'checked' : '' %>>
                            <label class="form-check-label fw-bold" for="isExpert">
                                <i class="fa-solid fa-star text-warning me-1"></i> <%= typeof __ !== 'undefined' ? __('profile.expert_user') : 'Utilisateur expert (distinction à l\'appréciation du staff)' %>
                            </label>
                            <div class="form-text small text-muted ms-1">
                                <%= typeof __ !== 'undefined' ? __('profile.expert_user_desc') : 'Attribue le statut d\'utilisateur expert. Ce badge sera le seul affiché dans la liste des personnes présentes sur le kiosque.' %>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-2 mb-4">
                    <div class="col-sm-6">
                        <button class="btn btn-primary w-100 py-2 rounded-pill shadow-sm" type="submit">
                            <i class="fa-solid fa-check me-1"></i> <%= typeof __ !== 'undefined' ? __('profile.update_profile') : 'Mettre à jour le profil' %>
                        </button>
                    </div>
                    <div class="col-sm-6">
                        <a id="cancel" href="/fabtrack" class="btn btn-outline-secondary w-100 py-2 rounded-pill">
                            <%= typeof __ !== 'undefined' ? __('common.cancel') : 'Annuler' %>
                        </a>
                    </div>
                </div>
            </form>

            <div class="d-flex align-items-center gap-2 mb-3 mt-4">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle section-badge-header px-2 py-1">
                    <%= typeof __ !== 'undefined' ? __('profile.user_stats') : 'Statistiques de l\'usager' %>
                </span>
                <hr class="flex-grow-1 my-0 opacity-25">
            </div>

            <div class="row g-3 mb-4">
                <!-- Balance Card -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Solde du compte</span>
                                <i class="fa-solid fa-wallet fs-5 <%= userStats.balancePositive ? 'text-success' : 'text-danger' %>"></i>
                            </div>
                            <div class="fs-4 fw-bold mb-1 <%= userStats.balancePositive ? 'text-success' : 'text-danger' %>">
                                <%= userStats.balance %> €
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <% if (userStats.balancePositive) { %>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle small">Solde positif</span>
                                <% } else { %>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">Débiteur</span>
                                <% } %>
                                <% if(role == "admin") { %>
                                    <button type="button" class="btn btn-sm btn-outline-success py-0 px-2" data-bs-toggle="modal" data-bs-target="#addMoney">
                                        <i class="fa-solid fa-plus-circle me-1"></i> Créditer
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Visits Card -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Visites au Fablab</span>
                                <i class="fa-solid fa-door-open fs-5 text-primary"></i>
                            </div>
                            <div class="fs-4 fw-bold mb-1 text-primary">
                                <%= userStats.totalVisits %>
                            </div>
                            <div class="small text-muted">
                                Dernière visite : <%= userStats.lastVisit %>
                            </div>
                            <div class="small text-muted">
                                Inscrit le <%= user.accountCreationDate %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Projects Card -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Projets</span>
                                <i class="fa-solid fa-folder-open fs-5 text-warning"></i>
                            </div>
                            <div class="fs-4 fw-bold mb-1 text-warning">
                                <%= userStats.totalProjects %>
                            </div>
                            <div class="small text-muted">
                                <%= userStats.activeProjects %> actif(s) / <%= userStats.totalProjects - userStats.activeProjects %> archivé(s)
                            </div>
                        </div>
                    </div>
                </div>



                <!-- Badges & Habilitations Card -->
                <div class="col-12">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary border-start border-warning border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Badges & Habilitations</span>
                                <div class="d-flex align-items-center gap-2">
                                    <% if (role === 'admin') { %>
                                        <button type="button" class="btn btn-sm btn-outline-warning py-0 px-2 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAddHabilitation" title="Ajouter manuellement une habilitation (rétroactive ou nouvelle)">
                                            <i class="fa-solid fa-plus-circle me-1"></i> Ajouter habilitation
                                        </button>
                                    <% } %>
                                    <i class="fa-solid fa-award fs-5 text-warning"></i>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                                <div class="fs-4 fw-bold text-primary">
                                    <%= userStats.badgesCount %> badge(s)
                                </div>
                                <% if (user.isExpert) { %>
                                    <span class="badge bg-warning text-dark border border-warning-subtle px-3 py-2 rounded-pill">
                                        <i class="fa-solid fa-star me-1"></i> Expert du Fablab
                                    </span>
                                <% } %>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                    <i class="fa-solid fa-graduation-cap me-1"></i> <%= userStats.workshopBadgesCount %> atelier(s) suivi(s)
                                </span>
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2 rounded-pill">
                                    <i class="fa-solid fa-lock-open me-1"></i> <%= userStats.habilitationsCount %> habilitation(s) machine
                                </span>
                            </div>
                            <% if (userStats.habilitations && userStats.habilitations.length > 0) { %>
                                <div class="small text-muted mt-2">
                                    <i class="fa-solid fa-shield-halved me-1 text-success"></i> Habilitations machines reconnues :
                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                        <% userStats.habilitations.forEach(function(hab) { %>
                                            <span class="badge bg-body-secondary text-secondary-emphasis border rounded-pill px-2 py-1">
                                                <i class="fa-solid fa-check me-1 text-success"></i><%= hab.name %>
                                            </span>
                                        <% }); %>
                                    </div>
                                </div>
                            <% } else { %>
                                <div class="small text-muted fst-italic mt-2">
                                    <i class="fa-solid fa-circle-info me-1"></i> Aucune habilitation machine enregistrée pour le moment.
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal to clear / add balance -->
            <div class="modal fade" id="addMoney" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
              <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form action="/history/credit" method="post">
                        <input type='hidden' id="userid" name='userid' value='<%= user.id %>' />
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="fa-solid fa-money-bill-wave text-success"></i> Créditer le compte</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p>Montant à créditer sur le compte de <strong><%= user.name %> <%= user.surname %></strong> :</p>
                            <div class="form-floating mb-3">
                                <input type="number" step="0.01" min="0.01" name="money" class="form-control" id="money" placeholder="Montant en euros" required />
                                <label for="money">Montant (€)</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                            <button type="submit" class="btn btn-success"><i class="fa-solid fa-check"></i> Ajouter le crédit</button>
                        </div>
                    </form>
                </div>
              </div>
            </div>

            <!-- Modal to award workshop / machine habilitation -->
            <% if (role === 'admin') { %>
            <div class="modal fade" id="modalAddHabilitation" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalAddHabilitationLabel" aria-hidden="true">
              <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <form action="/users/<%= user.id %>/workshop-badge/award" method="post">
                        <div class="modal-header bg-body-tertiary">
                            <h5 class="modal-title" id="modalAddHabilitationLabel">
                                <i class="fa-solid fa-award text-warning me-2"></i> Ajouter une habilitation
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <p class="text-muted small mb-3">
                                Attribuez une habilitation machine ou validez un atelier pour <strong><%= user.name %> <%= user.surname %></strong>. Vous pouvez indiquer une date passée si l'atelier a été réalisé avant la mise en place de la plateforme.
                            </p>

                            <div class="mb-3">
                                <label for="modalWorkshopId" class="form-label fw-semibold small">Atelier / Habilitation <span class="text-danger">*</span></label>
                                <select class="form-select" id="modalWorkshopId" name="workshopId" required>
                                    <option value="" disabled selected>Sélectionner l'atelier ou l'habilitation...</option>
                                    <% availableWorkshops.forEach(function(ws) { %>
                                        <% const isCompleted = user.workshopCompletions.some(wc => wc.workshopId === ws.id); %>
                                        <option value="<%= ws.id %>">
                                            <%= ws.name %> 
                                            <% if (ws.access) { %>(Habilite : <%= ws.access.name %>)<% } else { %>(Badge atelier)<% } %>
                                            <% if (isCompleted) { %> [Déjà attribué - met à jour la date]<% } %>
                                        </option>
                                    <% }); %>
                                </select>
                                <% if (!availableWorkshops || availableWorkshops.length === 0) { %>
                                    <div class="form-text text-danger small">
                                        Aucun atelier configuré. Vous pouvez en créer dans l'administration des ateliers.
                                    </div>
                                <% } %>
                            </div>

                            <div class="mb-3">
                                <label for="modalAwardedAt" class="form-label fw-semibold small">Date de réalisation / validation <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="modalAwardedAt" name="awardedAt" value="<%= new Date().toISOString().split('T')[0] %>" required />
                                <div class="form-text text-muted small">
                                    <i class="fa-regular fa-calendar-check me-1"></i> Date à laquelle la formation a été suivie (permet d'antidater).
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="modalAwardedBy" class="form-label fw-semibold small">Validé par / Formateur</label>
                                <input type="text" class="form-control" id="modalAwardedBy" name="awardedBy" value="<%= (typeof username !== 'undefined' && username) ? username : 'Admin' %>" placeholder="Ex: Jean (Médiateur) ou nom du formateur" />
                            </div>

                            <div class="form-check mt-3">
                                <input class="form-check-input" type="checkbox" name="removeInterest" value="true" id="modalRemoveInterest" checked />
                                <label class="form-check-label small text-muted" for="modalRemoveInterest">
                                    Supprimer la demande d'intérêt en attente si elle existe pour cet atelier
                                </label>
                            </div>
                        </div>
                        <div class="modal-footer bg-body-tertiary">
                            <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Annuler</button>
                            <button type="submit" class="btn btn-success rounded-pill px-3">
                                <i class="fa-solid fa-check me-1"></i> Enregistrer l'habilitation
                            </button>
                        </div>
                    </form>
                </div>
              </div>
            </div>
            <% } %>

            <div class="d-flex align-items-center gap-2 mb-3 mt-4">
                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle section-badge-header px-2 py-1">
                    <i class="fa-solid fa-folder-tree me-1"></i> Activité & Historique détaillé
                </span>
                <hr class="flex-grow-1 my-0 opacity-25">
            </div>

            <div class="accordion d-flex flex-column gap-3 mb-4" id="userProfileAccordion">

                <!-- 1. AVERTISSEMENTS -->
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="card-header bg-transparent border-0 p-0" id="headingWarnings">
                        <button class="accordion-button user-accordion-btn collapsed py-3 px-4 d-flex align-items-center justify-content-between" type="button" data-bs-toggle="collapse" data-bs-target="#collapseWarnings" aria-expanded="false" aria-controls="collapseWarnings">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-box bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px; font-size: 1.1rem;">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                </div>
                                <div class="text-start">
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="fw-bold mb-0">Avertissements</h6>
                                        <% if (warnings.length > 0) { %>
                                            <span class="badge bg-danger text-white rounded-pill px-2 py-1" style="font-size: 0.72rem;">
                                                <%= warnings.length %> en cours
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 0.72rem;">
                                                Aucun
                                            </span>
                                        <% } %>
                                    </div>
                                    <p class="text-muted small mb-0">Rappels de sécurité et avertissements actifs</p>
                                </div>
                            </div>
                        </button>
                    </div>
                    <div id="collapseWarnings" class="accordion-collapse collapse" data-bs-parent="#userProfileAccordion">
                        <div class="card-body p-4 pt-3 border-top">
                            <% if (warnings.length > 0) { %>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="fw-bold mb-0 text-danger d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-clock"></i> Avertissements en attente de résolution
                                    </h6>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill"><%= warnings.length %> actif(s)</span>
                                </div>
                                <div class="table-responsive border rounded-3 overflow-hidden mb-4">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th scope="col" style="width: 50px;">#</th>
                                                <th scope="col">Type d'avertissement</th>
                                                <th scope="col">Date d'émission</th>
                                                <th scope="col">Commentaires / Motif</th>
                                                <th scope="col" class="text-center" style="width: 120px;">Résoudre</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% warnings.forEach(function(warning) { %>
                                            <tr>
                                                <td class="text-muted small">#<%= warning.id %></td>
                                                <td>
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1">
                                                        <%= warning.warningtype.name %>
                                                    </span>
                                                </td>
                                                <td class="small text-muted"><%= warning.createdAt %></td>
                                                <td><%= warning.comments || '-' %></td>
                                                <td class="text-center">
                                                    <a href="/warning/deactivate/<%= warning.id %>" class="btn btn-outline-success btn-sm rounded-pill px-3" title="Marquer comme résolu" onclick="return confirm('Résoudre et désactiver cet avertissement ?');">
                                                        <i class="fa-solid fa-check me-1"></i> Résolu
                                                    </a>
                                                </td>
                                            </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } else { %>
                                <div class="p-3 mb-4 rounded-3 bg-success-subtle text-success-emphasis border border-success-subtle d-flex align-items-center gap-3">
                                    <i class="fa-solid fa-shield-check fs-4"></i>
                                    <div>
                                        <div class="fw-semibold small">Aucun avertissement actif</div>
                                        <div class="small text-muted">L'usager n'a aucun manquement ni rappel de sécurité enregistré.</div>
                                    </div>
                                </div>
                            <% } %>

                            <div class="card border-0 bg-body-tertiary rounded-3">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-2 d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-plus-circle text-warning"></i> Émettre un avertissement
                                    </h6>
                                    <p class="text-muted small mb-3">Enregistrez un rappel aux consignes ou un avertissement sur le compte de l'usager.</p>
                                    <form action="/warning/create" method="post">
                                        <input type='hidden' id="userid" name='userid' value='<%= user.id %>' />
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <div class="form-floating">
                                                    <select class="form-select" id="warningtype" name="warningtype">
                                                        <% warningtypes.forEach(function(warningtype) { %>
                                                        <option value="<%= warningtype.id %>"><%= warningtype.name %></option>
                                                        <% }); %>
                                                    </select>
                                                    <label for="warningtype"><i class="fa-solid fa-tag text-muted me-1"></i> Motif de l'avertissement</label>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-floating">
                                                    <textarea class="form-control" id="comments" name="comments" placeholder="Détails" style="height: 58px"></textarea>
                                                    <label for="comments"><i class="fa-solid fa-comment-dots text-muted me-1"></i> Précisions / Commentaire</label>
                                                </div>
                                            </div>
                                            <div class="col-12 d-flex justify-content-end">
                                                <button class="btn btn-warning rounded-pill px-4 shadow-sm" type="submit">
                                                    <i class="fa-solid fa-triangle-exclamation me-1"></i> Ajouter l'avertissement
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. HISTORIQUE DES VISITES -->
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="card-header bg-transparent border-0 p-0" id="headingHistory">
                        <button class="accordion-button user-accordion-btn collapsed py-3 px-4 d-flex align-items-center justify-content-between" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHistory" aria-expanded="false" aria-controls="collapseHistory">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-box bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px; font-size: 1.1rem;">
                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                </div>
                                <div class="text-start">
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="fw-bold mb-0">Historique des visites</h6>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" style="font-size: 0.72rem;">
                                            <%= history.length %> visite(s)
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-0">Présences au lab, horaires d'arrivée et de départ</p>
                                </div>
                            </div>
                        </button>
                    </div>
                    <div id="collapseHistory" class="accordion-collapse collapse" data-bs-parent="#userProfileAccordion">
                        <div class="card-body p-4 pt-3 border-top">
                            <div class="table-responsive border rounded-3 overflow-hidden">
                                <table class="table table-hover align-middle mb-0" id="historyTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th scope="col">Arrivée</th>
                                            <th scope="col" class="text-center">Départ</th>
                                            <th scope="col" class="text-center">Espace / Atelier</th>
                                            <th scope="col" class="text-center">Projet</th>
                                            <th scope="col" class="text-center">Commentaires</th>
                                        </tr>
                                    </thead>
                                    <tbody id="table-content">
                                        <% let tableData = [] %>
                                        <% for (const entry of history) { %>
                                        <% tableData.push( {
                                          col1: entry.arrival,
                                          col2: entry.departure || "-",
                                          col3: entry.workspace ? entry.workspace.name : "-",
                                          col4: (entry.userproject && entry.userproject.project) ? '<a href="' + entry.userproject.project.url + '" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0" title="Consulter"><i class="fa-solid fa-arrow-up-right-from-square fa-xs me-1"></i>Doc</a>' : '<span class="text-muted small">-</span>',
                                          col5: entry.comments ? '<span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-custom-class="custom-tooltip" data-bs-title="' + entry.comments + '"><i class="fa-solid fa-comment-dots text-primary"></i></span>' : '<span class="text-muted small">-</span>',
                                        }) %>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. PROJETS -->
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="card-header bg-transparent border-0 p-0" id="headingProjects">
                        <button class="accordion-button user-accordion-btn collapsed py-3 px-4 d-flex align-items-center justify-content-between" type="button" data-bs-toggle="collapse" data-bs-target="#collapseProjects" aria-expanded="false" aria-controls="collapseProjects">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-box bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px; font-size: 1.1rem;">
                                    <i class="fa-solid fa-folder-open"></i>
                                </div>
                                <div class="text-start">
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="fw-bold mb-0">Projets</h6>
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill" style="font-size: 0.72rem;">
                                            <%= userprojects.length %> projet(s)
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-0">Documentation et travaux suivis par l'usager</p>
                                </div>
                            </div>
                        </button>
                    </div>
                    <div id="collapseProjects" class="accordion-collapse collapse" data-bs-parent="#userProfileAccordion">
                        <div class="card-body p-4 pt-3 border-top">
                            <% if (userprojects.length > 0) { %>
                            <div class="table-responsive border rounded-3 overflow-hidden">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th scope="col" style="width: 50px;">#</th>
                                            <th scope="col">Intitulé / Documentation</th>
                                            <th scope="col">Dernière activité</th>
                                            <th scope="col">Type</th>
                                            <th scope="col" class="text-center" style="width: 90px;">Lien</th>
                                            <th scope="col" class="text-center" style="width: 120px;">Statut</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% userprojects.forEach(function(project) { %>
                                        <tr <% if (!project.active) { %>class="opacity-75 bg-body-tertiary"<% } %>>
                                            <td class="text-muted small">#<%= project.id %></td>
                                            <td>
                                                <div class="fw-semibold"><%= project.url %></div>
                                                <% if (!project.active) { %>
                                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill mt-1" style="font-size: 0.7rem;">Archivé</span>
                                                <% } %>
                                            </td>
                                            <td class="small text-muted">
                                                <%
                                                const lastEntry = history.find(entry => entry.userproject && entry.userproject.projectId === project.id);
                                                %>
                                                <%= lastEntry ? lastEntry.arrival : "-" %>
                                            </td>
                                            <td>
                                                <%
                                                const projectType = (project.projecttype) ? project.projecttype : (projecttypes || []).find(type => type.id === project.projecttypeId);
                                                const projectTypeName = projectType ? projectType.name : 'Projet';
                                                %>
                                                <span class="badge bg-body-secondary text-secondary-emphasis border rounded-pill"><%= projectTypeName %></span>
                                            </td>
                                            <td class="text-center">
                                                <% if (project.url && project.url.startsWith('http')) { %>
                                                    <a href="<%= project.url %>" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-2 py-0" title="Consulter la documentation">
                                                        <i class="fa-solid fa-arrow-up-right-from-square fa-xs"></i> Ouvrir
                                                    </a>
                                                <% } else { %>
                                                    <span class="text-muted small">-</span>
                                                <% } %>
                                            </td>
                                            <td class="text-center">
                                                <% if (project.active) { %>
                                                    <a href="/history/project/archive/<%= project.id %>" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0" title="Archiver ce projet">
                                                        <i class="fa-solid fa-box-archive fa-xs me-1"></i> Archiver
                                                    </a>
                                                <% } else { %>
                                                    <a href="/history/project/unarchive/<%= project.id %>" class="btn btn-sm btn-outline-success rounded-pill px-2 py-0" title="Désarchiver ce projet">
                                                        <i class="fa-solid fa-box-open fa-xs me-1"></i> Rétablir
                                                    </a>
                                                <% } %>
                                            </td>
                                        </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                            <% } else { %>
                                <div class="text-center text-muted py-4">
                                    <div class="icon-box bg-body-secondary text-secondary rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px; font-size: 1.25rem;">
                                        <i class="fa-solid fa-folder-open"></i>
                                    </div>
                                    <p class="mb-0 small">Aucun projet associé à cet utilisateur pour le moment.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- 4. SESSIONS MACHINES -->
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="card-header bg-transparent border-0 p-0" id="headingMachines">
                        <button class="accordion-button user-accordion-btn collapsed py-3 px-4 d-flex align-items-center justify-content-between" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMachines" aria-expanded="false" aria-controls="collapseMachines">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-box bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px; font-size: 1.1rem;">
                                    <i class="fa-solid fa-gears"></i>
                                </div>
                                <div class="text-start">
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="fw-bold mb-0">Utilisation des machines</h6>
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill" style="font-size: 0.72rem;">
                                            <%= userMachineUsage.length %> session(s)
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-0">Équipements et machines mobilisés au fablab</p>
                                </div>
                            </div>
                        </button>
                    </div>
                    <div id="collapseMachines" class="accordion-collapse collapse" data-bs-parent="#userProfileAccordion">
                        <div class="card-body p-4 pt-3 border-top">
                            <% if (userMachineUsage.length === 0) { %>
                                <div class="text-center text-muted py-4">
                                    <div class="icon-box bg-body-secondary text-secondary rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px; font-size: 1.25rem;">
                                        <i class="fa-solid fa-gears"></i>
                                    </div>
                                    <p class="mb-0 small">Aucune utilisation de machine enregistrée pour cet utilisateur.</p>
                                </div>
                            <% } else { %>
                                <div class="table-responsive border rounded-3 overflow-hidden">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th scope="col" style="width: 50px;">#</th>
                                                <th scope="col">Date & Heure</th>
                                                <th scope="col">Machine</th>
                                                <th scope="col">Type</th>
                                                <th scope="col">Emplacement</th>
                                                <th scope="col">Projet associé</th>
                                                <th scope="col">Espace</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% userMachineUsage.forEach(function(usage) { %>
                                            <tr>
                                                <td class="text-muted small">#<%= usage.id %></td>
                                                <td><%= usage.formattedDate %></td>
                                                <td>
                                                    <% if (usage.machine) { %>
                                                        <a href="/admin/machines/view/<%= usage.machine.id %>" class="fw-semibold text-decoration-none">
                                                            <%= usage.machine.name %>
                                                        </a>
                                                        <div class="small text-muted"><%= usage.machine.make %> <%= usage.machine.model %></div>
                                                    <% } else { %>
                                                        <span class="text-muted">Machine supprimée</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% if (usage.machine && usage.machine.machinetype) { %>
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill"><%= usage.machine.machinetype.name %></span>
                                                    <% } else { %>
                                                        <span class="text-muted small">-</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <span class="small text-secondary">
                                                        <%= (usage.machine && usage.machine.location) ? usage.machine.location.name : '-' %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <% if (usage.project) { %>
                                                        <a href="<%= usage.project.url %>" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0" title="<%= usage.project.url %>">
                                                            <i class="fa-solid fa-arrow-up-right-from-square fa-xs me-1"></i>Projet
                                                        </a>
                                                    <% } else { %>
                                                        <span class="text-muted small">-</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill">
                                                        <%= usage.workspace %>
                                                    </span>
                                                </td>
                                            </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- 5. MATÉRIAUX CONSOMMÉS -->
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="card-header bg-transparent border-0 p-0" id="headingConsumption">
                        <button class="accordion-button user-accordion-btn collapsed py-3 px-4 d-flex align-items-center justify-content-between" type="button" data-bs-toggle="collapse" data-bs-target="#collapseConsumption" aria-expanded="false" aria-controls="collapseConsumption">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-box bg-secondary-subtle text-secondary-emphasis rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px; font-size: 1.1rem;">
                                    <i class="fa-solid fa-boxes-stacked"></i>
                                </div>
                                <div class="text-start">
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="fw-bold mb-0">Consommation de matériaux</h6>
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill" style="font-size: 0.72rem;">
                                            <%= userConsumptions.length %> ligne(s)
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-0">Fournitures, plaques, consommables et coûts facturés</p>
                                </div>
                            </div>
                        </button>
                    </div>
                    <div id="collapseConsumption" class="accordion-collapse collapse" data-bs-parent="#userProfileAccordion">
                        <div class="card-body p-4 pt-3 border-top">
                            <% if (userConsumptions.length === 0) { %>
                                <div class="text-center text-muted py-4">
                                    <div class="icon-box bg-body-secondary text-secondary rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px; font-size: 1.25rem;">
                                        <i class="fa-solid fa-boxes-stacked"></i>
                                    </div>
                                    <p class="mb-0 small">Aucun matériau consommé enregistré pour cet utilisateur.</p>
                                </div>
                            <% } else { %>
                                <!-- Summary Bar -->
                                <div class="d-flex flex-wrap justify-content-between align-items-center p-3 mb-3 bg-body-secondary rounded-3 gap-2">
                                    <span class="small">
                                        <i class="fa-solid fa-cubes me-1 text-primary"></i> Total unités consommées : <strong><%= userStats.totalConsumablesCount %></strong>
                                    </span>
                                    <span class="small">
                                        <i class="fa-solid fa-coins me-1 text-warning"></i> Montant total facturé : <strong class="text-danger"><%= userStats.totalConsumablesCost %> €</strong>
                                    </span>
                                </div>

                                <div class="table-responsive border rounded-3 overflow-hidden">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th scope="col" style="width: 50px;">#</th>
                                                <th scope="col">Date & Heure</th>
                                                <th scope="col">Consommable</th>
                                                <th scope="col">Catégorie</th>
                                                <th scope="col" class="text-center">Quantité</th>
                                                <th scope="col" class="text-end">Prix unitaire</th>
                                                <th scope="col" class="text-end">Total débité</th>
                                                <th scope="col">Espace</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% userConsumptions.forEach(function(c) { %>
                                            <tr>
                                                <td class="text-muted small">#<%= c.id %></td>
                                                <td><%= c.formattedDate %></td>
                                                <td>
                                                    <% if (c.consumable) { %>
                                                        <span class="fw-semibold"><%= c.consumable.name %></span>
                                                    <% } else { %>
                                                        <span class="text-muted">Consommable supprimé</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% if (c.consumable && c.consumable.category) { %>
                                                        <span class="badge bg-body-secondary text-secondary-emphasis border rounded-pill"><%= c.consumable.category.name %></span>
                                                    <% } else { %>
                                                        <span class="text-muted small">-</span>
                                                    <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill"><%= c.quantity %> <%= c.unit %></span>
                                                </td>
                                                <td class="text-end text-muted small"><%= c.unitCost < 0.1 ? c.unitCost.toFixed(4) : c.unitCost.toFixed(2) %> € / <%= c.unit %></td>
                                                <td class="text-end fw-bold text-danger"><%= c.totalCost %> €</td>
                                                <td>
                                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill"><%= c.workspace %></span>
                                                </td>
                                            </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- 6. ATELIERS & INTÉRÊTS -->
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden" id="interests">
                    <div class="card-header bg-transparent border-0 p-0" id="headingInterests">
                        <button class="accordion-button user-accordion-btn collapsed py-3 px-4 d-flex align-items-center justify-content-between" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInterests" aria-expanded="false" aria-controls="collapseInterests">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-box bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px; font-size: 1.1rem;">
                                    <i class="fa-solid fa-graduation-cap"></i>
                                </div>
                                <div class="text-start">
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="fw-bold mb-0">Ateliers & Intérêts</h6>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 0.72rem;">
                                            <%= user.workshopInterests.length %> en attente &bull; <%= user.workshopCompletions.length %> validé(s)
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-0">Formations pratiques, intérêts déclarés et badges d'atelier</p>
                                </div>
                            </div>
                        </button>
                    </div>
                    <div id="collapseInterests" class="accordion-collapse collapse" data-bs-parent="#userProfileAccordion">
                        <div class="card-body p-4 pt-3 border-top">
                            <% if (role === 'admin') { %>
                            <!-- Encart Admin : Attribution manuelle d'habilitation -->
                            <div class="card border-0 bg-warning-subtle text-warning-emphasis rounded-3 mb-4 border-start border-warning border-3 shadow-sm">
                                <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                                    <div>
                                        <h6 class="fw-bold mb-1 text-dark">
                                            <i class="fa-solid fa-award text-warning me-1"></i> Attribution manuelle d'habilitation (Admin)
                                        </h6>
                                        <p class="small text-muted mb-0">
                                            Ajoutez directement une habilitation ou un badge d'atelier avec date rétroactive (utile si la formation a été effectuée avant la mise en place de la plateforme).
                                        </p>
                                    </div>
                                    <button type="button" class="btn btn-warning text-dark fw-semibold btn-sm rounded-pill px-3 py-2 shadow-sm text-nowrap align-self-start align-self-md-center" data-bs-toggle="modal" data-bs-target="#modalAddHabilitation">
                                        <i class="fa-solid fa-plus-circle me-1"></i> Ajouter une habilitation
                                    </button>
                                </div>
                            </div>
                            <% } %>

                            <!-- Formulaire pour ajouter un intérêt à un atelier -->
                            <div class="card border-0 bg-body-tertiary rounded-3 mb-4">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-2">
                                        <i class="fa-solid fa-heart-circle-plus text-danger me-1"></i> Enregistrer un intérêt pour un atelier
                                    </h6>
                                    <p class="text-muted small mb-3">
                                        Indiquez un atelier qui intéresse l'utilisateur pour le recontacter lors de la planification d'une session.
                                    </p>
                                    <form action="/users/<%= user.id %>/workshop-interest/add" method="post" class="row g-2 align-items-center">
                                        <div class="col-md-9">
                                            <select class="form-select form-select-sm" name="workshopId" required>
                                                <option value="" disabled selected>Sélectionner un atelier organisé par le fablab...</option>
                                                <% availableWorkshops.forEach(function(ws) { %>
                                                    <% const isInterested = user.workshopInterests.some(wi => wi.workshopId === ws.id); %>
                                                    <% const isCompleted = user.workshopCompletions.some(wc => wc.workshopId === ws.id); %>
                                                    <option value="<%= ws.id %>" <%= isInterested || isCompleted ? 'disabled' : '' %>>
                                                        <%= ws.name %> 
                                                        <% if (ws.access) { %>(Habilite : <%= ws.access.name %>)<% } %>
                                                        <% if (isCompleted) { %>— [Déjà validé / Badge obtenu]<% } else if (isInterested) { %>— [Intérêt déjà enregistré]<% } %>
                                                    </option>
                                                <% }); %>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <button type="submit" class="btn btn-sm btn-primary w-100 rounded-pill shadow-sm">
                                                <i class="fa-solid fa-plus me-1"></i> Ajouter intérêt
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <!-- Ateliers d'intérêt en attente -->
                            <div class="mb-4">
                                <h6 class="fw-bold mb-2 d-flex align-items-center justify-content-between">
                                    <span><i class="fa-solid fa-hourglass-half text-warning me-2"></i> Ateliers en attente d'organisation</span>
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill"><%= user.workshopInterests.length %></span>
                                </h6>
                                <% if (user.workshopInterests.length === 0) { %>
                                    <p class="text-muted small mb-0 fst-italic">Aucun atelier en attente d'organisation pour cet utilisateur.</p>
                                <% } else { %>
                                    <div class="table-responsive border rounded-3 overflow-hidden">
                                        <table class="table align-middle table-hover mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Atelier</th>
                                                    <th>Habilitation machine visée</th>
                                                    <th>Intérêt exprimé le</th>
                                                    <th class="text-end pe-3" style="width: 140px;">Actions staff</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% user.workshopInterests.forEach(function(item) { %>
                                                    <tr>
                                                        <td>
                                                            <span class="fw-semibold text-primary"><%= item.workshop.name %></span>
                                                            <% if (item.workshop.description) { %>
                                                                <div class="text-muted small"><%= item.workshop.description %></div>
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <% if (item.workshop.access) { %>
                                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill">
                                                                    <i class="fa-solid fa-lock-open me-1"></i><%= item.workshop.access.name %>
                                                                </span>
                                                            <% } else { %>
                                                                <span class="badge bg-body-secondary text-secondary border rounded-pill">Aucune</span>
                                                            <% } %>
                                                        </td>
                                                        <td class="text-muted small"><%= item.formattedDate %></td>
                                                        <td class="text-end pe-3">
                                                            <div class="d-inline-flex gap-1">
                                                                <form action="/users/<%= user.id %>/workshop-badge/award" method="post" class="d-inline">
                                                                    <input type="hidden" name="workshopId" value="<%= item.workshop.id %>">
                                                                    <input type="hidden" name="removeInterest" value="true">
                                                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-2 py-1" data-bs-toggle="tooltip" data-bs-placement="top" title="Atelier suivi (Attribuer le badge & valider)">
                                                                        <i class="fa-solid fa-check me-1"></i> Valider
                                                                    </button>
                                                                </form>
                                                                <a href="/users/<%= user.id %>/workshop-interest/remove/<%= item.workshop.id %>" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" data-bs-toggle="tooltip" data-bs-placement="top" title="Retirer l'intérêt" onclick="return confirm('Retirer l\'intérêt pour cet atelier ?');">
                                                                    <i class="fa-solid fa-trash-can"></i>
                                                                </a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Badges d'ateliers obtenus & habilitations -->
                            <div class="mb-4">
                                <h6 class="fw-bold mb-2 d-flex align-items-center justify-content-between">
                                    <span><i class="fa-solid fa-award text-success me-2"></i> Badges d'ateliers obtenus & validés</span>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill"><%= user.workshopCompletions.length %></span>
                                </h6>
                                <% if (user.workshopCompletions.length === 0) { %>
                                    <p class="text-muted small mb-0 fst-italic">Aucun badge d'atelier obtenu pour le moment.</p>
                                <% } else { %>
                                    <div class="row g-2">
                                        <% user.workshopCompletions.forEach(function(comp) { %>
                                            <div class="col-md-6">
                                                <div class="p-3 border rounded-3 bg-body-tertiary d-flex justify-content-between align-items-center shadow-sm">
                                                    <div>
                                                        <div class="fw-bold text-success d-flex align-items-center gap-1">
                                                            <i class="fa-solid fa-certificate"></i> <%= comp.workshop.name %>
                                                        </div>
                                                        <div class="text-muted small mt-1">
                                                            Validé le <%= comp.formattedDate %> <%= comp.awardedBy ? 'par ' + comp.awardedBy : '' %>
                                                        </div>
                                                        <% if (comp.workshop.access) { %>
                                                            <div class="mt-2">
                                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill small">
                                                                    <i class="fa-solid fa-check me-1"></i> Habilité machine : <%= comp.workshop.access.name %>
                                                                </span>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                    <div>
                                                        <a href="/users/<%= user.id %>/workshop-badge/revoke/<%= comp.workshop.id %>" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Révoquer le badge" onclick="return confirm('Révoquer le badge pour cet atelier ?');">
                                                            <i class="fa-solid fa-xmark"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Domaines fréquentés (statistiques d'activité) -->
                            <div class="pt-3 border-top">
                                <h6 class="fw-bold mb-2 text-muted small">
                                    <i class="fa-solid fa-chart-pie me-1"></i> Domaines et catégories fréquentés (calculés selon l'activité) :
                                </h6>
                                <% if (userInterests.length === 0) { %>
                                    <p class="small text-muted mb-0">Aucun domaine particulier identifié pour le moment.</p>
                                <% } else { %>
                                    <div class="d-flex flex-wrap gap-2">
                                        <% userInterests.forEach(function(interest) { %>
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill py-1 px-3 small">
                                                <i class="fa-solid fa-layer-group me-1"></i> <%= interest %>
                                            </span>
                                        <% }); %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        <%- include('../includes/footer.html') %>
        <script src="/javascripts/main.js"></script>
        <script>
          // Call the pagination function after the table is rendered
          addPagination('historyTable', <%- JSON.stringify(tableData) %>);

          // Automatically expand accordion section if URL has a hash anchor (e.g. #collapseInterests)
          if (window.location.hash) {
            const targetEl = document.querySelector(window.location.hash);
            if (targetEl && targetEl.classList.contains('collapse')) {
              const bsCollapse = new bootstrap.Collapse(targetEl, { toggle: false });
              bsCollapse.show();
              setTimeout(() => {
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }, 200);
            }
          }
        </script>
    </body>
</html>
