<!doctype html>
<html lang="en" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="" />
        <meta name="author" content="Stéphane Muller" />
        <title>Fabtrack signin</title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>
        <main class="form-signin w-100 m-auto">
            <form action="<%= typeof basePath !== 'undefined' ? basePath : '' %>/auth" method="post">
                <% if (typeof platformLogoType !== 'undefined' && platformLogoType === 'custom' && platformLogoPath) { %>
                    <img class="mb-2 app-auth-logo" src="<%= platformLogoPath %>" alt="<%= typeof platformName !== 'undefined' ? platformName : 'FabtrackJS' %>" />
                <% } else { %>
                    <img class="mb-2 app-auth-logo" src="/images/logo-fabtrack.svg" alt="<%= typeof platformName !== 'undefined' ? platformName : 'FabtrackJS' %>" width="75" height="58" />
                <% } %>
                <h1 class="h3 fw-normal mb-3"><%= __('auth.signin_title') %></h1>

                <div class="form-floating">
                    <input type="text" class="form-control" id="username" name="username" placeholder="<%= __('auth.username') %>" required />
                    <label for="username"><%= __('auth.username') %></label>
                </div>
                <div class="form-floating">
                    <input type="password" class="form-control" id="password" name="password" placeholder="<%= __('auth.password') %>" required />
                    <label for="password"><%= __('auth.password') %></label>
                </div>

                <div class="form-check my-3 text-start">
                    <input class="form-check-input" type="checkbox" value="remember-me" id="rememberMe" name="rememberMe" />
                    <label class="form-check-label" for="rememberMe"> <%= __('auth.remember_me') %> </label>
                </div>
                <button class="btn btn-primary w-100 py-2" type="submit"><%= __('auth.signin_btn') %></button>
                <p class="mt-2 text-center"><small><a href="<%= typeof basePath !== 'undefined' ? basePath : '' %>/register"><%= __('auth.create_account') %></a> | <a href="<%= typeof basePath !== 'undefined' ? basePath : '' %>/forgot"><%= __('auth.forgot_password') %></a></small></p>

            </form>

            <%- include('../includes/footer.html') %>
    </body>
</html>
