<!doctype html>
<html lang="en" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="" />
        <meta name="author" content="Stéphane Muller" />
        <title>Fabtrack signin</title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>
        <main class="form-signin w-100 m-auto">
            <form action="<%= typeof basePath !== 'undefined' ? basePath : '' %>/create-account" method="post">
                <% if (typeof platformLogoType !== 'undefined' && platformLogoType === 'custom' && platformLogoPath) { %>
                    <img class="mb-2 app-auth-logo" src="<%= platformLogoPath %>" alt="<%= typeof platformName !== 'undefined' ? platformName : 'FabtrackJS' %>" />
                <% } else { %>
                    <img class="mb-2 app-auth-logo" src="/images/logo-fabtrack.svg" alt="<%= typeof platformName !== 'undefined' ? platformName : 'FabtrackJS' %>" width="75" height="58" />
                <% } %>
                <h1 class="h3 fw-normal mb-3"><%= __('auth.create_account_title') %></h1>

                <div class="alert alert-warning" id="warning" style="display: none" role="alert"></div>

                <div class="form-floating">
                    <input type="text" class="form-control" id="username" name="username" placeholder="<%= __('auth.username') %>" required />
                    <label for="username"><%= __('auth.username') %></label>
                </div>

                <div class="form-floating">
                    <input type="password" class="form-control" id="password_verif" name="password_verif" placeholder="<%= __('auth.password') %>" required />
                    <label for="password_verif"><%= __('auth.password') %></label>
                </div>
                <div class="form-floating">
                    <input type="password" class="form-control" id="password" name="password" placeholder="<%= __('auth.confirm_password') %>" required />
                    <label for="password"><%= __('auth.confirm_password') %></label>
                </div>

                <div class="form-floating">
                    <input type="email" class="form-control" id="mail" name="mail" placeholder="your@email.com" required />
                    <label for="mail"><%= __('auth.email') %></label>
                </div>

                <!-- Honeypot field (hidden) -->
                <input type="text" name="honeypot" style="display: none;" autocomplete="off">

                <button class="btn btn-primary w-100 py-2" type="submit"><%= __('auth.create_account') %></button>
                <p class="mt-2 text-center"><small><a href="<%= typeof basePath !== 'undefined' ? basePath : '' %>/login"><%= __('auth.i_have_account') %></a></small></p>
            </form>

            <%- include('../includes/footer.html') %>

        <script>
        document.querySelector('form')
          .addEventListener('submit', (event) => {
            if (document.getElementById('password').value != document.getElementById('password_verif').value){
              event.preventDefault();
              document
                .getElementsByClassName("toast-body")[0]
                .innerHTML = "<%= __('auth.passwords_mismatch') %>";
              showNotification();
            }
          });
        </script>
    </body>
</html>
