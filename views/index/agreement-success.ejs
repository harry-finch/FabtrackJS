<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Validation de la charte d'utilisation" />
        <title><%= title %> • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

        <%- include('../includes/pagehead.html') %>
        <style>
            .success-icon-box {
                width: 64px;
                height: 64px;
                margin: 0 auto 1.25rem auto;
                border-radius: 6px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.75rem;
            }
            .countdown-badge {
                font-variant-numeric: tabular-nums;
                font-weight: 700;
            }
        </style>
    </head>

    <body class="d-flex justify-content-center align-items-center min-vh-100 bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container w-100 px-3" style="max-width: 620px;">
            <!-- Top Branding Logo -->
            <div class="text-center mb-4">
                <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>" class="text-decoration-none">
                    <% if (typeof platformLogoType !== 'undefined' && platformLogoType === 'custom' && platformLogoPath) { %>
                        <img src="<%= platformLogoPath %>" alt="<%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %>" style="max-height: 48px; max-width: 180px; object-fit: contain;" />
                    <% } else { %>
                        <img src="images/logo-fabtrack.svg" alt="FabtrackJS" width="60" height="46" class="app-auth-logo" />
                    <% } %>
                </a>
            </div>

            <!-- Confirmation Card -->
            <div class="card border bg-body text-center p-4 p-md-5">
                <div class="card-body p-0">
                    <% if (success) { %>
                        <div class="success-icon-box bg-success-subtle text-success border border-success-subtle">
                            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                        </div>

                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold mb-3">
                            <i class="fa-solid fa-file-signature me-1" aria-hidden="true"></i> Charte validée
                        </span>

                        <h1 class="h4 fw-bold mb-3 text-body">
                            <%= title %>
                        </h1>

                        <% if (typeof userName !== 'undefined' && userName) { %>
                        <p class="text-muted small mb-3">
                            Contributeur : <strong class="text-body"><%= userName %></strong>
                        </p>
                        <% } %>

                        <div class="text-secondary mb-4" style="font-size: 1rem; line-height: 1.6; white-space: pre-line;">
                            <%= message %>
                        </div>

                        <%
                            const validatedRedirectUrl = typeof redirectUrl !== 'undefined' && redirectUrl
                                ? (typeof safeHttpUrl === 'function'
                                    ? safeHttpUrl(redirectUrl)
                                    : (/^https?:\/\//i.test(redirectUrl) ? redirectUrl : null))
                                : null;
                        %>
                        <% if (validatedRedirectUrl) { %>
                            <div class="p-3 rounded-2 bg-body-tertiary border mb-4">
                                <div class="d-flex align-items-center justify-content-center gap-2 text-muted small mb-3">
                                    <div class="spinner-border spinner-border-sm text-primary" role="status" style="width: 1rem; height: 1rem;" id="spinnerTimer">
                                        <span class="visually-hidden">Chargement...</span>
                                    </div>
                                    <span id="countdownText">
                                        Redirection automatique dans <span id="countdownVal" class="countdown-badge text-primary fw-bold fs-6"><%= redirectDelay %></span> s...
                                    </span>
                                </div>

                                <a href="<%= validatedRedirectUrl %>" rel="noopener noreferrer" id="btnRedirectNow" class="btn btn-primary py-2 px-4 fw-semibold w-100 d-inline-flex align-items-center justify-content-center gap-2">
                                    <span>Accéder au site maintenant</span>
                                    <i class="fa-solid fa-arrow-up-right-from-square fa-sm" aria-hidden="true"></i>
                                </a>
                            </div>

                            <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
                                (function() {
                                    let delay = parseInt(String(<%- typeof safeJson === 'function' ? safeJson(redirectDelay) : JSON.stringify(redirectDelay) %>), 10);
                                    const targetUrl = <%- typeof safeJson === 'function' ? safeJson(validatedRedirectUrl) : JSON.stringify(validatedRedirectUrl) %>;
                                    const countdownEl = document.getElementById("countdownVal");
                                    const spinnerEl = document.getElementById("spinnerTimer");
                                    const countdownText = document.getElementById("countdownText");

                                    if (typeof targetUrl !== "string" || !/^https?:\/\//i.test(targetUrl)) {
                                        if (spinnerEl) spinnerEl.style.display = "none";
                                        return;
                                    }

                                    if (isNaN(delay) || delay <= 0) {
                                        if (spinnerEl) spinnerEl.style.display = "none";
                                        if (countdownText) countdownText.textContent = "Vous pouvez poursuivre vers le site ci-dessous :";
                                        return;
                                    }

                                    const timer = setInterval(function() {
                                        delay--;
                                        if (countdownEl) countdownEl.textContent = delay;
                                        if (delay <= 0) {
                                            clearInterval(timer);
                                            if (/^https?:\/\//i.test(targetUrl)) {
                                                window.location.assign(targetUrl);
                                            }
                                        }
                                    }, 1000);
                                })();
                            </script>
                        <% } else { %>
                            <div class="pt-2">
                                <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>fabtrack" class="btn btn-primary btn-sm px-4 py-2">
                                    <i class="fa-solid fa-desktop me-1" aria-hidden="true"></i> Aller au Kiosque
                                </a>
                            </div>
                        <% } %>

                    <% } else { %>
                        <!-- Error State -->
                        <div class="success-icon-box bg-danger-subtle text-danger border border-danger-subtle">
                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                        </div>

                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold mb-3">
                            <i class="fa-solid fa-xmark me-1" aria-hidden="true"></i> Validation impossible
                        </span>

                        <h1 class="h4 fw-bold mb-3 text-body">
                            <%= title %>
                        </h1>

                        <div class="text-secondary mb-4" style="font-size: 1rem; line-height: 1.6; white-space: pre-line;">
                            <%= message %>
                        </div>

                        <div class="pt-2">
                            <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>" class="btn btn-outline-secondary btn-sm px-4 py-2">
                                <i class="fa-solid fa-house me-1" aria-hidden="true"></i> Retour à l'accueil
                            </a>
                        </div>
                    <% } %>
                </div>
            </div>

            <%- include('../includes/footer.html') %>
    </body>
</html>
