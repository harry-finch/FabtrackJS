<!doctype html>
<html lang="en" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="" />
        <meta name="author" content="Stéphane Muller" />
        <title>Fabtrack signin</title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>
        <main class="form-signin w-100 m-auto">
            <form action="<%= typeof basePath !== 'undefined' ? basePath : '' %>/reset_password" method="post">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                <% if (typeof platformLogoType !== 'undefined' && platformLogoType === 'custom' && platformLogoPath) { %>
                    <img class="mb-2 app-auth-logo" src="<%= platformLogoPath %>" alt="<%= typeof platformName !== 'undefined' ? platformName : 'FabtrackJS' %>" />
                <% } else { %>
                    <img class="mb-2 app-auth-logo" src="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>images/logo-fabtrack.svg" alt="<%= typeof platformName !== 'undefined' ? platformName : 'FabtrackJS' %>" width="75" height="58" />
                <% } %>
                <h1 class="h3 fw-normal mb-3"><%= __('auth.reset_for_user', user.name) %></h1>

                <div class="form-floating">
                    <input type="password" class="form-control" id="password" name="password" placeholder="<%= __('auth.password') %>" minlength="8" autocomplete="new-password" required />
                    <label for="password"><%= __('auth.password') %></label>
                </div>
                <div class="form-floating mt-2">
                    <input type="password" class="form-control" id="password_verif" name="password_verif" placeholder="<%= __('auth.confirm_password') %>" minlength="8" autocomplete="new-password" required />
                    <label for="password_verif"><%= __('auth.confirm_password') %></label>
                </div>
                <div class="form-text text-body-secondary text-start mt-1 mb-2">
                    Minimum 8 caractères.
                </div>

                <input type="hidden" id="token" name="token" value="<%= token %>" />
                <div id="warning" class="alert alert-danger py-2 small mt-2 mb-2" role="alert" style="display: none;"></div>

                <button class="btn btn-primary w-100 py-2" type="submit"><%= __('auth.reset_password') %></button>
                <p class="text-body-secondary mb-3 mt-5">&copy; Stéphane Muller 2024</p>
            </form>

            <%- include('../includes/footer.html') %>

        <script>
            document.querySelector("form").addEventListener("submit", (event) => {
                const pwd = document.getElementById("password").value;
                const verif = document.getElementById("password_verif").value;
                const warningEl = document.getElementById("warning");
                if (pwd.length < 8) {
                    event.preventDefault();
                    warningEl.textContent = "Le mot de passe doit comporter au moins 8 caractères.";
                    warningEl.style.display = "block";
                    return;
                }
                if (pwd !== verif) {
                    event.preventDefault();
                    warningEl.textContent = "<%= __('auth.passwords_mismatch') %>";
                    warningEl.style.display = "block";
                }
            });
        </script>

    </body>
</html>
