<!DOCTYPE html>
<html lang="fr" data-bs-theme="auto">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Installation & Initialisation - FabtrackJS</title>
  <%- include('../includes/pagehead.html') %>
  <style>
    .setup-container {
      max-width: 760px;
      width: 100%;
    }
    .setup-step {
      display: none;
    }
    .setup-step.active {
      display: block;
      animation: fadeIn 0.25s ease-in-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .step-pill {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      border-radius: 50rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--bs-secondary-color);
      background-color: var(--bs-tertiary-bg);
      transition: all 0.2s ease;
    }
    .step-pill.active {
      color: #fff;
      background-color: var(--bs-primary);
      box-shadow: 0 4px 12px rgba(13, 110, 253, 0.25);
    }
    .step-pill.completed {
      color: var(--bs-success);
      background-color: var(--bs-success-bg-subtle);
    }
    .step-number {
      width: 1.5rem;
      height: 1.5rem;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,0.1);
      font-size: 0.75rem;
    }
    .step-pill.active .step-number {
      background: rgba(255,255,255,0.25);
    }
    .workspace-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.35rem 0.75rem;
      background-color: var(--bs-primary-bg-subtle);
      color: var(--bs-primary);
      border: 1px solid var(--bs-primary-border-subtle);
      border-radius: 50rem;
      font-size: 0.875rem;
      margin: 0.25rem;
    }
    .workspace-tag .btn-close-tag {
      cursor: pointer;
      font-size: 0.8rem;
      opacity: 0.65;
    }
    .workspace-tag .btn-close-tag:hover {
      opacity: 1;
      color: var(--bs-danger);
    }
  </style>
</head>
<body class="d-flex justify-content-center align-items-center min-vh-100 bg-body-tertiary py-5">
  <%- include('../includes/light-dark.html') %>

  <div class="setup-container px-3">
    <!-- Header / Brand -->
    <div class="text-center mb-4">
      <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle bg-primary bg-opacity-10 text-primary mb-3 shadow-sm">
        <i class="fa-solid fa-cube fa-2x"></i>
      </div>
      <h2 class="fw-bold tracking-tight mb-1">Bienvenue sur FabtrackJS</h2>
      <p class="text-secondary mb-0">Assistant de configuration et d'initialisation de votre plateforme</p>
    </div>

    <!-- Notification / Flash Error -->
    <% if (typeof notification !== 'undefined' && notification) { %>
      <div class="alert alert-<%= notification.startsWith('Error:') ? 'danger' : 'info' %> alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="fa-solid <%= notification.startsWith('Error:') ? 'fa-triangle-exclamation' : 'fa-circle-info' %> me-2"></i>
        <%= notification.replace(/^(Error:|Success:|Info:)\s*/, '') %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
      <!-- Steps Progress Bar -->
      <div class="card-header bg-body border-bottom p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
          <div class="step-pill active" id="pill-step-1">
            <span class="step-number">1</span>
            <span>Administrateur</span>
          </div>
          <div class="step-pill" id="pill-step-2">
            <span class="step-number">2</span>
            <span>Plateforme & Région</span>
          </div>
          <div class="step-pill" id="pill-step-3">
            <span class="step-number">3</span>
            <span>Espaces de travail</span>
          </div>
          <div class="step-pill" id="pill-step-4">
            <span class="step-number">4</span>
            <span>Lancement</span>
          </div>
        </div>
      </div>

      <!-- Form Body -->
      <div class="card-body p-4 p-md-5">
        <form id="setupForm" method="POST" action="/setup" novalidate>
          
          <!-- STEP 1: Admin Account -->
          <div class="setup-step active" id="step-1">
            <h4 class="fw-bold mb-1 text-body"><i class="fa-solid fa-user-shield text-primary me-2"></i>Compte Administrateur</h4>
            <p class="text-secondary small mb-4">Créez le compte responsable du Fablab qui aura accès à l'ensemble du panneau de gestion.</p>

            <div class="mb-3">
              <label for="adminName" class="form-label fw-semibold">Identifiant ou nom complet <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-user text-secondary"></i></span>
                <input type="text" class="form-control" id="adminName" name="adminName" placeholder="ex: admin ou Fabmanager" required value="admin" />
              </div>
              <div class="invalid-feedback">Veuillez indiquer un nom d'administrateur (au moins 2 caractères).</div>
            </div>

            <div class="mb-3">
              <label for="adminEmail" class="form-label fw-semibold">Adresse email <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-envelope text-secondary"></i></span>
                <input type="email" class="form-control" id="adminEmail" name="adminEmail" placeholder="admin@monfablab.fr" required />
              </div>
              <div class="form-text">Cette adresse sera utilisée pour recevoir les alertes système et réinitialiser le mot de passe.</div>
              <div class="invalid-feedback">Veuillez entrer une adresse email valide.</div>
            </div>

            <div class="row g-3 mb-2">
              <div class="col-md-6">
                <label for="adminPassword" class="form-label fw-semibold">Mot de passe <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-lock text-secondary"></i></span>
                  <input type="password" class="form-control" id="adminPassword" name="adminPassword" placeholder="••••••••" minlength="6" required />
                  <button type="button" class="btn btn-outline-secondary" onclick="togglePasswordVisibility('adminPassword', this)">
                    <i class="fa-solid fa-eye"></i>
                  </button>
                </div>
                <div class="invalid-feedback">Le mot de passe doit comporter au moins 6 caractères.</div>
              </div>
              <div class="col-md-6">
                <label for="confirmPassword" class="form-label fw-semibold">Confirmer le mot de passe <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-lock text-secondary"></i></span>
                  <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="••••••••" minlength="6" required />
                  <button type="button" class="btn btn-outline-secondary" onclick="togglePasswordVisibility('confirmPassword', this)">
                    <i class="fa-solid fa-eye"></i>
                  </button>
                </div>
                <div class="invalid-feedback" id="confirmPasswordFeedback">Les mots de passe ne correspondent pas.</div>
              </div>
            </div>
          </div>

          <!-- STEP 2: Platform & Regional -->
          <div class="setup-step" id="step-2">
            <h4 class="fw-bold mb-1 text-body"><i class="fa-solid fa-sliders text-primary me-2"></i>Identité & Régionalisation</h4>
            <p class="text-secondary small mb-4">Définissez le nom de votre établissement, la langue par défaut et la monnaie employée.</p>

            <div class="mb-3">
              <label for="platformName" class="form-label fw-semibold">Nom du Fablab ou de la structure <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-building text-secondary"></i></span>
                <input type="text" class="form-control" id="platformName" name="platformName" placeholder="ex: FabLab Sorbonne Université" value="FabtrackJS" required />
              </div>
              <div class="invalid-feedback">Le nom de la plateforme est requis.</div>
            </div>

            <div class="mb-3">
              <label for="platformSubtitle" class="form-label fw-semibold">Sous-titre ou description courte</label>
              <input type="text" class="form-control" id="platformSubtitle" name="platformSubtitle" placeholder="Suivi d'activité et gestion du fablab" value="Suivi d'activité du fablab" />
            </div>

            <div class="row g-3">
              <div class="col-md-6">
                <label for="defaultLanguage" class="form-label fw-semibold">Langue par défaut <span class="text-danger">*</span></label>
                <select class="form-select" id="defaultLanguage" name="defaultLanguage" required>
                  <option value="fr" selected>🇫🇷 Français (fr)</option>
                  <option value="en">🇬🇧 English (en)</option>
                </select>
                <div class="form-text">D'autres langues peuvent être ajoutées ultérieurement via CSV.</div>
              </div>
              <div class="col-md-6">
                <label for="currencySymbol" class="form-label fw-semibold">Symbole monétaire <span class="text-danger">*</span></label>
                <select class="form-select" id="currencySymbol" name="currencySymbol" required>
                  <option value="€" selected>€ (Euro)</option>
                  <option value="$">$ (Dollar)</option>
                  <option value="CHF">CHF (Franc Suisse)</option>
                  <option value="£">£ (Livre Sterling)</option>
                  <option value="C$">C$ (Dollar Canadien)</option>
                </select>
                <div class="form-text">Affiché dans le kiosque et les consommations de matière.</div>
              </div>
            </div>
          </div>

          <!-- STEP 3: Workspaces -->
          <div class="setup-step" id="step-3">
            <h4 class="fw-bold mb-1 text-body"><i class="fa-solid fa-layer-group text-primary me-2"></i>Espaces de travail (Workspaces)</h4>
            <p class="text-secondary small mb-4">Configurez les différentes salles ou pôles de votre fablab (ex: Impression 3D, Découpe laser, Électronique).</p>

            <div class="mb-3">
              <label class="form-label fw-semibold">Suggestions rapides (cliquez pour ajouter) :</label>
              <div class="d-flex flex-wrap gap-1 mb-2">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="addWorkspacePreset('Atelier principal')">+ Atelier principal</button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="addWorkspacePreset('Salle Impression 3D')">+ Salle Impression 3D</button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="addWorkspacePreset('Lab Électronique')">+ Lab Électronique</button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="addWorkspacePreset('Atelier Bois & CNC')">+ Atelier Bois & CNC</button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="addWorkspacePreset('Pôle Textile & Couture')">+ Pôle Textile & Couture</button>
              </div>
            </div>

            <div class="mb-3">
              <label for="workspaceInput" class="form-label fw-semibold">Ajouter un espace personnalisé :</label>
              <div class="input-group">
                <input type="text" class="form-control" id="workspaceInput" placeholder="ex: Espace Laser & Fraisage" />
                <button type="button" class="btn btn-primary" onclick="addCustomWorkspace()">
                  <i class="fa-solid fa-plus me-1"></i>Ajouter
                </button>
              </div>
            </div>

            <div class="border rounded-3 p-3 bg-body mb-2 min-h-100">
              <div class="small fw-semibold text-secondary mb-2">Espaces qui seront configurés :</div>
              <div id="workspaceTagsContainer" class="d-flex flex-wrap align-items-center">
                <!-- Injected via JavaScript -->
              </div>
              <div id="noWorkspaceNotice" class="text-muted small fst-italic p-2 d-none">
                Aucun espace sélectionné. Veuillez en ajouter au moins un.
              </div>
            </div>
            
            <!-- Hidden input that holds the JSON array of workspaces -->
            <input type="hidden" name="workspaces" id="workspacesJson" />
            <div class="invalid-feedback d-none" id="workspacesFeedback">Veuillez configurer au moins un espace de travail.</div>
          </div>

          <!-- STEP 4: Review & Final Confirmation -->
          <div class="setup-step" id="step-4">
            <h4 class="fw-bold mb-1 text-body"><i class="fa-solid fa-circle-check text-success me-2"></i>Récapitulatif & Finalisation</h4>
            <p class="text-secondary small mb-4">Vérifiez les paramètres saisis avant d'initialiser votre instance FabtrackJS.</p>

            <div class="list-group rounded-3 shadow-none border mb-4">
              <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                <div>
                  <div class="small text-secondary fw-semibold">Compte Administrateur</div>
                  <div class="fw-bold" id="summaryAdmin">admin &bull; admin@monfablab.fr</div>
                </div>
                <button type="button" class="btn btn-sm btn-link text-decoration-none" onclick="goToStep(1)">Modifier</button>
              </div>
              <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                <div>
                  <div class="small text-secondary fw-semibold">Plateforme & Région</div>
                  <div class="fw-bold" id="summaryPlatform">FabtrackJS (FR &bull; €)</div>
                </div>
                <button type="button" class="btn btn-sm btn-link text-decoration-none" onclick="goToStep(2)">Modifier</button>
              </div>
              <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                <div>
                  <div class="small text-secondary fw-semibold">Espaces de travail</div>
                  <div id="summaryWorkspaces" class="fw-bold">Atelier principal</div>
                </div>
                <button type="button" class="btn btn-sm btn-link text-decoration-none" onclick="goToStep(3)">Modifier</button>
              </div>
            </div>

            <div class="alert alert-primary d-flex align-items-center rounded-3 mb-0" role="alert">
              <i class="fa-solid fa-rocket fa-2x text-primary me-3"></i>
              <div>
                <div class="fw-bold">Prêt pour le décollage !</div>
                <div class="small">L'initialisation va créer votre compte admin, déployer vos espaces et initialiser les types d'usagers et projets indispensables.</div>
              </div>
            </div>
          </div>

          <!-- Navigation Buttons -->
          <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
            <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" id="btnPrev" onclick="navigateStep(-1)" style="visibility: hidden;">
              <i class="fa-solid fa-arrow-left me-2"></i>Précédent
            </button>
            <button type="button" class="btn btn-primary px-4 rounded-pill shadow-sm" id="btnNext" onclick="navigateStep(1)">
              Suivant<i class="fa-solid fa-arrow-right ms-2"></i>
            </button>
            <button type="submit" class="btn btn-success px-4 rounded-pill shadow-sm d-none" id="btnSubmit">
              <span id="submitText"><i class="fa-solid fa-check me-2"></i>Initialiser la plateforme</span>
              <span id="submitSpinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
            </button>
          </div>

        </form>
      </div>
    </div>

    <!-- Footer note -->
    <div class="text-center mt-4 text-secondary small">
      FabtrackJS &bull; Open-source Fablab & Makerspace Activity Tracker
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let currentStep = 1;
    const totalSteps = 4;
    const workspaces = ["Atelier principal"];

    // Initialize workspaces tags
    function renderWorkspaces() {
      const container = document.getElementById("workspaceTagsContainer");
      const notice = document.getElementById("noWorkspaceNotice");
      const hiddenInput = document.getElementById("workspacesJson");

      container.innerHTML = "";
      if (workspaces.length === 0) {
        notice.classList.remove("d-none");
      } else {
        notice.classList.add("d-none");
        workspaces.forEach((name, index) => {
          const tag = document.createElement("span");
          tag.className = "workspace-tag";
          tag.innerHTML = `
            <span><i class="fa-solid fa-location-dot me-1"></i>${name}</span>
            <span class="btn-close-tag ms-1" onclick="removeWorkspace(${index})" title="Supprimer">&times;</span>
          `;
          container.appendChild(tag);
        });
      }
      hiddenInput.value = JSON.stringify(workspaces);
    }

    function addWorkspacePreset(name) {
      if (!workspaces.includes(name)) {
        workspaces.push(name);
        renderWorkspaces();
      }
    }

    function addCustomWorkspace() {
      const input = document.getElementById("workspaceInput");
      const val = input.value.trim();
      if (val && !workspaces.includes(val)) {
        workspaces.push(val);
        renderWorkspaces();
        input.value = "";
      }
      input.focus();
    }

    document.getElementById("workspaceInput").addEventListener("keydown", function(e) {
      if (e.key === "Enter") {
        e.preventDefault();
        addCustomWorkspace();
      }
    });

    function removeWorkspace(index) {
      if (workspaces.length > 1) {
        workspaces.splice(index, 1);
        renderWorkspaces();
      } else {
        alert("Vous devez conserver au moins un espace de travail.");
      }
    }

    function togglePasswordVisibility(fieldId, btn) {
      const input = document.getElementById(fieldId);
      const icon = btn.querySelector("i");
      if (input.type === "password") {
        input.type = "text";
        icon.classList.remove("fa-eye");
        icon.classList.add("fa-eye-slash");
      } else {
        input.type = "password";
        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");
      }
    }

    function validateCurrentStep() {
      if (currentStep === 1) {
        const name = document.getElementById("adminName");
        const email = document.getElementById("adminEmail");
        const pass = document.getElementById("adminPassword");
        const confirm = document.getElementById("confirmPassword");

        let valid = true;

        if (!name.value.trim() || name.value.trim().length < 2) {
          name.classList.add("is-invalid");
          valid = false;
        } else {
          name.classList.remove("is-invalid");
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!email.value.trim() || !emailRegex.test(email.value.trim())) {
          email.classList.add("is-invalid");
          valid = false;
        } else {
          email.classList.remove("is-invalid");
        }

        if (!pass.value || pass.value.length < 6) {
          pass.classList.add("is-invalid");
          valid = false;
        } else {
          pass.classList.remove("is-invalid");
        }

        if (!confirm.value || confirm.value !== pass.value) {
          confirm.classList.add("is-invalid");
          valid = false;
        } else {
          confirm.classList.remove("is-invalid");
        }

        return valid;
      }

      if (currentStep === 2) {
        const platformName = document.getElementById("platformName");
        if (!platformName.value.trim()) {
          platformName.classList.add("is-invalid");
          return false;
        }
        platformName.classList.remove("is-invalid");
        return true;
      }

      if (currentStep === 3) {
        if (workspaces.length === 0) {
          document.getElementById("workspacesFeedback").classList.remove("d-none");
          return false;
        }
        document.getElementById("workspacesFeedback").classList.add("d-none");
        return true;
      }

      return true;
    }

    function updateSummary() {
      const adminName = document.getElementById("adminName").value.trim();
      const adminEmail = document.getElementById("adminEmail").value.trim();
      document.getElementById("summaryAdmin").textContent = `${adminName} (${adminEmail})`;

      const platName = document.getElementById("platformName").value.trim();
      const lang = document.getElementById("defaultLanguage").value.toUpperCase();
      const curr = document.getElementById("currencySymbol").value;
      document.getElementById("summaryPlatform").textContent = `${platName} (${lang} • ${curr})`;

      document.getElementById("summaryWorkspaces").innerHTML = workspaces
        .map(w => `<span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1 mb-1">${w}</span>`)
        .join(" ");
    }

    function goToStep(stepNumber) {
      if (stepNumber > currentStep && !validateCurrentStep()) {
        return;
      }
      currentStep = stepNumber;
      showStep(currentStep);
    }

    function navigateStep(direction) {
      if (direction === 1 && !validateCurrentStep()) {
        return;
      }
      currentStep += direction;
      showStep(currentStep);
    }

    function showStep(step) {
      // Hide all steps
      document.querySelectorAll(".setup-step").forEach(el => el.classList.remove("active"));
      document.getElementById(`step-${step}`).classList.add("active");

      // Update pills
      for (let i = 1; i <= totalSteps; i++) {
        const pill = document.getElementById(`pill-step-${i}`);
        pill.classList.remove("active", "completed");
        if (i < step) {
          pill.classList.add("completed");
        } else if (i === step) {
          pill.classList.add("active");
        }
      }

      // Update Buttons
      const btnPrev = document.getElementById("btnPrev");
      const btnNext = document.getElementById("btnNext");
      const btnSubmit = document.getElementById("btnSubmit");

      btnPrev.style.visibility = step === 1 ? "hidden" : "visible";

      if (step === totalSteps) {
        btnNext.classList.add("d-none");
        btnSubmit.classList.remove("d-none");
        updateSummary();
      } else {
        btnNext.classList.remove("d-none");
        btnSubmit.classList.add("d-none");
      }
    }

    document.getElementById("setupForm").addEventListener("submit", function(e) {
      if (!validateCurrentStep()) {
        e.preventDefault();
        return;
      }
      const btnSubmit = document.getElementById("btnSubmit");
      const spinner = document.getElementById("submitSpinner");
      btnSubmit.disabled = true;
      spinner.classList.remove("d-none");
    });

    // Initialize
    renderWorkspaces();
  </script>
</body>
</html>
