<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Signaler un problème ou une panne sur une machine du Fablab" />
    <title>Signaler une panne • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

    <%- include('../includes/pagehead.html') %>

    <style>
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .report-container {
        width: 100%;
        max-width: 680px;
        margin: 0 auto;
        padding: 1.25rem 1rem 3rem 1rem;
      }

      .camera-dropzone {
        border: 1px dashed var(--bs-border-color);
        border-radius: 6px;
        background-color: var(--bs-secondary-bg);
        transition: all 0.2s ease-in-out;
      }

      .camera-dropzone:hover {
        border-color: var(--bs-primary);
        background-color: var(--bs-tertiary-bg);
      }

      .preview-image-box {
        position: relative;
        max-height: 280px;
        overflow: hidden;
        border-radius: 6px;
      }

      .preview-image-box img {
        width: 100%;
        height: auto;
        max-height: 280px;
        object-fit: cover;
      }
    </style>
  </head>

  <body class="bg-body-tertiary py-4">
    <%- include('../includes/light-dark.html') %>

    <main class="report-container">
      <!-- Branding & Title -->
      <div class="text-center mb-4 pt-2">
        <div class="fab-kpi-icon mx-auto mb-3 bg-danger-subtle text-danger border-danger-subtle" style="width: 52px; height: 52px; font-size: 1.4rem;" aria-hidden="true">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h1 class="h3 fw-bold mb-1">Signaler un problème machine</h1>
        <p class="text-secondary small mb-0">
          Aidez l'équipe du Fablab à maintenir les machines en parfait état de fonctionnement.
        </p>
      </div>

      <%
        const rawNotif = typeof notification !== 'undefined' && notification ? String(notification).trim() : '';
        let notifVariant = 'info';
        let notifIcon = 'fa-circle-info';
        let notifClean = rawNotif;
        const notifMatch = rawNotif.match(/^(Error|Warning|Success|Info)\s*:\s*([\s\S]*)$/i);
        if (notifMatch) {
          const level = notifMatch[1].toLowerCase();
          notifClean = notifMatch[2].trim();
          if (level === 'error') {
            notifVariant = 'danger';
            notifIcon = 'fa-circle-exclamation';
          } else if (level === 'warning') {
            notifVariant = 'warning';
            notifIcon = 'fa-triangle-exclamation';
          } else if (level === 'success') {
            notifVariant = 'success';
            notifIcon = 'fa-circle-check';
          }
        }
      %>
      <% if (notifClean) { %>
        <div class="alert alert-<%= notifVariant %> alert-dismissible fade show border rounded-2 mb-4 d-flex align-items-start gap-2" role="alert" id="reportIssueNotification">
          <i class="fa-solid <%= notifIcon %> mt-1" aria-hidden="true"></i>
          <div class="flex-grow-1"><%= notifClean %></div>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
      <% } %>

      <% if (success) { %>
        <!-- Confirmation Success Screen -->
        <div class="card border bg-body overflow-hidden mb-4">
          <div class="card-body p-4 p-md-5 text-center">
            <div class="fab-kpi-icon mx-auto mb-3 bg-success-subtle text-success border-success-subtle" style="width: 56px; height: 56px; font-size: 1.6rem;" aria-hidden="true">
              <i class="fa-solid fa-circle-check"></i>
            </div>
            <h2 class="h4 fw-bold text-success mb-2">Signalement enregistré !</h2>
            <p class="text-secondary mb-3">
              Votre signalement pour la machine <strong class="text-body"><%= reportedMachineName || 'sélectionnée' %></strong> a bien été transmis.
            </p>

            <div class="alert alert-success border border-success-subtle bg-success-subtle text-success-emphasis text-start p-3 rounded-2 small mb-4">
              <div class="d-flex gap-2">
                <i class="fa-solid fa-bell mt-1" aria-hidden="true"></i>
                <div>
                  <strong>Équipe prévenue :</strong> Les médiateurs et administrateurs du fablab ont été notifiés par e-mail. L'incident a également été enregistré dans l'historique technique de la machine.
                </div>
              </div>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
              <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>report-issue" class="btn btn-outline-primary btn-sm px-4 py-2">
                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i> Signaler un autre incident
              </a>
              <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>" class="btn btn-primary btn-sm px-4 py-2">
                <i class="fa-solid fa-house me-1" aria-hidden="true"></i> Retour à l'accueil
              </a>
            </div>
          </div>
        </div>
      <% } else { %>
        <!-- Reporting Form -->
        <div class="card border bg-body overflow-hidden">
          <div class="card-header bg-body-tertiary py-3 px-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-wrench text-danger" aria-hidden="true"></i>
              <span class="fw-bold">Formulaire de signalement</span>
            </div>
            <span class="badge bg-body-secondary text-secondary-emphasis border">Public &amp; Ouvert</span>
          </div>

          <div class="card-body p-3 p-md-4">
            <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>report-issue?_csrf=<%= encodeURIComponent(typeof csrfToken !== 'undefined' ? csrfToken : '') %>" method="POST" enctype="multipart/form-data" id="reportIssueForm">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
              
              <!-- Machine Selection -->
              <div class="mb-3">
                <label for="machineId" class="form-label fw-bold d-flex justify-content-between align-items-center">
                  <span><i class="fa-solid fa-gears text-primary me-1" aria-hidden="true"></i> Machine concernée <span class="text-danger">*</span></span>
                  <% if (selectedMachine) { %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Sélectionnée via QR / Lien</span>
                  <% } %>
                </label>

                <select class="form-select" id="machineId" name="machineId" required>
                  <option value="" disabled <%= !selectedMachineId ? 'selected' : '' %>>-- Choisissez la machine dans la liste --</option>
                  <% machines.forEach(function(m) { %>
                    <option value="<%= m.id %>" <%= selectedMachineId === m.id ? 'selected' : '' %>>
                      <%= m.name %> <%= m.make ? '(' + m.make + ' ' + (m.model || '') + ')' : '' %> <%= m.location ? '— ' + m.location.name : '' %>
                    </option>
                  <% }); %>
                </select>
                <div class="form-text small">
                  Sélectionnez la machine sur laquelle vous avez constaté le problème ou le blocage.
                </div>
              </div>

              <!-- Problem Description -->
              <div class="mb-3">
                <label for="description" class="form-label fw-bold">
                  <i class="fa-solid fa-comment-dots text-danger me-1" aria-hidden="true"></i> Description du problème <span class="text-danger">*</span>
                </label>
                <textarea 
                  class="form-control" 
                  id="description" 
                  name="description" 
                  rows="4" 
                  placeholder="Expliquez ce qui s'est passé : bruit anormal, buse bouchée, pièce cassée, message d'erreur, coupe incomplète..."
                  required
                ></textarea>
                <div class="form-text small">
                  Plus votre description est précise (conditions d'utilisation, matière utilisée, messages affichés), plus vite la machine pourra être réparée.
                </div>
              </div>

              <!-- Photo Capture (Camera on Smartphone) -->
              <div class="mb-4">
                <label for="photoInput" class="form-label fw-bold d-flex justify-content-between align-items-center mb-2">
                  <span><i class="fa-solid fa-camera text-primary me-1" aria-hidden="true"></i> Photo du problème</span>
                  <span class="badge bg-body-secondary text-secondary-emphasis border">Optionnel mais recommandé</span>
                </label>

                <!-- Hidden file input with mobile camera capture -->
                <input 
                  type="file" 
                  id="photoInput" 
                  name="photo" 
                  accept=".png,.jpg,.jpeg,.webp,.gif,image/png,image/jpeg,image/webp,image/gif" 
                  capture="environment"
                  aria-label="Photo du problème"
                  class="d-none"
                />

                <!-- Action buttons for Photo -->
                <div id="uploadActionsContainer" class="camera-dropzone p-3 text-center">
                  <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <button type="button" class="btn btn-primary btn-sm py-2 px-3 d-flex align-items-center justify-content-center gap-2" id="btnTakePhoto">
                      <i class="fa-solid fa-camera" aria-hidden="true"></i>
                      <span class="fw-semibold">Prendre une photo</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm py-2 px-3 d-flex align-items-center justify-content-center gap-2" id="btnChoosePhoto">
                      <i class="fa-solid fa-images" aria-hidden="true"></i>
                      <span>Choisir une image</span>
                    </button>
                  </div>
                  <div class="small text-muted mt-2">
                    JPG, PNG, WEBP, GIF acceptés (max. 10 Mo). Sur smartphone, vous pouvez activer directement l'appareil photo.
                  </div>
                </div>

                <!-- Live Preview of chosen photo -->
                <div id="previewCard" class="card border p-2 bg-body-tertiary mt-2 d-none">
                  <div class="d-flex align-items-center justify-content-between gap-2 mb-2 px-1">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                      <i class="fa-solid fa-image text-primary" aria-hidden="true"></i>
                      <span id="previewFileName" class="small fw-semibold text-truncate">photo.jpg</span>
                      <span id="previewFileSize" class="badge bg-body-secondary text-secondary-emphasis border"></span>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm" id="btnRemovePhoto" title="Retirer la photo">
                      <i class="fa-solid fa-xmark me-1" aria-hidden="true"></i> Retirer
                    </button>
                  </div>
                  <div class="preview-image-box text-center bg-black bg-opacity-10 rounded">
                    <img id="previewImg" src="" alt="Aperçu de la photo" />
                  </div>
                </div>
              </div>

              <!-- Reporter Contact (Optional) -->
              <div class="border-top pt-3 mb-4">
                <h2 class="h6 fw-bold mb-2">
                  <i class="fa-solid fa-user text-secondary me-1" aria-hidden="true"></i> Vos coordonnées <small class="fw-normal text-muted">(facultatif)</small>
                </h2>
                <div class="row g-2">
                  <div class="col-12 col-sm-6">
                    <label for="reporterName" class="form-label small text-muted mb-1">Votre nom ou prénom</label>
                    <input type="text" class="form-control" id="reporterName" name="reporterName" placeholder="Ex: Alex Martin" />
                  </div>
                  <div class="col-12 col-sm-6">
                    <label for="reporterEmail" class="form-label small text-muted mb-1">Votre adresse e-mail</label>
                    <input type="email" class="form-control" id="reporterEmail" name="reporterEmail" placeholder="Ex: contributeur@exemple.fr" />
                  </div>
                </div>
                <div class="form-text small mt-1">
                  Permet à l'équipe technique de vous contacter si un complément d'information est nécessaire.
                </div>
              </div>

              <!-- Submit Button -->
              <div class="pt-2">
                <button type="submit" class="btn btn-danger w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2" id="submitBtn">
                  <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                  <span>Transmettre le signalement</span>
                </button>
              </div>

            </form>
          </div>
        </div>
      <% } %>

      <!-- Back / Home Footer Links -->
      <div class="text-center mt-4">
        <p class="small text-muted mb-1">
          FabtrackJS &bull; Gestion &amp; suivi d'activité pour fablab
        </p>
        <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>" class="small text-decoration-none text-secondary">
          <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Accéder au tableau de bord Fabtrack
        </a>
      </div>
    </main>

    <!-- Bootstrap Bundle JS -->
    <script src="vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
      (function () {
        const photoInput = document.getElementById("photoInput");
        const btnTakePhoto = document.getElementById("btnTakePhoto");
        const btnChoosePhoto = document.getElementById("btnChoosePhoto");
        const previewCard = document.getElementById("previewCard");
        const previewImg = document.getElementById("previewImg");
        const previewFileName = document.getElementById("previewFileName");
        const previewFileSize = document.getElementById("previewFileSize");
        const btnRemovePhoto = document.getElementById("btnRemovePhoto");
        const form = document.getElementById("reportIssueForm");
        const submitBtn = document.getElementById("submitBtn");

        if (btnTakePhoto && photoInput) {
          btnTakePhoto.addEventListener("click", function () {
            photoInput.setAttribute("capture", "environment");
            photoInput.click();
          });
        }

        if (btnChoosePhoto && photoInput) {
          btnChoosePhoto.addEventListener("click", function () {
            photoInput.removeAttribute("capture");
            photoInput.click();
          });
        }

        if (photoInput) {
          photoInput.addEventListener("change", function () {
            if (photoInput.files && photoInput.files[0]) {
              const file = photoInput.files[0];
              previewFileName.textContent = file.name;
              
              // Format file size
              const kb = file.size / 1024;
              previewFileSize.textContent = kb > 1024 
                ? (kb / 1024).toFixed(1) + " Mo" 
                : Math.round(kb) + " Ko";

              const reader = new FileReader();
              reader.onload = function (e) {
                previewImg.src = e.target.result;
                previewCard.classList.remove("d-none");
              };
              reader.readAsDataURL(file);
            } else {
              previewCard.classList.add("d-none");
              previewImg.src = "";
            }
          });
        }

        if (btnRemovePhoto && photoInput) {
          btnRemovePhoto.addEventListener("click", function () {
            photoInput.value = "";
            previewCard.classList.add("d-none");
            previewImg.src = "";
          });
        }

        if (form && submitBtn) {
          form.addEventListener("submit", function () {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Envoi en cours...';
          });
        }
      })();
    </script>
  </body>
</html>
