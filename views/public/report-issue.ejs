<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Signaler un problème ou une panne sur une machine du Fablab" />
    <title>Signaler une panne - <%= typeof platformName !== 'undefined' ? platformName : 'FabtrackJS' %></title>

    <%- include('../includes/pagehead.html') %>

    <style>
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background-color: var(--bs-tertiary-bg);
      }

      .report-container {
        width: 100%;
        max-width: 680px;
        margin: 0 auto;
        padding: 1.25rem 1rem 3rem 1rem;
      }

      .report-card {
        border-radius: 1rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        border: 1px solid var(--bs-border-color-translucent);
      }

      .camera-dropzone {
        border: 2px dashed var(--bs-border-color);
        border-radius: 0.85rem;
        background-color: var(--bs-secondary-bg);
        transition: all 0.2s ease-in-out;
      }

      .camera-dropzone:hover {
        border-color: var(--bs-primary);
        background-color: var(--bs-tertiary-bg);
      }

      .preview-image-box {
        position: relative;
        max-height: 280px;
        overflow: hidden;
        border-radius: 0.75rem;
      }

      .preview-image-box img {
        width: 100%;
        height: auto;
        max-height: 280px;
        object-fit: cover;
      }

      .badge-indicator {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
      }
    </style>
  </head>

  <body>
    <%- include('../includes/light-dark.html') %>

    <div class="report-container">
      <!-- Branding & Title -->
      <div class="text-center mb-4 pt-2">
        <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle p-3 mb-3 shadow-sm" style="width: 64px; height: 64px;">
          <i class="fa-solid fa-triangle-exclamation fa-2x"></i>
        </div>
        <h2 class="fw-bold mb-1">Signaler un problème machine</h2>
        <p class="text-secondary small mb-0">
          Aidez l'équipe du Fablab à maintenir les machines en parfait état de fonctionnement.
        </p>
      </div>

      <% if (success) { %>
        <!-- Confirmation Success Screen -->
        <div class="card report-card bg-body border-0 overflow-hidden mb-4 animate__animated animate__fadeIn">
          <div class="card-body p-4 p-md-5 text-center">
            <div class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-circle p-3 mb-3 shadow-sm" style="width: 72px; height: 72px;">
              <i class="fa-solid fa-circle-check fa-3x"></i>
            </div>
            <h3 class="fw-bold text-success mb-2">Signalement enregistré !</h3>
            <p class="text-secondary mb-3">
              Votre signalement pour la machine <strong class="text-body"><%= reportedMachineName || 'sélectionnée' %></strong> a bien été transmis.
            </p>

            <div class="alert alert-success border-0 bg-success-subtle text-success-emphasis text-start p-3 rounded-3 small mb-4">
              <div class="d-flex gap-2">
                <i class="fa-solid fa-bell mt-1"></i>
                <div>
                  <strong>Équipe prévenue :</strong> Les médiateurs et administrateurs du fablab ont été notifiés par e-mail. L'incident a également été enregistré dans l'historique technique de la machine.
                </div>
              </div>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
              <a href="/report-issue" class="btn btn-outline-primary rounded-pill px-4">
                <i class="fa-solid fa-plus me-1"></i> Signaler un autre incident
              </a>
              <a href="/" class="btn btn-primary rounded-pill px-4">
                <i class="fa-solid fa-house me-1"></i> Retour à l'accueil
              </a>
            </div>
          </div>
        </div>
      <% } else { %>
        <!-- Reporting Form -->
        <div class="card report-card bg-body overflow-hidden">
          <div class="card-header bg-danger text-white py-3 px-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-wrench"></i>
              <span class="fw-bold">Formulaire de signalement</span>
            </div>
            <span class="badge bg-white text-danger fw-semibold px-2 py-1 rounded-pill small">Public &amp; Ouvert</span>
          </div>

          <div class="card-body p-3 p-md-4">
            <form action="/report-issue" method="POST" enctype="multipart/form-data" id="reportIssueForm">
              
              <!-- Machine Selection -->
              <div class="mb-3">
                <label for="machineId" class="form-label fw-bold d-flex justify-content-between align-items-center">
                  <span><i class="fa-solid fa-gears text-primary me-1"></i> Machine concernée <span class="text-danger">*</span></span>
                  <% if (selectedMachine) { %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill small">Sélectionnée via QR / Lien</span>
                  <% } %>
                </label>

                <select class="form-select form-select-lg" id="machineId" name="machineId" required>
                  <option value="" disabled <%= !selectedMachineId ? 'selected' : '' %>>-- Choisissez la machine dans la liste --</option>
                  <% machines.forEach(function(m) { %>
                    <option value="<%= m.id %>" <%= selectedMachineId === m.id ? 'selected' : '' %>>
                      <%= m.name %> <%= m.make ? '(' + m.make + ' ' + (m.model || '') + ')' : '' %> <%= m.location ? '— ' + m.location.name : '' %>
                    </option>
                  <% }); %>
                </select>
                <div class="form-text small">
                  Sélectionnez la machine sur laquelle vous avez constaté le problème ou le blocage.
                </div>
              </div>

              <!-- Problem Description -->
              <div class="mb-3">
                <label for="description" class="form-label fw-bold">
                  <i class="fa-solid fa-comment-dots text-danger me-1"></i> Description du problème <span class="text-danger">*</span>
                </label>
                <textarea 
                  class="form-control" 
                  id="description" 
                  name="description" 
                  rows="4" 
                  placeholder="Expliquez ce qui s'est passé : bruit anormal, buse bouchée, pièce cassée, message d'erreur, coupe incomplète..."
                  required
                ></textarea>
                <div class="form-text small">
                  Plus votre description est précise (conditions d'utilisation, matière utilisée, messages affichés), plus vite la machine pourra être réparée.
                </div>
              </div>

              <!-- Photo Capture (Camera on Smartphone) -->
              <div class="mb-4">
                <label class="form-label fw-bold d-flex justify-content-between align-items-center mb-2">
                  <span><i class="fa-solid fa-camera text-primary me-1"></i> Photo du problème</span>
                  <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill small">Optionnel mais recommandé</span>
                </label>

                <!-- Hidden file input with mobile camera capture -->
                <input 
                  type="file" 
                  id="photoInput" 
                  name="photo" 
                  accept="image/*" 
                  capture="environment"
                  class="d-none"
                />

                <!-- Action buttons for Photo -->
                <div id="uploadActionsContainer" class="camera-dropzone p-3 text-center">
                  <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <button type="button" class="btn btn-primary py-2 px-3 rounded-pill d-flex align-items-center justify-content-center gap-2" id="btnTakePhoto">
                      <i class="fa-solid fa-camera"></i>
                      <span class="fw-semibold">Prendre une photo</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary py-2 px-3 rounded-pill d-flex align-items-center justify-content-center gap-2" id="btnChoosePhoto">
                      <i class="fa-solid fa-images"></i>
                      <span>Choisir une image</span>
                    </button>
                  </div>
                  <div class="small text-muted mt-2">
                    JPG, PNG, WEBP acceptés (max. 15 Mo). Sur smartphone, vous pouvez activer directement l'appareil photo.
                  </div>
                </div>

                <!-- Live Preview of chosen photo -->
                <div id="previewCard" class="card border rounded-3 p-2 bg-body-tertiary mt-2 d-none">
                  <div class="d-flex align-items-center justify-content-between gap-2 mb-2 px-1">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                      <i class="fa-solid fa-image text-primary"></i>
                      <span id="previewFileName" class="small fw-semibold text-truncate">photo.jpg</span>
                      <span id="previewFileSize" class="badge bg-body-secondary text-secondary small"></span>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-2 py-0" id="btnRemovePhoto" title="Retirer la photo">
                      <i class="fa-solid fa-xmark me-1"></i> Retirer
                    </button>
                  </div>
                  <div class="preview-image-box text-center bg-black bg-opacity-10 rounded">
                    <img id="previewImg" src="" alt="Aperçu de la photo" />
                  </div>
                </div>
              </div>

              <!-- Reporter Contact (Optional) -->
              <div class="border-top pt-3 mb-4">
                <h6 class="fw-bold mb-2">
                  <i class="fa-solid fa-user text-secondary me-1"></i> Vos coordonnées <small class="fw-normal text-muted">(facultatif)</small>
                </h6>
                <div class="row g-2">
                  <div class="col-12 col-sm-6">
                    <label for="reporterName" class="form-label small text-muted mb-1">Votre nom ou prénom</label>
                    <input type="text" class="form-control" id="reporterName" name="reporterName" placeholder="Ex: Alex Martin" />
                  </div>
                  <div class="col-12 col-sm-6">
                    <label for="reporterEmail" class="form-label small text-muted mb-1">Votre adresse e-mail</label>
                    <input type="email" class="form-control" id="reporterEmail" name="reporterEmail" placeholder="Ex: usager@exemple.fr" />
                  </div>
                </div>
                <div class="form-text small mt-1">
                  Permet à l'équipe technique de vous contacter si un complément d'information est nécessaire.
                </div>
              </div>

              <!-- Submit Button -->
              <div class="pt-2">
                <button type="submit" class="btn btn-danger btn-lg w-100 py-3 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2" id="submitBtn">
                  <i class="fa-solid fa-paper-plane"></i>
                  <span>Transmettre le signalement</span>
                </button>
              </div>

            </form>
          </div>
        </div>
      <% } %>

      <!-- Back / Home Footer Links -->
      <div class="text-center mt-4">
        <p class="small text-muted mb-1">
          FabtrackJS &bull; Gestion &amp; suivi d'activité pour fablab
        </p>
        <a href="/" class="small text-decoration-none text-secondary">
          <i class="fa-solid fa-arrow-left me-1"></i> Accéder au tableau de bord Fabtrack
        </a>
      </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>

    <script>
      (function () {
        const photoInput = document.getElementById("photoInput");
        const btnTakePhoto = document.getElementById("btnTakePhoto");
        const btnChoosePhoto = document.getElementById("btnChoosePhoto");
        const previewCard = document.getElementById("previewCard");
        const previewImg = document.getElementById("previewImg");
        const previewFileName = document.getElementById("previewFileName");
        const previewFileSize = document.getElementById("previewFileSize");
        const btnRemovePhoto = document.getElementById("btnRemovePhoto");
        const form = document.getElementById("reportIssueForm");
        const submitBtn = document.getElementById("submitBtn");

        if (btnTakePhoto && photoInput) {
          btnTakePhoto.addEventListener("click", function () {
            photoInput.setAttribute("capture", "environment");
            photoInput.click();
          });
        }

        if (btnChoosePhoto && photoInput) {
          btnChoosePhoto.addEventListener("click", function () {
            photoInput.removeAttribute("capture");
            photoInput.click();
          });
        }

        if (photoInput) {
          photoInput.addEventListener("change", function () {
            if (photoInput.files && photoInput.files[0]) {
              const file = photoInput.files[0];
              previewFileName.textContent = file.name;
              
              // Format file size
              const kb = file.size / 1024;
              previewFileSize.textContent = kb > 1024 
                ? (kb / 1024).toFixed(1) + " Mo" 
                : Math.round(kb) + " Ko";

              const reader = new FileReader();
              reader.onload = function (e) {
                previewImg.src = e.target.result;
                previewCard.classList.remove("d-none");
              };
              reader.readAsDataURL(file);
            } else {
              previewCard.classList.add("d-none");
              previewImg.src = "";
            }
          });
        }

        if (btnRemovePhoto && photoInput) {
          btnRemovePhoto.addEventListener("click", function () {
            photoInput.value = "";
            previewCard.classList.add("d-none");
            previewImg.src = "";
          });
        }

        if (form && submitBtn) {
          form.addEventListener("submit", function () {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Envoi en cours...';
          });
        }
      })();
    </script>
  </body>
</html>
