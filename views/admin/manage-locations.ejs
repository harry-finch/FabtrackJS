<!doctype html>
<html lang="en" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="" />
        <meta name="author" content="Stéphane Muller" />
        <title>Fabtrack administration panel</title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Page Header -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.25rem;">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h4 class="fw-bold mb-0">Emplacements</h4>
                                <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill" style="font-size: 0.72rem;">
                                    <%= locations.length %> emplacements
                                </span>
                            </div>
                            <p class="text-muted small mb-0">Salles, zones et espaces physiques du fablab</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="/admin" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            <i class="fa-solid fa-arrow-left me-1"></i> Retour panneau admin
                        </a>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th onclick="sortTable(0)" scope="col" class="ps-3">#</th>
                                    <th onclick="sortTable(1)" scope="col">Location</th>
                                    <th scope="col">Description</th>
                                    <th scope="col" class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="table-content">
                                <% locations.forEach(function(location) { %>
                                <tr>
                                    <td scope="row" class="ps-3 text-muted">#<%= location.id %></td>
                                    <td class="fw-semibold"><%= location.name %></td>
                                    <td><span class="text-muted small"><%= location.description || '-' %></span></td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a href="#" class="btn btn-outline-primary" id="edit-<%= location.id %>"
                                                        data-id="<%= location.id %>"
                                                        data-name="<%= location.name %>"
                                                        data-description="<%= location.description %>"
                                                        title="Modifier">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>
                                            <a href="/admin/locations/delete/<%= location.id %>" class="btn btn-outline-danger" title="Supprimer" onclick="return confirm('Supprimer l\'emplacement <%= location.name %> ?');">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-0 pt-3 pb-0">
                    <h5 class="fw-bold mb-0" id="formTitle">
                        <i class="fa-solid fa-location-dot text-info-emphasis me-2"></i>Create new location
                    </h5>
                </div>
                <div class="card-body">
                    <form action="/admin/locations/create" method="post" id="locationForm">
                        <div class="row">
                            <input type='hidden' id="locationid" name='locationid' value='' />
                            <div class="col-12">
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="name" name="name" placeholder="Name" required />
                                    <label for="name">Name</label>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div class="form-floating mb-3">
                                    <textarea class="form-control" id="description" name="description" style="height: 100px"></textarea>
                                    <label for="description">Description</label>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary rounded-pill px-4 py-2" type="submit" id="submitBtn">
                                Create new location
                            </button>
                            <button type="button" id="cancelEditBtn" class="btn btn-outline-secondary rounded-pill px-4 py-2" style="display: none;" onclick="cancelEdit()">
                                Annuler
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <%- include('../includes/footer.html') %>

        <script>
          const elements = document.querySelectorAll('[id^="edit-"]');
          elements.forEach(function(element){
            element.addEventListener("click", editItem);
          });

          function editItem(event) {
            if (event) event.preventDefault();

            document.getElementById("formTitle").innerHTML = "<i class='fa-solid fa-pen-to-square text-primary me-2'></i>Update location";
            document.getElementById("locationForm").action = "/admin/locations/update";
            document.getElementById("locationid").value = this.dataset.id;
            document.getElementById("name").value = this.dataset.name;
            document.getElementById("description").value = this.dataset.description || '';
            document.getElementById("submitBtn").innerText = "Update location";
            document.getElementById("cancelEditBtn").style.display = "inline-block";

            document.getElementById("locationForm").scrollIntoView({ behavior: 'smooth' });
            return false;
          }

          function cancelEdit() {
            document.getElementById("formTitle").innerHTML = "<i class='fa-solid fa-location-dot text-info-emphasis me-2'></i>Create new location";
            document.getElementById("locationForm").action = "/admin/locations/create";
            document.getElementById("locationid").value = "";
            document.getElementById("name").value = "";
            document.getElementById("description").value = "";
            document.getElementById("submitBtn").innerText = "Create new location";
            document.getElementById("cancelEditBtn").style.display = "none";
          }
        </script>

    </body>
</html>
