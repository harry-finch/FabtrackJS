<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Gestion des emplacements et salles du fablab" />
        <meta name="author" content="Stéphane Muller" />
        <title>Emplacements • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Page Header -->
            <div class="fab-page-header">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h1 class="fab-page-title">Emplacements</h1>
                        <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
                            <%= locations.length %> emplacement<%= locations.length > 1 ? 's' : '' %>
                        </span>
                    </div>
                    <p class="fab-page-subtitle">Salles, zones et espaces physiques du fablab</p>
                </div>
            </div>

            <div class="card border mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th data-sort="0" scope="col" class="ps-3">#</th>
                                    <th data-sort="1" scope="col">Emplacement</th>
                                    <th scope="col">Description</th>
                                    <th scope="col" class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="table-content">
                                <% if (!locations || locations.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        <i class="fa-solid fa-location-dot fs-4 d-block mb-2 opacity-50" aria-hidden="true"></i>
                                        Aucun emplacement enregistré pour le moment.
                                    </td>
                                </tr>
                                <% } else { %>
                                <% locations.forEach(function(location) { %>
                                <tr>
                                    <td scope="row" class="ps-3 text-muted tabular-nums">#<%= location.id %></td>
                                    <td class="fw-semibold"><%= location.name %></td>
                                    <td><span class="text-muted small"><%= location.description || '—' %></span></td>
                                    <td class="text-end pe-3">
                                        <div class="fab-row-actions">
                                            <a
                                                href="#"
                                                class="btn btn-outline-primary"
                                                id="edit-<%= location.id %>"
                                                data-id="<%= location.id %>"
                                                data-name="<%= location.name %>"
                                                data-description="<%= location.description %>"
                                                title="Modifier"
                                                aria-label="Modifier l'emplacement <%= location.name %>"
                                            >
                                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                            </a>
                                            <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/locations/delete/<%= location.id %>" class="d-inline" data-confirm="Supprimer l'emplacement <%= location.name %> ?">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                                                <button type="submit" class="btn btn-outline-danger" title="Supprimer" aria-label="Supprimer l'emplacement <%= location.name %>">
                                                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border mb-4">
                <div class="card-header bg-body-tertiary">
                    <h2 class="h6 fw-bold mb-0" id="formTitle">
                        <i class="fa-solid fa-location-dot text-secondary me-2" aria-hidden="true"></i>Nouvel emplacement
                    </h2>
                </div>
                <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/locations/create" method="post" id="locationForm">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                    <input type="hidden" id="locationid" name="locationid" value="" />

                    <div class="card-body">
                        <div class="mb-3">
                            <label for="name" class="form-label fw-semibold small">Nom de l'emplacement</label>
                            <input type="text" class="form-control" id="name" name="name" placeholder="Ex. : Zone laser, Salle électronique, Armoire B2" required />
                        </div>
                        <div class="mb-0">
                            <label for="description" class="form-label fw-semibold small">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="3" placeholder="Précisions sur la salle, l'étage ou la zone"></textarea>
                        </div>
                    </div>

                    <div class="card-footer bg-body-tertiary d-flex flex-wrap gap-2">
                        <button class="btn btn-primary" type="submit" id="submitBtn">
                            Créer l'emplacement
                        </button>
                        <button type="button" id="cancelEditBtn" class="btn btn-outline-secondary" style="display: none;" data-action="cancel-edit">
                            Annuler
                        </button>
                    </div>
                </form>
            </div>

            <%- include('../includes/footer.html') %>

        <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
          const elements = document.querySelectorAll('[id^="edit-"]');
          elements.forEach(function(element) {
            element.addEventListener("click", editItem);
          });

          function editItem(event) {
            if (event) event.preventDefault();

            document.getElementById("formTitle").innerHTML = "<i class='fa-solid fa-pen-to-square text-primary me-2' aria-hidden='true'></i>Modifier l'emplacement";
            document.getElementById("locationForm").action = (window.getAppBaseUrl ? window.getAppBaseUrl("admin/locations/update") : "/admin/locations/update");
            document.getElementById("locationid").value = this.dataset.id;
            document.getElementById("name").value = this.dataset.name;
            document.getElementById("description").value = this.dataset.description || '';
            document.getElementById("submitBtn").innerText = "Enregistrer les modifications";
            document.getElementById("cancelEditBtn").style.display = "inline-block";

            document.getElementById("locationForm").scrollIntoView({ behavior: 'smooth' });
            return false;
          }

          function cancelEdit() {
            document.getElementById("formTitle").innerHTML = "<i class='fa-solid fa-location-dot text-secondary me-2' aria-hidden='true'></i>Nouvel emplacement";
            document.getElementById("locationForm").action = (window.getAppBaseUrl ? window.getAppBaseUrl("admin/locations/create") : "/admin/locations/create");
            document.getElementById("locationid").value = "";
            document.getElementById("name").value = "";
            document.getElementById("description").value = "";
            document.getElementById("submitBtn").innerText = "Créer l'emplacement";
            document.getElementById("cancelEditBtn").style.display = "none";
          }
        </script>
    </body>
</html>
