<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Gestion des Projets Sorbonne et Facturation par Entité/UFR" />
    <title>Projets Sorbonne &amp; Facturation • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

    <%- include('../includes/pagehead.html') %>
  </head>

  <body class="d-flex justify-content-center bg-body-tertiary py-4">
    <%- include('../includes/light-dark.html') %>

    <main class="main-container">
      <%- include('../includes/header.html') %>

      <!-- Page Header -->
      <div class="fab-page-header">
        <div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <h1 class="fab-page-title">Projets Sorbonne &amp; Facturation</h1>
            <% if (typeof isPluginSorbonneEnabled !== 'undefined' && !isPluginSorbonneEnabled) { %>
              <span class="badge bg-body-secondary text-secondary-emphasis border">
                <i class="fa-solid fa-power-off me-1" aria-hidden="true"></i>Plugin désactivé
              </span>
            <% } else { %>
              <span class="badge bg-body-secondary text-secondary-emphasis border">Sorbonne Université</span>
            <% } %>
          </div>
          <p class="fab-page-subtitle">Rattachement par Entité / UFR, suivi des consommables engagés et règlement des facturations</p>
        </div>
        <div class="fab-page-actions">
          <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/sorbonne/export-csv?entity=<%= encodeURIComponent(selectedEntity) %>&status=<%= encodeURIComponent(selectedStatus) %>&startDate=<%= encodeURIComponent(startDate) %>&endDate=<%= encodeURIComponent(endDate) %>" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-file-csv me-1" aria-hidden="true"></i> Exporter CSV
          </a>
        </div>
      </div>

      <!-- Disabled notice banner -->
      <% if (typeof isPluginSorbonneEnabled !== 'undefined' && !isPluginSorbonneEnabled) { %>
      <div class="alert alert-secondary border d-flex align-items-center justify-content-between mb-4 px-3 py-2">
        <div class="d-flex align-items-center gap-3">
          <span class="fab-kpi-icon" aria-hidden="true">
            <i class="fa-solid fa-power-off"></i>
          </span>
          <div>
            <div class="fw-semibold small">Plugin Projets Sorbonne actuellement désactivé</div>
            <div class="text-muted small">Le champ d'entité/UFR et le suivi associé sont inactifs sur la borne d'accueil. Vous pouvez réactiver le plugin dans la <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/settings" class="alert-link">configuration générale</a>.</div>
          </div>
        </div>
        <span class="badge bg-body-secondary text-secondary-emphasis border">Inactif</span>
      </div>
      <% } %>

      <!-- KPI Summary Cards -->
      <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
          <div class="card h-100 fab-kpi-card <%= pendingTotalCost > 0 ? 'border-warning' : '' %>">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="small text-muted fw-semibold">Encours à régler</div>
                <div class="kpi-value tabular-nums <%= pendingTotalCost > 0 ? 'text-warning-emphasis' : 'text-body' %> mt-1">
                  <%= pendingTotalCost.toFixed(2) %> <%= typeof currencySymbol !== 'undefined' ? currencySymbol : '€' %>
                </div>
                <div class="small text-muted mt-1">À facturer aux entités / UFR</div>
              </div>
              <span class="fab-kpi-icon <%= pendingTotalCost > 0 ? 'bg-warning-subtle text-warning-emphasis border-warning-subtle' : '' %>" aria-hidden="true">
                <i class="fa-solid fa-clock"></i>
              </span>
            </div>
          </div>
        </div>

        <div class="col-xl-3 col-md-6">
          <div class="card h-100 fab-kpi-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="small text-muted fw-semibold">Total réglé</div>
                <div class="kpi-value tabular-nums text-success mt-1">
                  <%= settledTotalCost.toFixed(2) %> <%= typeof currencySymbol !== 'undefined' ? currencySymbol : '€' %>
                </div>
                <div class="small text-muted mt-1">Factures / consommations soldées</div>
              </div>
              <span class="fab-kpi-icon" aria-hidden="true">
                <i class="fa-solid fa-circle-check"></i>
              </span>
            </div>
          </div>
        </div>

        <div class="col-xl-3 col-md-6">
          <div class="card h-100 fab-kpi-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="small text-muted fw-semibold">Entités / UFR</div>
                <div class="kpi-value tabular-nums mt-1"><%= activeEntitiesCount %></div>
                <div class="small text-muted mt-1">Structures répertoriées</div>
              </div>
              <span class="fab-kpi-icon" aria-hidden="true">
                <i class="fa-solid fa-landmark"></i>
              </span>
            </div>
          </div>
        </div>

        <div class="col-xl-3 col-md-6">
          <div class="card h-100 fab-kpi-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="small text-muted fw-semibold">Volume total</div>
                <div class="kpi-value tabular-nums mt-1">
                  <%= grandTotalCost.toFixed(2) %> <%= typeof currencySymbol !== 'undefined' ? currencySymbol : '€' %>
                </div>
                <div class="small text-muted mt-1"><%= activities.length %> consommation(s) enregistrée(s)</div>
              </div>
              <span class="fab-kpi-icon" aria-hidden="true">
                <i class="fa-solid fa-coins"></i>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Filters Form -->
      <div class="fab-filter-bar">
        <form method="GET" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/sorbonne" class="row g-2 align-items-center">
          <div class="col-md-4 col-sm-6">
            <div class="input-group input-group-sm">
              <span class="input-group-text"><i class="fa-solid fa-landmark" aria-hidden="true"></i></span>
              <select name="entity" class="form-select" aria-label="Filtrer par entité ou UFR">
                <option value="all" <%= selectedEntity === 'all' ? 'selected' : '' %>>Toutes les entités / UFR</option>
                <% entities.forEach(function(e) { %>
                  <option value="<%= e %>" <%= selectedEntity.toLowerCase() === e.toLowerCase() ? 'selected' : '' %>><%= e %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="col-md-3 col-sm-6">
            <div class="input-group input-group-sm">
              <span class="input-group-text"><i class="fa-solid fa-filter" aria-hidden="true"></i></span>
              <select name="status" class="form-select" aria-label="Filtrer par statut de règlement">
                <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>Tous les statuts</option>
                <option value="pending" <%= selectedStatus === 'pending' ? 'selected' : '' %>>À régler uniquement</option>
                <option value="settled" <%= selectedStatus === 'settled' ? 'selected' : '' %>>Réglé uniquement</option>
              </select>
            </div>
          </div>

          <div class="col-md-2 col-sm-4">
            <input type="date" name="startDate" value="<%= startDate %>" class="form-control form-control-sm" title="Date de début" aria-label="Date de début">
          </div>

          <div class="col-md-2 col-sm-4">
            <input type="date" name="endDate" value="<%= endDate %>" class="form-control form-control-sm" title="Date de fin" aria-label="Date de fin">
          </div>

          <div class="col-md-1 col-sm-4 d-flex gap-1">
            <button type="submit" class="btn btn-primary btn-sm w-100" title="Appliquer les filtres" aria-label="Appliquer les filtres">
              <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            </button>
            <% if (selectedEntity !== 'all' || selectedStatus !== 'all' || startDate || endDate) { %>
              <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/sorbonne" class="btn btn-outline-secondary btn-sm" title="Réinitialiser" aria-label="Réinitialiser les filtres">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
              </a>
            <% } %>
          </div>
        </form>
      </div>

      <!-- Action banner for single entity batch settlement -->
      <% if (selectedEntity !== 'all') { %>
        <% const currentEntitySummary = entitySummary.find(s => s.entity.toLowerCase() === selectedEntity.toLowerCase()); %>
        <% if (currentEntitySummary && currentEntitySummary.pendingCost > 0) { %>
        <div class="alert alert-warning border d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 px-3 py-2">
          <div class="d-flex align-items-center gap-3">
            <span class="fab-kpi-icon bg-warning-subtle text-warning-emphasis border-warning-subtle" aria-hidden="true">
              <i class="fa-solid fa-file-invoice-dollar"></i>
            </span>
            <div>
              <div class="fw-bold small">Règlement groupé pour « <%= currentEntitySummary.entity %> »</div>
              <div class="small text-muted">
                Encours en attente : <strong class="tabular-nums"><%= currentEntitySummary.pendingCost.toFixed(2) %> <%= typeof currencySymbol !== 'undefined' ? currencySymbol : '€' %></strong> (<%= currentEntitySummary.pendingCount %> consommation(s))
              </div>
            </div>
          </div>
          <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/sorbonne/settle-entity" data-confirm="Confirmez-vous le règlement de toutes les consommations en attente pour <%= currentEntitySummary.entity %> ?">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
            <input type="hidden" name="entity" value="<%= currentEntitySummary.entity %>">
            <button type="submit" class="btn btn-primary btn-sm">
              <i class="fa-solid fa-check-double me-1" aria-hidden="true"></i> Tout marquer comme réglé
            </button>
          </form>
        </div>
        <% } %>
      <% } %>

      <!-- Nav Tabs -->
      <ul class="nav nav-tabs mb-3" id="sorbonneTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active fw-semibold" id="tab-log" data-bs-toggle="tab" data-bs-target="#panel-log" type="button" role="tab">
            <i class="fa-solid fa-clock-rotate-left me-1" aria-hidden="true"></i> Journal des consommations (<%= activities.length %>)
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link fw-semibold" id="tab-summary" data-bs-toggle="tab" data-bs-target="#panel-summary" type="button" role="tab">
            <i class="fa-solid fa-chart-pie me-1" aria-hidden="true"></i> Synthèse par Entité / UFR (<%= entitySummary.length %>)
          </button>
        </li>
      </ul>

      <div class="tab-content" id="sorbonneTabsContent">
        <!-- TAB 1: CONSUMPTIONS LOG -->
        <div class="tab-pane fade show active" id="panel-log" role="tabpanel">
          <div class="card border mb-4">
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th scope="col" class="ps-3 text-nowrap" style="width: 100px;">Date</th>
                      <th scope="col" style="max-width: 140px;">Entité / UFR</th>
                      <th scope="col" style="max-width: 150px;">Projet</th>
                      <th scope="col" style="max-width: 140px;">Contributeur</th>
                      <th scope="col" style="max-width: 150px;">Consommable</th>
                      <th scope="col" class="text-end text-nowrap" style="width: 80px;">Quantité</th>
                      <th scope="col" class="text-end text-nowrap" style="width: 85px;">Total</th>
                      <th scope="col" class="text-center text-nowrap" style="width: 105px;">Statut</th>
                      <th scope="col" class="text-end pe-3 text-nowrap" style="width: 90px;">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (activities.length === 0) { %>
                    <tr>
                      <td colspan="9" class="text-center text-muted py-4">
                        <i class="fa-solid fa-inbox fa-2x mb-2 d-block opacity-50" aria-hidden="true"></i>
                        Aucune consommation trouvée pour ces critères de recherche.
                      </td>
                    </tr>
                    <% } %>
                    <% activities.forEach(function(act) { %>
                    <tr class="<%= act.settled ? 'text-muted' : '' %>">
                      <td class="ps-3 text-nowrap small tabular-nums">
                        <%= act.formattedDate %>
                      </td>
                      <td class="text-truncate" style="max-width: 140px;">
                        <span class="badge bg-body-secondary text-secondary-emphasis border text-truncate d-inline-block" style="max-width: 100%;" title="<%= act.sorbonneEntity %>">
                          <%= act.sorbonneEntity %>
                        </span>
                      </td>
                      <td class="small text-truncate" style="max-width: 150px;">
                        <% if (act.projectUrl && act.projectUrl !== 'N/A') { %>
                          <% const validActUrl = safeHttpUrl(act.projectUrl); %>
                          <% if (validActUrl) { %>
                            <a href="<%= validActUrl %>" target="_blank" rel="noopener noreferrer" class="text-decoration-none" title="<%= validActUrl %>">
                              <%= validActUrl.length > 25 ? validActUrl.substring(0, 22) + '…' : validActUrl %>
                              <i class="fa-solid fa-arrow-up-right-from-square ms-1 small" aria-hidden="true"></i>
                            </a>
                          <% } else { %>
                            <span class="text-truncate d-inline-block" style="max-width: 100%;" title="<%= act.projectUrl %>"><%= act.projectUrl %></span>
                          <% } %>
                        <% } else { %>
                          <span class="text-muted fst-italic">Sans titre</span>
                        <% } %>
                      </td>
                      <td class="small" style="max-width: 140px;">
                        <div class="fw-semibold text-truncate" title="<%= act.userName %>"><%= act.userName %></div>
                        <% if (act.userEmail) { %>
                          <div class="text-muted text-truncate" style="font-size: 0.74rem;" title="<%= act.userEmail %>"><%= act.userEmail %></div>
                        <% } %>
                      </td>
                      <td class="small text-truncate" style="max-width: 150px;">
                        <span class="fw-medium text-truncate d-inline-block" style="max-width: 100%;" title="<%= act.consumableName %>"><%= act.consumableName %></span>
                      </td>
                      <td class="text-end small text-nowrap tabular-nums">
                        <%= act.quantity %> <%= act.consumableUnit %>
                      </td>
                      <td class="text-end fw-bold small text-nowrap tabular-nums">
                        <%= act.totalCost.toFixed(2) %> <%= typeof currencySymbol !== 'undefined' ? currencySymbol : '€' %>
                      </td>
                      <td class="text-center text-nowrap">
                        <% if (act.settled) { %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle" title="Réglé le <%= act.settledAtFormatted %> par <%= act.settledBy || 'Staff' %>">
                            <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>Réglé
                          </span>
                          <% if (act.settledBy) { %>
                            <div class="text-muted" style="font-size: 0.72rem;"><%= act.settledBy %></div>
                          <% } %>
                        <% } else { %>
                          <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                            <i class="fa-solid fa-clock me-1" aria-hidden="true"></i>À régler
                          </span>
                        <% } %>
                      </td>
                      <td class="text-end pe-3 text-nowrap">
                        <div class="fab-row-actions">
                          <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/sorbonne/toggle-settled/<%= act.id %>" class="d-inline">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                            <% if (act.settled) { %>
                              <button type="submit" class="btn btn-outline-secondary btn-sm" title="Basculer vers Non réglé" aria-label="Annuler le règlement #<%= act.id %>">
                                <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                              </button>
                            <% } else { %>
                              <button type="submit" class="btn btn-outline-success btn-sm" title="Marquer comme réglé" aria-label="Marquer la consommation #<%= act.id %> comme réglée">
                                <i class="fa-solid fa-check" aria-hidden="true"></i>
                              </button>
                            <% } %>
                          </form>
                        </div>
                      </td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 2: ENTITY SUMMARY -->
        <div class="tab-pane fade" id="panel-summary" role="tabpanel">
          <div class="card border mb-4">
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th scope="col" class="ps-3">Entité / UFR</th>
                      <th scope="col" class="text-center">Projets</th>
                      <th scope="col" class="text-center">Contributeurs</th>
                      <th scope="col" class="text-center">Consommations</th>
                      <th scope="col" class="text-end">Encours à régler</th>
                      <th scope="col" class="text-end">Total réglé</th>
                      <th scope="col" class="text-end">Volume total</th>
                      <th scope="col" class="text-end pe-3">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (entitySummary.length === 0) { %>
                    <tr>
                      <td colspan="8" class="text-center text-muted py-4">
                        Aucune synthèse disponible.
                      </td>
                    </tr>
                    <% } %>
                    <% entitySummary.forEach(function(st) { %>
                    <tr>
                      <td class="ps-3 fw-semibold">
                        <i class="fa-solid fa-landmark me-2 text-muted" aria-hidden="true"></i><%= st.entity %>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums"><%= st.projectsCount %></span>
                      </td>
                      <td class="text-center">
                        <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums"><%= st.usersCount %></span>
                      </td>
                      <td class="text-center tabular-nums">
                        <%= st.totalCount %>
                        <% if (st.pendingCount > 0) { %>
                          <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1" title="<%= st.pendingCount %> en attente"><%= st.pendingCount %></span>
                        <% } %>
                      </td>
                      <td class="text-end fw-bold tabular-nums <%= st.pendingCost > 0 ? 'text-warning-emphasis' : 'text-muted' %>">
                        <%= st.pendingCost.toFixed(2) %> <%= typeof currencySymbol !== 'undefined' ? currencySymbol : '€' %>
                      </td>
                      <td class="text-end text-success fw-semibold tabular-nums">
                        <%= st.settledCost.toFixed(2) %> <%= typeof currencySymbol !== 'undefined' ? currencySymbol : '€' %>
                      </td>
                      <td class="text-end fw-bold tabular-nums">
                        <%= st.totalCost.toFixed(2) %> <%= typeof currencySymbol !== 'undefined' ? currencySymbol : '€' %>
                      </td>
                      <td class="text-end pe-3 text-nowrap">
                        <div class="fab-row-actions">
                          <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/sorbonne?entity=<%= encodeURIComponent(st.entity) %>" class="btn btn-outline-primary btn-sm" title="Filtrer par cette entité" aria-label="Filtrer par <%= st.entity %>">
                            <i class="fa-solid fa-list" aria-hidden="true"></i>
                          </a>
                          <% if (st.pendingCost > 0) { %>
                          <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/sorbonne/settle-entity" class="d-inline" data-confirm="Confirmez-vous le règlement de toutes les consommations en attente pour <%= st.entity %> ?">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                            <input type="hidden" name="entity" value="<%= st.entity %>">
                            <button type="submit" class="btn btn-outline-success btn-sm" title="Tout solder pour <%= st.entity %>" aria-label="Tout solder pour <%= st.entity %>">
                              <i class="fa-solid fa-check-double" aria-hidden="true"></i>
                            </button>
                          </form>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%- include('../includes/footer.html') %>
  </body>
</html>
