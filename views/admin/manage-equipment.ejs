<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Gestion des outils et équipements empruntables" />
    <meta name="author" content="FabtrackJS" />
    <title>Outils &amp; équipements • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

    <%- include('../includes/pagehead.html') %>
  </head>

  <body class="d-flex justify-content-center bg-body-tertiary py-4">
    <%- include('../includes/light-dark.html') %>

    <main class="main-container">
      <%- include('../includes/header.html') %>

      <% const overdueCount = (typeof activeLoans !== 'undefined') ? activeLoans.filter(l => l.isOverdue).length : 0; %>

      <!-- Page Header -->
      <div class="fab-page-header">
        <div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <h1 class="fab-page-title">Outils &amp; équipements</h1>
            <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
              <%= equipment.length %> outil(s)
            </span>
          </div>
          <p class="fab-page-subtitle">Gestion du matériel empruntable et association par espace de travail</p>
        </div>
        <div class="fab-page-actions">
          <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/inventory/movements?itemType=EQUIPMENT" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-clock-rotate-left me-1" aria-hidden="true"></i> Historique sorties &amp; casses
          </a>
          <button
            type="button"
            class="btn btn-primary btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#modalInventoryCheckout"
            data-item-type="EQUIPMENT"
          >
            <i class="fa-solid fa-arrow-up-from-bracket me-1" aria-hidden="true"></i> Sortie de matériel
          </button>
        </div>
      </div>

      <!-- KPI Stats & Résumé des emprunts -->
      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <div class="card h-100 fab-kpi-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="small text-muted fw-semibold">Outils &amp; matériels au catalogue</div>
                <div class="kpi-value tabular-nums mt-1"><%= equipment.length %></div>
              </div>
              <span class="fab-kpi-icon" aria-hidden="true">
                <i class="fa-solid fa-toolbox"></i>
              </span>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 fab-kpi-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="small text-muted fw-semibold">Objets en cours d'emprunt</div>
                <div class="kpi-value tabular-nums mt-1"><%= typeof activeLoans !== 'undefined' ? activeLoans.length : 0 %></div>
              </div>
              <span class="fab-kpi-icon" aria-hidden="true">
                <i class="fa-solid fa-handshake-angle"></i>
              </span>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 fab-kpi-card <%= overdueCount > 0 ? 'border-danger' : '' %>">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="small text-muted fw-semibold">Emprunts en retard</div>
                <div class="kpi-value tabular-nums mt-1 <%= overdueCount > 0 ? 'text-danger' : '' %>"><%= overdueCount %></div>
              </div>
              <span class="fab-kpi-icon <%= overdueCount > 0 ? 'bg-danger-subtle text-danger border-danger-subtle' : '' %>" aria-hidden="true">
                <i class="fa-solid <%= overdueCount > 0 ? 'fa-triangle-exclamation' : 'fa-circle-check' %>"></i>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Section : Objets en cours d'emprunt (Supervision Admin) -->
      <div class="card border mb-4">
        <div class="card-header bg-transparent d-flex flex-wrap align-items-center justify-content-between gap-2">
          <div>
            <h2 class="h6 fw-bold mb-0">
              <i class="fa-solid fa-clock-rotate-left text-secondary me-1" aria-hidden="true"></i> Objets actuellement en cours d'emprunt
            </h2>
            <span class="text-muted small fw-normal">Liste de tous les matériels sortis et contributeurs responsables</span>
          </div>
          <% if (typeof activeLoans !== 'undefined' && activeLoans.length > 0) { %>
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle tabular-nums">
              <%= activeLoans.length %> emprunt(s) actif(s)
            </span>
          <% } %>
        </div>
        <div class="card-body p-0">
          <% if (typeof activeLoans === 'undefined' || activeLoans.length === 0) { %>
            <div class="text-center py-4 text-muted">
              <i class="fa-solid fa-circle-check text-success fa-2x mb-2 d-block opacity-75" aria-hidden="true"></i>
              <p class="mb-0 fw-medium">Aucun équipement n'est actuellement en cours d'emprunt.</p>
              <span class="small text-secondary">Tout le matériel répertorié est actuellement disponible au lab.</span>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th scope="col" class="ps-3">Équipement / Outil</th>
                    <th scope="col">Emprunté par</th>
                    <th scope="col">Espace</th>
                    <th scope="col">Emprunté le</th>
                    <th scope="col">Retour prévu</th>
                    <th scope="col" class="text-center">Statut</th>
                    <th scope="col" class="text-end pe-3">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% activeLoans.forEach(function(loan) { %>
                  <tr class="<%= loan.isOverdue ? 'table-danger' : '' %>">
                    <td class="ps-3">
                      <span class="fw-semibold text-body">
                        <i class="fa-solid fa-toolbox fa-sm text-muted me-2" aria-hidden="true"></i><%= loan.equipment ? loan.equipment.name : ('Équipement #' + loan.id) %>
                      </span>
                    </td>
                    <td>
                      <% if (loan.user) { %>
                        <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>users/edit/<%= loan.user.id %>" class="fw-semibold text-decoration-none d-block">
                          <i class="fa-solid fa-user me-1 text-primary" aria-hidden="true"></i><%= loan.user.name %> <%= loan.user.surname %>
                        </a>
                        <span class="text-muted small"><%= loan.user.email %></span>
                      <% } else { %>
                        <span class="text-muted small">Contributeur inconnu</span>
                      <% } %>
                    </td>
                    <td>
                      <span class="badge bg-body-secondary text-secondary-emphasis border">
                        <%= loan.workspace %>
                      </span>
                    </td>
                    <td class="text-nowrap">
                      <div class="small text-body tabular-nums"><%= loan.formattedDate %></div>
                      <% if (loan.borrowDurationDays) { %>
                        <div class="small text-muted tabular-nums">
                          <i class="fa-regular fa-clock fa-xs me-1" aria-hidden="true"></i><%= loan.borrowDurationDays %> jour(s)
                        </div>
                      <% } %>
                    </td>
                    <td class="text-nowrap">
                      <strong class="small text-body tabular-nums"><%= loan.formattedExpectedReturn %></strong>
                    </td>
                    <td class="text-center text-nowrap">
                      <% if (loan.isOverdue) { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                          <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>En retard (<%= Math.abs(loan.daysDiff) %> j)
                        </span>
                      <% } else if (loan.daysDiff !== null) { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                          <i class="fa-solid fa-check me-1" aria-hidden="true"></i>Reste <%= loan.daysDiff %> j
                        </span>
                      <% } else { %>
                        <span class="badge bg-body-secondary text-secondary-emphasis border">En cours</span>
                      <% } %>
                    </td>
                    <td class="text-end pe-3">
                      <div class="fab-row-actions">
                        <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/equipment/return/<%= loan.id %>" method="post" class="d-inline" data-confirm="Confirmer la restitution de cet équipement ?">
                          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                          <button type="submit" class="btn btn-outline-success btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Restituer l'équipement" aria-label="Restituer l'équipement <%= loan.equipment ? loan.equipment.name : '#' + loan.id %>">
                            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Formulaire d'ajout rapide -->
      <div class="card border mb-4">
        <div class="card-body p-3">
          <h2 class="h6 fw-bold mb-2">
            <i class="fa-solid fa-plus text-primary me-1" aria-hidden="true"></i> Ajouter un équipement / outil
          </h2>
          <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/equipment/create" method="post" class="row g-2 align-items-center">
            <div class="col-md-5 col-sm-6">
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-body-tertiary">
                  <i class="fa-solid fa-wrench text-muted" aria-hidden="true"></i>
                </span>
                <input
                  type="text"
                  class="form-control"
                  id="name"
                  name="name"
                  placeholder="Nom de l'outil (ex : Dremel, Multimètre...)"
                  aria-label="Nom de l'équipement ou de l'outil"
                  required
                  autocomplete="off"
                />
              </div>
            </div>
            <div class="col-md-4 col-sm-6">
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-body-tertiary">
                  <i class="fa-solid fa-cube text-muted" aria-hidden="true"></i>
                </span>
                <select class="form-select" id="workspaceId" name="workspaceId" aria-label="Espace associé à l'équipement">
                  <option value="">-- Aucun espace / Partagé --</option>
                  <% workspaces.forEach(function(ws) { %>
                    <option value="<%= ws.id %>"><%= ws.name %></option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="col-md-3 col-sm-12">
              <button type="submit" class="btn btn-primary btn-sm w-100">
                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i> Ajouter l'outil
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Tableau des équipements -->
      <div class="card border mb-4">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th data-sort="0" scope="col" class="ps-3" style="cursor: pointer; width: 70px;">
                    # <i class="fa-solid fa-sort fa-xs text-muted" aria-hidden="true"></i>
                  </th>
                  <th data-sort="1" scope="col" style="cursor: pointer;">
                    Nom de l'équipement <i class="fa-solid fa-sort fa-xs text-muted" aria-hidden="true"></i>
                  </th>
                  <th data-sort="2" scope="col" style="cursor: pointer; width: 220px;">
                    Espace / Atelier <i class="fa-solid fa-sort fa-xs text-muted" aria-hidden="true"></i>
                  </th>
                  <th data-sort="3" scope="col" class="text-center" style="cursor: pointer; width: 150px;">
                    Emprunts enregistrés <i class="fa-solid fa-sort fa-xs text-muted" aria-hidden="true"></i>
                  </th>
                  <th scope="col" class="text-center" style="width: 140px;">Statut</th>
                  <th scope="col" class="text-end pe-3" style="width: 150px;">Actions</th>
                </tr>
              </thead>
              <tbody id="table-content">
                <% if (equipment.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center py-4 text-muted">
                    <i class="fa-solid fa-inbox fa-2x mb-2 d-block opacity-50" aria-hidden="true"></i>
                    Aucun outil ou équipement enregistré pour le moment.
                  </td>
                </tr>
                <% } else { %>
                <% equipment.forEach(function(item) { %>
                <tr>
                  <td scope="row" class="ps-3 text-muted">#<%= item.id %></td>
                  <td>
                    <div class="d-flex align-items-center flex-wrap gap-2">
                      <span class="fw-semibold text-body">
                        <i class="fa-solid fa-toolbox fa-sm text-muted me-2" aria-hidden="true"></i><%= item.name %>
                      </span>
                      <% if (item.isCurrentlyBorrowed) { %>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" data-bs-toggle="tooltip" title="Emprunté par : <%= item.currentBorrowers.join(', ') %>">
                          <i class="fa-solid fa-clock me-1" aria-hidden="true"></i>En prêt
                        </span>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <% if (item.workspace) { %>
                      <span class="badge bg-body-secondary text-secondary-emphasis border">
                        <i class="fa-solid fa-cube me-1" aria-hidden="true"></i><%= item.workspace.name %>
                      </span>
                    <% } else { %>
                      <span class="badge bg-body-secondary text-secondary-emphasis border">
                        <i class="fa-solid fa-share-nodes me-1" aria-hidden="true"></i>Partagé / Non assigné
                      </span>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <% if (item.borrowCount > 0) { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle">
                        <i class="fa-solid fa-handshake-angle me-1" aria-hidden="true"></i><%= item.borrowCount %> emprunt(s)
                      </span>
                    <% } else { %>
                      <span class="badge bg-body-secondary text-secondary-emphasis border">
                        0 emprunt
                      </span>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <% if (item.status === 'OUT_OF_SERVICE') { %>
                      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" data-bs-toggle="tooltip" title="<%= item.decommissionReason || 'Hors service / En panne' %>">
                        <i class="fa-solid fa-screwdriver-wrench me-1" aria-hidden="true"></i>Hors service
                      </span>
                    <% } else if (item.status === 'DECOMMISSIONED') { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle" data-bs-toggle="tooltip" title="<%= item.decommissionReason || 'Mis au rebut' %>">
                        <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>Au rebut
                      </span>
                    <% } else { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle">
                        <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>Disponible
                      </span>
                    <% } %>
                  </td>
                  <td class="text-end pe-3">
                    <div class="fab-row-actions">
                      <button
                        type="button"
                        class="btn btn-outline-warning btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#modalInventoryCheckout"
                        data-item-type="EQUIPMENT"
                        data-item-id="<%= item.id %>"
                        data-item-name="<%= item.name %>"
                        title="Sortie d'inventaire (casse, rebut, panne...)"
                        aria-label="Sortie d'inventaire pour <%= item.name %>"
                      >
                        <i class="fa-solid fa-arrow-up-from-bracket" aria-hidden="true"></i>
                      </button>
                      <% if (item.status === 'OUT_OF_SERVICE' || item.status === 'DECOMMISSIONED') { %>
                      <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/inventory/equipment/restore/<%= item.id %>" method="POST" class="d-inline" data-confirm="Remettre cet équipement en service (disponible au prêt) ?">
                        <button type="submit" class="btn btn-outline-success btn-sm" title="Remettre en service (disponible)" aria-label="Remettre en service <%= item.name %>">
                          <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                        </button>
                      </form>
                      <% } %>
                      <button
                        type="button"
                        class="btn btn-outline-primary btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#editModal"
                        data-id="<%= item.id %>"
                        data-name="<%= item.name %>"
                        data-workspace-id="<%= item.workspaceId || '' %>"
                        title="Modifier"
                        aria-label="Modifier <%= item.name %>"
                      >
                        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                      </button>
                      <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/equipment/delete/<%= item.id %>" class="d-inline" data-confirm="Êtes-vous sûr de vouloir supprimer cet équipement (<%= item.name %>) ?">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Supprimer" aria-label="Supprimer <%= item.name %>">
                          <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Modale de modification -->
      <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="editModalLabel">
                <i class="fa-solid fa-pen-to-square text-primary me-1" aria-hidden="true"></i> Modifier l'équipement
              </h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/equipment/update" method="post">
              <div class="modal-body">
                <input type="hidden" id="edit-id" name="id" />
                <div class="mb-3">
                  <label for="edit-name" class="form-label small fw-semibold">Nom de l'équipement</label>
                  <div class="input-group">
                    <span class="input-group-text bg-body-tertiary">
                      <i class="fa-solid fa-toolbox text-muted" aria-hidden="true"></i>
                    </span>
                    <input type="text" class="form-control" id="edit-name" name="name" required autocomplete="off" />
                  </div>
                </div>
                <div class="mb-0">
                  <label for="edit-workspaceId" class="form-label small fw-semibold">Espace / Atelier associé</label>
                  <div class="input-group">
                    <span class="input-group-text bg-body-tertiary">
                      <i class="fa-solid fa-cube text-muted" aria-hidden="true"></i>
                    </span>
                    <select class="form-select" id="edit-workspaceId" name="workspaceId">
                      <option value="">-- Aucun espace / Partagé --</option>
                      <% workspaces.forEach(function(ws) { %>
                        <option value="<%= ws.id %>"><%= ws.name %></option>
                      <% }); %>
                    </select>
                  </div>
                </div>
              </div>
              <div class="modal-footer bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary btn-sm">
                  <i class="fa-solid fa-check me-1" aria-hidden="true"></i> Enregistrer
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <%- include('../includes/footer.html') %>

    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
      const editModal = document.getElementById('editModal');
      if (editModal) {
        editModal.addEventListener('show.bs.modal', function(event) {
          const button = event.relatedTarget;
          const id = button.getAttribute('data-id');
          const name = button.getAttribute('data-name');
          const workspaceId = button.getAttribute('data-workspace-id');

          document.getElementById('edit-id').value = id;
          document.getElementById('edit-name').value = name;
          document.getElementById('edit-workspaceId').value = workspaceId || '';
        });
      }
    </script>
  </body>
</html>
