<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Gestion des outils et équipements empruntables" />
    <meta name="author" content="FabtrackJS" />
    <title>Manage Equipment - FabtrackJS</title>

    <%- include('../includes/pagehead.html') %>
  </head>

  <body class="d-flex justify-content-center bg-body-tertiary py-4">
    <%- include('../includes/light-dark.html') %>

    <main class="main-container">
      <%- include('../includes/header.html') %>

      <!-- Page Header -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-box bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.25rem;">
              <i class="fa-solid fa-toolbox"></i>
            </div>
            <div>
              <div class="d-flex align-items-center gap-2">
                <h4 class="fw-bold mb-0">Outils & Équipements</h4>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" style="font-size: 0.72rem;">
                  <%= equipment.length %> outil(s)
                </span>
              </div>
              <p class="text-muted small mb-0">Gestion du matériel empruntable et association par espace de travail</p>
            </div>
          </div>
          <div class="d-flex align-items-center gap-2">
            <a href="/admin/inventory/movements?itemType=EQUIPMENT" class="btn btn-outline-warning btn-sm rounded-pill px-3">
              <i class="fa-solid fa-clock-rotate-left me-1"></i> Historique sorties & casses
            </a>
            <button
              type="button"
              class="btn btn-warning btn-sm rounded-pill px-3 shadow-sm fw-semibold"
              data-bs-toggle="modal"
              data-bs-target="#modalInventoryCheckout"
              data-item-type="EQUIPMENT"
            >
              <i class="fa-solid fa-arrow-up-from-bracket me-1"></i> Sortie de matériel
            </button>
            <a href="/admin" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
              <i class="fa-solid fa-arrow-left me-1"></i> Retour panneau admin
            </a>
          </div>
        </div>
      </div>

      <!-- KPI Stats & Résumé des emprunts -->
      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <div class="card border-0 shadow-sm rounded-3 p-3">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <p class="text-muted small mb-1">Outils & Matériels au catalogue</p>
                <h4 class="fw-bold mb-0 text-body"><%= equipment.length %></h4>
              </div>
              <div class="icon-box bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 1.25rem;">
                <i class="fa-solid fa-toolbox"></i>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card border-0 shadow-sm rounded-3 p-3">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <p class="text-muted small mb-1">Objets en cours d'emprunt</p>
                <h4 class="fw-bold mb-0 <%= (typeof activeLoans !== 'undefined' && activeLoans.length > 0) ? 'text-warning' : 'text-body' %>">
                  <%= typeof activeLoans !== 'undefined' ? activeLoans.length : 0 %>
                </h4>
              </div>
              <div class="icon-box bg-warning-subtle text-warning-emphasis rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 1.25rem;">
                <i class="fa-solid fa-handshake-angle"></i>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <% const overdueCount = (typeof activeLoans !== 'undefined') ? activeLoans.filter(l => l.isOverdue).length : 0; %>
          <div class="card border-0 shadow-sm rounded-3 p-3 <%= overdueCount > 0 ? 'border-start border-danger border-4' : '' %>">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <p class="text-muted small mb-1">Emprunts en retard</p>
                <h4 class="fw-bold mb-0 <%= overdueCount > 0 ? 'text-danger' : 'text-success' %>">
                  <%= overdueCount %>
                </h4>
              </div>
              <div class="icon-box <%= overdueCount > 0 ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success' %> rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; font-size: 1.25rem;">
                <i class="fa-solid <%= overdueCount > 0 ? 'fa-triangle-exclamation' : 'fa-circle-check' %>"></i>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section : Objets en cours d'emprunt (Supervision Admin) -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent py-3 px-4 d-flex align-items-center justify-content-between border-0">
          <div class="d-flex align-items-center gap-2">
            <div class="icon-box bg-warning-subtle text-warning-emphasis rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 1rem;">
              <i class="fa-solid fa-clock-rotate-left"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0 text-body">
                Objets actuellement en cours d'emprunt
              </h5>
              <span class="text-muted small">Liste de tous les matériels sortis et usagers responsables</span>
            </div>
          </div>
          <% if (typeof activeLoans !== 'undefined' && activeLoans.length > 0) { %>
            <span class="badge bg-warning text-dark border border-warning-subtle rounded-pill px-3 py-1">
              <%= activeLoans.length %> emprunt(s) actif(s)
            </span>
          <% } %>
        </div>
        <div class="card-body p-0">
          <% if (typeof activeLoans === 'undefined' || activeLoans.length === 0) { %>
            <div class="text-center py-4 text-muted">
              <i class="fa-solid fa-circle-check text-success fa-2x mb-2 d-block opacity-75"></i>
              <p class="mb-0 fw-medium">Aucun équipement n'est actuellement en cours d'emprunt.</p>
              <span class="small text-secondary">Tout le matériel répertorié est actuellement disponible au lab.</span>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th scope="col" class="ps-4">Équipement / Outil</th>
                    <th scope="col">Emprunté par</th>
                    <th scope="col">Espace</th>
                    <th scope="col">Date d'emprunt</th>
                    <th scope="col">Durée convenue</th>
                    <th scope="col">Date limite de retour</th>
                    <th scope="col" class="text-center">Statut</th>
                    <th scope="col" class="text-end pe-4">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% activeLoans.forEach(function(loan) { %>
                  <tr class="<%= loan.isOverdue ? 'table-danger-subtle' : '' %>">
                    <td class="ps-4">
                      <div class="d-flex align-items-center">
                        <div class="icon-box bg-secondary-subtle text-secondary me-2 p-2 rounded-circle" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                          <i class="fa-solid fa-toolbox fa-sm"></i>
                        </div>
                        <div>
                          <span class="fw-semibold text-body">
                            <%= loan.equipment ? loan.equipment.name : ('Équipement #' + loan.id) %>
                          </span>
                        </div>
                      </div>
                    </td>
                    <td>
                      <% if (loan.user) { %>
                        <a href="/users/edit/<%= loan.user.id %>" class="fw-semibold text-decoration-none d-block">
                          <i class="fa-solid fa-user me-1 text-primary"></i><%= loan.user.name %> <%= loan.user.surname %>
                        </a>
                        <span class="text-muted small"><%= loan.user.email %></span>
                      <% } else { %>
                        <span class="text-muted small">Usager inconnu</span>
                      <% } %>
                    </td>
                    <td>
                      <span class="badge bg-body-secondary text-secondary border rounded-pill">
                        <%= loan.workspace %>
                      </span>
                    </td>
                    <td>
                      <span class="small text-body"><%= loan.formattedDate %></span>
                    </td>
                    <td>
                      <span class="badge bg-light text-dark border">
                        <i class="fa-regular fa-clock me-1 text-muted"></i><%= loan.borrowDurationDays ? loan.borrowDurationDays + ' jour(s)' : '-' %>
                      </span>
                    </td>
                    <td>
                      <strong class="small"><%= loan.formattedExpectedReturn %></strong>
                    </td>
                    <td class="text-center">
                      <% if (loan.isOverdue) { %>
                        <span class="badge bg-danger text-white rounded-pill px-2 py-1 shadow-sm">
                          <i class="fa-solid fa-triangle-exclamation me-1"></i>En retard (<%= Math.abs(loan.daysDiff) %> j)
                        </span>
                      <% } else if (loan.daysDiff !== null) { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                          <i class="fa-solid fa-check me-1"></i>Reste <%= loan.daysDiff %> j
                        </span>
                      <% } else { %>
                        <span class="badge bg-info-subtle text-info rounded-pill px-2 py-1">En cours</span>
                      <% } %>
                    </td>
                    <td class="text-end pe-4">
                      <form action="/admin/equipment/return/<%= loan.id %>" method="post" class="d-inline" onsubmit="return confirm('Confirmer la restitution de cet équipement ?');">
                        <button type="submit" class="btn btn-sm btn-success rounded-circle shadow-sm" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;" data-bs-toggle="tooltip" data-bs-placement="top" title="Restituer l'équipement" aria-label="Restituer">
                          <i class="fa-solid fa-rotate-left"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Formulaire d'ajout rapide -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
          <h6 class="fw-bold mb-2">
            <i class="fa-solid fa-plus text-success me-1"></i> Ajouter un équipement / outil
          </h6>
          <form action="/admin/equipment/create" method="post" class="row g-2 align-items-center">
            <div class="col-md-5 col-sm-6">
              <div class="input-group">
                <span class="input-group-text bg-body-secondary">
                  <i class="fa-solid fa-wrench text-muted"></i>
                </span>
                <input
                  type="text"
                  class="form-control"
                  id="name"
                  name="name"
                  placeholder="Nom de l'outil (ex: Dremel, Multimètre...)"
                  required
                  autocomplete="off"
                />
              </div>
            </div>
            <div class="col-md-4 col-sm-6">
              <div class="input-group">
                <span class="input-group-text bg-body-secondary">
                  <i class="fa-solid fa-cube text-muted"></i>
                </span>
                <select class="form-select" id="workspaceId" name="workspaceId">
                  <option value="">-- Aucun espace / Partagé --</option>
                  <% workspaces.forEach(function(ws) { %>
                    <option value="<%= ws.id %>"><%= ws.name %></option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="col-md-3 col-sm-12">
              <button type="submit" class="btn btn-primary w-100 rounded-pill">
                <i class="fa-solid fa-plus me-1"></i> Ajouter l'outil
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Tableau des équipements -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th onclick="sortTable(0)" scope="col" class="ps-3" style="cursor: pointer; width: 70px;">
                    # <i class="fa-solid fa-sort fa-xs text-muted"></i>
                  </th>
                  <th onclick="sortTable(1)" scope="col" style="cursor: pointer;">
                    Nom de l'équipement <i class="fa-solid fa-sort fa-xs text-muted"></i>
                  </th>
                  <th onclick="sortTable(2)" scope="col" style="cursor: pointer; width: 220px;">
                    Espace / Atelier <i class="fa-solid fa-sort fa-xs text-muted"></i>
                  </th>
                  <th onclick="sortTable(3)" scope="col" class="text-center" style="cursor: pointer; width: 150px;">
                    Emprunts enregistrés <i class="fa-solid fa-sort fa-xs text-muted"></i>
                  </th>
                  <th scope="col" class="text-center" style="width: 140px;">Statut</th>
                  <th scope="col" class="text-end pe-3" style="width: 150px;">Actions</th>
                </tr>
              </thead>
              <tbody id="table-content">
                <% if (equipment.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center py-4 text-muted">
                    <i class="fa-solid fa-inbox fa-2x mb-2 d-block opacity-50"></i>
                    Aucun outil ou équipement enregistré pour le moment.
                  </td>
                </tr>
                <% } else { %>
                <% equipment.forEach(function(item) { %>
                <tr>
                  <td scope="row" class="ps-3 text-muted">#<%= item.id %></td>
                  <td>
                    <div class="d-flex align-items-center">
                      <div class="icon-box bg-secondary-subtle text-secondary me-2 p-2 rounded-circle" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="fa-solid fa-toolbox fa-sm"></i>
                      </div>
                      <span class="fw-semibold text-body"><%= item.name %></span>
                      <% if (item.isCurrentlyBorrowed) { %>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill ms-2 small" data-bs-toggle="tooltip" title="Emprunté par : <%= item.currentBorrowers.join(', ') %>">
                          <i class="fa-solid fa-clock me-1"></i>En prêt
                        </span>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <% if (item.workspace) { %>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1">
                        <i class="fa-solid fa-cube me-1"></i> <%= item.workspace.name %>
                      </span>
                    <% } else { %>
                      <span class="badge bg-body-secondary text-secondary border rounded-pill px-2 py-1">
                        <i class="fa-solid fa-share-nodes me-1"></i> Partagé / Non assigné
                      </span>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <% if (item.borrowCount > 0) { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                        <i class="fa-solid fa-handshake-angle me-1"></i> <%= item.borrowCount %> emprunt(s)
                      </span>
                    <% } else { %>
                      <span class="badge bg-body-secondary text-muted border rounded-pill px-2 py-1">
                        0 emprunt
                      </span>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <% if (item.status === 'OUT_OF_SERVICE') { %>
                      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1" data-bs-toggle="tooltip" title="<%= item.decommissionReason || 'Hors service / En panne' %>">
                        <i class="fa-solid fa-screwdriver-wrench me-1"></i> Hors service
                      </span>
                    <% } else if (item.status === 'DECOMMISSIONED') { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1" data-bs-toggle="tooltip" title="<%= item.decommissionReason || 'Mis au rebut' %>">
                        <i class="fa-solid fa-trash-can me-1"></i> Au rebut
                      </span>
                    <% } else { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                        <i class="fa-solid fa-circle-check me-1"></i> Disponible
                      </span>
                    <% } %>
                  </td>
                  <td class="text-end pe-3">
                    <div class="btn-group btn-group-sm">
                      <button
                        type="button"
                        class="btn btn-outline-warning"
                        data-bs-toggle="modal"
                        data-bs-target="#modalInventoryCheckout"
                        data-item-type="EQUIPMENT"
                        data-item-id="<%= item.id %>"
                        data-item-name="<%= item.name %>"
                        title="Sortie d'inventaire (casse, rebut, panne...)"
                      >
                        <i class="fa-solid fa-arrow-up-from-bracket"></i>
                      </button>
                      <% if (item.status === 'OUT_OF_SERVICE' || item.status === 'DECOMMISSIONED') { %>
                      <form action="/admin/inventory/equipment/restore/<%= item.id %>" method="POST" class="d-inline" onsubmit="return confirm('Remettre cet équipement en service (disponible au prêt) ?');">
                        <button type="submit" class="btn btn-outline-success" title="Remettre en service (disponible)">
                          <i class="fa-solid fa-rotate-left"></i>
                        </button>
                      </form>
                      <% } %>
                      <button
                        type="button"
                        class="btn btn-outline-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#editModal"
                        data-id="<%= item.id %>"
                        data-name="<%= item.name %>"
                        data-workspace-id="<%= item.workspaceId || '' %>"
                        title="Modifier"
                      >
                        <i class="fa-solid fa-pen-to-square"></i>
                      </button>
                      <a
                        href="/admin/equipment/delete/<%= item.id %>"
                        class="btn btn-outline-danger"
                        title="Supprimer"
                        onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet équipement (<%= item.name %>) ?');"
                      >
                        <i class="fa-solid fa-trash-can"></i>
                      </a>
                    </div>
                  </td>
                </tr>
                <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Modale de modification -->
      <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom">
              <h5 class="modal-title fw-bold" id="editModalLabel">
                <i class="fa-solid fa-pen-to-square text-primary me-2"></i>Modifier l'équipement
              </h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/equipment/update" method="post">
              <div class="modal-body">
                <input type="hidden" id="edit-id" name="id" />
                <div class="mb-3">
                  <label for="edit-name" class="form-label fw-semibold">Nom de l'équipement</label>
                  <div class="input-group">
                    <span class="input-group-text bg-body-secondary">
                      <i class="fa-solid fa-toolbox text-muted"></i>
                    </span>
                    <input type="text" class="form-control" id="edit-name" name="name" required autocomplete="off" />
                  </div>
                </div>
                <div class="mb-3">
                  <label for="edit-workspaceId" class="form-label fw-semibold">Espace / Atelier associé</label>
                  <div class="input-group">
                    <span class="input-group-text bg-body-secondary">
                      <i class="fa-solid fa-cube text-muted"></i>
                    </span>
                    <select class="form-select" id="edit-workspaceId" name="workspaceId">
                      <option value="">-- Aucun espace / Partagé --</option>
                      <% workspaces.forEach(function(ws) { %>
                        <option value="<%= ws.id %>"><%= ws.name %></option>
                      <% }); %>
                    </select>
                  </div>
                </div>
              </div>
              <div class="modal-footer border-top">
                <button type="button" class="btn btn-secondary rounded-pill btn-sm" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary rounded-pill btn-sm">
                  <i class="fa-solid fa-check me-1"></i> Enregistrer les modifications
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <%- include('../includes/footer.html') %>
    </main>

    <script src="/javascripts/table-sorting.js"></script>
    <script>
      const editModal = document.getElementById('editModal');
      if (editModal) {
        editModal.addEventListener('show.bs.modal', function(event) {
          const button = event.relatedTarget;
          const id = button.getAttribute('data-id');
          const name = button.getAttribute('data-name');
          const workspaceId = button.getAttribute('data-workspace-id');

          document.getElementById('edit-id').value = id;
          document.getElementById('edit-name').value = name;
          document.getElementById('edit-workspaceId').value = workspaceId || '';
        });
      }
    </script>
  </body>
</html>
