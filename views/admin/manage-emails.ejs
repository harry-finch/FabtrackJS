            <script>
                function scrollToAgreementTemplate() {
                    const target = document.getElementById("agreementTemplateCard");
                    if (target) {
                        target.scrollIntoView({ behavior: "smooth", block: "start" });
                        target.classList.add("border", "border-primary", "shadow");
                        setTimeout(() => {
                            target.classList.remove("border", "border-primary", "shadow");
                        }, 1800);
                        const subjectInput = document.getElementById("mail_user_agreement_subject");
                        if (subjectInput) {
                            subjectInput.focus();
                        }
                    }
                }

                function insertVar(tag) {
                    const textarea = document.getElementById("mail_user_agreement_body");
                    if (!textarea) return;
                    const start = textarea.selectionStart;
                    const end = textarea.selectionEnd;
                    const text = textarea.value;
                    textarea.value = text.substring(0, start) + tag + text.substring(end);
                    textarea.focus();
                    textarea.selectionStart = textarea.selectionEnd = start + tag.length;
                    updateLivePreview();
                }

                function updateLivePreview() {
                    const titleInput = document.getElementById("mail_user_agreement_title");
                    const bodyInput = document.getElementById("mail_user_agreement_body");
                    const ctaInput = document.getElementById("mail_user_agreement_cta_text");

                    const previewTitle = document.getElementById("previewAgreementTitle");
                    const previewBody = document.getElementById("previewAgreementBody");
                    const previewCta = document.getElementById("previewAgreementCta");

                    const sampleUser = {
                        name: "Camille",
                        surname: "Martin",
                        fullname: "Camille Martin",
                        email: "camille.martin@sorbonne-universite.fr",
                        lab_name: "<%= settings.platform_name || 'FabtrackJS' %>"
                    };

                    const replaceSample = (str) => {
                        if (!str) return "";
                        return str
                            .replace(/\{name\}|\{\{name\}\}/gi, sampleUser.name)
                            .replace(/\{surname\}|\{\{surname\}\}/gi, sampleUser.surname)
                            .replace(/\{fullname\}|\{\{fullname\}\}/gi, sampleUser.fullname)
                            .replace(/\{email\}|\{\{email\}\}/gi, sampleUser.email)
                            .replace(/\{lab_name\}|\{\{lab_name\}\}/gi, sampleUser.lab_name)
                            .replace(/\{link\}|\{\{link\}\}/gi, "https://fablab.example.org/agreement/sample-token-123");
                    };

                    if (previewTitle && titleInput) {
                        previewTitle.textContent = replaceSample(titleInput.value) || "Validation de la charte d'utilisation du Fablab";
                    }

                    if (previewBody && bodyInput) {
                        const raw = bodyInput.value || "";
                        const formatted = replaceSample(raw)
                            .split("\n\n")
                            .map(p => `<p class="mb-2">${p.replace(/\n/g, "<br>")}</p>`)
                            .join("");
                        previewBody.innerHTML = formatted;
                    }

                    if (previewCta && ctaInput) {
                        previewCta.textContent = replaceSample(ctaInput.value) || "Signer la charte d'utilisation";
                    }
                }

                document.addEventListener("DOMContentLoaded", () => {
                    const titleInput = document.getElementById("mail_user_agreement_title");
                    const bodyInput = document.getElementById("mail_user_agreement_body");
                    const ctaInput = document.getElementById("mail_user_agreement_cta_text");

                    if (titleInput) titleInput.addEventListener("input", updateLivePreview);
                    if (bodyInput) bodyInput.addEventListener("input", updateLivePreview);
                    if (ctaInput) ctaInput.addEventListener("input", updateLivePreview);

                    updateLivePreview();
                });
            </script>

