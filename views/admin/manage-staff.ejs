<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Gestion des comptes staff et médiateurs du fablab" />
        <meta name="author" content="Stéphane Muller" />
        <title>Comptes staff &amp; médiateurs • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Page Header -->
            <div class="fab-page-header">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h1 class="fab-page-title">Comptes staff &amp; médiateurs</h1>
                        <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
                            <%= users.length %> compte<%= users.length > 1 ? 's' : '' %>
                        </span>
                    </div>
                    <p class="fab-page-subtitle">Gestion des droits et comptes de l'équipe du fablab</p>
                </div>
            </div>

            <div class="card border mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th data-sort="0" scope="col" class="ps-3">#</th>
                                    <th data-sort="1" scope="col">Nom d'utilisateur</th>
                                    <th data-sort="2" scope="col">E-mail</th>
                                    <th data-sort="3" scope="col" class="text-center">Rôle</th>
                                    <th scope="col" class="text-center">Statut</th>
                                    <th scope="col" class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="table-content">
                                <% if (!users || users.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-5">
                                        <i class="fa-solid fa-users-gear fs-4 d-block mb-2 opacity-50" aria-hidden="true"></i>
                                        Aucun compte staff enregistré pour le moment.
                                    </td>
                                </tr>
                                <% } else { %>
                                <% users.forEach(function(user) { %>
                                <tr>
                                    <td scope="row" class="ps-3 text-muted tabular-nums">#<%= user.id %></td>
                                    <td class="fw-semibold"><%= user.name %></td>
                                    <td><a href="mailto:<%= user.email %>" class="text-decoration-none"><%= user.email %></a></td>
                                    <td class="text-center">
                                        <% if (user.role == "admin") { %>
                                        <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/staff/demote/<%= user.id %>" class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary px-2 py-0" title="Cliquer pour rétrograder en médiateur" aria-label="Rétrograder <%= user.name %> en médiateur">
                                                <i class="fa-solid fa-shield-halved me-1" aria-hidden="true"></i>Admin
                                            </button>
                                        </form>
                                        <% } else if (user.role == "staff") { %>
                                        <span class="badge bg-body-secondary text-secondary-emphasis border px-2 py-1">
                                            <i class="fa-solid fa-desktop me-1" aria-hidden="true"></i>Borne kiosque
                                        </span>
                                        <% } else { %>
                                        <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/staff/promote/<%= user.id %>" class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary px-2 py-0" title="Cliquer pour promouvoir administrateur" aria-label="Promouvoir <%= user.name %> administrateur">
                                                <i class="fa-solid fa-user-gear me-1" aria-hidden="true"></i>Médiateur
                                            </button>
                                        </form>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <% if (user.approved) { %>
                                        <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/staff/disable/<%= user.id %>" class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                                            <button type="submit" class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" title="Cliquer pour désactiver" aria-label="Désactiver le compte de <%= user.name %>" style="cursor: pointer;">
                                                <i class="fa-solid fa-check me-1" aria-hidden="true"></i>Actif
                                            </button>
                                        </form>
                                        <% } else { %>
                                        <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/staff/enable/<%= user.id %>" class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                                            <button type="submit" class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" title="Cliquer pour activer" aria-label="Activer le compte de <%= user.name %>" style="cursor: pointer;">
                                                <i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>Inactif
                                            </button>
                                        </form>
                                        <% } %>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="fab-row-actions">
                                            <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/staff/edit/<%= user.id %>" class="btn btn-outline-primary" title="Modifier" aria-label="Modifier le compte de <%= user.name %>">
                                                <i class="fa-solid fa-user-pen" aria-hidden="true"></i>
                                            </a>
                                            <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/staff/delete/<%= user.id %>" class="d-inline" data-confirm="Supprimer le compte staff de <%= user.name %> ?">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                                                <button type="submit" class="btn btn-outline-danger" title="Supprimer" aria-label="Supprimer le compte de <%= user.name %>">
                                                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <%- include('../includes/footer.html') %>
    </body>
</html>
