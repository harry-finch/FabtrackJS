<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Historique complet des visites au fablab" />
    <meta name="author" content="Stéphane Muller" />
    <title>Historique des visites • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

    <%- include('../includes/pagehead.html') %>
  </head>

  <body class="d-flex justify-content-center bg-body-tertiary py-4">
    <%- include('../includes/light-dark.html') %>

    <%
      const safeBaseUrl = typeof baseUrl !== 'undefined' ? baseUrl : '/';
      const safeHistory = Array.isArray(history) ? history : [];
      const safeWorkspaces = typeof availableWorkspaces !== 'undefined' && Array.isArray(availableWorkspaces) ? availableWorkspaces : [];
      const safeFilters = typeof filters !== 'undefined' && filters ? filters : { workspaceId: 'all', startDate: '', endDate: '', search: '' };
      const activeWsId = safeFilters.workspaceId ? String(safeFilters.workspaceId) : 'all';
      const safeTotalCount = typeof totalCount !== 'undefined' ? Number(totalCount) : safeHistory.length;
      const safeGrandTotalCount = typeof grandTotalCount !== 'undefined' ? Number(grandTotalCount) : safeTotalCount;
      const safeWorkspaceCountsMap = typeof workspaceCountsMap !== 'undefined' && workspaceCountsMap ? workspaceCountsMap : {};
      const safeCurrentPage = typeof currentPage !== 'undefined' ? Number(currentPage) : 1;
      const safeTotalPages = typeof totalPages !== 'undefined' ? Math.max(1, Number(totalPages)) : 1;
      const safeLimit = typeof limit !== 'undefined' ? Number(limit) : 50;

      function buildHistoryUrl(overrides) {
        const opts = overrides || {};
        const params = new URLSearchParams();
        const ws = opts.workspaceId !== undefined ? opts.workspaceId : activeWsId;
        const sd = opts.startDate !== undefined ? opts.startDate : (safeFilters.startDate || '');
        const ed = opts.endDate !== undefined ? opts.endDate : (safeFilters.endDate || '');
        const q = opts.search !== undefined ? opts.search : (safeFilters.search || '');
        const p = opts.page !== undefined ? opts.page : safeCurrentPage;
        const lim = opts.limit !== undefined ? opts.limit : safeLimit;

        if (ws && ws !== 'all') params.set('workspaceId', String(ws));
        if (sd) params.set('startDate', sd);
        if (ed) params.set('endDate', ed);
        if (q) params.set('search', q);
        if (lim) params.set('limit', String(lim));
        if (p) params.set('page', String(p));
        const qs = params.toString();
        return safeBaseUrl + 'admin/view-history' + (qs ? '?' + qs : '');
      }

      const pageWindow = [];
      const windowRadius = 2;
      for (let p = 1; p <= safeTotalPages; p++) {
        if (
          p === 1 ||
          p === safeTotalPages ||
          (p >= safeCurrentPage - windowRadius && p <= safeCurrentPage + windowRadius)
        ) {
          pageWindow.push(p);
        }
      }
      const hasActiveFilters = Boolean(
        (activeWsId && activeWsId !== 'all') ||
        safeFilters.startDate ||
        safeFilters.endDate ||
        safeFilters.search
      );
    %>

    <main class="main-container">
      <%- include('../includes/header.html') %>

      <!-- Page Header -->
      <div class="fab-page-header">
        <div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <h1 class="fab-page-title">Historique des visites</h1>
            <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums" id="historyCounter">
              <%= safeTotalCount %> enregistrements
            </span>
            <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
              Page <%= safeCurrentPage %> / <%= safeTotalPages %>
            </span>
          </div>
          <p class="fab-page-subtitle">Journal chronologique des entrées, sorties et sessions au Fablab</p>
        </div>
        <div class="fab-page-actions">
          <a href="<%= safeBaseUrl %>admin/history/import" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-file-import me-1" aria-hidden="true"></i> Importer un enseignement (CSV)
          </a>
        </div>
      </div>

      <!-- Filter Controls -->
      <div class="fab-filter-bar">
        <div class="row g-3 align-items-center">
          <!-- Workspace filters -->
          <div class="col-12">
            <div class="d-flex flex-wrap gap-1 align-items-center">
              <span class="small fw-semibold text-muted me-1"><i class="fa-solid fa-building me-1" aria-hidden="true"></i>Espace :</span>
              <a
                href="<%= buildHistoryUrl({ workspaceId: 'all', page: 1 }) %>"
                class="btn btn-sm btn-outline-secondary <%= activeWsId === 'all' ? 'active' : '' %>"
              >
                Tous (<%= safeGrandTotalCount %>)
              </a>
              <% safeWorkspaces.forEach(function(ws) {
                   const count = safeWorkspaceCountsMap[ws.id] || 0;
                   const isActiveWs = activeWsId === String(ws.id);
              %>
                <a
                  href="<%= buildHistoryUrl({ workspaceId: String(ws.id), page: 1 }) %>"
                  class="btn btn-sm btn-outline-secondary <%= isActiveWs ? 'active' : '' %>"
                >
                  <%= ws.name %> (<%= count %>)
                </a>
              <% }); %>
            </div>
          </div>

          <!-- Date range + Search form -->
          <div class="col-12">
            <form method="GET" action="<%= safeBaseUrl %>admin/view-history" class="row g-2 align-items-center">
              <% if (activeWsId && activeWsId !== 'all') { %>
                <input type="hidden" name="workspaceId" value="<%= activeWsId %>" />
              <% } %>
              <input type="hidden" name="limit" value="<%= safeLimit %>" />
              <div class="col-lg-5 col-md-6 col-sm-12">
                <div class="d-flex align-items-center gap-1">
                  <span class="small fw-semibold text-muted me-1 text-nowrap"><i class="fa-solid fa-calendar-days me-1" aria-hidden="true"></i>Période :</span>
                  <input
                    type="date"
                    id="historyStartDate"
                    name="startDate"
                    value="<%= safeFilters.startDate || '' %>"
                    class="form-control form-control-sm"
                    title="Date de début"
                    aria-label="Date de début"
                  />
                  <span class="text-muted small">à</span>
                  <input
                    type="date"
                    id="historyEndDate"
                    name="endDate"
                    value="<%= safeFilters.endDate || '' %>"
                    class="form-control form-control-sm"
                    title="Date de fin"
                    aria-label="Date de fin"
                  />
                </div>
              </div>

              <div class="col-lg-4 col-md-6 col-sm-12">
                <div class="input-group input-group-sm">
                  <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
                  <input
                    type="text"
                    id="historySearchInput"
                    name="search"
                    value="<%= safeFilters.search || '' %>"
                    class="form-control"
                    placeholder="Rechercher (nom, e-mail, commentaire, projet)..."
                    aria-label="Rechercher dans l'historique par nom, e-mail, commentaire ou projet"
                  />
                </div>
              </div>

              <div class="col-lg-3 col-md-12 d-flex gap-2 justify-content-lg-end">
                <button type="submit" class="btn btn-primary btn-sm">
                  <i class="fa-solid fa-filter me-1" aria-hidden="true"></i> Filtrer
                </button>
                <% if (hasActiveFilters) { %>
                  <a href="<%= safeBaseUrl %>admin/view-history" class="btn btn-outline-secondary btn-sm">
                    <i class="fa-solid fa-rotate-left me-1" aria-hidden="true"></i> Réinitialiser
                  </a>
                <% } %>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- History Table directly rendered -->
      <div class="card border mb-3">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="historyTable">
              <thead class="table-light">
                <tr>
                  <th scope="col" class="text-center">#</th>
                  <th scope="col"><%= typeof __ !== 'undefined' ? __('history.col_arrival') : 'Arrivée' %></th>
                  <th scope="col" class="text-center"><%= typeof __ !== 'undefined' ? __('history.col_departure') : 'Départ' %></th>
                  <th scope="col"><%= typeof __ !== 'undefined' ? __('history.col_user') : 'Contributeur' %></th>
                  <th scope="col"><%= typeof __ !== 'undefined' ? __('history.col_workspace') : 'Espace' %></th>
                  <th scope="col" class="text-center"><%= typeof __ !== 'undefined' ? __('history.col_project') : 'Projet' %></th>
                  <th scope="col" class="text-center"><%= typeof __ !== 'undefined' ? __('history.col_comments') : 'Commentaires' %></th>
                  <th scope="col" class="text-end pe-3"><%= typeof __ !== 'undefined' ? __('common.actions') : 'Actions' %></th>
                </tr>
              </thead>
              <tbody id="table-content">
                <% if (safeHistory.length === 0) { %>
                <tr id="emptyHistoryRow">
                  <td colspan="8" class="text-center text-muted py-4"><%= typeof __ !== 'undefined' ? __('history.no_records') : 'Aucun enregistrement trouvé dans l\'historique.' %></td>
                </tr>
                <% } else { %>
                  <% safeHistory.forEach(function(entry) { %>
                  <tr data-ws-id="<%= entry.workspaceId || '' %>" data-arrival="<%= entry.rawArrival || '' %>">
                    <td class="text-center"><%= entry.id %></td>
                    <td><strong><%= entry.arrival %></strong></td>
                    <td class="text-center">
                      <% if (entry.departure && entry.departure !== '-') { %>
                        <%= entry.departure %>
                      <% } else { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">En cours</span>
                      <% } %>
                    </td>
                    <td>
                      <a href="<%= safeBaseUrl %>users/edit/<%= entry.userId %>" class="fw-semibold text-decoration-none">
                        <%= entry.user ? (entry.user.name + ' ' + entry.user.surname) : 'Inconnu' %>
                      </a>
                    </td>
                    <td>
                      <% if (entry.workspace) { %>
                        <span class="badge bg-body-secondary text-secondary-emphasis border"><%= entry.workspace.name %></span>
                      <% } else { %>
                        <span class="text-muted small">-</span>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <%
                        const entryProjectObj = entry.userproject && entry.userproject.project ? entry.userproject.project : null;
                        const rawProjectLabel = entryProjectObj ? String(entryProjectObj.url || '').trim() : '';
                        const resolvedProjectTitle = entryProjectObj
                          ? (typeof resolveProjectTitle === 'function'
                              ? resolveProjectTitle(entryProjectObj)
                              : (entryProjectObj.customTitle || entryProjectObj.wikiTitle || rawProjectLabel))
                          : '';
                        const validProjectUrl = rawProjectLabel ? safeHttpUrl(rawProjectLabel) : null;
                        const isRepairProject = /repair|répar/i.test(rawProjectLabel);
                        const projectTooltip = resolvedProjectTitle && validProjectUrl && resolvedProjectTitle !== validProjectUrl
                          ? `${resolvedProjectTitle} — ${validProjectUrl}`
                          : (resolvedProjectTitle || validProjectUrl || rawProjectLabel);
                      %>
                      <% if (validProjectUrl) { %>
                        <a href="<%= validProjectUrl %>" target="_blank" rel="noopener noreferrer" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-custom-class="custom-tooltip" data-bs-title="<%= projectTooltip %>" title="<%= projectTooltip %>" aria-label="Documentation : <%= resolvedProjectTitle || validProjectUrl %>">
                          <i class="fa-solid fa-book" aria-hidden="true"></i>
                        </a>
                      <% } else if (resolvedProjectTitle || rawProjectLabel) { %>
                        <span class="d-inline-flex align-items-center justify-content-center text-secondary" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-custom-class="custom-tooltip" data-bs-title="<%= resolvedProjectTitle || rawProjectLabel %>" title="<%= resolvedProjectTitle || rawProjectLabel %>" aria-label="<%= resolvedProjectTitle || rawProjectLabel %>">
                          <i class="fa-solid <%= isRepairProject ? 'fa-screwdriver-wrench' : 'fa-folder-open' %>" aria-hidden="true"></i>
                        </span>
                      <% } else { %>
                        <span class="text-muted small">-</span>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <% if (entry.comments) { %>
                        <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-custom-class="custom-tooltip" data-bs-title="<%= entry.comments %>" aria-label="Commentaire : <%= entry.comments %>">
                          <i class="fa-solid fa-comment-dots text-primary" aria-hidden="true"></i>
                        </span>
                      <% } else { %>
                        <i class="fa-regular fa-comment text-muted" aria-hidden="true"></i>
                      <% } %>
                    </td>
                    <td class="text-end pe-3">
                      <div class="fab-row-actions">
                        <button
                          type="button"
                          class="btn btn-outline-primary btn-sm"
                          data-bs-toggle="modal"
                          data-bs-target="#editHistoryModal"
                          data-bs-id="<%= entry.id %>"
                          data-bs-comments="<%= entry.comments ? entry.comments.replace(/"/g, '&quot;') : '' %>"
                          data-bs-workspace="<%= entry.workspaceId || '' %>"
                          title="Modifier l'entrée"
                          aria-label="Modifier l'entrée #<%= entry.id %>"
                        >
                          <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                        </button>
                        <form method="POST" action="<%= safeBaseUrl %>history/delete/<%= entry.id %>" class="d-inline" data-confirm="Confirmez-vous la suppression de cette entrée d'historique ?">
                          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                          <button type="submit" class="btn btn-outline-danger btn-sm" title="Supprimer l'entrée" aria-label="Supprimer l'entrée #<%= entry.id %>">
                            <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Pagination Controls -->
      <nav aria-label="Pagination historique" class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <div class="small text-muted">
          Page <strong><%= safeCurrentPage %></strong> / <strong><%= safeTotalPages %></strong>
          — <strong><%= safeTotalCount %></strong> enregistrements
        </div>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= safeCurrentPage <= 1 ? 'disabled' : '' %>">
            <a
              class="page-link"
              href="<%= safeCurrentPage > 1 ? buildHistoryUrl({ page: safeCurrentPage - 1 }) : '#' %>"
              aria-label="Précédent"
            >
              &laquo; Précédent
            </a>
          </li>
          <% let prevPageNum = null; %>
          <% pageWindow.forEach(function(p) { %>
            <% if (prevPageNum !== null && p - prevPageNum > 1) { %>
              <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
            <% } %>
            <li class="page-item <%= p === safeCurrentPage ? 'active' : '' %>" <%= p === safeCurrentPage ? 'aria-current="page"' : '' %>>
              <a class="page-link" href="<%= buildHistoryUrl({ page: p }) %>"><%= p %></a>
            </li>
            <% prevPageNum = p; %>
          <% }); %>
          <li class="page-item <%= safeCurrentPage >= safeTotalPages ? 'disabled' : '' %>">
            <a
              class="page-link"
              href="<%= safeCurrentPage < safeTotalPages ? buildHistoryUrl({ page: safeCurrentPage + 1 }) : '#' %>"
              aria-label="Suivant"
            >
              Suivant &raquo;
            </a>
          </li>
        </ul>
      </nav>

      <!-- Modal for editing a history entry -->
      <div class="modal fade" id="editHistoryModal" tabindex="-1" aria-labelledby="editHistoryLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <form action="<%= safeBaseUrl %>history/update" method="post">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
              <input type="hidden" id="editHistoryId" name="historyid" />
              <div class="modal-header">
                <h5 class="modal-title" id="editHistoryLabel">
                  <i class="fa-solid fa-pen-to-square me-1 text-primary" aria-hidden="true"></i> Modifier l'entrée d'historique
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
              </div>
              <div class="modal-body">
                <div class="mb-3">
                  <label for="editWorkspaceId" class="form-label small fw-semibold">Espace</label>
                  <select class="form-select" id="editWorkspaceId" name="workspaceId">
                    <option value="">(Aucun espace)</option>
                    <% safeWorkspaces.forEach(function(ws) { %>
                      <option value="<%= ws.id %>"><%= ws.name %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="mb-0">
                  <label for="editComments" class="form-label small fw-semibold">Commentaires</label>
                  <textarea class="form-control" id="editComments" name="comments" rows="4"></textarea>
                </div>
              </div>
              <div class="modal-footer bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary btn-sm">Enregistrer</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <%- include('../includes/footer.html') %>

      <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
        // Edit History Modal pre-fill
        const editHistoryModal = document.getElementById('editHistoryModal');
        if (editHistoryModal) {
          editHistoryModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            if (!button) return;
            const id = button.getAttribute('data-bs-id');
            const comments = button.getAttribute('data-bs-comments') || '';
            const workspaceId = button.getAttribute('data-bs-workspace') || '';

            document.getElementById('editHistoryId').value = id;
            document.getElementById('editComments').value = comments;
            document.getElementById('editWorkspaceId').value = workspaceId;
          });
        }
      </script>
  </body>
</html>
