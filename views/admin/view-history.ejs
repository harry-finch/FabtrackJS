<!doctype html>
<html lang="en" data-bs-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="View entire lab user history" />
    <meta name="author" content="Stéphane Muller" />
    <title>Fabtrack - History</title>

    <%- include('../includes/pagehead.html') %>
    <script src="/javascripts/pagination.js"></script>
  </head>

  <body class="d-flex justify-content-center bg-body-tertiary py-4">
    <%- include('../includes/light-dark.html') %>

    <main class="main-container">
      <%- include('../includes/header.html') %>

      <!-- Page Header -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-box bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.25rem;">
              <i class="fa-solid fa-clock-rotate-left"></i>
            </div>
            <div>
              <div class="d-flex align-items-center gap-2">
                <h4 class="fw-bold mb-0">Historique des visites</h4>
                <span class="badge bg-secondary-subtle text-secondary-emphasis border rounded-pill" id="historyCounter" style="font-size: 0.72rem;">
                  <%= history.length %> enregistrements
                </span>
              </div>
              <p class="text-muted small mb-0">Journal chronologique des entrées, sorties et sessions au Fablab</p>
            </div>
          </div>
          <div class="d-flex align-items-center gap-2">
            <a href="/admin/history/import" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
              <i class="fa-solid fa-file-import me-1"></i> Importer un enseignement (CSV)
            </a>
            <a href="/admin" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
              <i class="fa-solid fa-arrow-left me-1"></i> Retour panneau admin
            </a>
          </div>
        </div>
      </div>

      <!-- Filter Controls -->
      <div class="card bg-body-secondary border-0 p-3 mb-3 shadow-sm">
        <div class="row g-3 align-items-center">
          <!-- Workspace filters -->
          <div class="col-lg-5 col-md-12">
            <div class="d-flex flex-wrap gap-1 align-items-center">
              <span class="small fw-semibold text-muted me-1"><i class="fa-solid fa-building"></i> Workspace:</span>
              <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill active filter-workspace-btn" data-ws-id="all">
                All (<%= history.length %>)
              </button>
              <% availableWorkspaces.forEach(function(ws) {
                   const count = history.filter(h => h.workspaceId === ws.id).length;
              %>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill filter-workspace-btn" data-ws-id="<%= ws.id %>">
                  <%= ws.name %> (<%= count %>)
                </button>
              <% }); %>
            </div>
          </div>

          <!-- Date range filter -->
          <div class="col-lg-4 col-md-7 col-sm-12">
            <div class="d-flex align-items-center gap-1">
              <span class="small fw-semibold text-muted me-1 text-nowrap"><i class="fa-solid fa-calendar-days"></i> Période :</span>
              <input type="date" id="historyStartDate" class="form-control form-control-sm" title="Date de début" />
              <span class="text-muted small">à</span>
              <input type="date" id="historyEndDate" class="form-control form-control-sm" title="Date de fin" />
              <button type="button" id="clearDateBtn" class="btn btn-sm btn-outline-secondary" title="Réinitialiser la période" style="display: none;">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>
          </div>

          <!-- Search filter -->
          <div class="col-lg-3 col-md-5 col-sm-12">
            <div class="input-group input-group-sm">
              <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
              <input type="text" id="historySearchInput" class="form-control" placeholder="Recherche..." />
            </div>
          </div>
        </div>
      </div>

      <!-- History Table directly rendered -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="historyTable">
              <thead class="table-light">
          <tr>
            <th scope="col" class="text-center">#</th>
            <th scope="col"><%= typeof __ !== 'undefined' ? __('history.col_arrival') : 'Arrivée' %></th>
            <th scope="col" class="text-center"><%= typeof __ !== 'undefined' ? __('history.col_departure') : 'Départ' %></th>
            <th scope="col"><%= typeof __ !== 'undefined' ? __('history.col_user') : 'Usager' %></th>
            <th scope="col"><%= typeof __ !== 'undefined' ? __('history.col_workspace') : 'Espace' %></th>
            <th scope="col" class="text-center"><%= typeof __ !== 'undefined' ? __('history.col_project') : 'Projet' %></th>
            <th scope="col" class="text-center"><%= typeof __ !== 'undefined' ? __('history.col_comments') : 'Commentaires' %></th>
            <th scope="col" class="text-center"><%= typeof __ !== 'undefined' ? __('history.col_edit') : 'Modifier' %></th>
            <th scope="col" class="text-center"><%= typeof __ !== 'undefined' ? __('history.col_delete') : 'Supprimer' %></th>
          </tr>
        </thead>
        <tbody id="table-content">
          <% if (history.length === 0) { %>
          <tr id="emptyHistoryRow">
            <td colspan="9" class="text-center text-muted py-4"><%= typeof __ !== 'undefined' ? __('history.no_records') : 'Aucun enregistrement trouvé dans l\'historique.' %></td>
          </tr>
          <% } else { %>
            <% history.forEach(function(entry) { %>
            <tr data-ws-id="<%= entry.workspaceId || '' %>" data-arrival="<%= entry.rawArrival || '' %>">
              <td class="text-center"><%= entry.id %></td>
              <td><strong><%= entry.arrival %></strong></td>
              <td class="text-center">
                <% if (entry.departure && entry.departure !== '-') { %>
                  <%= entry.departure %>
                <% } else { %>
                  <span class="badge bg-success">Active</span>
                <% } %>
              </td>
              <td>
                <a href="/users/edit/<%= entry.userId %>" class="fw-semibold">
                  <%= entry.user ? (entry.user.name + ' ' + entry.user.surname) : 'Unknown' %>
                </a>
              </td>
              <td>
                <% if (entry.workspace) { %>
                  <span class="badge bg-light text-dark border"><%= entry.workspace.name %></span>
                <% } else { %>
                  <span class="text-muted small">-</span>
                <% } %>
              </td>
              <td class="text-center">
                <% if (entry.userproject && entry.userproject.project) { %>
                  <a href="<%= entry.userproject.project.url %>" target="_blank" title="View Project">
                    <i class="fa-solid fa-book"></i>
                  </a>
                <% } else { %>
                  <span class="text-muted small">-</span>
                <% } %>
              </td>
              <td class="text-center">
                <% if (entry.comments) { %>
                  <span data-bs-toggle="tooltip" data-bs-placement="top" data-bs-custom-class="custom-tooltip" data-bs-title="<%= entry.comments %>">
                    <i class="fa-solid fa-comment-lines text-primary"></i>
                  </span>
                <% } else { %>
                  <i class="fa-regular fa-comment text-muted"></i>
                <% } %>
              </td>
              <td class="text-center">
                <a
                  href="#"
                  data-bs-toggle="modal"
                  data-bs-target="#editHistoryModal"
                  data-bs-id="<%= entry.id %>"
                  data-bs-comments="<%= entry.comments ? entry.comments.replace(/"/g, '&quot;') : '' %>"
                  data-bs-workspace="<%= entry.workspaceId || '' %>"
                  title="Edit Record"
                >
                  <i class="fa-solid fa-pen-to-square"></i>
                </a>
              </td>
              <td class="text-center">
                <a
                  href="/history/delete/<%= entry.id %>"
                  onclick="return confirm('Are you sure you want to delete this history record?')"
                  title="Delete Record"
                >
                  <i class="fa-solid fa-trash-can text-danger"></i>
                </a>
              </td>
            </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

      <!-- Modal for editing a history entry -->
      <div class="modal fade" id="editHistoryModal" tabindex="-1" aria-labelledby="editHistoryLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <form action="/history/update" method="post">
              <input type="hidden" id="editHistoryId" name="historyid" />
              <div class="modal-header">
                <h5 class="modal-title" id="editHistoryLabel">
                  <i class="fa-solid fa-pen-to-square"></i> Edit History Record
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                <div class="form-floating mb-3">
                  <select class="form-select" id="editWorkspaceId" name="workspaceId">
                    <option value="">(No Workspace)</option>
                    <% availableWorkspaces.forEach(function(ws) { %>
                      <option value="<%= ws.id %>"><%= ws.name %></option>
                    <% }); %>
                  </select>
                  <label for="editWorkspaceId">Workspace</label>
                </div>
                <div class="form-floating mb-3">
                  <textarea class="form-control" id="editComments" name="comments" style="height: 100px"></textarea>
                  <label for="editComments">Comments</label>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save changes</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <%- include('../includes/footer.html') %>

      <script>
        // Edit History Modal pre-fill
        const editHistoryModal = document.getElementById('editHistoryModal');
        if (editHistoryModal) {
          editHistoryModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            if (!button) return;
            const id = button.getAttribute('data-bs-id');
            const comments = button.getAttribute('data-bs-comments') || '';
            const workspaceId = button.getAttribute('data-bs-workspace') || '';

            document.getElementById('editHistoryId').value = id;
            document.getElementById('editComments').value = comments;
            document.getElementById('editWorkspaceId').value = workspaceId;
          });
        }

        // Filtering and search logic
        const wsButtons = document.querySelectorAll('.filter-workspace-btn');
        const searchInput = document.getElementById('historySearchInput');
        const startDateInput = document.getElementById('historyStartDate');
        const endDateInput = document.getElementById('historyEndDate');
        const clearDateBtn = document.getElementById('clearDateBtn');
        const rows = document.querySelectorAll('#table-content tr[data-ws-id]');
        const counter = document.getElementById('historyCounter');

        let activeWorkspace = 'all';
        let searchQuery = '';
        let startDate = '';
        let endDate = '';

        function applyFilters() {
          let visibleCount = 0;
          rows.forEach(row => {
            const rowWs = row.getAttribute('data-ws-id');
            const rowDate = row.getAttribute('data-arrival');
            const rowText = row.textContent.toLowerCase();

            const matchesWs = (activeWorkspace === 'all' || rowWs === activeWorkspace);
            const matchesSearch = (!searchQuery || rowText.includes(searchQuery));
            const matchesStartDate = (!startDate || (rowDate && rowDate >= startDate));
            const matchesEndDate = (!endDate || (rowDate && rowDate <= endDate));

            if (matchesWs && matchesSearch && matchesStartDate && matchesEndDate) {
              row.style.display = '';
              visibleCount++;
            } else {
              row.style.display = 'none';
            }
          });

          if (counter) {
            counter.textContent = `${visibleCount} records`;
          }
        }

        wsButtons.forEach(btn => {
          btn.addEventListener('click', function() {
            wsButtons.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            activeWorkspace = this.getAttribute('data-ws-id');
            applyFilters();
          });
        });

        if (searchInput) {
          searchInput.addEventListener('input', function() {
            searchQuery = this.value.trim().toLowerCase();
            applyFilters();
          });
        }

        function updateDateFilters() {
          startDate = startDateInput ? startDateInput.value : '';
          endDate = endDateInput ? endDateInput.value : '';
          if (clearDateBtn) {
            clearDateBtn.style.display = (startDate || endDate) ? '' : 'none';
          }
          applyFilters();
        }

        if (startDateInput) startDateInput.addEventListener('change', updateDateFilters);
        if (endDateInput) endDateInput.addEventListener('change', updateDateFilters);
        if (clearDateBtn) {
          clearDateBtn.addEventListener('click', function() {
            if (startDateInput) startDateInput.value = '';
            if (endDateInput) endDateInput.value = '';
            updateDateFilters();
          });
        }
      </script>
    </main>
  </body>
</html>
