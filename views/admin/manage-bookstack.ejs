<!doctype html>
<html lang="fr" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Wiki BookStack & Documentation - <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>
        <%- include('../includes/pagehead.html') %>
    </head>
    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Page Header -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.25rem;">
                            <i class="fa-solid fa-book"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h4 class="fw-bold mb-0">Wiki BookStack & Documentation</h4>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" style="font-size: 0.72rem;">Plugin</span>
                            </div>
                            <p class="text-muted small mb-0">Intégration du wiki Sorbonne Université, suivi de fraîcheur documentaire et clés API</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="/admin" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            <i class="fa-solid fa-arrow-left me-1"></i> Retour panneau admin
                        </a>
                    </div>
                </div>
            </div>

            <!-- Notification banner -->
            <% if (typeof notification !== 'undefined' && notification) { 
                const isError = notification.toLowerCase().includes('error');
                const isSuccess = notification.toLowerCase().includes('success');
            %>
            <div class="alert <%= isError ? 'alert-danger' : isSuccess ? 'alert-success' : 'alert-info' %> alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid <%= isError ? 'fa-triangle-exclamation' : isSuccess ? 'fa-circle-check' : 'fa-circle-info' %>"></i>
                    <div><%= notification.replace(/^(Success:|Error:|Warning:)\s*/i, '') %></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

            <!-- SECTION 1: KPI Cards - Documentation Freshness Metrics -->
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-4">
                <!-- KPI 1: % Up to date -->
                <div class="col">
                    <div class="card border-0 shadow-sm h-100 p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Documentation à jour</span>
                            <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                <i class="fa-solid fa-percent fa-sm"></i>
                            </div>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            <span class="fs-2 fw-bold <%= stats.upToDatePercentage >= 70 ? 'text-success' : stats.upToDatePercentage >= 40 ? 'text-warning-emphasis' : 'text-danger' %>">
                                <%= stats.upToDatePercentage %>%
                            </span>
                            <span class="text-muted small">des projets évalués</span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar <%= stats.upToDatePercentage >= 70 ? 'bg-success' : stats.upToDatePercentage >= 40 ? 'bg-warning' : 'bg-danger' %>" role="progressbar" style="width: <%= stats.upToDatePercentage %>%;" aria-valuenow="<%= stats.upToDatePercentage %>" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>

                <!-- KPI 2: Up to date count -->
                <div class="col">
                    <div class="card border-0 shadow-sm h-100 p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Doc. Synchronisée</span>
                            <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                <i class="fa-solid fa-circle-check fa-sm"></i>
                            </div>
                        </div>
                        <div class="fs-2 fw-bold text-success mb-1"><%= stats.upToDateCount %></div>
                        <small class="text-muted">Modifiés depuis le dernier passage</small>
                    </div>
                </div>

                <!-- KPI 3: Outdated count -->
                <div class="col">
                    <div class="card border-0 shadow-sm h-100 p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Doc. En retard</span>
                            <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                <i class="fa-solid fa-triangle-exclamation fa-sm"></i>
                            </div>
                        </div>
                        <div class="fs-2 fw-bold text-danger mb-1"><%= stats.outdatedCount %></div>
                        <small class="text-muted">Non modifiés depuis la dernière visite</small>
                    </div>
                </div>

                <!-- KPI 4: Total wiki projects -->
                <div class="col">
                    <div class="card border-0 shadow-sm h-100 p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Projets Wiki Liés</span>
                            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                <i class="fa-solid fa-book-bookmark fa-sm"></i>
                            </div>
                        </div>
                        <div class="fs-2 fw-bold text-body mb-1"><%= stats.totalWiki %></div>
                        <small class="text-muted">sur <%= stats.totalActiveProjects %> projets actifs enregistrés</small>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: Plugin & API Configuration Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-body border-0 pt-4 px-4 pb-2">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-2.5 py-1">
                                <i class="fa-solid fa-key me-1"></i> Configuration API
                            </span>
                            <h5 class="fw-bold mb-0">Paramètres du Wiki BookStack</h5>
                        </div>
                        <form action="/admin/bookstack/test" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm">
                                <i class="fa-solid fa-plug-circle-check me-1"></i> Tester la connexion API
                            </button>
                        </form>
                    </div>
                    <p class="text-muted small mt-1 mb-0">Identifiants d'accès à l'API REST de BookStack et préférences de saisie</p>
                </div>
                <div class="card-body p-4">
                    <form action="/admin/bookstack/settings" method="POST">
                        <div class="row g-3">
                            <!-- Toggle Plugin Enabled -->
                            <div class="col-12 col-md-6">
                                <div class="p-3 bg-body-tertiary rounded-3 border h-100 d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="fw-semibold small">Activer le plugin BookStack</div>
                                        <small class="text-muted">Active la vérification de fraîcheur documentaire et le statut dynamique (vert/rouge)</small>
                                    </div>
                                    <div class="form-check form-switch fs-5 mb-0 ms-3">
                                        <input class="form-check-input" type="checkbox" role="switch" id="plugin_bookstack_enabled" name="plugin_bookstack_enabled" value="true" <%= settings.plugin_bookstack_enabled !== 'false' ? 'checked' : '' %>>
                                    </div>
                                </div>
                            </div>

                            <!-- Toggle Auto Prefill -->
                            <div class="col-12 col-md-6">
                                <div class="p-3 bg-body-tertiary rounded-3 border h-100 d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="fw-semibold small">Pré-remplissage automatique de l'adresse</div>
                                        <small class="text-muted">Pré-remplit le champ documentation avec l'URL de base du wiki lors de la création d'un projet</small>
                                    </div>
                                    <div class="form-check form-switch fs-5 mb-0 ms-3">
                                        <input class="form-check-input" type="checkbox" role="switch" id="bookstack_auto_prefill" name="bookstack_auto_prefill" value="true" <%= settings.bookstack_auto_prefill !== 'false' ? 'checked' : '' %>>
                                    </div>
                                </div>
                            </div>

                            <!-- BookStack Base URL -->
                            <div class="col-12">
                                <label for="bookstack_url" class="form-label fw-semibold small">
                                    <i class="fa-solid fa-globe me-1 text-primary"></i> Adresse de base du Wiki BookStack
                                </label>
                                <input type="url" class="form-control" id="bookstack_url" name="bookstack_url" value="<%= settings.bookstack_url || 'https://wiki.fablab.sorbonne-universite.fr/BookStack/' %>" placeholder="https://wiki.fablab.sorbonne-universite.fr/BookStack/" required>
                                <div class="form-text small">URL racine de votre instance BookStack. Le préfixe <code>api/</code> sera automatiquement utilisé pour les requêtes REST.</div>
                            </div>

                            <!-- Token ID -->
                            <div class="col-12 col-md-6">
                                <label for="bookstack_token_id" class="form-label fw-semibold small">
                                    <i class="fa-solid fa-id-badge me-1 text-secondary"></i> Token ID (Identifiant de jeton API)
                                </label>
                                <input type="text" class="form-control font-monospace" id="bookstack_token_id" name="bookstack_token_id" value="<%= settings.bookstack_token_id || '' %>" placeholder="ex: aBcDeFgHiJkLmNoPqRsTuVwXyZ123456" autocomplete="off">
                                <div class="form-text small">Généré depuis votre profil BookStack dans <em>Modifier le profil &gt; Jetons d'API</em>.</div>
                            </div>

                            <!-- Token Secret -->
                            <div class="col-12 col-md-6">
                                <label for="bookstack_token_secret" class="form-label fw-semibold small">
                                    <i class="fa-solid fa-key me-1 text-secondary"></i> Token Secret (Clé secrète de jeton API)
                                </label>
                                <input type="password" class="form-control font-monospace" id="bookstack_token_secret" name="bookstack_token_secret" placeholder="<%= hasTokenSecret ? '•••••••••••••••••••••••• (inchangé)' : 'Saisir le secret API' %>" autocomplete="new-password">
                                <div class="form-text small"><%= hasTokenSecret ? 'Un secret API est déjà enregistré. Laissez vide pour ne pas le modifier.' : 'Le secret fourni par BookStack lors de la création du jeton.' %></div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Enregistrer les paramètres
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- SECTION 3: Projects Table with Documentation Freshness Status -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-body border-0 pt-4 px-4 pb-2">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1">
                                <i class="fa-solid fa-table-list me-1"></i> Projets Référencés
                            </span>
                            <h5 class="fw-bold mb-0">État de mise à jour des documentations</h5>
                        </div>
                        <span class="badge bg-body-secondary text-body-secondary border rounded-pill">
                            <%= stats.projects.length %> projet(s) wiki
                        </span>
                    </div>
                    <p class="text-muted small mt-1 mb-0">Comparaison entre la dernière modification sur le wiki et la date du dernier passage de l'usager au Fablab</p>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Projet & URL</th>
                                    <th>Typologie</th>
                                    <th>Usager principal</th>
                                    <th>Dernière visite au lab</th>
                                    <th>Dernière modif wiki</th>
                                    <th class="text-center pe-4">Statut documentaire</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (stats.projects.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-book-open fa-2x mb-3 text-secondary opacity-50 d-block"></i>
                                        Aucun projet actif référençant le wiki BookStack n'a été trouvé.
                                    </td>
                                </tr>
                                <% } else { %>
                                    <% stats.projects.forEach(function(proj) { 
                                        const isUp = proj.status === 'up_to_date';
                                        const isOutdated = proj.status === 'outdated';
                                        const isNotFound = proj.status === 'not_found';
                                    %>
                                    <tr>
                                        <td class="ps-4" style="max-width: 320px;">
                                            <div class="fw-bold text-truncate" title="<%= proj.docTitle || proj.url %>">
                                                <%= proj.docTitle || proj.url.replace(/^https?:\/\/[^/]+\/[^/]+\/?/i, '') || proj.url %>
                                            </div>
                                            <a href="<%= proj.url %>" target="_blank" class="small text-muted text-decoration-none text-truncate d-inline-block" style="max-width: 280px;">
                                                <i class="fa-solid fa-arrow-up-right-from-square fa-xs me-1"></i><%= proj.url %>
                                            </a>
                                        </td>
                                        <td>
                                            <span class="badge bg-body-secondary text-body-secondary border rounded-pill">
                                                <%= proj.projectType %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="small fw-semibold"><%= proj.userFullName %></span>
                                            <% if (proj.userCount > 1) { %>
                                                <span class="badge bg-secondary-subtle text-secondary rounded-pill ms-1">+<%= proj.userCount - 1 %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (proj.lastVisitDate) { %>
                                                <div class="small fw-semibold"><%= new Date(proj.lastVisitDate).toLocaleDateString('fr-FR') %></div>
                                                <small class="text-muted"><%= new Date(proj.lastVisitDate).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %></small>
                                            <% } else { %>
                                                <span class="text-muted small fst-italic">Première visite</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (proj.docUpdatedAt) { %>
                                                <div class="small fw-semibold"><%= new Date(proj.docUpdatedAt).toLocaleDateString('fr-FR') %></div>
                                                <small class="text-muted"><%= new Date(proj.docUpdatedAt).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %></small>
                                            <% } else if (isNotFound) { %>
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill">Page non trouvée</span>
                                            <% } else { %>
                                                <span class="text-muted small fst-italic">Non interrogé</span>
                                            <% } %>
                                        </td>
                                        <td class="text-center pe-4">
                                            <% if (isUp) { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1">
                                                    <i class="fa-solid fa-circle-check fa-xs"></i> À jour
                                                </span>
                                            <% } else if (isOutdated) { %>
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1">
                                                    <i class="fa-solid fa-triangle-exclamation fa-xs"></i> En retard
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1.5">
                                                    Non vérifié
                                                </span>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <%- include('../includes/footer.html') %>
        </main>
    </body>
</html>
