<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Wiki BookStack &amp; Documentation • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>
        <%- include('../includes/pagehead.html') %>
    </head>
    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Page Header -->
            <div class="fab-page-header">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h1 class="fab-page-title">Wiki BookStack &amp; Documentation</h1>
                        <% if (settings.plugin_bookstack_enabled === 'false') { %>
                            <span class="badge bg-body-secondary text-secondary-emphasis border">
                                <i class="fa-solid fa-power-off me-1" aria-hidden="true"></i>Plugin désactivé
                            </span>
                        <% } else { %>
                            <span class="badge bg-body-secondary text-secondary-emphasis border">Plugin</span>
                        <% } %>
                    </div>
                    <p class="fab-page-subtitle">Intégration du wiki Sorbonne Université, suivi de fraîcheur documentaire et clés API</p>
                </div>
                <div class="fab-page-actions">
                    <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/bookstack/test" method="POST" class="d-inline">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                            <i class="fa-solid fa-plug-circle-check me-1" aria-hidden="true"></i> Tester la connexion API
                        </button>
                    </form>
                </div>
            </div>

            <!-- Disabled notice banner -->
            <% if (settings.plugin_bookstack_enabled === 'false') { %>
            <div class="alert alert-secondary border d-flex align-items-center justify-content-between mb-4 px-3 py-2">
                <div class="d-flex align-items-center gap-3">
                    <span class="fab-kpi-icon" aria-hidden="true">
                        <i class="fa-solid fa-power-off"></i>
                    </span>
                    <div>
                        <div class="fw-semibold small">Plugin BookStack actuellement désactivé</div>
                        <div class="text-muted small">L'intégration wiki et la vérification documentaire sont inactives sur l'accueil. Vous pouvez réactiver le plugin ci-dessous ou dans la <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/settings" class="alert-link">configuration générale</a>.</div>
                    </div>
                </div>
                <span class="badge bg-body-secondary text-secondary-emphasis border">Inactif</span>
            </div>
            <% } %>

            <!-- Notification banner -->
            <% if (typeof notification !== 'undefined' && notification) {
                const isError = notification.toLowerCase().includes('error');
                const isSuccess = notification.toLowerCase().includes('success');
            %>
            <div class="alert <%= isError ? 'alert-danger' : isSuccess ? 'alert-success' : 'alert-info' %> alert-dismissible fade show border mb-4" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid <%= isError ? 'fa-triangle-exclamation' : isSuccess ? 'fa-circle-check' : 'fa-circle-info' %>" aria-hidden="true"></i>
                    <div><%= notification.replace(/^(Success:|Error:|Warning:)\s*/i, '') %></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
            <% } %>

            <!-- SECTION 1: KPI Cards - Documentation Freshness Metrics -->
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-4">
                <div class="col">
                    <div class="card h-100 fab-kpi-card">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                <div class="small text-muted fw-semibold">Documentation à jour</div>
                                <span class="fab-kpi-icon" aria-hidden="true">
                                    <i class="fa-solid fa-percent"></i>
                                </span>
                            </div>
                            <div class="d-flex align-items-baseline gap-2 mb-2">
                                <span class="kpi-value tabular-nums <%= stats.upToDatePercentage >= 70 ? 'text-success' : stats.upToDatePercentage >= 40 ? 'text-warning-emphasis' : 'text-danger' %>">
                                    <%= stats.upToDatePercentage %>%
                                </span>
                                <span class="text-muted small">des projets évalués</span>
                            </div>
                            <div class="progress" style="height: 5px;">
                                <div class="progress-bar <%= stats.upToDatePercentage >= 70 ? 'bg-success' : stats.upToDatePercentage >= 40 ? 'bg-warning' : 'bg-danger' %>" role="progressbar" style="width: <%= stats.upToDatePercentage %>%;" aria-valuenow="<%= stats.upToDatePercentage %>" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100 fab-kpi-card">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                            <div>
                                <div class="small text-muted fw-semibold">Doc. synchronisée</div>
                                <div class="kpi-value tabular-nums text-success mt-1"><%= stats.upToDateCount %></div>
                                <div class="small text-muted mt-1">Modifiés depuis le dernier passage</div>
                            </div>
                            <span class="fab-kpi-icon" aria-hidden="true">
                                <i class="fa-solid fa-circle-check"></i>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100 fab-kpi-card <%= stats.outdatedCount > 0 ? 'border-danger' : '' %>">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                            <div>
                                <div class="small text-muted fw-semibold">Doc. en retard</div>
                                <div class="kpi-value tabular-nums <%= stats.outdatedCount > 0 ? 'text-danger' : 'text-body' %> mt-1"><%= stats.outdatedCount %></div>
                                <div class="small text-muted mt-1">Non modifiés depuis la dernière visite</div>
                            </div>
                            <span class="fab-kpi-icon <%= stats.outdatedCount > 0 ? 'bg-danger-subtle text-danger border-danger-subtle' : '' %>" aria-hidden="true">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100 fab-kpi-card">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                            <div>
                                <div class="small text-muted fw-semibold">Projets wiki liés</div>
                                <div class="kpi-value tabular-nums mt-1"><%= stats.totalWiki %></div>
                                <div class="small text-muted mt-1">sur <%= stats.totalActiveProjects %> projets actifs</div>
                            </div>
                            <span class="fab-kpi-icon" aria-hidden="true">
                                <i class="fa-solid fa-book-bookmark"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: Plugin & API Configuration Card -->
            <div class="card border mb-4">
                <div class="card-header bg-body-tertiary d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <h2 class="h6 fw-bold mb-0">
                            <i class="fa-solid fa-key text-muted me-2" aria-hidden="true"></i>Paramètres du Wiki BookStack
                        </h2>
                        <div class="text-muted small fw-normal">Identifiants d'accès à l'API REST de BookStack et préférences de saisie</div>
                    </div>
                </div>
                <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/bookstack/settings" method="POST">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <div class="p-3 bg-body-tertiary rounded border h-100 d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="fw-semibold small"><label class="form-check-label" for="plugin_bookstack_enabled">Activer le plugin BookStack</label></div>
                                        <small class="text-muted">Active la vérification de fraîcheur documentaire et le statut dynamique (vert/rouge)</small>
                                    </div>
                                    <div class="form-check form-switch fs-5 mb-0 ms-3">
                                        <input class="form-check-input" type="checkbox" role="switch" id="plugin_bookstack_enabled" name="plugin_bookstack_enabled" value="true" <%= settings.plugin_bookstack_enabled !== 'false' ? 'checked' : '' %>>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="p-3 bg-body-tertiary rounded border h-100 d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="fw-semibold small"><label class="form-check-label" for="bookstack_auto_prefill">Pré-remplissage automatique de l'adresse</label></div>
                                        <small class="text-muted">Pré-remplit le champ documentation avec l'URL de base du wiki lors de la création d'un projet</small>
                                    </div>
                                    <div class="form-check form-switch fs-5 mb-0 ms-3">
                                        <input class="form-check-input" type="checkbox" role="switch" id="bookstack_auto_prefill" name="bookstack_auto_prefill" value="true" <%= settings.bookstack_auto_prefill !== 'false' ? 'checked' : '' %>>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <label for="bookstack_url" class="form-label fw-semibold small">
                                    <i class="fa-solid fa-globe me-1 text-muted" aria-hidden="true"></i> Adresse de base du Wiki BookStack
                                </label>
                                <input type="url" class="form-control" id="bookstack_url" name="bookstack_url" value="<%= settings.bookstack_url || 'https://wiki.fablab.sorbonne-universite.fr/BookStack/' %>" placeholder="https://wiki.fablab.sorbonne-universite.fr/BookStack/" required>
                                <div class="form-text small">URL racine de votre instance BookStack. Le préfixe <code>api/</code> sera automatiquement utilisé pour les requêtes REST.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="bookstack_token_id" class="form-label fw-semibold small">
                                    <i class="fa-solid fa-id-badge me-1 text-muted" aria-hidden="true"></i> Token ID (Identifiant de jeton API)
                                </label>
                                <input type="text" class="form-control font-monospace" id="bookstack_token_id" name="bookstack_token_id" value="<%= settings.bookstack_token_id || '' %>" placeholder="ex: aBcDeFgHiJkLmNoPqRsTuVwXyZ123456" autocomplete="off">
                                <div class="form-text small">Généré depuis votre profil BookStack dans <em>Modifier le profil &gt; Jetons d'API</em>.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="bookstack_token_secret" class="form-label fw-semibold small">
                                    <i class="fa-solid fa-key me-1 text-muted" aria-hidden="true"></i> Token Secret (Clé secrète de jeton API)
                                </label>
                                <input type="password" class="form-control font-monospace" id="bookstack_token_secret" name="bookstack_token_secret" placeholder="<%= hasTokenSecret ? '•••••••••••••••••••••••• (inchangé)' : 'Saisir le secret API' %>" autocomplete="new-password">
                                <div class="form-text small"><%= hasTokenSecret ? 'Un secret API est déjà enregistré. Laissez vide pour ne pas le modifier.' : 'Le secret fourni par BookStack lors de la création du jeton.' %></div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-body-tertiary py-3 px-4 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary btn-sm px-3">
                            <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i> Enregistrer les paramètres
                        </button>
                    </div>
                </form>
            </div>

            <!-- SECTION 3: Projects Table with Documentation Freshness Status -->
            <div class="card border mb-4">
                <div class="card-header bg-body-tertiary d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <h2 class="h6 fw-bold mb-0">
                            <i class="fa-solid fa-table-list text-muted me-2" aria-hidden="true"></i>État de mise à jour des documentations
                        </h2>
                        <div class="text-muted small fw-normal">Comparaison entre la dernière modification sur le wiki et la date du dernier passage au Fablab</div>
                    </div>
                    <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
                        <%= stats.projects.length %> projet(s) wiki
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3">Projet &amp; URL</th>
                                    <th scope="col">Typologie</th>
                                    <th scope="col">Contributeur principal</th>
                                    <th scope="col">Dernière visite au lab</th>
                                    <th scope="col">Dernière modif wiki</th>
                                    <th scope="col" class="text-center pe-3">Statut documentaire</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (stats.projects.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-book-open fa-2x mb-2 text-secondary opacity-50 d-block" aria-hidden="true"></i>
                                        Aucun projet actif référençant le wiki BookStack n'a été trouvé.
                                    </td>
                                </tr>
                                <% } else { %>
                                    <% stats.projects.forEach(function(proj) {
                                        const isUp = proj.status === 'up_to_date';
                                        const isOutdated = proj.status === 'outdated';
                                        const isNotFound = proj.status === 'not_found';
                                    %>
                                    <tr>
                                        <td class="ps-3" style="max-width: 320px;">
                                            <div class="fw-semibold text-truncate" title="<%= proj.docTitle || proj.url %>">
                                                <%= proj.docTitle || proj.url.replace(/^https?:\/\/[^/]+\/[^/]+\/?/i, '') || proj.url %>
                                            </div>
                                            <% const validProjUrl = safeHttpUrl(proj.url); %>
                                            <% if (validProjUrl) { %>
                                            <a href="<%= validProjUrl %>" target="_blank" rel="noopener noreferrer" class="small text-muted text-decoration-none text-truncate d-inline-block" style="max-width: 280px;">
                                                <i class="fa-solid fa-arrow-up-right-from-square fa-xs me-1" aria-hidden="true"></i><%= validProjUrl %>
                                            </a>
                                            <% } else { %>
                                            <span class="small text-muted text-truncate d-inline-block" style="max-width: 280px;"><%= proj.url %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="badge bg-body-secondary text-secondary-emphasis border">
                                                <%= proj.projectType %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="small fw-semibold"><%= proj.userFullName %></span>
                                            <% if (proj.userCount > 1) { %>
                                                <span class="badge bg-body-secondary text-secondary-emphasis border ms-1">+<%= proj.userCount - 1 %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (proj.lastVisitDate) { %>
                                                <div class="small fw-semibold tabular-nums"><%= new Date(proj.lastVisitDate).toLocaleDateString('fr-FR') %></div>
                                                <small class="text-muted tabular-nums"><%= new Date(proj.lastVisitDate).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %></small>
                                            <% } else { %>
                                                <span class="text-muted small fst-italic">Première visite</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (proj.docUpdatedAt) { %>
                                                <div class="small fw-semibold tabular-nums"><%= new Date(proj.docUpdatedAt).toLocaleDateString('fr-FR') %></div>
                                                <small class="text-muted tabular-nums"><%= new Date(proj.docUpdatedAt).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %></small>
                                            <% } else if (isNotFound) { %>
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Page non trouvée</span>
                                            <% } else { %>
                                                <span class="text-muted small fst-italic">Non interrogé</span>
                                            <% } %>
                                        </td>
                                        <td class="text-center pe-3">
                                            <% if (isUp) { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1">
                                                    <i class="fa-solid fa-circle-check fa-xs" aria-hidden="true"></i> À jour
                                                </span>
                                            <% } else if (isOutdated) { %>
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle d-inline-flex align-items-center gap-1">
                                                    <i class="fa-solid fa-triangle-exclamation fa-xs" aria-hidden="true"></i> En retard
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-body-secondary text-secondary-emphasis border">
                                                    Non vérifié
                                                </span>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <%- include('../includes/footer.html') %>
    </body>
</html>
