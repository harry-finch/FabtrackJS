<!doctype html>
<html lang="en" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="" />
        <meta name="author" content="Stéphane Muller" />
        <title>Fabtrack administration panel</title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Page Header -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-info-subtle text-info-emphasis rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.25rem;">
                            <i class="fa-solid fa-diagram-project"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h4 class="fw-bold mb-0">Types de projets</h4>
                                <span class="badge bg-info-subtle text-info-emphasis border rounded-pill" style="font-size: 0.72rem;">
                                    <%= projecttypes.length %> types
                                </span>
                            </div>
                            <p class="text-muted small mb-0">Typologies de projets (Académique, Personnel, Recherche, Repair Café...)</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="/admin" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            <i class="fa-solid fa-arrow-left me-1"></i> Retour panneau admin
                        </a>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th onclick="sortTable(0)" scope="col" class="ps-3">#</th>
                                    <th onclick="sortTable(1)" scope="col">Project type</th>
                                    <th scope="col" class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="table-content">
                                <% projecttypes.forEach(function(projecttype) { %>
                                <tr>
                                    <td scope="row" class="ps-3 text-muted">#<%= projecttype.id %></td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-2 py-1">
                                            <%= projecttype.name %>
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a href="#" class="btn btn-outline-primary" id="edit-<%= projecttype.id %>"
                                                        data-id="<%= projecttype.id %>"
                                                        data-name="<%= projecttype.name %>"
                                                        title="Modifier">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>
                                            <a href="/admin/projecttypes/delete/<%= projecttype.id %>" class="btn btn-outline-danger" title="Supprimer" onclick="return confirm('Supprimer le type de projet <%= projecttype.name %> ?');">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-0 pt-3 pb-0">
                    <h5 class="fw-bold mb-0" id="formTitle">
                        <i class="fa-solid fa-diagram-project text-info-emphasis me-2"></i>Create new project type
                    </h5>
                </div>
                <div class="card-body">
                    <form action="/admin/projecttypes/create" method="post" id="projectTypeForm">
                        <div class="row g-2 align-items-center">
                            <input type='hidden' id="projecttypeid" name='projecttypeid' value='' />
                            <div class="col-md-8 col-12">
                                <div class="form-floating mb-2 mb-md-0">
                                    <input type="text" class="form-control" id="name" name="name" placeholder="Type name" required />
                                    <label for="name">Type name</label>
                                </div>
                            </div>
                            <div class="col-md-4 col-12 d-flex gap-2">
                                <button class="btn btn-primary rounded-pill px-4 py-3 flex-grow-1" type="submit" id="submitBtn">
                                    Create project type
                                </button>
                                <button type="button" id="cancelEditBtn" class="btn btn-outline-secondary rounded-pill px-3 py-3" style="display: none;" onclick="cancelEdit()">
                                    Annuler
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <%- include('../includes/footer.html') %>

        <script>
          const elements = document.querySelectorAll('[id^="edit-"]');
          elements.forEach(function(element){
            element.addEventListener("click", editItem);
          });

          function editItem(event) {
            if (event) event.preventDefault();

            document.getElementById("formTitle").innerHTML = "<i class='fa-solid fa-pen-to-square text-primary me-2'></i>Update project type";
            document.getElementById("projectTypeForm").action = "/admin/projecttypes/update";
            document.getElementById("projecttypeid").value = this.dataset.id;
            document.getElementById("name").value = this.dataset.name;
            document.getElementById("submitBtn").innerText = "Update project type";
            document.getElementById("cancelEditBtn").style.display = "inline-block";

            document.getElementById("projectTypeForm").scrollIntoView({ behavior: 'smooth' });
            return false;
          }

          function cancelEdit() {
            document.getElementById("formTitle").innerHTML = "<i class='fa-solid fa-diagram-project text-info-emphasis me-2'></i>Create new project type";
            document.getElementById("projectTypeForm").action = "/admin/projecttypes/create";
            document.getElementById("projecttypeid").value = "";
            document.getElementById("name").value = "";
            document.getElementById("submitBtn").innerText = "Create project type";
            document.getElementById("cancelEditBtn").style.display = "none";
          }
        </script>

    </body>
</html>
