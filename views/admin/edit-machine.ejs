<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Modifier les informations de la machine" />
    <title>Modifier <%= machine.name %> • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

    <%- include('../includes/pagehead.html') %>
  </head>

  <body class="d-flex justify-content-center bg-body-tertiary py-4">
    <%- include('../includes/light-dark.html') %>

    <main class="main-container">
      <%- include('../includes/header.html') %>

      <!-- Page Header -->
      <div class="fab-page-header">
        <div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <h1 class="fab-page-title">Modifier la machine</h1>
            <span class="badge bg-body-secondary text-secondary-emphasis border">
              <%= machine.name %>
            </span>
          </div>
          <p class="fab-page-subtitle">Paramètres techniques, maintenance et documentation machine</p>
        </div>
        <div class="fab-page-actions">
          <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/manage" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Retour aux machines
          </a>
        </div>
      </div>

      <div class="card border mb-4">
        <div class="card-body p-4">
          <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/update?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="post" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
            <input type="hidden" name="machineid" value="<%= machine.id %>" />

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label for="name" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_name') : 'Nom de la machine' %></label>
                <input type="text" class="form-control" id="name" name="name" value="<%= machine.name %>" required />
              </div>
              <div class="col-md-3">
                <label for="machinetypeId" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_type') : 'Type' %></label>
                <select class="form-select" id="machinetypeId" name="machinetypeId" required>
                  <% machinetypes.forEach(function(type) { %>
                    <option value="<%= type.id %>" <%= machine.machinetypeId === type.id ? 'selected' : '' %>><%= type.name %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-3">
                <label for="categoryId" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_category') : 'Catégorie' %></label>
                <select class="form-select" id="categoryId" name="categoryId">
                  <option value=""><%= typeof __ !== 'undefined' ? __('machines.no_category') : '(Sans catégorie)' %></option>
                  <% categories.forEach(function(cat) { %>
                    <option value="<%= cat.id %>" <%= machine.categoryId === cat.id ? 'selected' : '' %>><%= cat.name %></option>
                  <% }); %>
                </select>
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label for="make" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_make') : 'Marque / Fabricant' %></label>
                <input type="text" class="form-control" id="make" name="make" value="<%= machine.make %>" required />
              </div>
              <div class="col-md-6">
                <label for="model" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_model') : 'Modèle' %></label>
                <input type="text" class="form-control" id="model" name="model" value="<%= machine.model %>" required />
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label for="serialNumber" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_serial') : 'Numéro de série' %></label>
                <input type="text" class="form-control" id="serialNumber" name="serialNumber" value="<%= machine.serialNumber || '' %>" />
              </div>
              <div class="col-md-6">
                <label for="internalReference" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_internal_ref') : 'Référence interne (#)' %></label>
                <input type="number" class="form-control" id="internalReference" name="internalReference" value="<%= machine.internalReference || '' %>" />
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label for="locationId" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_location') : 'Emplacement' %></label>
                <select class="form-select" id="locationId" name="locationId">
                  <option value=""><%= typeof __ !== 'undefined' ? __('common.none') : 'Aucun' %></option>
                  <% locations.forEach(function(loc) { %>
                    <option value="<%= loc.id %>" <%= machine.locationId === loc.id ? 'selected' : '' %>><%= loc.name %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6">
                <label for="accessId" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_access') : 'Niveau d\'accès' %></label>
                <select class="form-select" id="accessId" name="accessId" required>
                  <% access.forEach(function(acc) { %>
                    <option value="<%= acc.id %>" <%= machine.accessId === acc.id ? 'selected' : '' %>><%= acc.name %></option>
                  <% }); %>
                </select>
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-4">
                <label for="purchaseDate" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_purchase_date') : 'Date d\'achat' %></label>
                <input type="date" class="form-control" id="purchaseDate" name="purchaseDate" value="<%= machine.purchaseDate ? new Date(machine.purchaseDate).toISOString().split('T')[0] : '' %>" />
              </div>
              <div class="col-md-4">
                <label for="lastMaintenance" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_last_maintenance') : 'Dernière maintenance' %></label>
                <input type="date" class="form-control" id="lastMaintenance" name="lastMaintenance" value="<%= machine.lastMaintenance ? new Date(machine.lastMaintenance).toISOString().split('T')[0] : '' %>" />
              </div>
              <div class="col-md-4">
                <label for="warrantyExpiry" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_warranty_expiry') : 'Expiration de garantie' %></label>
                <input type="date" class="form-control" id="warrantyExpiry" name="warrantyExpiry" value="<%= machine.warrantyExpiry ? new Date(machine.warrantyExpiry).toISOString().split('T')[0] : '' %>" />
              </div>
            </div>

            <div class="mb-3">
              <label for="documentation" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_documentation') : 'URL de documentation' %></label>
              <input type="url" class="form-control" id="documentation" name="documentation" value="<%= machine.documentation || '' %>" placeholder="https://..." />
            </div>

            <div class="mb-4">
              <label for="machinePicture" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_picture') : 'Photo de la machine (optionnel)' %></label>
              <input type="file" class="form-control" id="machinePicture" name="machinePicture" accept="image/*" />
              <% if (machine.picture) { %>
                <div class="mt-2 d-flex align-items-center gap-2">
                  <span class="text-muted small">Image actuelle :</span>
                  <img src="<%= machine.picture %>" alt="Aperçu de la machine" class="rounded border" style="height: 40px;" />
                </div>
              <% } %>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
              <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/manage" class="btn btn-outline-secondary btn-sm"><%= typeof __ !== 'undefined' ? __('common.cancel') : 'Annuler' %></a>
              <button class="btn btn-primary btn-sm" type="submit"><%= typeof __ !== 'undefined' ? __('machines.btn_update') : 'Enregistrer les modifications' %></button>
            </div>
          </form>
        </div>
      </div>

      <%- include('../includes/footer.html') %>
  </body>
</html>
