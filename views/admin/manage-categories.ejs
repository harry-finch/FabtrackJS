<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Gestion des catégories de matériels et consommables" />
        <meta name="author" content="Stéphane Muller" />
        <title>Catégories de matériels • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Page Header -->
            <div class="fab-page-header">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h1 class="fab-page-title">Catégories de matériels</h1>
                        <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
                            <%= categories.length %> catégorie<%= categories.length > 1 ? 's' : '' %>
                        </span>
                    </div>
                    <p class="fab-page-subtitle">Organisation et classification des consommables et équipements</p>
                </div>
            </div>

            <div class="card border mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th data-sort="0" scope="col" class="ps-3">#</th>
                                    <th data-sort="1" scope="col">Catégorie</th>
                                    <th data-sort="2" scope="col">Espace</th>
                                    <th scope="col" class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="table-content">
                                <% if (!categories || categories.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        <i class="fa-solid fa-layer-group fs-4 d-block mb-2 opacity-50" aria-hidden="true"></i>
                                        Aucune catégorie enregistrée pour le moment.
                                    </td>
                                </tr>
                                <% } else { %>
                                <% categories.forEach(function(category) { %>
                                <tr>
                                    <td scope="row" class="ps-3 text-muted tabular-nums">#<%= category.id %></td>
                                    <td class="fw-semibold"><%= category.name %></td>
                                    <td>
                                        <% if (category.workspace) { %>
                                        <span class="badge bg-body-secondary text-secondary-emphasis border">
                                            <%= category.workspace.name %>
                                        </span>
                                        <% } else { %>
                                        <span class="text-muted small">—</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="fab-row-actions">
                                            <a
                                                href="#"
                                                class="btn btn-outline-primary"
                                                id="edit-<%= category.id %>"
                                                data-id="<%= category.id %>"
                                                data-name="<%= category.name %>"
                                                data-workspace-id="<%= category.workspaceId %>"
                                                title="Modifier"
                                                aria-label="Modifier la catégorie <%= category.name %>"
                                            >
                                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                            </a>
                                            <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/categories/delete/<%= category.id %>" class="d-inline" data-confirm="Supprimer la catégorie <%= category.name %> ?">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                                                <button type="submit" class="btn btn-outline-danger" title="Supprimer" aria-label="Supprimer la catégorie <%= category.name %>">
                                                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border mb-4">
                <div class="card-header bg-body-tertiary">
                    <h2 class="h6 fw-bold mb-0" id="formTitle">
                        <i class="fa-solid fa-layer-group text-secondary me-2" aria-hidden="true"></i>Nouvelle catégorie
                    </h2>
                </div>
                <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/categories/create" method="post" id="categoryForm">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                    <input type="hidden" id="categoryid" name="categoryid" value="" />

                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-8 col-12">
                                <label for="name" class="form-label fw-semibold small">Nom de la catégorie</label>
                                <input type="text" class="form-control" id="name" name="name" placeholder="Ex. : Impression 3D, Électronique, Bois" required />
                            </div>
                            <div class="col-md-4 col-12">
                                <label for="workspaceId" class="form-label fw-semibold small">Espace</label>
                                <select class="form-select" id="workspaceId" name="workspaceId" required>
                                    <option value="" disabled selected>Sélectionner un espace</option>
                                    <% workspaces.forEach(function(workspace) { %>
                                    <option value="<%= workspace.id %>"><%= workspace.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-body-tertiary d-flex flex-wrap gap-2">
                        <button class="btn btn-primary" type="submit" id="submitBtn">
                            Créer la catégorie
                        </button>
                        <button type="button" id="cancelEditBtn" class="btn btn-outline-secondary" style="display: none;" data-action="cancel-edit">
                            Annuler
                        </button>
                    </div>
                </form>
            </div>

            <%- include('../includes/footer.html') %>

        <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
          const elements = document.querySelectorAll('[id^="edit-"]');
          elements.forEach(function (element) {
            element.addEventListener("click", editItem);
          });

          function editItem(event) {
            if (event) event.preventDefault();

            document.getElementById("formTitle").innerHTML =
              "<i class='fa-solid fa-pen-to-square text-primary me-2' aria-hidden='true'></i>Modifier la catégorie";
            document.getElementById("categoryForm").action = (window.getAppBaseUrl ? window.getAppBaseUrl("admin/categories/update") : "/admin/categories/update");
            document.getElementById("categoryid").value = this.dataset.id;
            document.getElementById("name").value = this.dataset.name;
            document.getElementById("workspaceId").value = this.dataset.workspaceId || '';
            document.getElementById("submitBtn").innerText = "Enregistrer les modifications";
            document.getElementById("cancelEditBtn").style.display = "inline-block";

            document.getElementById("categoryForm").scrollIntoView({ behavior: 'smooth' });
            return false;
          }

          function cancelEdit() {
            document.getElementById("formTitle").innerHTML =
              "<i class='fa-solid fa-layer-group text-secondary me-2' aria-hidden='true'></i>Nouvelle catégorie";
            document.getElementById("categoryForm").action = (window.getAppBaseUrl ? window.getAppBaseUrl("admin/categories/create") : "/admin/categories/create");
            document.getElementById("categoryid").value = "";
            document.getElementById("name").value = "";
            document.getElementById("workspaceId").selectedIndex = 0;
            document.getElementById("submitBtn").innerText = "Créer la catégorie";
            document.getElementById("cancelEditBtn").style.display = "none";
          }
        </script>
    </body>
</html>
