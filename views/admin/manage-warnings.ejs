<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Administration des avertissements et rappels de sécurité contributeurs" />
        <title>Avertissements contributeurs • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>
        <%- include('../includes/pagehead.html') %>
    </head>
    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <% 
                const activeCount = warnings.filter(w => w.active).length;
                const resolvedCount = warnings.filter(w => !w.active).length;
            %>

            <!-- Page Header -->
            <div class="fab-page-header">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h1 class="fab-page-title">Avertissements contributeurs</h1>
                        <% if (activeCount > 0) { %>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                <%= activeCount %> actif(s)
                            </span>
                        <% } else { %>
                            <span class="badge bg-body-secondary text-secondary-emphasis border">
                                0 actif
                            </span>
                        <% } %>
                        <span class="badge bg-body-secondary text-secondary-emphasis border">
                            <%= resolvedCount %> résolu(s)
                        </span>
                    </div>
                    <p class="fab-page-subtitle">Suivi des rappels aux règles, manquements et sanctions de sécurité</p>
                </div>
                <div class="fab-page-actions">
                    <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/warningtypes/manage" class="btn btn-outline-secondary btn-sm">
                        <i class="fa-solid fa-tags me-1" aria-hidden="true"></i> Types d'avertissements
                    </a>
                    <a href="#newWarningCard" id="btnScrollToNewWarning" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-plus me-1" aria-hidden="true"></i> Émettre un avertissement
                    </a>
                </div>
            </div>

            <!-- Notification banner -->
            <% if (typeof notification !== 'undefined' && notification) { 
                const isError = notification.toLowerCase().includes('error');
                const isSuccess = notification.toLowerCase().includes('success');
            %>
            <div class="alert <%= isError ? 'alert-danger' : isSuccess ? 'alert-success' : 'alert-info' %> alert-dismissible fade show border mb-4" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid <%= isError ? 'fa-triangle-exclamation' : isSuccess ? 'fa-circle-check' : 'fa-circle-info' %>" aria-hidden="true"></i>
                    <div><%= notification.replace(/^(Success:|Error:|Warning:)\s*/i, '') %></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
            <% } %>

            <!-- Filter Bar -->
            <div class="fab-filter-bar d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-muted small fw-semibold me-1">Filtrer :</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary active filter-btn" data-warning-filter="all">
                        Tous (<%= warnings.length %>)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary filter-btn" data-warning-filter="active">
                        <i class="fa-solid fa-clock me-1" aria-hidden="true"></i> Actifs (<%= activeCount %>)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary filter-btn" data-warning-filter="resolved">
                        <i class="fa-solid fa-check me-1" aria-hidden="true"></i> Résolus (<%= resolvedCount %>)
                    </button>
                </div>

                <!-- Search Input -->
                <div class="input-group input-group-sm" style="max-width: 280px;">
                    <span class="input-group-text bg-body-secondary border-end-0"><i class="fa-solid fa-magnifying-glass fa-sm text-muted" aria-hidden="true"></i></span>
                    <input type="text" id="warningSearch" class="form-control border-start-0" placeholder="Rechercher un contributeur, motif..." aria-label="Rechercher un avertissement par contributeur ou motif" />
                </div>
            </div>

            <!-- Table Card -->
            <div class="card border mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="warningsTable">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4" style="width: 70px;">#</th>
                                    <th scope="col">Contributeur</th>
                                    <th scope="col">Type d'avertissement</th>
                                    <th scope="col">Date d'émission</th>
                                    <th scope="col">Commentaires / Motif</th>
                                    <th scope="col" class="text-center" style="width: 110px;">Statut</th>
                                    <th scope="col" class="text-end pe-4" style="width: 140px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (warnings && warnings.length > 0) { %>
                                    <% warnings.forEach(function(warning) { %>
                                    <tr class="warning-row" data-status="<%= warning.active ? 'active' : 'resolved' %>" data-search="<%= (warning.user?.name + ' ' + warning.user?.surname + ' ' + warning.user?.email + ' ' + warning.warningtype?.name + ' ' + (warning.comments || '')).toLowerCase() %>">
                                        <td class="ps-4 text-muted small">#<%= warning.id %></td>
                                        <td>
                                            <% if (warning.user) { %>
                                                <div class="fw-semibold">
                                                    <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>users/edit/<%= warning.user.id %>" class="text-decoration-none text-body" title="Voir la fiche contributeur">
                                                        <%= warning.user.name %> <%= warning.user.surname %>
                                                    </a>
                                                </div>
                                                <small class="text-muted"><%= warning.user.email %></small>
                                            <% } else { %>
                                                <span class="text-muted fst-italic">Contributeur inconnu ou supprimé</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                                <% if (warning.warningtype?.icon) { %>
                                                    <i class="<%= sanitizeWarningIcon(warning.warningtype.icon) %> me-1" aria-hidden="true"></i>
                                                <% } else { %>
                                                    <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
                                                <% } %>
                                                <%= warning.warningtype?.name || 'Avertissement' %>
                                            </span>
                                        </td>
                                        <td class="small text-muted">
                                            <%= typeof formatDateTime === 'function' ? formatDateTime(warning.createdAt) : warning.createdAt %>
                                        </td>
                                        <td>
                                            <% if (warning.comments) { %>
                                                <span class="small"><%= warning.comments %></span>
                                            <% } else { %>
                                                <span class="text-muted small fst-italic">Aucun commentaire</span>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <% if (warning.active) { %>
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                    <i class="fa-solid fa-clock me-1" aria-hidden="true"></i> Actif
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    <i class="fa-solid fa-check me-1" aria-hidden="true"></i> Résolu
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="fab-row-actions">
                                                <% if (warning.active) { %>
                                                    <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/warnings/deactivate/<%= warning.id %>" class="d-inline" data-confirm="Marquer cet avertissement comme résolu ?">
                                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Marquer comme résolu" aria-label="Marquer l'avertissement #<%= warning.id %> comme résolu">
                                                            <i class="fa-solid fa-check" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                <% } else { %>
                                                    <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/warnings/activate/<%= warning.id %>" class="d-inline" data-confirm="Réactiver cet avertissement ?">
                                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Réactiver cet avertissement" aria-label="Réactiver l'avertissement #<%= warning.id %>">
                                                            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                <% } %>
                                                <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/warnings/delete/<%= warning.id %>" class="d-inline" data-confirm="Supprimer définitivement cet enregistrement d'avertissement ?">
                                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer définitivement" aria-label="Supprimer l'avertissement #<%= warning.id %>">
                                                        <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-5 text-muted">
                                            <div class="d-flex flex-column align-items-center justify-content-center">
                                                <i class="fa-solid fa-shield-halved fs-1 text-success mb-2" aria-hidden="true"></i>
                                                <h6 class="fw-semibold mb-1">Aucun avertissement enregistré</h6>
                                                <small class="text-muted">Aucun contributeur n'a reçu d'avertissement pour le moment.</small>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- New Warning Card -->
            <div class="card border mb-4" id="newWarningCard">
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                            <i class="fa-solid fa-plus me-1" aria-hidden="true"></i> Nouveau
                        </span>
                        <h2 class="h6 fw-bold mb-0">Émettre un avertissement contributeur</h2>
                    </div>
                    <p class="text-muted small mt-1 mb-0">Enregistrez un rappel au règlement, un manquement ou une infraction sur le profil d'un contributeur</p>
                </div>
                <div class="card-body p-4">
                    <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/warnings/create" method="POST">
                        <div class="row g-3">
                            <!-- Select User -->
                            <div class="col-12 col-md-6">
                                <label for="userid" class="form-label fw-semibold small">
                                    <i class="fa-solid fa-user me-1 text-primary" aria-hidden="true"></i> Contributeur concerné
                                </label>
                                <select class="form-select" id="userid" name="userid" required>
                                    <option value="" disabled selected>-- Sélectionnez un contributeur --</option>
                                    <% users.forEach(function(u) { %>
                                        <option value="<%= u.id %>">
                                            <%= u.surname %> <%= u.name %> (<%= u.email %>)
                                        </option>
                                    <% }); %>
                                </select>
                            </div>

                            <!-- Select Warning Type -->
                            <div class="col-12 col-md-6">
                                <label for="warningtype" class="form-label fw-semibold small">
                                    <i class="fa-solid fa-triangle-exclamation me-1 text-warning-emphasis" aria-hidden="true"></i> Motif / Type d'avertissement
                                </label>
                                <select class="form-select" id="warningtype" name="warningtype" required>
                                    <option value="" disabled selected>-- Sélectionnez un motif --</option>
                                    <% warningtypes.forEach(function(wt) { %>
                                        <option value="<%= wt.id %>">
                                            <%= wt.name %>
                                        </option>
                                    <% }); %>
                                </select>
                            </div>

                            <!-- Comments -->
                            <div class="col-12">
                                <label for="comments" class="form-label fw-semibold small">
                                    <i class="fa-solid fa-comment-dots me-1 text-muted" aria-hidden="true"></i> Commentaires / Précisions (facultatif)
                                </label>
                                <textarea class="form-control" id="comments" name="comments" rows="3" placeholder="Circonstances, machine concernée, consigne rappelée..."></textarea>
                                <div class="form-text small text-muted">Ce commentaire apparaîtra sur la fiche contributeur et dans l'alerte e-mail éventuelle.</div>
                            </div>

                            <div class="col-12 d-flex justify-content-end gap-2 pt-2">
                                <button type="reset" class="btn btn-outline-secondary btn-sm">
                                    Réinitialiser
                                </button>
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i> Émettre l'avertissement
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
                let currentStatusFilter = 'all';

                function filterWarnings(status, btn) {
                    currentStatusFilter = status;
                    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                    if (btn) btn.classList.add('active');
                    applyFilters();
                }

                function searchWarnings(query) {
                    applyFilters();
                }

                function applyFilters() {
                    const query = (document.getElementById('warningSearch')?.value || '').trim().toLowerCase();
                    const rows = document.querySelectorAll('.warning-row');

                    rows.forEach(row => {
                        const status = row.getAttribute('data-status');
                        const text = row.getAttribute('data-search') || '';

                        const matchesStatus = (currentStatusFilter === 'all') || (status === currentStatusFilter);
                        const matchesQuery = !query || text.includes(query);

                        if (matchesStatus && matchesQuery) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                }

                const btnScrollToNewWarning = document.getElementById('btnScrollToNewWarning');
                if (btnScrollToNewWarning) {
                    btnScrollToNewWarning.addEventListener('click', () => {
                        document.getElementById('newWarningCard')?.scrollIntoView({ behavior: 'smooth' });
                        document.getElementById('userid')?.focus();
                    });
                }

                document.querySelectorAll('.filter-btn[data-warning-filter]').forEach((btn) => {
                    btn.addEventListener('click', () => {
                        filterWarnings(btn.getAttribute('data-warning-filter') || 'all', btn);
                    });
                });

                const warningSearchInput = document.getElementById('warningSearch');
                if (warningSearchInput) {
                    warningSearchInput.addEventListener('input', (e) => searchWarnings(e.target.value));
                }
            </script>

            <%- include('../includes/footer.html') %>
    </body>
</html>
