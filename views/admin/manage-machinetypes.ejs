<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Gestion des types de machines du fablab" />
        <meta name="author" content="Stéphane Muller" />
        <title>Types de machines • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Page Header -->
            <div class="fab-page-header">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h1 class="fab-page-title">Types de machines</h1>
                        <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
                            <%= machinetypes.length %> type<%= machinetypes.length > 1 ? 's' : '' %>
                        </span>
                    </div>
                    <p class="fab-page-subtitle">Technologies et familles d'équipements (FDM, Laser, CNC…)</p>
                </div>
            </div>

            <div class="card border mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th data-sort="0" scope="col" class="ps-3">#</th>
                                    <th data-sort="1" scope="col">Type de machine</th>
                                    <th scope="col" class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="table-content">
                                <% if (!machinetypes || machinetypes.length === 0) { %>
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-5">
                                        <i class="fa-solid fa-gears fs-4 d-block mb-2 opacity-50" aria-hidden="true"></i>
                                        Aucun type de machine enregistré pour le moment.
                                    </td>
                                </tr>
                                <% } else { %>
                                <% machinetypes.forEach(function(machinetype) { %>
                                <tr>
                                    <td scope="row" class="ps-3 text-muted tabular-nums">#<%= machinetype.id %></td>
                                    <td>
                                        <span class="badge bg-body-secondary text-secondary-emphasis border">
                                            <%= machinetype.name %>
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="fab-row-actions">
                                            <a
                                                href="#"
                                                class="btn btn-outline-primary"
                                                id="edit-<%= machinetype.id %>"
                                                data-id="<%= machinetype.id %>"
                                                data-name="<%= machinetype.name %>"
                                                title="Modifier"
                                                aria-label="Modifier le type de machine <%= machinetype.name %>"
                                            >
                                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                            </a>
                                            <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/delete-type/<%= machinetype.id %>" class="d-inline" data-confirm="Supprimer le type de machine <%= machinetype.name %> ?">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                                                <button type="submit" class="btn btn-outline-danger" title="Supprimer" aria-label="Supprimer le type de machine <%= machinetype.name %>">
                                                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border mb-4">
                <div class="card-header bg-body-tertiary">
                    <h2 class="h6 fw-bold mb-0" id="formTitle">
                        <i class="fa-solid fa-gears text-secondary me-2" aria-hidden="true"></i>Nouveau type de machine
                    </h2>
                </div>
                <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/create-type" method="post" id="machineTypeForm">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                    <input type="hidden" id="machinetypeid" name="machinetypeid" value="" />

                    <div class="card-body">
                        <div class="mb-0">
                            <label for="name" class="form-label fw-semibold small">Nom du type de machine</label>
                            <input type="text" class="form-control" id="name" name="name" placeholder="Ex. : Imprimante 3D FDM, Découpeuse laser, Fraiseuse CNC" required />
                        </div>
                    </div>

                    <div class="card-footer bg-body-tertiary d-flex flex-wrap gap-2">
                        <button class="btn btn-primary" type="submit" id="submitBtn">
                            Créer le type de machine
                        </button>
                        <button type="button" id="cancelEditBtn" class="btn btn-outline-secondary" style="display: none;" data-action="cancel-edit">
                            Annuler
                        </button>
                    </div>
                </form>
            </div>

            <%- include('../includes/footer.html') %>

        <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
          const elements = document.querySelectorAll('[id^="edit-"]');
          elements.forEach(function(element) {
            element.addEventListener("click", editItem);
          });

          function editItem(event) {
            if (event) event.preventDefault();

            document.getElementById("formTitle").innerHTML = "<i class='fa-solid fa-pen-to-square text-primary me-2' aria-hidden='true'></i>Modifier le type de machine";
            document.getElementById("machineTypeForm").action = (window.getAppBaseUrl ? window.getAppBaseUrl("admin/machines/update-type") : "/admin/machines/update-type");
            document.getElementById("machinetypeid").value = this.dataset.id;
            document.getElementById("name").value = this.dataset.name;
            document.getElementById("submitBtn").innerText = "Enregistrer les modifications";
            document.getElementById("cancelEditBtn").style.display = "inline-block";

            document.getElementById("machineTypeForm").scrollIntoView({ behavior: 'smooth' });
            return false;
          }

          function cancelEdit() {
            document.getElementById("formTitle").innerHTML = "<i class='fa-solid fa-gears text-secondary me-2' aria-hidden='true'></i>Nouveau type de machine";
            document.getElementById("machineTypeForm").action = (window.getAppBaseUrl ? window.getAppBaseUrl("admin/machines/create-type") : "/admin/machines/create-type");
            document.getElementById("machinetypeid").value = "";
            document.getElementById("name").value = "";
            document.getElementById("submitBtn").innerText = "Créer le type de machine";
            document.getElementById("cancelEditBtn").style.display = "none";
          }
        </script>
    </body>
</html>
