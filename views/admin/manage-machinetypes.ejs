<!doctype html>
<html lang="en" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="" />
        <meta name="author" content="Stéphane Muller" />
        <title>Fabtrack administration panel</title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <div class="mb-3">
                <a href="/admin" class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="fa-solid fa-arrow-left me-1"></i> Panneau d'administration
                </a>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold mb-0">
                        <i class="fa-solid fa-gears text-secondary me-2"></i>Manage machine types
                    </h4>
                    <small class="text-muted">Technologies & familles d'équipements (FDM, Laser, CNC...)</small>
                </div>
                <span class="badge bg-secondary-subtle text-secondary-emphasis border rounded-pill px-3 py-2">
                    <%= machinetypes.length %> types
                </span>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th onclick="sortTable(0)" scope="col" class="ps-3">#</th>
                                    <th onclick="sortTable(1)" scope="col">Machine type</th>
                                    <th scope="col" class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="table-content">
                                <% machinetypes.forEach(function(machinetype) { %>
                                <tr>
                                    <td scope="row" class="ps-3 text-muted">#<%= machinetype.id %></td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-2 py-1">
                                            <%= machinetype.name %>
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a href="#" class="btn btn-outline-primary" id="edit-<%= machinetype.id %>"
                                                        data-id="<%= machinetype.id %>"
                                                        data-name="<%= machinetype.name %>"
                                                        title="Modifier">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>
                                            <a href="/admin/machines/delete-type/<%= machinetype.id %>" class="btn btn-outline-danger" title="Supprimer" onclick="return confirm('Supprimer le type de machine <%= machinetype.name %> ?');">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-0 pt-3 pb-0">
                    <h5 class="fw-bold mb-0" id="formTitle">
                        <i class="fa-solid fa-gears text-secondary me-2"></i>Create new machine type
                    </h5>
                </div>
                <div class="card-body">
                    <form action="/admin/machines/create-type" method="post" id="machineTypeForm">
                        <div class="row g-2 align-items-center">
                            <input type='hidden' id="machinetypeid" name='machinetypeid' value='' />
                            <div class="col-md-8 col-12">
                                <div class="form-floating mb-2 mb-md-0">
                                    <input type="text" class="form-control" id="name" name="name" placeholder="Type name" required />
                                    <label for="name">Type name</label>
                                </div>
                            </div>
                            <div class="col-md-4 col-12 d-flex gap-2">
                                <button class="btn btn-primary rounded-pill px-4 py-3 flex-grow-1" type="submit" id="submitBtn">
                                    Create machine type
                                </button>
                                <button type="button" id="cancelEditBtn" class="btn btn-outline-secondary rounded-pill px-3 py-3" style="display: none;" onclick="cancelEdit()">
                                    Annuler
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <%- include('../includes/footer.html') %>

        <script>
          const elements = document.querySelectorAll('[id^="edit-"]');
          elements.forEach(function(element){
            element.addEventListener("click", editItem);
          });

          function editItem(event) {
            if (event) event.preventDefault();

            document.getElementById("formTitle").innerHTML = "<i class='fa-solid fa-pen-to-square text-primary me-2'></i>Update machine type";
            document.getElementById("machineTypeForm").action = "/admin/machines/update-type";
            document.getElementById("machinetypeid").value = this.dataset.id;
            document.getElementById("name").value = this.dataset.name;
            document.getElementById("submitBtn").innerText = "Update machine type";
            document.getElementById("cancelEditBtn").style.display = "inline-block";

            document.getElementById("machineTypeForm").scrollIntoView({ behavior: 'smooth' });
            return false;
          }

          function cancelEdit() {
            document.getElementById("formTitle").innerHTML = "<i class='fa-solid fa-gears text-secondary me-2'></i>Create new machine type";
            document.getElementById("machineTypeForm").action = "/admin/machines/create-type";
            document.getElementById("machinetypeid").value = "";
            document.getElementById("name").value = "";
            document.getElementById("submitBtn").innerText = "Create machine type";
            document.getElementById("cancelEditBtn").style.display = "none";
          }
        </script>

    </body>
</html>
