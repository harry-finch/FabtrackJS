<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Fiche détaillée de la machine" />
    <title><%= machine.name %> • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

    <%- include('../includes/pagehead.html') %>
  </head>

  <body class="d-flex justify-content-center bg-body-tertiary py-4">
    <%- include('../includes/light-dark.html') %>

    <%
      const safeEvents = (typeof events !== 'undefined' && Array.isArray(events)) ? events : ((typeof locals !== 'undefined' && Array.isArray(locals.events)) ? locals.events : []);
      const safeIssues = (typeof issues !== 'undefined' && Array.isArray(issues)) ? issues : ((typeof locals !== 'undefined' && Array.isArray(locals.issues)) ? locals.issues : []);
      const safeMaintenances = (typeof maintenances !== 'undefined' && Array.isArray(maintenances)) ? maintenances : ((typeof locals !== 'undefined' && Array.isArray(locals.maintenances)) ? locals.maintenances : []);
      const safeOpenIssuesCount = (typeof openIssuesCount !== 'undefined') ? openIssuesCount : ((typeof locals !== 'undefined' && typeof locals.openIssuesCount !== 'undefined') ? locals.openIssuesCount : safeIssues.filter(i => i.status === 'OPEN').length);
      const safeFormatDate = (d) => {
        if (!d) return '-';
        if (typeof formatDate === 'function') return formatDate(d);
        if (typeof locals !== 'undefined' && typeof locals.formatDate === 'function') return locals.formatDate(d);
        try { return new Date(d).toLocaleDateString('fr-FR'); } catch (e) { return String(d); }
      };
      const eventList = (safeEvents.length > 0) ? safeEvents : safeIssues.map(i => ({
        eventId: `issue-${i.id}`,
        kind: 'ISSUE',
        formattedDate: i.formattedCreatedAt,
        status: i.status,
        author: i.reporterName || i.reporterEmail || 'Contributeur',
        title: 'Incident / Panne signalée',
        description: i.description,
        photoPath: i.photoPath,
        resolvedAt: i.resolvedAt,
        formattedResolvedAt: i.formattedResolvedAt,
        resolutionNotes: i.resolutionNotes,
        original: i
      }));
    %>

    <main class="main-container">
      <%- include('../includes/header.html') %>

      <!-- Page Header -->
      <div class="fab-page-header">
        <div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <h1 class="fab-page-title"><%= machine.name %></h1>
            <span class="badge bg-body-secondary text-secondary-emphasis border">
              <%= machine.machinetype ? machine.machinetype.name : 'Machine' %>
            </span>
            <% if (safeOpenIssuesCount > 0) { %>
              <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i><%= safeOpenIssuesCount %> panne(s) en cours
              </span>
            <% } %>
          </div>
          <p class="fab-page-subtitle"><%= machine.make || '' %> <%= machine.model || '' %> &bull; <%= machine.location ? machine.location.name : 'Emplacement non défini' %></p>
        </div>
        <div class="fab-page-actions">
          <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/manage" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Retour aux machines
          </a>
          <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>report-issue/<%= machine.id %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm" title="Ouvrir la page publique de signalement pour cette machine">
            <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i> Signaler un problème
          </a>
          <% if (typeof role !== 'undefined' && role === 'admin') { %>
          <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/edit/<%= machine.id %>" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-pen-to-square me-1" aria-hidden="true"></i> Modifier
          </a>
          <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/delete/<%= machine.id %>" class="d-inline" data-confirm="Confirmez-vous la suppression définitive de cette machine ?">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
            <button type="submit" class="btn btn-outline-secondary btn-sm">
              <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i> Supprimer
            </button>
          </form>
          <% } %>
          <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAddMaintenance">
            <i class="fa-solid fa-wrench me-1" aria-hidden="true"></i> Déclarer une maintenance
          </button>
        </div>
      </div>

      <!-- Machine Details Card -->
      <div class="card border mb-4">
        <div class="row g-0">
          <div class="col-md-5 d-flex align-items-center justify-content-center bg-body-tertiary p-3">
            <% if (machine.picture) { %>
              <img
                src="<%= machine.picture %>"
                alt="<%= machine.name %>"
                class="img-fluid rounded"
                style="max-height: 280px; object-fit: cover;"
              />
            <% } else { %>
              <div class="text-center text-muted p-4">
                <i class="fa-solid fa-gears fa-4x mb-3 opacity-50" aria-hidden="true"></i>
                <p class="mb-0 small">Aucune image disponible</p>
              </div>
            <% } %>
          </div>

          <div class="col-md-7">
            <div class="card-body">
              <h2 class="h5 card-title fw-bold mb-1"><%= machine.name %></h2>
              <p class="text-muted small mb-2"><%= machine.make %> - <%= machine.model %></p>

              <div class="d-flex flex-wrap gap-1 mb-3">
                <span class="badge bg-body-secondary text-secondary-emphasis border"><%= machine.machinetype ? machine.machinetype.name : 'Type inconnu' %></span>
                <% if (machine.category) { %>
                  <span class="badge bg-body-secondary text-secondary-emphasis border"><i class="fa-solid fa-layer-group me-1" aria-hidden="true"></i><%= machine.category.name %></span>
                <% } %>
                <span class="badge bg-body-secondary text-secondary-emphasis border"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i><%= machine.access ? machine.access.name : 'Accès non défini' %></span>
              </div>

              <hr />

              <div class="row g-2 small">
                <div class="col-6">
                  <strong>Numéro de série :</strong>
                  <p class="text-secondary mb-2"><%= machine.serialNumber || 'Non renseigné' %></p>
                </div>
                <div class="col-6">
                  <strong><%= typeof __ !== 'undefined' ? __('machines.field_internal_ref') : 'Réf. interne :' %></strong>
                  <p class="text-secondary mb-2"><%= machine.internalReference ? '#' + machine.internalReference : 'Non renseignée' %></p>
                </div>
                <div class="col-6">
                  <strong><%= typeof __ !== 'undefined' ? __('machines.col_location') : 'Emplacement :' %></strong>
                  <p class="text-secondary mb-2"><%= machine.location ? machine.location.name : 'Non renseigné' %></p>
                </div>
                <div class="col-6">
                  <strong><%= typeof __ !== 'undefined' ? __('machines.field_purchase_date') : 'Date d\'achat :' %></strong>
                  <p class="text-secondary mb-2"><%= safeFormatDate(machine.purchaseDate) %></p>
                </div>
                <div class="col-6">
                  <strong><%= typeof __ !== 'undefined' ? __('machines.field_last_maintenance') : 'Dernière maintenance :' %></strong>
                  <p class="text-secondary mb-2"><%= safeFormatDate(machine.lastMaintenance) %></p>
                </div>
                <div class="col-6">
                  <strong><%= typeof __ !== 'undefined' ? __('machines.field_warranty_expiry') : 'Expiration de garantie :' %></strong>
                  <p class="text-secondary mb-2"><%= safeFormatDate(machine.warrantyExpiry) %></p>
                </div>
                <div class="col-12">
                  <strong><%= typeof __ !== 'undefined' ? __('machines.field_documentation') : 'Documentation :' %></strong>
                  <p class="mb-0">
                    <% if (machine.documentation) { %>
                      <a href="<%= machine.documentation %>" target="_blank" rel="noopener noreferrer" class="link-primary">
                        <i class="fa-solid fa-arrow-up-right-from-square me-1" aria-hidden="true"></i><%= machine.documentation %>
                      </a>
                    <% } else { %>
                      <span class="text-secondary"><%= typeof __ !== 'undefined' ? __('common.none') : 'Aucune' %></span>
                    <% } %>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Machine Events, Issues & Maintenance Section -->
      <div class="card border mb-4" id="issues">
        <div class="card-header bg-transparent d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
          <div class="d-flex flex-wrap align-items-center gap-2">
            <h2 class="h6 fw-bold mb-0">
              <i class="fa-solid fa-clipboard-list text-secondary me-1" aria-hidden="true"></i> Incidents, pannes &amp; maintenances
            </h2>
            <% if (safeOpenIssuesCount > 0) { %>
              <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                <%= safeOpenIssuesCount %> panne(s) en cours
              </span>
            <% } else { %>
              <span class="badge bg-success-subtle text-success border border-success-subtle">
                <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>Opérationnelle
              </span>
            <% } %>
            <% if (safeMaintenances.length > 0) { %>
              <span class="badge bg-body-secondary text-secondary-emphasis border">
                <i class="fa-solid fa-wrench me-1" aria-hidden="true"></i><%= safeMaintenances.length %> maintenance(s)
              </span>
            <% } %>
          </div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- Filter buttons -->
            <div class="btn-group btn-group-sm" role="group" id="eventFilterGroup" aria-label="Filtrer les événements">
              <button type="button" class="btn btn-outline-secondary active" data-event-filter="ALL">
                Tous (<%= safeEvents.length > 0 ? safeEvents.length : safeIssues.length %>)
              </button>
              <button type="button" class="btn btn-outline-secondary" data-event-filter="MAINTENANCE">
                <i class="fa-solid fa-wrench me-1" aria-hidden="true"></i> Maintenances (<%= safeMaintenances.length %>)
              </button>
              <button type="button" class="btn btn-outline-secondary" data-event-filter="ISSUE">
                <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i> Pannes (<%= safeIssues.length %>)
              </button>
            </div>

            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAddMaintenance">
              <i class="fa-solid fa-plus me-1" aria-hidden="true"></i> Déclarer une maintenance
            </button>
            <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>report-issue/<%= machine.id %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm">
              <i class="fa-solid fa-camera me-1" aria-hidden="true"></i> Signaler une panne
            </a>
          </div>
        </div>

        <div class="card-body">
          <% if (eventList.length === 0) { %>
            <div class="text-center text-muted py-5">
              <i class="fa-solid fa-shield-halved fa-3x mb-3 text-success opacity-75" aria-hidden="true"></i>
              <p class="mb-1 fw-semibold">Aucun incident ni opération de maintenance enregistrée pour cette machine.</p>
              <small class="text-secondary">Les signalements de panne et opérations d'entretien (buses, lentilles, filtres...) apparaîtront ici.</small>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0" id="tableMachineEvents">
                <thead class="table-light">
                  <tr>
                    <th scope="col" style="width: 140px;">Événement</th>
                    <th scope="col" style="width: 130px;">Date</th>
                    <th scope="col" style="width: 170px;">Intervenant / Signalé par</th>
                    <th scope="col">Détails &amp; interventions</th>
                    <th scope="col" class="text-center" style="width: 90px;">Photo</th>
                    <th scope="col" class="text-end pe-3" style="width: 160px;">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% eventList.forEach(function(ev) { %>
                    <tr class="event-row <%= ev.kind === 'MAINTENANCE' ? 'event-maintenance' : 'event-issue ' + (ev.status === 'OPEN' ? 'table-danger' : '') %>" data-event-kind="<%= ev.kind %>">
                      <td>
                        <% if (ev.kind === 'MAINTENANCE') { %>
                          <span class="badge bg-body-secondary text-secondary-emphasis border">
                            <i class="fa-solid fa-wrench me-1" aria-hidden="true"></i>Maintenance
                          </span>
                        <% } else if (ev.status === 'OPEN') { %>
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                            <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>Panne
                          </span>
                        <% } else { %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="fa-solid fa-check me-1" aria-hidden="true"></i>Résolue
                          </span>
                        <% } %>
                      </td>

                      <td>
                        <small class="fw-semibold"><%= ev.formattedDate %></small>
                      </td>

                      <td>
                        <% if (ev.kind === 'MAINTENANCE') { %>
                          <div class="fw-semibold small"><i class="fa-solid fa-user-gear me-1 text-primary" aria-hidden="true"></i><%= ev.author %></div>
                          <span class="badge bg-body-secondary text-secondary-emphasis border" style="font-size: 0.68rem;">Équipe Fablab</span>
                        <% } else { %>
                          <div class="fw-semibold small"><%= ev.author %></div>
                          <% if (ev.original && ev.original.reporterEmail) { %>
                            <div class="small text-muted text-truncate" style="max-width: 150px;"><%= ev.original.reporterEmail %></div>
                          <% } %>
                        <% } %>
                      </td>

                      <td>
                        <% if (ev.kind === 'MAINTENANCE') { %>
                          <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <span class="fw-bold text-body"><%= ev.title %></span>
                            <% 
                              let typeLabel = 'Préventive';
                              let typeBadge = 'bg-body-secondary text-secondary-emphasis border';
                              if (ev.type === 'CURATIVE') { typeLabel = 'Réparation'; typeBadge = 'bg-warning-subtle text-warning-emphasis border border-warning-subtle'; }
                              else if (ev.type === 'REPLACEMENT') { typeLabel = 'Remplacement pièce'; typeBadge = 'bg-body-secondary text-secondary-emphasis border'; }
                              else if (ev.type === 'CALIBRATION') { typeLabel = 'Calibration'; typeBadge = 'bg-success-subtle text-success border border-success-subtle'; }
                              else if (ev.type === 'CLEANING') { typeLabel = 'Nettoyage'; typeBadge = 'bg-body-secondary text-secondary-emphasis border'; }
                            %>
                            <span class="badge <%= typeBadge %>" style="font-size: 0.68rem;"><%= typeLabel %></span>
                            <% if (ev.cost) { %>
                              <span class="badge bg-body-secondary text-secondary-emphasis border" style="font-size: 0.68rem;"><%= ev.cost %> €</span>
                            <% } %>
                          </div>
                          <% if (ev.partsReplaced) { %>
                            <div class="small text-primary mb-1">
                              <i class="fa-solid fa-screwdriver me-1" aria-hidden="true"></i> Pièces changées : <strong><%= ev.partsReplaced %></strong>
                            </div>
                          <% } %>
                          <% if (ev.description) { %>
                            <div class="p-2 rounded bg-body-tertiary border small text-break">
                              <%= ev.description %>
                            </div>
                          <% } %>
                        <% } else { %>
                          <div class="p-2 rounded bg-body-tertiary border small text-break">
                            <%= ev.description %>
                          </div>
                          <% if (ev.status === 'RESOLVED' && ev.resolvedAt) { %>
                            <div class="small text-success mt-1">
                              <i class="fa-solid fa-check-double me-1" aria-hidden="true"></i> Résolu le <%= ev.formattedResolvedAt %>
                              <% if (ev.resolutionNotes) { %>
                                &mdash; <em><%= ev.resolutionNotes %></em>
                              <% } %>
                            </div>
                          <% } %>
                        <% } %>
                      </td>

                      <td class="text-center">
                        <% if (ev.photoPath) { %>
                          <button type="button" class="btn btn-outline-secondary btn-sm p-1" data-bs-toggle="modal" data-bs-target="#modalPhotoIssue<%= ev.original.id %>" title="Voir la photo" aria-label="Voir la photo de l'incident">
                            <img src="<%= ev.photoPath %>" alt="Photo incident" style="width: 44px; height: 44px; object-fit: cover;" class="rounded" />
                          </button>
                        <% } else { %>
                          <span class="text-muted small">-</span>
                        <% } %>
                      </td>

                      <td class="text-end pe-3">
                        <div class="fab-row-actions">
                          <% if (ev.kind === 'MAINTENANCE') { %>
                            <% if (typeof role !== 'undefined' && role === 'admin') { %>
                              <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/maintenance/<%= ev.original.id %>/delete" method="POST" class="d-inline" data-confirm="Confirmez-vous la suppression de cette fiche de maintenance ?">
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Supprimer la maintenance" aria-label="Supprimer la fiche de maintenance <%= ev.title %>">
                                  <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                </button>
                              </form>
                            <% } %>
                          <% } else { %>
                            <% if (ev.status === 'OPEN') { %>
                              <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalResolveIssue<%= ev.original.id %>" title="Marquer comme résolu" aria-label="Marquer l'incident comme résolu">
                                <i class="fa-solid fa-check me-1" aria-hidden="true"></i> Résoudre
                              </button>
                            <% } else { %>
                              <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/issues/<%= ev.original.id %>/status" method="POST" class="d-inline">
                                <input type="hidden" name="status" value="OPEN" />
                                <input type="hidden" name="machineId" value="<%= machine.id %>" />
                                <button type="submit" class="btn btn-outline-warning btn-sm" title="Rouvrir l'incident" aria-label="Rouvrir l'incident">
                                  <i class="fa-solid fa-arrow-rotate-left me-1" aria-hidden="true"></i> Rouvrir
                                </button>
                              </form>
                            <% } %>

                            <% if (typeof role !== 'undefined' && role === 'admin') { %>
                            <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/issues/<%= ev.original.id %>/delete" method="POST" class="d-inline" data-confirm="Confirmez-vous la suppression de ce signalement ?">
                              <button type="submit" class="btn btn-outline-danger btn-sm" title="Supprimer le signalement" aria-label="Supprimer le signalement">
                                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                              </button>
                            </form>
                            <% } %>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Modals for Incident Photos & Resolution -->
      <% eventList.forEach(function(ev) { %>
        <% if (ev.photoPath) { %>
          <div class="modal fade" id="modalPhotoIssue<%= ev.original.id %>" tabindex="-1" aria-labelledby="modalPhotoIssueLabel<%= ev.original.id %>" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="modalPhotoIssueLabel<%= ev.original.id %>">
                    <i class="fa-solid fa-camera me-1 text-primary" aria-hidden="true"></i> Photo de l'incident - <%= machine.name %>
                  </h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body p-3 text-center bg-body-tertiary">
                  <img src="<%= ev.photoPath %>" alt="Photo de l'incident" class="img-fluid rounded" style="max-height: 80vh;" />
                </div>
              </div>
            </div>
          </div>
        <% } %>

        <% if (ev.kind === 'ISSUE' && ev.status === 'OPEN') { %>
          <div class="modal fade" id="modalResolveIssue<%= ev.original.id %>" tabindex="-1" aria-labelledby="modalResolveIssueLabel<%= ev.original.id %>" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content text-start">
                <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/issues/<%= ev.original.id %>/status" method="POST">
                  <input type="hidden" name="status" value="RESOLVED" />
                  <input type="hidden" name="machineId" value="<%= machine.id %>" />
                  <div class="modal-header">
                    <h5 class="modal-title" id="modalResolveIssueLabel<%= ev.original.id %>">
                      <i class="fa-solid fa-circle-check text-success me-1" aria-hidden="true"></i> Marquer l'incident comme résolu
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                  </div>
                  <div class="modal-body">
                    <p class="small text-muted mb-3">
                      L'incident sur <strong><%= machine.name %></strong> sera archivé comme résolu.
                    </p>
                    <label for="resolutionNotes<%= ev.original.id %>" class="form-label small fw-semibold">
                      Notes de réparation / intervention (optionnel) :
                    </label>
                    <textarea class="form-control form-control-sm" id="resolutionNotes<%= ev.original.id %>" name="resolutionNotes" rows="3" placeholder="Ex : Remplacement de la buse d'extrusion 0.4 mm, nettoyage du plateau et réalignement."></textarea>
                  </div>
                  <div class="modal-footer bg-body-tertiary">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary btn-sm">
                      <i class="fa-solid fa-check me-1" aria-hidden="true"></i> Confirmer la résolution
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        <% } %>
      <% }); %>

      <!-- Machine Usage History Section -->
      <div class="card border mb-4" id="history">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
          <h2 class="h6 fw-bold mb-0">
            <i class="fa-solid fa-clock-rotate-left text-secondary me-1" aria-hidden="true"></i> Historique d'utilisation de la machine
          </h2>
          <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
            <%= usageStats.totalSessions %> session(s)
          </span>
        </div>

        <div class="card-body">
          <!-- Usage Metrics Overview -->
          <div class="row g-3 mb-4">
            <div class="col-md-4">
              <div class="card h-100 fab-kpi-card">
                <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                  <div>
                    <div class="small text-muted fw-semibold">Nombre total d'utilisations</div>
                    <div class="kpi-value tabular-nums mt-1"><%= usageStats.totalSessions %></div>
                  </div>
                  <span class="fab-kpi-icon" aria-hidden="true">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                  </span>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card h-100 fab-kpi-card">
                <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                  <div>
                    <div class="small text-muted fw-semibold">Contributeurs uniques</div>
                    <div class="kpi-value tabular-nums mt-1"><%= usageStats.uniqueUsers %></div>
                  </div>
                  <span class="fab-kpi-icon" aria-hidden="true">
                    <i class="fa-solid fa-users"></i>
                  </span>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card h-100 fab-kpi-card">
                <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                  <div>
                    <div class="small text-muted fw-semibold">Dernière utilisation</div>
                    <div class="kpi-value tabular-nums mt-1"><%= usageStats.lastUsed %></div>
                  </div>
                  <span class="fab-kpi-icon" aria-hidden="true">
                    <i class="fa-solid fa-calendar-check"></i>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Usage History Table -->
          <% if (usageHistory.length === 0) { %>
            <div class="text-center text-muted py-5">
              <i class="fa-solid fa-clock-rotate-left fa-3x mb-3 opacity-50" aria-hidden="true"></i>
              <p class="mb-0">Aucune utilisation enregistrée pour cette machine pour le moment.</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0" id="machineHistoryTable">
                <thead class="table-light">
                  <tr>
                    <th data-sort="0" scope="col"># <i class="fa-solid fa-sort text-muted small ms-1" aria-hidden="true"></i></th>
                    <th data-sort="1" scope="col">Date &amp; début <i class="fa-solid fa-sort text-muted small ms-1" aria-hidden="true"></i></th>
                    <th data-sort="2" scope="col">Fin / Durée <i class="fa-solid fa-sort text-muted small ms-1" aria-hidden="true"></i></th>
                    <th data-sort="3" scope="col">Contributeur <i class="fa-solid fa-sort text-muted small ms-1" aria-hidden="true"></i></th>
                    <th data-sort="4" scope="col">Atelier / Espace <i class="fa-solid fa-sort text-muted small ms-1" aria-hidden="true"></i></th>
                    <th scope="col">Impression 3D / Télémétrie</th>
                    <th scope="col" class="text-center">Statut</th>
                    <th scope="col">Commentaires</th>
                  </tr>
                </thead>
                <tbody>
                  <% usageHistory.forEach(function(entry) { %>
                    <tr>
                      <td class="text-muted"><%= entry.id %></td>
                      <td>
                        <strong><%= entry.formattedStartedAt || entry.formattedDate %></strong>
                      </td>
                      <td>
                        <% if (entry.endedAt) { %>
                          <div class="small fw-semibold"><%= entry.formattedEndedAt %></div>
                          <% if (entry.durationFormatted) { %>
                            <span class="badge bg-body-secondary text-secondary-emphasis border">
                              <i class="fa-regular fa-clock me-1" aria-hidden="true"></i><%= entry.durationFormatted %>
                            </span>
                          <% } %>
                        <% } else if (entry.status === 'IN_PROGRESS') { %>
                          <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                            <i class="fa-solid fa-spinner fa-spin me-1" aria-hidden="true"></i>En cours
                          </span>
                        <% } else { %>
                          <span class="text-muted small">-</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (entry.user) { %>
                          <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>users/edit/<%= entry.user.id %>" class="fw-semibold text-decoration-none">
                            <i class="fa-solid fa-user me-1 text-primary" aria-hidden="true"></i><%= entry.user.name %> <%= entry.user.surname %>
                          </a>
                          <div class="small text-muted"><%= entry.user.email %></div>
                        <% } else { %>
                          <span class="text-muted">Contributeur supprimé</span>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge bg-body-secondary text-secondary-emphasis border">
                          <%= entry.workspace %>
                        </span>
                      </td>
                      <td>
                        <% if (entry.filamentQuantity || entry.filamentType || entry.gcodeName || entry.printDuration) { %>
                          <div class="d-flex flex-wrap gap-1 align-items-center">
                            <% if (entry.gcodeName) { %>
                              <span class="badge bg-body-secondary text-secondary-emphasis border" title="Fichier : <%= entry.gcodeName %>">
                                <i class="fa-solid fa-file-code me-1 text-primary" aria-hidden="true"></i><%= entry.gcodeName.length > 20 ? entry.gcodeName.substring(0, 18) + '...' : entry.gcodeName %>
                              </span>
                            <% } %>
                            <% if (entry.filamentQuantity || entry.filamentType) { %>
                              <span class="badge bg-body-secondary text-secondary-emphasis border">
                                <i class="fa-solid fa-cubes me-1" aria-hidden="true"></i><%= entry.filamentQuantity ? entry.filamentQuantity + 'g ' : '' %><%= entry.filamentType || '' %>
                              </span>
                            <% } %>
                            <% if (entry.printDurationFormatted) { %>
                              <span class="badge bg-body-secondary text-secondary-emphasis border" title="Durée d'impression">
                                <i class="fa-solid fa-stopwatch me-1" aria-hidden="true"></i><%= entry.printDurationFormatted %>
                              </span>
                            <% } %>
                          </div>
                        <% } else { %>
                          <span class="text-muted small">-</span>
                        <% } %>
                      </td>
                      <td class="text-center">
                        <% if (entry.endedAt) { %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="fa-solid fa-check me-1" aria-hidden="true"></i>Terminé
                          </span>
                        <% } else if (entry.status === 'IN_PROGRESS') { %>
                          <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                            <i class="fa-solid fa-play me-1" aria-hidden="true"></i>En cours
                          </span>
                        <% } else { %>
                          <span class="badge bg-body-secondary text-secondary-emphasis border">
                            Enregistré
                          </span>
                        <% } %>
                      </td>
                      <td>
                        <% if (entry.comments) { %>
                          <span class="small text-secondary"><%= entry.comments %></span>
                        <% } else { %>
                          <span class="text-muted small">-</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Modal: Déclarer une opération de maintenance -->
      <div class="modal fade" id="modalAddMaintenance" tabindex="-1" aria-labelledby="modalAddMaintenanceLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content">
            <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/maintenance/create" method="POST">
              <input type="hidden" name="machineId" value="<%= machine.id %>" />

              <div class="modal-header">
                <div>
                  <h5 class="modal-title mb-0" id="modalAddMaintenanceLabel">
                    <i class="fa-solid fa-wrench text-primary me-1" aria-hidden="true"></i> Enregistrer une maintenance
                  </h5>
                  <small class="text-muted"><%= machine.name %> &bull; <%= machine.make || '' %> <%= machine.model || '' %></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
              </div>

              <div class="modal-body">
                <!-- Suggestions rapides -->
                <div class="mb-3">
                  <span class="form-label small fw-semibold text-muted d-block mb-2">Interventions fréquentes (clic pour remplir) :</span>
                  <div class="d-flex flex-wrap gap-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-preset-title="Changement de buse" data-preset-type="REPLACEMENT" data-preset-parts="Buse d'extrusion">
                      <i class="fa-solid fa-bolt fa-xs me-1" aria-hidden="true"></i> Changement de buse
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-preset-title="Changement de lentille" data-preset-type="REPLACEMENT" data-preset-parts="Lentille focale ZnSe">
                      <i class="fa-solid fa-bolt fa-xs me-1" aria-hidden="true"></i> Changement de lentille
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-preset-title="Changement de filtre" data-preset-type="REPLACEMENT" data-preset-parts="Filtre HEPA / Charbon">
                      <i class="fa-solid fa-bolt fa-xs me-1" aria-hidden="true"></i> Changement de filtre
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-preset-title="Nettoyage &amp; alignement des miroirs" data-preset-type="CLEANING" data-preset-parts="">
                      <i class="fa-solid fa-bolt fa-xs me-1" aria-hidden="true"></i> Alignement miroirs
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-preset-title="Nivellement plateau &amp; calibration Z" data-preset-type="CALIBRATION" data-preset-parts="">
                      <i class="fa-solid fa-bolt fa-xs me-1" aria-hidden="true"></i> Calibration plateau
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-preset-title="Tension courroies &amp; lubrification axes" data-preset-type="PREVENTIVE" data-preset-parts="">
                      <i class="fa-solid fa-bolt fa-xs me-1" aria-hidden="true"></i> Lubrification &amp; courroies
                    </button>
                  </div>
                </div>

                <div class="row g-3">
                  <!-- Intitulé -->
                  <div class="col-md-8">
                    <label for="maintenanceTitle" class="form-label small fw-semibold">Intitulé de l'intervention <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-tag text-muted" aria-hidden="true"></i></span>
                      <input
                        type="text"
                        class="form-control"
                        id="maintenanceTitle"
                        name="title"
                        placeholder="Ex : Changement de lentille 20 mm, Remplacement buse 0.4..."
                        required
                        autocomplete="off"
                      />
                    </div>
                  </div>

                  <!-- Type d'entretien -->
                  <div class="col-md-4">
                    <label for="maintenanceType" class="form-label small fw-semibold">Nature <span class="text-danger">*</span></label>
                    <select class="form-select" id="maintenanceType" name="type">
                      <option value="PREVENTIVE">Entretien préventif</option>
                      <option value="CURATIVE">Réparation / Dépannage</option>
                      <option value="REPLACEMENT" selected>Remplacement pièce</option>
                      <option value="CALIBRATION">Calibrage &amp; réglages</option>
                      <option value="CLEANING">Nettoyage &amp; graissage</option>
                      <option value="OTHER">Autre opération</option>
                    </select>
                  </div>

                  <!-- Date -->
                  <div class="col-md-4">
                    <label for="maintenanceDate" class="form-label small fw-semibold">Date de réalisation <span class="text-danger">*</span></label>
                    <% const todayStr = new Date().toISOString().split('T')[0]; %>
                    <input type="date" class="form-control" id="maintenanceDate" name="maintenanceDate" value="<%= todayStr %>" required />
                  </div>

                  <!-- Pièces remplacées -->
                  <div class="col-md-5">
                    <label for="maintenanceParts" class="form-label small fw-semibold">Pièces ou consommables changés</label>
                    <div class="input-group">
                      <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-screwdriver text-muted" aria-hidden="true"></i></span>
                      <input
                        type="text"
                        class="form-control"
                        id="maintenanceParts"
                        name="partsReplaced"
                        placeholder="Ex : Lentille ZnSe, Buse laiton 0.4 mm..."
                        autocomplete="off"
                      />
                    </div>
                  </div>

                  <!-- Coût estimé -->
                  <div class="col-md-3">
                    <label for="maintenanceCost" class="form-label small fw-semibold">Coût estimé (€)</label>
                    <div class="input-group">
                      <input type="number" step="0.01" min="0" class="form-control" id="maintenanceCost" name="cost" placeholder="0.00" />
                      <span class="input-group-text bg-body-tertiary">€</span>
                    </div>
                  </div>

                  <!-- Intervenant -->
                  <div class="col-md-6">
                    <label for="maintenanceOperator" class="form-label small fw-semibold">Réalisé par (équipe)</label>
                    <div class="input-group">
                      <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-user-gear text-muted" aria-hidden="true"></i></span>
                      <input
                        type="text"
                        class="form-control"
                        id="maintenanceOperator"
                        name="operator"
                        value="<%= typeof username !== 'undefined' ? username : 'Équipe' %>"
                        required
                      />
                    </div>
                  </div>

                  <!-- Description / Observations -->
                  <div class="col-12">
                    <label for="maintenanceDescription" class="form-label small fw-semibold">Détails, mesures et observations</label>
                    <textarea
                      class="form-control"
                      id="maintenanceDescription"
                      name="description"
                      rows="3"
                      placeholder="Précisez le contexte de l'intervention, les réglages appliqués ou l'état de la pièce remplacée..."
                    ></textarea>
                  </div>

                  <!-- Option clore pannes ouvertes -->
                  <% if (safeOpenIssuesCount > 0) { %>
                  <div class="col-12">
                    <div class="form-check form-switch p-3 bg-warning-subtle rounded border border-warning-subtle">
                      <input class="form-check-input ms-0 me-2" type="checkbox" id="resolveOpenIssues" name="resolveOpenIssues" value="true" checked />
                      <label class="form-check-label fw-bold text-warning-emphasis small" for="resolveOpenIssues">
                        <i class="fa-solid fa-check-double me-1" aria-hidden="true"></i> Résoudre automatiquement les <%= safeOpenIssuesCount %> panne(s) actuellement signalée(s) sur cette machine
                      </label>
                      <div class="small text-muted ps-4">L'enregistrement de cette maintenance marquera ces incidents comme résolus dans l'historique.</div>
                    </div>
                  </div>
                  <% } %>
                </div>
              </div>

              <div class="modal-footer bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary btn-sm">
                  <i class="fa-solid fa-check me-1" aria-hidden="true"></i> Enregistrer l'opération
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
        // Client-side event filtering between ALL, MAINTENANCE, and ISSUE
        function filterMachineEvents(kind, btnEl) {
          const rows = document.querySelectorAll("#tableMachineEvents tbody tr.event-row");
          rows.forEach(row => {
            if (kind === "ALL") {
              row.style.display = "";
            } else if (kind === "MAINTENANCE") {
              row.style.display = row.classList.contains("event-maintenance") ? "" : "none";
            } else if (kind === "ISSUE") {
              row.style.display = row.classList.contains("event-issue") ? "" : "none";
            }
          });

          if (btnEl && btnEl.parentElement) {
            btnEl.parentElement.querySelectorAll("button").forEach(b => b.classList.remove("active"));
            btnEl.classList.add("active");
          }
        }

        // Apply quick preset to maintenance modal
        function applyMaintenancePreset(title, type, parts) {
          const titleInput = document.getElementById("maintenanceTitle");
          const typeSelect = document.getElementById("maintenanceType");
          const partsInput = document.getElementById("maintenanceParts");

          if (titleInput) titleInput.value = title;
          if (typeSelect && type) typeSelect.value = type;
          if (partsInput && parts) partsInput.value = parts;
          if (titleInput) titleInput.focus();
        }

        document.querySelectorAll("#eventFilterGroup [data-event-filter]").forEach(btn => {
          btn.addEventListener("click", () => {
            filterMachineEvents(btn.dataset.eventFilter || "ALL", btn);
          });
        });

        document.querySelectorAll("[data-preset-title]").forEach(btn => {
          btn.addEventListener("click", () => {
            applyMaintenancePreset(
              btn.dataset.presetTitle || "",
              btn.dataset.presetType || "",
              btn.dataset.presetParts || ""
            );
          });
        });
      </script>

      <%- include('../includes/footer.html') %>
  </body>
</html>
