<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Historique de consommation lié aux projets" />
    <title>Consommation par projet • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

    <%- include('../includes/pagehead.html') %>
  </head>

  <body class="d-flex justify-content-center bg-body-tertiary py-4">
    <%- include('../includes/light-dark.html') %>

    <main class="main-container">
      <%- include('../includes/header.html') %>

      <!-- Page Header -->
      <div class="fab-page-header">
        <div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <h1 class="fab-page-title">Consommation par projet</h1>
            <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
              <%= stats.totalEntries %> prélèvement(s)
            </span>
          </div>
          <p class="fab-page-subtitle">Historique des matériaux et consommables utilisés dans le cadre de chaque projet</p>
        </div>
        <div class="fab-page-actions"></div>
      </div>

      <!-- KPI Overview Cards -->
      <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
          <div class="card h-100 fab-kpi-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="small text-muted fw-semibold">Projets actifs</div>
                <div class="kpi-value tabular-nums mt-1"><%= stats.activeProjectsCount %></div>
                <div class="small text-muted mt-1">Hors archivés</div>
              </div>
              <span class="fab-kpi-icon" aria-hidden="true">
                <i class="fa-solid fa-folder-open"></i>
              </span>
            </div>
          </div>
        </div>

        <div class="col-md-3 col-sm-6">
          <div class="card h-100 fab-kpi-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="small text-muted fw-semibold">Volume consommé</div>
                <div class="kpi-value tabular-nums mt-1"><%= stats.totalUnits %></div>
                <div class="small text-muted mt-1">Unités de consommables</div>
              </div>
              <span class="fab-kpi-icon" aria-hidden="true">
                <i class="fa-solid fa-cubes"></i>
              </span>
            </div>
          </div>
        </div>

        <div class="col-md-3 col-sm-6">
          <div class="card h-100 fab-kpi-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="small text-muted fw-semibold">Montant total</div>
                <div class="kpi-value tabular-nums mt-1"><%= stats.totalCost %> €</div>
                <div class="small text-muted mt-1">Coût cumulé sur projets</div>
              </div>
              <span class="fab-kpi-icon" aria-hidden="true">
                <i class="fa-solid fa-coins"></i>
              </span>
            </div>
          </div>
        </div>

        <div class="col-md-3 col-sm-6">
          <div class="card h-100 fab-kpi-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div class="min-w-0">
                <div class="small text-muted fw-semibold">Matériau phare</div>
                <div class="fw-bold text-truncate mt-1" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= stats.topMaterial %>">
                  <%= stats.topMaterial %>
                </div>
                <div class="small text-muted mt-1">Le plus sollicité</div>
              </div>
              <span class="fab-kpi-icon" aria-hidden="true">
                <i class="fa-solid fa-star"></i>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Filters and Controls -->
      <div class="fab-filter-bar">
        <div class="row g-2 align-items-center">
          <div class="col-md-5">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
              <input
                type="text"
                id="projectConsumptionSearch"
                class="form-control"
                placeholder="Rechercher par projet, matériau, contributeur..."
                aria-label="Rechercher une consommation par projet, matériau ou contributeur"
              />
            </div>
          </div>
          <div class="col-md-4">
            <select id="projectSelectFilter" class="form-select form-select-sm" aria-label="Filtrer par projet">
              <option value="" selected>-- Choisir un projet --</option>
              <option value="all">Tous les projets (<%= projectGroups.length %>)</option>
              <% projectGroups.forEach(function(group) { %>
                <option value="<%= group.project.id %>">
                  <%= group.project.url.replace(/^https?:\/\//, '') %> (<%= group.entries.length %> cons.<% if (!group.project.active && group.project.id !== 0) { %> - Archivé<% } %>)
                </option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-3 text-end">
            <div class="btn-group btn-group-sm w-100" role="group" aria-label="Mode d'affichage">
              <button type="button" class="btn btn-outline-secondary active" id="btnViewCards">
                <i class="fa-solid fa-grip-vertical me-1" aria-hidden="true"></i> Par projet
              </button>
              <button type="button" class="btn btn-outline-secondary" id="btnViewTable">
                <i class="fa-solid fa-table-list me-1" aria-hidden="true"></i> Tout lister
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Initial empty prompt shown by default when no search / project selected -->
      <div id="initialEmptyPrompt" class="card border text-center py-5 mb-4">
        <div class="card-body py-4">
          <div class="text-secondary mb-3">
            <i class="fa-solid fa-diagram-project fa-3x opacity-75" aria-hidden="true"></i>
          </div>
          <h2 class="h5 fw-bold">Sélectionnez un projet pour consulter sa consommation</h2>
          <p class="text-muted mx-auto mb-0" style="max-width: 520px;">
            Choisissez un projet dans le menu déroulant ci-dessus ou saisissez un mot-clé dans la barre de recherche pour afficher les consommables et matériaux associés.
          </p>
        </div>
      </div>

      <!-- Prompt when search yields 0 results -->
      <div id="noResultsPrompt" class="card border text-center py-5 mb-4" style="display: none;">
        <div class="card-body py-4">
          <div class="text-muted mb-3">
            <i class="fa-solid fa-folder-open fa-3x opacity-50" aria-hidden="true"></i>
          </div>
          <h2 class="h5 fw-bold">Aucun résultat trouvé</h2>
          <p class="text-muted mb-0">Aucun projet ou consommation ne correspond à vos critères de recherche.</p>
        </div>
      </div>

      <!-- VIEW 1: Grouped by Project Cards -->
      <div id="cardsView" style="display: none;">
        <% if (projectGroups.length === 0) { %>
          <div class="text-center text-muted py-5 card border">
            <i class="fa-solid fa-diagram-project fa-3x mb-3 opacity-50" aria-hidden="true"></i>
            <p class="mb-0">Aucun historique de consommation lié à des projets pour le moment.</p>
          </div>
        <% } else { %>
          <% projectGroups.forEach(function(group) { %>
            <div class="card border mb-4 project-card-item" data-project-id="<%= group.project.id %>">
              <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center py-3 flex-wrap gap-2">
                <div class="d-flex align-items-center">
                  <i class="fa-solid fa-folder-open text-secondary fs-5 me-2" aria-hidden="true"></i>
                  <div>
                    <h2 class="h6 mb-0 fw-bold">
                      <% const validGroupUrl = group.project.id !== 0 ? safeHttpUrl(group.project.url) : null; %>
                      <% if (validGroupUrl) { %>
                        <a href="<%= validGroupUrl %>" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                          <%= validGroupUrl %> <i class="fa-solid fa-arrow-up-right-from-square small text-muted ms-1" aria-hidden="true"></i>
                        </a>
                      <% } else { %>
                        <%= group.project.url %>
                      <% } %>
                    </h2>
                    <div class="small text-muted mt-1 d-flex align-items-center flex-wrap gap-1">
                      <% if (group.project.projecttype) { %>
                        <span class="badge bg-body-secondary text-secondary-emphasis border"><%= group.project.projecttype.name %></span>
                      <% } %>
                      <% if (group.project.active) { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Actif</span>
                      <% } else if (group.project.id !== 0) { %>
                        <span class="badge bg-body-secondary text-secondary-emphasis border">Archivé</span>
                      <% } %>
                      <span
                        class="badge bg-body-secondary text-secondary-emphasis border"
                        data-bs-toggle="tooltip"
                        data-bs-html="true"
                        data-bs-placement="top"
                        title="<% if (group.contributorsList.length > 0) { %><strong>Contributeurs (<%= group.contributorsCount %>) :</strong><br><%- group.contributorsList.map(function(u) { return escapeHtml(u); }).join('<br>') %><% } else { %>Aucun contributeur enregistré<% } %>"
                        style="cursor: help;"
                      >
                        <i class="fa-solid fa-users me-1" aria-hidden="true"></i><%= group.contributorsCount %> contributeur(s)
                      </span>
                    </div>
                  </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                  <span class="badge bg-body-secondary text-secondary-emphasis border">
                    <i class="fa-solid fa-cubes me-1" aria-hidden="true"></i><%= group.totalUnits %> unité(s)
                  </span>
                  <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                    <i class="fa-solid fa-coins me-1" aria-hidden="true"></i><%= group.totalCost %> €
                  </span>
                </div>
              </div>

              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th scope="col" class="ps-3">Date</th>
                      <th scope="col">Consommable</th>
                      <th scope="col">Catégorie</th>
                      <th scope="col" class="text-center">Quantité</th>
                      <th scope="col" class="text-end">Prix unitaire</th>
                      <th scope="col" class="text-end">Total</th>
                      <th scope="col">Contributeur</th>
                      <th scope="col" class="pe-3">Atelier</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% group.entries.forEach(function(entry) { %>
                      <tr class="project-entry-row" data-search-text="<%= (group.project.url + ' ' + entry.consumableName + ' ' + entry.categoryName + ' ' + entry.userName + ' ' + entry.workspaceName).toLowerCase() %>">
                        <td class="ps-3 small"><strong><%= entry.formattedDate %></strong></td>
                        <td>
                          <span class="fw-semibold"><%= entry.consumableName %></span>
                        </td>
                        <td>
                          <span class="badge bg-body-secondary text-secondary-emphasis border"><%= entry.categoryName %></span>
                        </td>
                        <td class="text-center">
                          <span class="badge bg-body-secondary text-secondary-emphasis border"><%= entry.quantity %> <%= entry.unit %></span>
                        </td>
                        <td class="text-end small text-muted"><%= entry.unitCost < 0.1 ? entry.unitCost.toFixed(4) : entry.unitCost.toFixed(2) %> € / <%= entry.unit %></td>
                        <td class="text-end fw-bold text-danger"><%= entry.totalCost.toFixed(2) %> €</td>
                        <td>
                          <% if (entry.user) { %>
                            <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>users/edit/<%= entry.user.id %>" class="text-decoration-none">
                              <i class="fa-solid fa-user small me-1 text-primary" aria-hidden="true"></i><%= entry.userName %>
                            </a>
                          <% } else { %>
                            <span class="text-muted"><%= entry.userName %></span>
                          <% } %>
                        </td>
                        <td class="pe-3">
                          <span class="small text-secondary"><%= entry.workspaceName %></span>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>

      <!-- VIEW 2: Global Table View -->
      <div id="tableView" style="display: none;">
        <div class="card border mb-4">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="globalConsumptionTable">
              <thead class="table-light">
                <tr>
                  <th data-sort="0" scope="col" class="ps-3">Projet <i class="fa-solid fa-sort text-muted small ms-1" aria-hidden="true"></i></th>
                  <th data-sort="1" scope="col">Date <i class="fa-solid fa-sort text-muted small ms-1" aria-hidden="true"></i></th>
                  <th data-sort="2" scope="col">Consommable <i class="fa-solid fa-sort text-muted small ms-1" aria-hidden="true"></i></th>
                  <th data-sort="3" scope="col">Catégorie <i class="fa-solid fa-sort text-muted small ms-1" aria-hidden="true"></i></th>
                  <th data-sort="4" scope="col" class="text-center">Quantité <i class="fa-solid fa-sort text-muted small ms-1" aria-hidden="true"></i></th>
                  <th data-sort="5" scope="col" class="text-end">Coût (€) <i class="fa-solid fa-sort text-muted small ms-1" aria-hidden="true"></i></th>
                  <th data-sort="6" scope="col">Contributeur <i class="fa-solid fa-sort text-muted small ms-1" aria-hidden="true"></i></th>
                  <th data-sort="7" scope="col" class="pe-3">Atelier <i class="fa-solid fa-sort text-muted small ms-1" aria-hidden="true"></i></th>
                </tr>
              </thead>
              <tbody>
                <% allEntries.forEach(function(entry) { %>
                  <tr class="global-entry-row" data-project-id="<%= entry.projectId || 0 %>" data-search-text="<%= (entry.projectUrl + ' ' + entry.consumableName + ' ' + entry.categoryName + ' ' + entry.userName + ' ' + entry.workspaceName).toLowerCase() %>">
                    <td class="ps-3">
                      <% const validEntryUrl = entry.project ? safeHttpUrl(entry.project.url) : null; %>
                      <% if (validEntryUrl) { %>
                        <a href="<%= validEntryUrl %>" target="_blank" rel="noopener noreferrer" class="small fw-semibold text-decoration-none" title="<%= validEntryUrl %>">
                          <%= validEntryUrl.replace(/^https?:\/\//, '').substring(0, 32) %>...
                        </a>
                      <% } else { %>
                        <span class="small text-muted"><%= entry.projectUrl %></span>
                      <% } %>
                    </td>
                    <td class="small"><strong><%= entry.formattedDate %></strong></td>
                    <td><span class="fw-semibold"><%= entry.consumableName %></span></td>
                    <td><span class="badge bg-body-secondary text-secondary-emphasis border"><%= entry.categoryName %></span></td>
                    <td class="text-center"><span class="badge bg-body-secondary text-secondary-emphasis border"><%= entry.quantity %> <%= entry.unit %></span></td>
                    <td class="text-end fw-bold text-danger"><%= entry.totalCost.toFixed(2) %> €</td>
                    <td>
                      <% if (entry.user) { %>
                        <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>users/edit/<%= entry.user.id %>" class="small text-decoration-none">
                          <%= entry.userName %>
                        </a>
                      <% } else { %>
                        <span class="small text-muted"><%= entry.userName %></span>
                      <% } %>
                    </td>
                    <td class="pe-3"><span class="small text-secondary"><%= entry.workspaceName %></span></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <%- include('../includes/footer.html') %>

    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
      let currentViewMode = 'cards'; // 'cards' or 'table'

      const btnCards = document.getElementById('btnViewCards');
      const btnTable = document.getElementById('btnViewTable');
      const cardsView = document.getElementById('cardsView');
      const tableView = document.getElementById('tableView');
      const searchInput = document.getElementById('projectConsumptionSearch');
      const projectFilter = document.getElementById('projectSelectFilter');
      const initialPrompt = document.getElementById('initialEmptyPrompt');
      const noResultsPrompt = document.getElementById('noResultsPrompt');

      function initTooltips() {
        const triggers = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        triggers.forEach(el => {
          if (!bootstrap.Tooltip.getInstance(el)) {
            new bootstrap.Tooltip(el);
          }
        });
      }

      btnCards.addEventListener('click', function () {
        btnCards.classList.add('active');
        btnTable.classList.remove('active');
        currentViewMode = 'cards';
        filterContent();
      });

      btnTable.addEventListener('click', function () {
        btnTable.classList.add('active');
        btnCards.classList.remove('active');
        currentViewMode = 'table';
        filterContent();
      });

      function filterContent() {
        const query = (searchInput.value || '').trim().toLowerCase();
        const selectedProj = projectFilter.value;

        // By default: if no search query and no project selected, display no projects!
        const isFilterActive = query !== '' || selectedProj !== '';

        if (!isFilterActive) {
          initialPrompt.style.display = '';
          noResultsPrompt.style.display = 'none';
          cardsView.style.display = 'none';
          tableView.style.display = 'none';
          return;
        }

        initialPrompt.style.display = 'none';

        let totalVisibleCards = 0;
        let totalVisibleRows = 0;

        // Filter cards
        document.querySelectorAll('.project-card-item').forEach(card => {
          const projId = card.getAttribute('data-project-id');
          const matchesProj = (selectedProj === 'all' || selectedProj === '' || projId === selectedProj);

          let visibleRowsInCard = 0;
          card.querySelectorAll('.project-entry-row').forEach(row => {
            const text = row.getAttribute('data-search-text') || '';
            const matchesQuery = query === '' || text.includes(query);
            if (matchesProj && matchesQuery) {
              row.style.display = '';
              visibleRowsInCard++;
            } else {
              row.style.display = 'none';
            }
          });

          if (matchesProj && visibleRowsInCard > 0) {
            card.style.display = '';
            totalVisibleCards++;
          } else {
            card.style.display = 'none';
          }
        });

        // Filter global table rows
        document.querySelectorAll('.global-entry-row').forEach(row => {
          const projId = row.getAttribute('data-project-id');
          const text = row.getAttribute('data-search-text') || '';
          const matchesProj = (selectedProj === 'all' || selectedProj === '' || projId === selectedProj);
          const matchesQuery = query === '' || text.includes(query);

          if (matchesProj && matchesQuery) {
            row.style.display = '';
            totalVisibleRows++;
          } else {
            row.style.display = 'none';
          }
        });

        const hasResults = currentViewMode === 'cards' ? totalVisibleCards > 0 : totalVisibleRows > 0;

        if (hasResults) {
          noResultsPrompt.style.display = 'none';
          if (currentViewMode === 'cards') {
            cardsView.style.display = '';
            tableView.style.display = 'none';
          } else {
            cardsView.style.display = 'none';
            tableView.style.display = '';
          }
        } else {
          noResultsPrompt.style.display = '';
          cardsView.style.display = 'none';
          tableView.style.display = 'none';
        }

        initTooltips();
      }

      searchInput.addEventListener('input', filterContent);
      projectFilter.addEventListener('change', filterContent);

      // Check if URL contains ?projectId=...
      const urlParams = new URLSearchParams(window.location.search);
      const initialProjId = urlParams.get('projectId');
      if (initialProjId) {
        projectFilter.value = initialProjId;
      }

      // Run on initial load
      filterContent();
      initTooltips();
    </script>
  </body>
</html>
