<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Gestion des machines du Fablab" />
  <meta name="author" content="Stéphane Muller" />
  <title>Gestion des machines • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

  <%- include('../includes/pagehead.html') %>
</head>

<body class="d-flex justify-content-center bg-body-tertiary py-4">
  <%- include('../includes/light-dark.html') %>

  <main class="main-container">
    <%- include('../includes/header.html') %>

    <%
      const distinctLocs = new Set(machines.filter(m => m.location && m.location.name).map(m => m.location.name)).size;
    %>

    <!-- Page Header -->
    <div class="fab-page-header">
      <div>
        <div class="d-flex flex-wrap align-items-center gap-2">
          <h1 class="fab-page-title">Gestion des machines</h1>
          <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
            <%= machines.length %> machine(s)
          </span>
        </div>
        <p class="fab-page-subtitle">Parc matériel, statuts et caractéristiques techniques</p>
      </div>
      <div class="fab-page-actions">
        <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/manage-types" class="btn btn-outline-secondary btn-sm">
          <i class="fa-solid fa-gears me-1" aria-hidden="true"></i> Types de machines
        </a>
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createMachineModal">
          <i class="fa-solid fa-plus me-1" aria-hidden="true"></i> Nouvelle machine
        </button>
      </div>
    </div>

    <!-- KPI Summary Row -->
    <div class="row g-3 mb-4">
      <div class="col-md-4 col-sm-6">
        <div class="card h-100 fab-kpi-card">
          <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
            <div>
              <div class="small text-muted fw-semibold">Total machines</div>
              <div class="kpi-value tabular-nums mt-1"><%= machines.length %></div>
            </div>
            <span class="fab-kpi-icon" aria-hidden="true">
              <i class="fa-solid fa-screwdriver-wrench"></i>
            </span>
          </div>
        </div>
      </div>
      <div class="col-md-4 col-sm-6">
        <div class="card h-100 fab-kpi-card">
          <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
            <div>
              <div class="small text-muted fw-semibold">Catégories actives</div>
              <div class="kpi-value tabular-nums mt-1"><%= categories.length %></div>
            </div>
            <span class="fab-kpi-icon" aria-hidden="true">
              <i class="fa-solid fa-layer-group"></i>
            </span>
          </div>
        </div>
      </div>
      <div class="col-md-4 col-sm-12">
        <div class="card h-100 fab-kpi-card">
          <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
            <div>
              <div class="small text-muted fw-semibold">Emplacements distincts</div>
              <div class="kpi-value tabular-nums mt-1"><%= distinctLocs %></div>
            </div>
            <span class="fab-kpi-icon" aria-hidden="true">
              <i class="fa-solid fa-location-dot"></i>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Category Filter Bar -->
    <div class="fab-filter-bar">
      <div class="row g-2 align-items-center">
        <div class="col-md-7 col-12">
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="small fw-semibold text-muted me-1">
              <i class="fa-solid fa-filter me-1" aria-hidden="true"></i>Catégorie :
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary active filter-category-btn" data-category="all">
              Toutes (<%= machines.length %>)
            </button>
            <% categories.forEach(function(cat) { 
                 const catCount = machines.filter(m => m.categoryId === cat.id).length;
            %>
              <button type="button" class="btn btn-sm btn-outline-secondary filter-category-btn" data-category="<%= cat.id %>">
                <%= cat.name %> (<%= catCount %>)
              </button>
            <% }); %>
            <% const uncatCount = machines.filter(m => !m.categoryId).length; %>
            <% if (uncatCount > 0) { %>
              <button type="button" class="btn btn-sm btn-outline-secondary filter-category-btn" data-category="none">
                Sans catégorie (<%= uncatCount %>)
              </button>
            <% } %>
          </div>
        </div>
        <div class="col-md-5 col-12">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
            <input
              type="text"
              id="searchMachineInput"
              class="form-control"
              placeholder="Rechercher par nom, marque, modèle, lieu..."
              aria-label="Rechercher une machine par nom, marque, modèle ou lieu"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="card border mb-5">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" id="machinesTable">
            <thead class="table-light">
              <tr>
                <th scope="col" class="ps-3">#</th>
                <th scope="col"><%= typeof __ !== 'undefined' ? __('machines.col_name') : 'Nom' %></th>
                <th scope="col">Modèle</th>
                <th scope="col"><%= typeof __ !== 'undefined' ? __('machines.col_type') : 'Type' %></th>
                <th scope="col"><%= typeof __ !== 'undefined' ? __('machines.col_location') : 'Emplacement' %></th>
                <th scope="col"><%= typeof __ !== 'undefined' ? __('machines.col_access') : 'Niveau d\'accès' %></th>
                <th scope="col" class="text-end pe-3"><%= typeof __ !== 'undefined' ? __('machines.col_actions') : 'Actions' %></th>
              </tr>
            </thead>
            <tbody>
              <% machines.forEach(function(machine) {
                   const modelDisplay = [machine.make, machine.model].filter(Boolean).join(' ').trim();
              %>
              <tr class="machine-row" data-cat-id="<%= machine.categoryId || 'none' %>" data-search-text="<%= (machine.name + ' ' + (machine.make || '') + ' ' + (machine.model || '') + ' ' + (machine.category ? machine.category.name : '') + ' ' + (machine.machinetype ? machine.machinetype.name : '') + ' ' + (machine.location ? machine.location.name : '')).toLowerCase() %>">
                <th scope="row" class="ps-3 text-muted">#<%= machine.id %></th>
                <td>
                  <span class="fw-semibold"><%= machine.name %></span>
                </td>
                <td>
                  <% if (modelDisplay) { %>
                    <span class="small text-body-secondary"><%= modelDisplay %></span>
                  <% } else { %>
                    <span class="text-muted small">-</span>
                  <% } %>
                </td>
                <td>
                  <% if (machine.machinetype) { %>
                    <span class="badge bg-body-secondary text-secondary-emphasis border"><%= machine.machinetype.name %></span>
                  <% } else { %>
                    <span class="text-muted small">-</span>
                  <% } %>
                </td>
                <td><span class="small text-body-secondary"><i class="fa-solid fa-location-dot fa-xs text-muted me-1" aria-hidden="true"></i><%= machine.location ? machine.location.name : '-' %></span></td>
                <td>
                  <% if (machine.access) { %>
                    <span class="badge bg-body-secondary text-secondary-emphasis border"><%= machine.access.name %></span>
                  <% } else { %>
                    <span class="text-muted small">-</span>
                  <% } %>
                </td>
                <td class="text-end pe-3">
                  <div class="fab-row-actions">
                    <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/view/<%= machine.id %>" class="btn btn-outline-secondary btn-sm" title="<%= typeof __ !== 'undefined' ? __('machines.action_view') : 'Voir la fiche' %>" aria-label="Voir la fiche de <%= machine.name %>">
                      <i class="fa-solid fa-eye" aria-hidden="true"></i>
                    </a>
                    <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/view/<%= machine.id %>#history" class="btn btn-outline-secondary btn-sm" title="<%= typeof __ !== 'undefined' ? __('machines.action_history') : 'Historique d\'utilisation' %>" aria-label="Historique d'utilisation de <%= machine.name %>">
                      <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
                    </a>
                    <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/edit/<%= machine.id %>" class="btn btn-outline-primary btn-sm" title="<%= typeof __ !== 'undefined' ? __('machines.action_edit') : 'Modifier' %>" aria-label="Modifier <%= machine.name %>">
                      <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                    </a>
                    <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/delete/<%= machine.id %>" class="d-inline" data-confirm="<%= typeof __ !== 'undefined' ? __('machines.confirm_delete') : 'Êtes-vous sûr de vouloir supprimer cette machine ?' %>">
                      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                      <button type="submit" class="btn btn-outline-danger btn-sm" title="<%= typeof __ !== 'undefined' ? __('machines.action_delete') : 'Supprimer' %>" aria-label="Supprimer <%= machine.name %>">
                        <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }); %>
              <tr id="noMachinesRow" style="display: none;">
                <td colspan="7" class="text-center py-4 text-muted">
                  <i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i> Aucune machine ne correspond aux critères sélectionnés.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="modal fade" id="createMachineModal" tabindex="-1" aria-labelledby="createMachineModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
          <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/machines/create?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="post" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
            <div class="modal-header">
              <h5 class="modal-title" id="createMachineModalLabel">
                <i class="fa-solid fa-circle-plus text-primary me-1" aria-hidden="true"></i> <%= typeof __ !== 'undefined' ? __('machines.create_title') : 'Nouvelle machine' %>
              </h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label for="machineName" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_name') : 'Nom de la machine (optionnel)' %></label>
                  <input type="text" class="form-control" id="machineName" name="name" placeholder="Ex : Prusa MK4 #1" />
                </div>
                <div class="col-md-3">
                  <label for="machineTypeId" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_type') : 'Type' %></label>
                  <select class="form-select" id="machineTypeId" name="machinetypeId" required>
                    <option value="" selected disabled><%= typeof __ !== 'undefined' ? __('machines.select_type') : 'Sélectionner un type' %></option>
                    <% machinetypes.forEach(function(machinetype) { %>
                      <option value="<%= machinetype.id %>"><%= machinetype.name %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="col-md-3">
                  <label for="machineCategoryId" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_category') : 'Catégorie' %></label>
                  <select class="form-select" id="machineCategoryId" name="categoryId">
                    <option value=""><%= typeof __ !== 'undefined' ? __('machines.no_category') : '(Sans catégorie)' %></option>
                    <% categories.forEach(function(cat) { %>
                      <option value="<%= cat.id %>"><%= cat.name %></option>
                    <% }); %>
                  </select>
                </div>
              </div>
              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label for="machineMake" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_make') : 'Marque / Fabricant' %></label>
                  <input type="text" class="form-control" id="machineMake" name="make" placeholder="Marque" required />
                </div>
                <div class="col-md-6">
                  <label for="machineModel" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_model') : 'Modèle' %></label>
                  <input type="text" class="form-control" id="machineModel" name="model" placeholder="Modèle" required />
                </div>
              </div>
              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label for="machineSerialNum" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_serial') : 'Numéro de série' %></label>
                  <input type="text" class="form-control" id="machineSerialNum" name="serialNumber" placeholder="Numéro de série" />
                </div>
                <div class="col-md-6">
                  <label for="machineInternalReference" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_internal_ref') : 'Référence interne (#)' %></label>
                  <input type="number" class="form-control" id="machineInternalReference" name="internalReference" placeholder="Réf." />
                </div>
              </div>
              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label for="machineLocationId" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_location') : 'Emplacement' %></label>
                  <select class="form-select" id="machineLocationId" name="locationId">
                    <option value="" selected><%= typeof __ !== 'undefined' ? __('machines.select_location') : 'Sélectionner un emplacement (optionnel)' %></option>
                    <% locations.forEach(function(location) { %>
                      <option value="<%= location.id %>"><%= location.name %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="col-md-6">
                  <label for="machineAccessId" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_access') : 'Niveau d\'accès' %></label>
                  <select class="form-select" id="machineAccessId" name="accessId" required>
                    <option value="" selected disabled><%= typeof __ !== 'undefined' ? __('machines.select_access') : 'Sélectionner un niveau d\'accès' %></option>
                    <% access.forEach(function(accesslevel) { %>
                      <option value="<%= accesslevel.id %>"><%= accesslevel.name %></option>
                    <% }); %>
                  </select>
                </div>
              </div>
              <div class="row g-3 mb-3">
                <div class="col-md-4">
                  <label for="purchaseDate" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_purchase_date') : 'Date d\'achat' %></label>
                  <input type="date" class="form-control" id="purchaseDate" name="purchaseDate" />
                </div>
                <div class="col-md-4">
                  <label for="lastMaintenance" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_last_maintenance') : 'Dernière maintenance' %></label>
                  <input type="date" class="form-control" id="lastMaintenance" name="lastMaintenance" />
                </div>
                <div class="col-md-4">
                  <label for="warrantyExpiry" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_warranty_expiry') : 'Expiration de garantie' %></label>
                  <input type="date" class="form-control" id="warrantyExpiry" name="warrantyExpiry" />
                </div>
              </div>
              <div class="mb-3">
                <label for="machineDocumentation" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_documentation') : 'URL de documentation (optionnel)' %></label>
                <input type="url" class="form-control" id="machineDocumentation" name="documentation" placeholder="https://..." />
              </div>
              <div class="mb-0">
                <label for="fileInput" class="form-label small fw-semibold"><%= typeof __ !== 'undefined' ? __('machines.field_picture') : 'Photo de la machine (optionnel)' %></label>
                <input type="file" class="form-control" id="fileInput" name="machinePicture" accept="image/*" />
              </div>
            </div>
            <div class="modal-footer bg-body-tertiary">
              <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Annuler</button>
              <button type="submit" class="btn btn-primary btn-sm"><%= typeof __ !== 'undefined' ? __('machines.btn_create') : 'Créer la machine' %></button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
      document.addEventListener('DOMContentLoaded', function () {
        const filterBtns = document.querySelectorAll('.filter-category-btn');
        const searchInput = document.getElementById('searchMachineInput');
        const rows = document.querySelectorAll('#machinesTable tbody tr.machine-row');
        const noRows = document.getElementById('noMachinesRow');

        let currentCat = 'all';

        function filterTable() {
          const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
          let visibleCount = 0;

          rows.forEach(row => {
            const rowCat = row.getAttribute('data-cat-id');
            const text = row.getAttribute('data-search-text') || '';

            const matchesCat = (currentCat === 'all' || rowCat === currentCat);
            const matchesQuery = (query === '' || text.includes(query));

            if (matchesCat && matchesQuery) {
              row.style.display = '';
              visibleCount++;
            } else {
              row.style.display = 'none';
            }
          });

          if (noRows) {
            noRows.style.display = visibleCount === 0 ? '' : 'none';
          }
        }

        filterBtns.forEach(btn => {
          btn.addEventListener('click', function () {
            filterBtns.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            currentCat = this.getAttribute('data-category');
            filterTable();
          });
        });

        if (searchInput) {
          searchInput.addEventListener('input', filterTable);
        }

        // Check if URL contains ?category=...
        const urlParams = new URLSearchParams(window.location.search);
        const catParam = urlParams.get('category');
        if (catParam) {
          const targetBtn = document.querySelector(`.filter-category-btn[data-category="${catParam}"]`);
          if (targetBtn) {
            filterBtns.forEach(b => b.classList.remove('active'));
            targetBtn.classList.add('active');
            currentCat = catParam;
            filterTable();
          }
        }
      });
    </script>

    <%- include('../includes/footer.html') %>

</body>
</html>
