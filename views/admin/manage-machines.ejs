<!doctype html>
<html lang="en" data-bs-theme="auto">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Manage Machines">
  <meta name="author" content="Stéphane Muller">
  <title>Fabtrack - Manage Machines</title>

  <%- include('../includes/pagehead.html') %>
</head>

<body class="d-flex justify-content-center bg-body-tertiary py-4">
  <%- include('../includes/light-dark.html') %>

  <main class="main-container">
    <%- include('../includes/header.html') %>

    <div class="mb-3">
      <a href="/admin" class="btn btn-outline-secondary btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i> Panneau d'administration
      </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="mb-0">
        <i class="fa-solid fa-screwdriver-wrench"></i>&nbsp;&nbsp;Manage Machines
      </h4>
      <div>
        <a href="/admin/machines/manage-types" class="btn btn-outline-secondary btn-sm me-2">
          <i class="fa-solid fa-gears"></i> Machine Types
        </a>
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createMachineModal">
          <i class="fa-solid fa-plus"></i> New Machine
        </button>
      </div>
    </div>

    <!-- Category Filter Bar -->
    <div class="card shadow-sm border-0 mb-4 bg-body-secondary">
      <div class="card-body p-3">
        <div class="row g-2 align-items-center">
          <div class="col-md-7 col-12">
            <div class="d-flex flex-wrap gap-2 align-items-center">
              <span class="small fw-semibold text-muted me-1">
                <i class="fa-solid fa-filter"></i> Catégorie :
              </span>
              <button type="button" class="btn btn-sm btn-outline-primary active filter-category-btn" data-category="all">
                Toutes (<%= machines.length %>)
              </button>
              <% categories.forEach(function(cat) { 
                   const catCount = machines.filter(m => m.categoryId === cat.id).length;
              %>
                <button type="button" class="btn btn-sm btn-outline-primary filter-category-btn" data-category="<%= cat.id %>">
                  <%= cat.name %> (<%= catCount %>)
                </button>
              <% }); %>
              <% const uncatCount = machines.filter(m => !m.categoryId).length; %>
              <% if (uncatCount > 0) { %>
                <button type="button" class="btn btn-sm btn-outline-secondary filter-category-btn" data-category="none">
                  Sans catégorie (<%= uncatCount %>)
                </button>
              <% } %>
            </div>
          </div>
          <div class="col-md-5 col-12">
            <div class="input-group input-group-sm">
              <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
              <input
                type="text"
                id="searchMachineInput"
                class="form-control"
                placeholder="Rechercher par nom, marque, modèle, lieu..."
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-5" id="machinesTable">
        <thead>
          <tr>
            <th scope="col">#</th>
            <th scope="col">Name</th>
            <th scope="col">Type</th>
            <th scope="col">Category</th>
            <th scope="col">Location</th>
            <th scope="col">Access</th>
            <th scope="col" class="text-center">View</th>
            <th scope="col" class="text-center">History</th>
            <th scope="col" class="text-center">Edit</th>
            <th scope="col" class="text-center">Delete</th>
          </tr>
        </thead>
        <tbody>
          <% machines.forEach(function(machine) { %>
          <tr class="machine-row" data-cat-id="<%= machine.categoryId || 'none' %>" data-search-text="<%= (machine.name + ' ' + (machine.make || '') + ' ' + (machine.model || '') + ' ' + (machine.category ? machine.category.name : '') + ' ' + (machine.machinetype ? machine.machinetype.name : '') + ' ' + (machine.location ? machine.location.name : '')).toLowerCase() %>">
            <th scope="row"><%= machine.id %></th>
            <td>
              <strong><%= machine.name %></strong>
              <div class="small text-muted"><%= machine.make %> <%= machine.model %></div>
            </td>
            <td><span class="badge bg-primary"><%= machine.machinetype ? machine.machinetype.name : '-' %></span></td>
            <td>
              <% if (machine.category) { %>
                <span class="badge bg-secondary"><%= machine.category.name %></span>
              <% } else { %>
                <span class="text-muted small">-</span>
              <% } %>
            </td>
            <td><span class="small"><%= machine.location ? machine.location.name : '-' %></span></td>
            <td><span class="small"><%= machine.access ? machine.access.name : '-' %></span></td>
            <td class="text-center">
              <a href="/admin/machines/view/<%= machine.id %>" class="text-info" title="View details">
                <i class="fa-solid fa-eye"></i>
              </a>
            </td>
            <td class="text-center">
              <a href="/admin/machines/view/<%= machine.id %>#history" class="text-secondary" title="Usage history">
                <i class="fa-solid fa-clock-rotate-left"></i>
              </a>
            </td>
            <td class="text-center">
              <a href="/admin/machines/edit/<%= machine.id %>" class="text-primary" title="Edit">
                <i class="fa-solid fa-pen-to-square"></i>
              </a>
            </td>
            <td class="text-center">
              <a href="/admin/machines/delete/<%= machine.id %>" class="text-danger" title="Delete" onclick="return confirm('Are you sure you want to delete <%= machine.name %>?');">
                <i class="fa-solid fa-trash-can"></i>
              </a>
            </td>
          </tr>
          <% }); %>
          <tr id="noMachinesRow" style="display: none;">
            <td colspan="10" class="text-center py-4 text-muted">
              <i class="fa-solid fa-circle-info me-1"></i> Aucune machine ne correspond aux critères sélectionnés.
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="modal fade" id="createMachineModal" tabindex="-1" aria-labelledby="createMachineModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
              <h5 class="modal-title" id="createMachineModalLabel"><i class="fa-solid fa-plus-circle"></i> Create New Machine</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <form action="/admin/machines/create" method="post" enctype="multipart/form-data">
              <div class="row">
                <div class="col-6">
                  <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="machineName" name="name" placeholder="Name">
                    <label for="machineName">Machine Name (optional):</label>
                  </div>
                </div>
                <div class="col-3">
                  <div class="form-floating mb-3">
                    <select class="form-select" id="machineTypeId" name="machinetypeId" required>
                      <option value="" selected disabled>Select type</option>
                      <% machinetypes.forEach(function(machinetype) { %>
                        <option value="<%= machinetype.id %>"><%= machinetype.name %></option>
                      <% }); %>
                    </select>
                    <label for="machineTypeId">Type:</label>
                  </div>
                </div>
                <div class="col-3">
                  <div class="form-floating mb-3">
                    <select class="form-select" id="machineCategoryId" name="categoryId">
                      <option value="">(No category)</option>
                      <% categories.forEach(function(cat) { %>
                        <option value="<%= cat.id %>"><%= cat.name %></option>
                      <% }); %>
                    </select>
                    <label for="machineCategoryId">Category:</label>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-6">
                  <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="machineMake" name="make" placeholder="Make" required>
                    <label for="machineMake">Make / Manufacturer:</label>
                  </div>
                </div>
                <div class="col-6">
                  <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="machineModel" name="model" placeholder="Model" required>
                    <label for="machineModel">Model:</label>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-6">
                  <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="machineSerialNum" name="serialNumber" placeholder="Serial Number">
                    <label for="machineSerialNum">Serial Number:</label>
                  </div>
                </div>
                <div class="col-6">
                  <div class="form-floating mb-3">
                    <input type="number" class="form-control" id="machineInternalReference" name="internalReference" placeholder="Ref">
                    <label for="machineInternalReference">Internal Reference (#):</label>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-6">
                  <div class="form-floating mb-3">
                    <select class="form-select" id="machineLocationId" name="locationId">
                      <option value="" selected>Select location (optional)</option>
                      <% locations.forEach(function(location) { %>
                        <option value="<%= location.id %>"><%= location.name %></option>
                      <% }); %>
                    </select>
                    <label for="machineLocationId">Location:</label>
                  </div>
                </div>
                <div class="col-6">
                  <div class="form-floating mb-3">
                    <select class="form-select" id="machineAccessId" name="accessId" required>
                      <option value="" selected disabled>Select access level</option>
                      <% access.forEach(function(accesslevel) { %>
                        <option value="<%= accesslevel.id %>"><%= accesslevel.name %></option>
                      <% }); %>
                    </select>
                    <label for="machineAccessId">Access Level:</label>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-4">
                  <div class="form-floating mb-3">
                    <input type="date" class="form-control" id="purchaseDate" name="purchaseDate">
                    <label for="purchaseDate">Purchase Date:</label>
                  </div>
                </div>
                <div class="col-4">
                  <div class="form-floating mb-3">
                    <input type="date" class="form-control" id="lastMaintenance" name="lastMaintenance">
                    <label for="lastMaintenance">Last Maintenance:</label>
                  </div>
                </div>
                <div class="col-4">
                  <div class="form-floating mb-3">
                    <input type="date" class="form-control" id="warrantyExpiry" name="warrantyExpiry">
                    <label for="warrantyExpiry">Warranty Expiry:</label>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-12">
                  <div class="form-floating mb-3">
                    <input type="url" class="form-control" id="machineDocumentation" name="documentation" placeholder="URL">
                    <label for="machineDocumentation">Documentation URL (optional):</label>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-12">
                  <label class="form-label small text-muted">Machine Picture (optional):</label>
                  <input type="file" class="form-control" id="fileInput" name="machinePicture" accept="image/*">
                </div>
              </div>
              <button type="submit" class="btn w-100 btn-primary py-2">Create Machine</button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const filterBtns = document.querySelectorAll('.filter-category-btn');
        const searchInput = document.getElementById('searchMachineInput');
        const rows = document.querySelectorAll('#machinesTable tbody tr.machine-row');
        const noRows = document.getElementById('noMachinesRow');

        let currentCat = 'all';

        function filterTable() {
          const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
          let visibleCount = 0;

          rows.forEach(row => {
            const rowCat = row.getAttribute('data-cat-id');
            const text = row.getAttribute('data-search-text') || '';

            const matchesCat = (currentCat === 'all' || rowCat === currentCat);
            const matchesQuery = (query === '' || text.includes(query));

            if (matchesCat && matchesQuery) {
              row.style.display = '';
              visibleCount++;
            } else {
              row.style.display = 'none';
            }
          });

          if (noRows) {
            noRows.style.display = visibleCount === 0 ? '' : 'none';
          }
        }

        filterBtns.forEach(btn => {
          btn.addEventListener('click', function () {
            filterBtns.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            currentCat = this.getAttribute('data-category');
            filterTable();
          });
        });

        if (searchInput) {
          searchInput.addEventListener('input', filterTable);
        }

        // Check if URL contains ?category=...
        const urlParams = new URLSearchParams(window.location.search);
        const catParam = urlParams.get('category');
        if (catParam) {
          const targetBtn = document.querySelector(`.filter-category-btn[data-category="${catParam}"]`);
          if (targetBtn) {
            filterBtns.forEach(b => b.classList.remove('active'));
            targetBtn.classList.add('active');
            currentCat = catParam;
            filterTable();
          }
        }
      });
    </script>

    <%- include('../includes/footer.html') %>

</body>
</html>
