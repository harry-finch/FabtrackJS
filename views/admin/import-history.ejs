<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Importation groupée d'historique et de séances d'enseignement" />
  <title>Import de séances (CSV) • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

  <%- include('../includes/pagehead.html') %>
  <style>
    .dropzone-box {
      border: 2px dashed var(--bs-border-color);
      border-radius: 6px;
      background-color: var(--bs-tertiary-bg);
      transition: all 0.2s ease-in-out;
      cursor: pointer;
    }
    .dropzone-box:hover, .dropzone-box.dragover {
      border-color: var(--bs-primary);
      background-color: var(--bs-primary-subtle);
    }
    .table-scrollable {
      max-height: 480px;
      overflow-y: auto;
    }
  </style>
</head>

<body class="d-flex justify-content-center bg-body-tertiary py-4">
  <%- include('../includes/light-dark.html') %>

  <main class="main-container">
    <%- include('../includes/header.html') %>

    <!-- Page Header -->
    <div class="fab-page-header">
      <div>
        <div class="d-flex flex-wrap align-items-center gap-2">
          <h1 class="fab-page-title">Import de séances &amp; enseignements</h1>
          <span class="badge bg-body-secondary text-secondary-emphasis border">Format CSV</span>
        </div>
        <p class="fab-page-subtitle">Enregistrez d'un coup les présences d'un cours ou atelier avec création automatique des étudiants</p>
      </div>
      <div class="fab-page-actions">
        <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/history/template" class="btn btn-outline-secondary btn-sm">
          <i class="fa-solid fa-file-csv me-1" aria-hidden="true"></i> Télécharger le modèle CSV
        </a>
        <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/view-history" class="btn btn-outline-secondary btn-sm">
          <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Retour à l'historique
        </a>
      </div>
    </div>

    <!-- Étape 1 : Formulaire de téléversement et valeurs par défaut -->
    <div class="card border mb-4" id="uploadStepCard">
      <div class="card-header bg-transparent">
        <h2 class="h6 fw-bold mb-1"><i class="fa-solid fa-1 me-2 text-secondary" aria-hidden="true"></i>Sélectionner le fichier CSV et configurer la séance</h2>
        <p class="text-muted small mb-0 fw-normal">
          Les informations ci-dessous seront appliquées aux étudiants dont les colonnes ne sont pas explicitement définies dans le fichier CSV.
        </p>
      </div>
      <div class="card-body p-4">
        <form id="csvUploadForm" enctype="multipart/form-data">
          <!-- Zone de glisser-déposer pour le fichier CSV -->
          <div class="dropzone-box p-4 text-center mb-4" id="dropzoneBox">
            <input type="file" id="csvFileInput" name="csv_file" accept=".csv,text/csv,text/plain" class="d-none" aria-label="Sélectionner un fichier CSV à importer" required />
            <div id="dropzonePrompt">
              <i class="fa-solid fa-cloud-arrow-up text-primary fs-1 mb-2" aria-hidden="true"></i>
              <h3 class="h6 fw-bold mb-1">Glissez votre fichier CSV ici ou cliquez pour parcourir</h3>
              <p class="text-muted small mb-2">Colonnes requises : <code>nom</code>, <code>prenom</code>, <code>email</code> (séparateur virgule ou point-virgule)</p>
              <button type="button" class="btn btn-sm btn-outline-secondary" data-click-target="csvFileInput">
                <i class="fa-solid fa-folder-open me-1" aria-hidden="true"></i> Choisir un fichier CSV
              </button>
            </div>
            <div id="fileSelectedDisplay" class="d-none">
              <i class="fa-solid fa-file-csv text-success fs-2 mb-2" aria-hidden="true"></i>
              <div class="fw-bold text-success" id="selectedFileName">mon_fichier.csv</div>
              <small class="text-muted" id="selectedFileSize">0 Ko</small>
              <div class="mt-2">
                <button type="button" class="btn btn-sm btn-link text-danger p-0" id="btnRemoveFile">
                  <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i> Changer de fichier
                </button>
              </div>
            </div>
          </div>

          <!-- Réglages par défaut de la séance -->
          <div class="row g-3">
            <div class="col-md-4">
              <label for="default_date" class="form-label small fw-semibold"><i class="fa-solid fa-calendar-day me-1 text-secondary" aria-hidden="true"></i> Date de la séance</label>
              <input type="date" class="form-control" id="default_date" name="default_date" value="<%= todayDate %>" required />
              <small class="text-muted">Utilisée si la colonne <code>date</code> est vide.</small>
            </div>
            <div class="col-md-4">
              <label for="default_arrival" class="form-label small fw-semibold"><i class="fa-solid fa-clock me-1 text-secondary" aria-hidden="true"></i> Heure d'arrivée</label>
              <input type="time" class="form-control" id="default_arrival" name="default_arrival" value="14:00" required />
              <small class="text-muted">Utilisée si la colonne <code>arrivee</code> est vide.</small>
            </div>
            <div class="col-md-4">
              <label for="default_departure" class="form-label small fw-semibold"><i class="fa-solid fa-clock-rotate-left me-1 text-secondary" aria-hidden="true"></i> Heure de départ</label>
              <input type="time" class="form-control" id="default_departure" name="default_departure" value="17:00" />
              <small class="text-muted">Optionnelle (colonne <code>depart</code>).</small>
            </div>

            <div class="col-md-4">
              <label for="default_project_type" class="form-label small fw-semibold"><i class="fa-solid fa-diagram-project me-1 text-secondary" aria-hidden="true"></i> Motif de la visite</label>
              <select class="form-select" id="default_project_type" name="default_project_type">
                <% projecttypes.forEach(function(pt) { %>
                  <option value="<%= pt.name %>" <%= (pt.name.toLowerCase() === 'academic' || pt.name.toLowerCase() === 'enseignement') ? 'selected' : '' %>><%= pt.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="col-md-4">
              <label for="default_workspace_id" class="form-label small fw-semibold"><i class="fa-solid fa-building me-1 text-secondary" aria-hidden="true"></i> Espace du Fablab</label>
              <select class="form-select" id="default_workspace_id" name="default_workspace_id">
                <option value="">-- Aucun espace spécifique --</option>
                <% workspaces.forEach(function(ws) { %>
                  <option value="<%= ws.id %>"><%= ws.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="col-md-4">
              <label for="default_usertype_id" class="form-label small fw-semibold"><i class="fa-solid fa-user-tag me-1 text-secondary" aria-hidden="true"></i> Typologie des nouveaux contributeurs</label>
              <select class="form-select" id="default_usertype_id" name="default_usertype_id">
                <% usertypes.forEach(function(ut) { %>
                  <option value="<%= ut.id %>" <%= ut.name.toLowerCase().includes('étudiant') || ut.name.toLowerCase().includes('etudiant') ? 'selected' : '' %>><%= ut.name %></option>
                <% }); %>
              </select>
              <small class="text-muted">Attribuée aux comptes créés automatiquement.</small>
            </div>

            <div class="col-12 mt-3">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="acceptTerms" name="accept_terms" checked />
                <label class="form-check-label small" for="acceptTerms">
                  <strong>Charte réputée signée :</strong> Valider automatiquement la charte d'utilisation pour les nouveaux étudiants dans le cadre de cet enseignement encadré.
                </label>
              </div>
            </div>
          </div>

          <div class="d-flex justify-content-end mt-4 pt-3 border-top">
            <button type="button" class="btn btn-primary btn-sm" id="btnAnalyzeCsv">
              <i class="fa-solid fa-magnifying-glass-chart me-1" aria-hidden="true"></i> Analyser et prévisualiser le fichier
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Spinner d'analyse -->
    <div id="analysisSpinner" class="card border p-5 text-center my-4 d-none">
      <div class="spinner-border text-primary mx-auto mb-3" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Chargement...</span>
      </div>
      <h2 class="h6 fw-bold mb-1">Analyse du fichier CSV en cours...</h2>
      <p class="text-muted small mb-0">Contrôle des concordances contributeurs, détection des homonymes et validation des horaires.</p>
    </div>

    <!-- Étape 2 : Prévisualisation & Validation des données -->
    <div class="card border mb-4 d-none" id="previewStepCard">
      <div class="card-header bg-transparent d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
          <h2 class="h6 fw-bold mb-1"><i class="fa-solid fa-2 me-2 text-secondary" aria-hidden="true"></i>Prévisualisation &amp; contrôle des concordances</h2>
          <p class="text-muted small mb-0 fw-normal">Vérifiez les données avant de lancer l'enregistrement définitif dans l'historique.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn btn-outline-secondary btn-sm" id="btnBackToUpload">
            <i class="fa-solid fa-rotate-left me-1" aria-hidden="true"></i> Modifier le fichier
          </button>
        </div>
      </div>
      <div class="card-body p-4">
        <!-- KPI récapitulatifs -->
        <div class="row g-3 mb-4">
          <div class="col-6 col-md-3">
            <div class="card h-100 fab-kpi-card">
              <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                <div>
                  <div class="small text-muted fw-semibold">Lignes prêtes</div>
                  <div class="kpi-value tabular-nums mt-1" id="kpiReadyCount">0</div>
                </div>
                <span class="fab-kpi-icon" aria-hidden="true"><i class="fa-solid fa-circle-check"></i></span>
              </div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card h-100 fab-kpi-card">
              <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                <div>
                  <div class="small text-muted fw-semibold">Contributeurs existants</div>
                  <div class="kpi-value tabular-nums mt-1" id="kpiExistingCount">0</div>
                </div>
                <span class="fab-kpi-icon" aria-hidden="true"><i class="fa-solid fa-user-check"></i></span>
              </div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card h-100 fab-kpi-card">
              <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                <div>
                  <div class="small text-muted fw-semibold">Nouveaux contributeurs</div>
                  <div class="kpi-value tabular-nums mt-1" id="kpiNewCount">0</div>
                </div>
                <span class="fab-kpi-icon" aria-hidden="true"><i class="fa-solid fa-user-plus"></i></span>
              </div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card h-100 fab-kpi-card" id="kpiWarningCard">
              <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                <div>
                  <div class="small text-muted fw-semibold">Avertissements</div>
                  <div class="kpi-value tabular-nums mt-1" id="kpiWarningCount">0</div>
                </div>
                <span class="fab-kpi-icon" id="kpiWarningIcon" aria-hidden="true"><i class="fa-solid fa-triangle-exclamation"></i></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Tableau interactif de prévisualisation -->
        <div class="table-responsive table-scrollable border rounded mb-4">
          <table class="table table-hover align-middle mb-0" id="previewTable">
            <thead class="table-light sticky-top">
              <tr>
                <th scope="col" class="text-center" style="width: 50px;">Ligne</th>
                <th scope="col">Étudiant (Nom &amp; Prénom)</th>
                <th scope="col">E-mail</th>
                <th scope="col">Statut contributeur</th>
                <th scope="col">Créneau</th>
                <th scope="col">Projet / UE</th>
                <th scope="col">Statut</th>
              </tr>
            </thead>
            <tbody id="previewTableBody">
              <!-- Rempli dynamiquement en JS -->
            </tbody>
          </table>
        </div>

        <!-- Barre de confirmation -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-3 border-top">
          <div class="small text-muted" id="previewNoticeText">
            <i class="fa-solid fa-circle-info me-1 text-primary" aria-hidden="true"></i> Les nouveaux comptes seront automatiquement créés lors de la confirmation.
          </div>
          <button type="button" class="btn btn-primary btn-sm" id="btnConfirmImport">
            <i class="fa-solid fa-check me-1" aria-hidden="true"></i> Confirmer et importer l'historique
          </button>
        </div>
      </div>
    </div>

    <!-- Étape 3 : Résultat du traitement -->
    <div class="card border p-4 text-center d-none" id="resultCard">
      <div class="d-flex justify-content-center mb-3">
        <span class="fab-kpi-icon bg-success-subtle text-success border-success-subtle" aria-hidden="true">
          <i class="fa-solid fa-circle-check"></i>
        </span>
      </div>
      <h2 class="h5 fw-bold text-success mb-2">Importation terminée avec succès !</h2>
      <p class="text-muted small mb-4" id="resultMessageText">Toutes les visites et contributeurs ont été enregistrés.</p>
      <div class="d-flex justify-content-center gap-2">
        <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/view-history" class="btn btn-primary btn-sm">
          <i class="fa-solid fa-clock-rotate-left me-1" aria-hidden="true"></i> Consulter l'historique
        </a>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnImportAnother">
          <i class="fa-solid fa-plus me-1" aria-hidden="true"></i> Importer un autre fichier
        </button>
      </div>
    </div>

    <%- include('../includes/footer.html') %>

  <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
    document.addEventListener('DOMContentLoaded', () => {
      const dropzoneBox = document.getElementById('dropzoneBox');
      const csvFileInput = document.getElementById('csvFileInput');
      const dropzonePrompt = document.getElementById('dropzonePrompt');
      const fileSelectedDisplay = document.getElementById('fileSelectedDisplay');
      const selectedFileName = document.getElementById('selectedFileName');
      const selectedFileSize = document.getElementById('selectedFileSize');
      const btnRemoveFile = document.getElementById('btnRemoveFile');

      const btnAnalyzeCsv = document.getElementById('btnAnalyzeCsv');
      const uploadStepCard = document.getElementById('uploadStepCard');
      const analysisSpinner = document.getElementById('analysisSpinner');
      const previewStepCard = document.getElementById('previewStepCard');
      const resultCard = document.getElementById('resultCard');

      const previewTableBody = document.getElementById('previewTableBody');
      const kpiReadyCount = document.getElementById('kpiReadyCount');
      const kpiExistingCount = document.getElementById('kpiExistingCount');
      const kpiNewCount = document.getElementById('kpiNewCount');
      const kpiWarningCount = document.getElementById('kpiWarningCount');
      const kpiWarningCard = document.getElementById('kpiWarningCard');
      const kpiWarningIcon = document.getElementById('kpiWarningIcon');

      const btnConfirmImport = document.getElementById('btnConfirmImport');
      const btnBackToUpload = document.getElementById('btnBackToUpload');
      const btnImportAnother = document.getElementById('btnImportAnother');
      const resultMessageText = document.getElementById('resultMessageText');

      let currentAnalysisData = null;

      // Gestion du Drag & Drop
      ['dragenter', 'dragover'].forEach(eventName => {
        dropzoneBox.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzoneBox.classList.add('dragover');
        });
      });

      ['dragleave', 'drop'].forEach(eventName => {
        dropzoneBox.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzoneBox.classList.remove('dragover');
        });
      });

      dropzoneBox.addEventListener('drop', (e) => {
        const files = e.dataTransfer.files;
        if (files.length > 0) {
          csvFileInput.files = files;
          handleFileChosen(files[0]);
        }
      });

      csvFileInput.addEventListener('change', () => {
        if (csvFileInput.files.length > 0) {
          handleFileChosen(csvFileInput.files[0]);
        }
      });

      function handleFileChosen(file) {
        selectedFileName.textContent = file.name;
        selectedFileSize.textContent = (file.size / 1024).toFixed(1) + ' Ko';
        dropzonePrompt.classList.add('d-none');
        fileSelectedDisplay.classList.remove('d-none');
      }

      btnRemoveFile.addEventListener('click', (e) => {
        e.stopPropagation();
        csvFileInput.value = '';
        dropzonePrompt.classList.remove('d-none');
        fileSelectedDisplay.classList.add('d-none');
      });

      // Analyse du fichier CSV (Étape 1 -> Étape 2)
      btnAnalyzeCsv.addEventListener('click', async () => {
        if (!csvFileInput.files || csvFileInput.files.length === 0) {
          if (typeof window.showAppToast === 'function') {
            window.showAppToast('Veuillez d\'abord sélectionner un fichier CSV.', 'warning');
          } else if (typeof window.fabtrackAlert === 'function') {
            window.fabtrackAlert({ title: 'Fichier manquant', message: 'Veuillez d\'abord sélectionner un fichier CSV.', variant: 'warning' });
          }
          return;
        }

        const formData = new FormData(document.getElementById('csvUploadForm'));

        uploadStepCard.classList.add('d-none');
        analysisSpinner.classList.remove('d-none');
        previewStepCard.classList.add('d-none');

        try {
          let previewUrl = '/admin/history/preview';
          if (window.location && window.location.pathname) {
            const currentPath = window.location.pathname.replace(/\/import\/?$/, '');
            previewUrl = `${currentPath}/preview`;
          } else if (window.getAppBaseUrl) {
            previewUrl = window.getAppBaseUrl('admin/history/preview');
          }

          const response = await fetch(previewUrl, {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData,
          });

          const res = await response.json();
          if (!response.ok || !res.success) {
            throw new Error(res.message || 'Impossible d\'analyser le fichier CSV.');
          }

          currentAnalysisData = res.data;
          renderPreview(res.data);

          analysisSpinner.classList.add('d-none');
          previewStepCard.classList.remove('d-none');
        } catch (err) {
          analysisSpinner.classList.add('d-none');
          uploadStepCard.classList.remove('d-none');
          if (typeof window.fabtrackAlert === 'function') {
            window.fabtrackAlert({ title: 'Erreur lors de l\'analyse', message: err.message, variant: 'danger' });
          } else if (typeof window.showAppToast === 'function') {
            window.showAppToast('Erreur lors de l\'analyse : ' + err.message, 'error');
          }
        }
      });

      // Rendu du tableau de prévisualisation
      function renderPreview(data) {
        kpiReadyCount.textContent = data.readyCount;
        kpiExistingCount.textContent = data.existingUsersCount;
        kpiNewCount.textContent = data.newUsersCount;
        kpiWarningCount.textContent = data.homonymWarningCount;

        if (kpiWarningCard && kpiWarningIcon) {
          const hasWarnings = Number(data.homonymWarningCount) > 0;
          kpiWarningCard.classList.toggle('border-warning', hasWarnings);
          kpiWarningCount.classList.toggle('text-warning-emphasis', hasWarnings);
          kpiWarningIcon.classList.toggle('bg-warning-subtle', hasWarnings);
          kpiWarningIcon.classList.toggle('text-warning-emphasis', hasWarnings);
          kpiWarningIcon.classList.toggle('border-warning-subtle', hasWarnings);
        }

        previewTableBody.innerHTML = '';

        data.items.forEach(item => {
          const tr = document.createElement('tr');
          if (!item.isValid) {
            tr.classList.add('table-danger');
          } else if (item.userStatus === 'HOMONYM_WARNING') {
            tr.classList.add('table-warning');
          }

          const tdNum = document.createElement('td');
          tdNum.className = 'text-center text-muted small';
          tdNum.textContent = String(item.rowNum);

          const tdUser = document.createElement('td');
          const strongSurname = document.createElement('strong');
          strongSurname.textContent = item.surname || '';
          tdUser.appendChild(strongSurname);
          tdUser.appendChild(document.createTextNode(' ' + (item.name || '')));

          const tdEmail = document.createElement('td');
          const codeEmail = document.createElement('code');
          codeEmail.textContent = item.email || '';
          tdEmail.appendChild(codeEmail);

          // Badge Statut Contributeur
          const tdUserStatus = document.createElement('td');
          const userBadge = document.createElement('span');
          const userIcon = document.createElement('i');
          if (item.userStatus === 'EXISTING_USER') {
            userBadge.className = 'badge bg-body-secondary text-secondary-emphasis border';
            userIcon.className = 'fa-solid fa-user-check me-1';
            userBadge.appendChild(userIcon);
            userBadge.appendChild(document.createTextNode(' Compte existant'));
          } else if (item.userStatus === 'HOMONYM_WARNING') {
            userBadge.className = 'badge bg-warning-subtle text-warning-emphasis border border-warning-subtle';
            userBadge.title = Array.isArray(item.warnings) ? item.warnings.join(' | ') : '';
            userIcon.className = 'fa-solid fa-triangle-exclamation me-1';
            userBadge.appendChild(userIcon);
            userBadge.appendChild(document.createTextNode(' Homonyme (' + (item.homonymEmail || '') + ')'));
          } else {
            userBadge.className = 'badge bg-body-secondary text-secondary-emphasis border';
            userIcon.className = 'fa-solid fa-user-plus me-1';
            userBadge.appendChild(userIcon);
            userBadge.appendChild(document.createTextNode(' Nouveau compte'));
          }
          tdUserStatus.appendChild(userBadge);

          const tdDate = document.createElement('td');
          const dateSpan = document.createElement('span');
          dateSpan.className = 'small';
          dateSpan.textContent = `${item.date || ''} (${item.displayArrival || ''} - ${item.displayDeparture || ''})`;
          tdDate.appendChild(dateSpan);

          const tdProject = document.createElement('td');
          const projectSpan = document.createElement('span');
          projectSpan.className = 'small text-muted';
          projectSpan.textContent = item.projectName || item.projectTypeName || '';
          tdProject.appendChild(projectSpan);

          // Badge Statut Ligne
          const tdRowStatus = document.createElement('td');
          const rowBadge = document.createElement('span');
          const rowIcon = document.createElement('i');
          if (item.isValid) {
            rowBadge.className = 'badge bg-success-subtle text-success border border-success-subtle';
            rowIcon.className = 'fa-solid fa-check me-1';
            rowBadge.appendChild(rowIcon);
            rowBadge.appendChild(document.createTextNode(' Prêt'));
          } else {
            rowBadge.className = 'badge bg-danger-subtle text-danger border border-danger-subtle';
            rowBadge.title = Array.isArray(item.errors) ? item.errors.join(', ') : '';
            rowIcon.className = 'fa-solid fa-xmark me-1';
            rowBadge.appendChild(rowIcon);
            rowBadge.appendChild(document.createTextNode(' Erreur'));
          }
          tdRowStatus.appendChild(rowBadge);

          tr.append(tdNum, tdUser, tdEmail, tdUserStatus, tdDate, tdProject, tdRowStatus);

          previewTableBody.appendChild(tr);
        });

        btnConfirmImport.disabled = data.readyCount === 0;
      }

      // Confirmation de l'import (Étape 2 -> Étape 3)
      btnConfirmImport.addEventListener('click', async () => {
        if (!currentAnalysisData || !currentAnalysisData.items || currentAnalysisData.readyCount === 0) {
          if (typeof window.showAppToast === 'function') {
            window.showAppToast('Aucune donnée valide à importer.', 'warning');
          }
          return;
        }

        const confirmed =
          typeof window.fabtrackConfirm === 'function'
            ? await window.fabtrackConfirm({
                title: 'Confirmer l\'importation',
                message: `Confirmez-vous l'enregistrement de ${currentAnalysisData.readyCount} visite(s) dans l'historique ?`,
                confirmLabel: 'Importer',
                variant: 'primary',
              })
            : false;
        if (!confirmed) {
          return;
        }

        btnConfirmImport.disabled = true;
        btnConfirmImport.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Enregistrement en cours...';

        try {
          let executeUrl = '/admin/history/execute';
          if (window.location && window.location.pathname) {
            const currentPath = window.location.pathname.replace(/\/import\/?$/, '');
            executeUrl = `${currentPath}/execute`;
          } else if (window.getAppBaseUrl) {
            executeUrl = window.getAppBaseUrl('admin/history/execute');
          }

          const payload = {
            items: currentAnalysisData.items,
            options: {
              defaultUserTypeId: document.getElementById('default_usertype_id')?.value,
              acceptTerms: document.getElementById('acceptTerms')?.checked,
            },
          };

          const response = await fetch(executeUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify(payload),
          });

          const res = await response.json();
          if (!response.ok || !res.success) {
            throw new Error(res.message || 'Échec de l\'enregistrement.');
          }

          resultMessageText.textContent = res.message;
          previewStepCard.classList.add('d-none');
          resultCard.classList.remove('d-none');
        } catch (err) {
          if (typeof window.fabtrackAlert === 'function') {
            window.fabtrackAlert({ title: 'Erreur lors de l\'importation', message: err.message, variant: 'danger' });
          } else if (typeof window.showAppToast === 'function') {
            window.showAppToast('Erreur lors de l\'importation : ' + err.message, 'error');
          }
          btnConfirmImport.disabled = false;
          btnConfirmImport.innerHTML = '<i class="fa-solid fa-check me-1" aria-hidden="true"></i> Confirmer et importer l\'historique';
        }
      });

      btnBackToUpload.addEventListener('click', () => {
        previewStepCard.classList.add('d-none');
        uploadStepCard.classList.remove('d-none');
      });

      btnImportAnother.addEventListener('click', () => {
        resultCard.classList.add('d-none');
        csvFileInput.value = '';
        dropzonePrompt.classList.remove('d-none');
        fileSelectedDisplay.classList.add('d-none');
        uploadStepCard.classList.remove('d-none');
      });

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }
    });
  </script>
</body>
</html>
