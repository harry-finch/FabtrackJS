<!doctype html>
<html lang="en" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="" />
        <meta name="author" content="Stéphane Muller" />
        <title>Fabtrack administration panel</title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Page Header -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.25rem;">
                            <i class="fa-solid fa-user-pen"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h4 class="fw-bold mb-0">Modifier le compte staff</h4>
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill" style="font-size: 0.72rem;">
                                    <%= user.name %>
                                </span>
                            </div>
                            <p class="text-muted small mb-0">Édition des identifiants et permissions d'accès</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="/admin/staff/manage" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            <i class="fa-solid fa-arrow-left me-1"></i> Retour liste staff
                        </a>
                    </div>
                </div>
            </div>

            <form action="/admin/staff/update" method="post">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="username" name="username" value="<%= user.name %>" required />
                    <label for="username">Username</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="email" name="email" value="<%= user.email %>" required />
                    <label for="email">Email</label>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-3 mb-3 p-3 bg-body-tertiary rounded-3 border">
                    <div class="form-check me-2">
                        <input type="radio" id="radio1" name="role" value="admin" class="form-check-input" required <% if(user.role =='admin') { %> checked <% } %> />
                        <label class="form-check-label fw-semibold" for="radio1"><i class="fa-solid fa-shield-halved text-primary me-1"></i> Admin</label>
                    </div>
                    <div class="form-check me-2">
                        <input type="radio" id="radio2" name="role" value="user" class="form-check-input" required <% if(user.role =='user') { %> checked <% } %> />
                        <label class="form-check-label fw-semibold" for="radio2"><i class="fa-solid fa-user-gear text-secondary me-1"></i> Médiateur (User)</label>
                    </div>
                    <div class="form-check me-2">
                        <input type="radio" id="radio3" name="role" value="staff" class="form-check-input" required <% if(user.role =='staff') { %> checked <% } %> />
                        <label class="form-check-label fw-semibold" for="radio3"><i class="fa-solid fa-desktop text-info me-1"></i> Borne Kiosque (Staff)</label>
                    </div>
                    <div class="form-check ms-auto">
                        <input type="checkbox" id="approved" name="approved" class="form-check-input" <% if(user.approved) { %> checked <% } %> />
                        <label class="form-check-label fw-semibold" for="approved"><i class="fa-solid fa-check text-success me-1"></i> Compte approuvé</label>
                    </div>
                </div>

                <input type='hidden' id="id" name='id' value='<%= user.id %>' />
                <button class="btn btn-primary w-100 py-2 mb-2" type="submit">Update account</button>
                <button class="btn btn-secondary w-100 py-2" type="button" onclick="window.location.href = '/admin/staff/manage'">Cancel</button>
            </form>

            <%- include('../includes/footer.html') %>

    </body>
</html>
