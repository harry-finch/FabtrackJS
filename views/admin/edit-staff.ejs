<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Modification d'un compte staff ou médiateur" />
        <meta name="author" content="Stéphane Muller" />
        <title>Modifier le compte staff • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Page Header -->
            <div class="fab-page-header">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h1 class="fab-page-title">Modifier le compte staff</h1>
                        <span class="badge bg-body-secondary text-secondary-emphasis border">
                            <%= user.name %>
                        </span>
                    </div>
                    <p class="fab-page-subtitle">Édition des identifiants et permissions d'accès</p>
                </div>
                <div class="fab-page-actions">
                    <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/staff/manage" class="btn btn-outline-secondary btn-sm">
                        <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Retour à la liste
                    </a>
                </div>
            </div>

            <div class="card border mb-4">
                <div class="card-header bg-body-tertiary">
                    <h2 class="h6 fw-bold mb-0">
                        <i class="fa-solid fa-user-pen text-primary me-2" aria-hidden="true"></i>Informations et permissions
                    </h2>
                </div>
                <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/staff/update" method="post">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                    <input type="hidden" id="id" name="id" value="<%= user.id %>" />

                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="username" class="form-label fw-semibold small">Nom d'utilisateur</label>
                                <input type="text" class="form-control" id="username" name="username" value="<%= user.name %>" required />
                            </div>
                            <div class="col-md-6">
                                <label for="email" class="form-label fw-semibold small">Adresse e-mail</label>
                                <input type="text" class="form-control" id="email" name="email" value="<%= user.email %>" required />
                            </div>
                        </div>

                        <div class="p-3 bg-body-tertiary rounded border">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                <div class="d-flex flex-wrap align-items-center gap-3" role="radiogroup" aria-label="Rôle du compte">
                                    <div class="form-check mb-0">
                                        <input type="radio" id="radio1" name="role" value="admin" class="form-check-input" required <% if (user.role == 'admin') { %> checked <% } %> />
                                        <label class="form-check-label fw-semibold" for="radio1">
                                            <i class="fa-solid fa-shield-halved text-primary me-1" aria-hidden="true"></i>Administrateur
                                        </label>
                                    </div>
                                    <div class="form-check mb-0">
                                        <input type="radio" id="radio2" name="role" value="user" class="form-check-input" required <% if (user.role == 'user') { %> checked <% } %> />
                                        <label class="form-check-label fw-semibold" for="radio2">
                                            <i class="fa-solid fa-user-gear text-secondary me-1" aria-hidden="true"></i>Médiateur
                                        </label>
                                    </div>
                                    <div class="form-check mb-0">
                                        <input type="radio" id="radio3" name="role" value="staff" class="form-check-input" required <% if (user.role == 'staff') { %> checked <% } %> />
                                        <label class="form-check-label fw-semibold" for="radio3">
                                            <i class="fa-solid fa-desktop text-secondary me-1" aria-hidden="true"></i>Borne kiosque
                                        </label>
                                    </div>
                                </div>
                                <div class="form-check mb-0">
                                    <input type="checkbox" id="approved" name="approved" class="form-check-input" <% if (user.approved) { %> checked <% } %> />
                                    <label class="form-check-label fw-semibold" for="approved">
                                        <i class="fa-solid fa-check text-success me-1" aria-hidden="true"></i>Compte approuvé
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-body-tertiary d-flex flex-wrap justify-content-end gap-2">
                        <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/staff/manage" class="btn btn-outline-secondary">
                            <%= typeof __ !== 'undefined' ? __('common.cancel') : 'Annuler' %>
                        </a>
                        <button class="btn btn-primary" type="submit">
                            <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>Enregistrer les modifications
                        </button>
                    </div>
                </form>
            </div>

            <%- include('../includes/footer.html') %>
    </body>
</html>
