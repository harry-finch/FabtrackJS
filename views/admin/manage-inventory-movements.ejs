<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Suivi des mouvements d'inventaire et des rebuts" />
    <meta name="author" content="FabtrackJS" />
    <title>Mouvements d'inventaire • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

    <%- include('../includes/pagehead.html') %>
  </head>

  <body class="d-flex justify-content-center bg-body-tertiary py-4">
    <%- include('../includes/light-dark.html') %>

    <main class="main-container">
      <%- include('../includes/header.html') %>

      <!-- Page Header -->
      <div class="fab-page-header">
        <div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <h1 class="fab-page-title">Mouvements d'inventaire &amp; sorties</h1>
            <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
              <%= total %> enregistrement(s)
            </span>
          </div>
          <p class="fab-page-subtitle">Traçabilité des déstockages, casses d'outils, rebuts et maintenances</p>
        </div>
        <div class="fab-page-actions">
          <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/inventory/movements/export" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-file-csv me-1" aria-hidden="true"></i> Exporter CSV
          </a>
          <button
            type="button"
            class="btn btn-primary btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#modalInventoryCheckout"
          >
            <i class="fa-solid fa-arrow-up-from-bracket me-1" aria-hidden="true"></i> Nouvelle sortie
          </button>
        </div>
      </div>

      <!-- KPI Summary Cards -->
      <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
          <div class="card h-100 fab-kpi-card">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="small text-muted fw-semibold">Sorties ce mois-ci</div>
                <div class="kpi-value tabular-nums mt-1"><%= stats.monthCount %></div>
              </div>
              <span class="fab-kpi-icon" aria-hidden="true">
                <i class="fa-solid fa-calendar-days"></i>
              </span>
            </div>
          </div>
        </div>

        <div class="col-md-3 col-sm-6">
          <div class="card h-100 fab-kpi-card <%= Number(stats.breakageCount || 0) > 0 ? 'border-danger' : '' %>">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="small text-muted fw-semibold">Casses &amp; dégradations</div>
                <div class="kpi-value tabular-nums mt-1 <%= Number(stats.breakageCount || 0) > 0 ? 'text-danger' : '' %>"><%= stats.breakageCount %></div>
              </div>
              <span class="fab-kpi-icon <%= Number(stats.breakageCount || 0) > 0 ? 'bg-danger-subtle text-danger border-danger-subtle' : '' %>" aria-hidden="true">
                <i class="fa-solid fa-triangle-exclamation"></i>
              </span>
            </div>
          </div>
        </div>

        <div class="col-md-3 col-sm-6">
          <div class="card h-100 fab-kpi-card <%= Number(stats.scrapCount || 0) > 0 ? 'border-warning' : '' %>">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="small text-muted fw-semibold">Mises au rebut</div>
                <div class="kpi-value tabular-nums mt-1 <%= Number(stats.scrapCount || 0) > 0 ? 'text-warning-emphasis' : '' %>"><%= stats.scrapCount %></div>
              </div>
              <span class="fab-kpi-icon <%= Number(stats.scrapCount || 0) > 0 ? 'bg-warning-subtle text-warning-emphasis border-warning-subtle' : '' %>" aria-hidden="true">
                <i class="fa-solid fa-trash-can"></i>
              </span>
            </div>
          </div>
        </div>

        <div class="col-md-3 col-sm-6">
          <div class="card h-100 fab-kpi-card <%= Number(stats.equipmentOutCount || 0) > 0 ? 'border-warning' : '' %>">
            <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
              <div>
                <div class="small text-muted fw-semibold">Outils indisponibles</div>
                <div class="kpi-value tabular-nums mt-1 <%= Number(stats.equipmentOutCount || 0) > 0 ? 'text-warning-emphasis' : '' %>"><%= stats.equipmentOutCount %></div>
              </div>
              <span class="fab-kpi-icon <%= Number(stats.equipmentOutCount || 0) > 0 ? 'bg-warning-subtle text-warning-emphasis border-warning-subtle' : '' %>" aria-hidden="true">
                <i class="fa-solid fa-wrench"></i>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Filters & Search Form -->
      <div class="fab-filter-bar">
        <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/inventory/movements" method="GET" class="row g-2 align-items-center">
          <div class="col-md-3 col-sm-6">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-layer-group text-muted" aria-hidden="true"></i></span>
              <select class="form-select" name="itemType" aria-label="Filtrer par type d'article" data-auto-submit="true">
                <option value="">Tous les types</option>
                <option value="CONSUMABLE" <%= itemType === 'CONSUMABLE' ? 'selected' : '' %>>Consommables</option>
                <option value="EQUIPMENT" <%= itemType === 'EQUIPMENT' ? 'selected' : '' %>>Outils &amp; Équipements</option>
              </select>
            </div>
          </div>

          <div class="col-md-3 col-sm-6">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-tag text-muted" aria-hidden="true"></i></span>
              <select class="form-select" name="reason" aria-label="Filtrer par motif de mouvement" data-auto-submit="true">
                <option value="">Tous les motifs</option>
                <option value="Casse" <%= reason === 'Casse' ? 'selected' : '' %>>Casse / Dégradation</option>
                <option value="Rebut" <%= reason === 'Rebut' ? 'selected' : '' %>>Mise au rebut / Usure</option>
                <option value="Maintenance" <%= reason === 'Maintenance' ? 'selected' : '' %>>Panne / Maintenance</option>
                <option value="Atelier" <%= reason === 'Atelier' ? 'selected' : '' %>>Utilisation atelier</option>
                <option value="Perte" <%= reason === 'Perte' ? 'selected' : '' %>>Perte / Vol</option>
                <option value="Écart" <%= reason === 'Écart' ? 'selected' : '' %>>Écart d'inventaire</option>
                <option value="Remise" <%= reason === 'Remise' ? 'selected' : '' %>>Remise en service</option>
              </select>
            </div>
          </div>

          <div class="col-md-4 col-sm-8">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-magnifying-glass text-muted" aria-hidden="true"></i></span>
              <input
                type="text"
                class="form-control"
                name="search"
                value="<%= search %>"
                placeholder="Rechercher par article, auteur, note..."
                aria-label="Rechercher par article, auteur ou note"
                autocomplete="off"
              />
            </div>
          </div>

          <div class="col-md-2 col-sm-4 d-flex gap-2 justify-content-md-end">
            <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
              <i class="fa-solid fa-filter me-1" aria-hidden="true"></i> Filtrer
            </button>
            <% if (itemType || reason || search) { %>
              <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/inventory/movements" class="btn btn-outline-secondary btn-sm" title="Réinitialiser les filtres" aria-label="Réinitialiser les filtres">
                <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
              </a>
            <% } %>
          </div>
        </form>
      </div>

      <!-- Movements Table -->
      <div class="card border mb-4">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col" class="ps-4" style="width: 130px;">Date &amp; heure</th>
                  <th scope="col" style="width: 140px;">Type</th>
                  <th scope="col">Article concerné</th>
                  <th scope="col" class="text-center" style="width: 140px;">Quantité / Impact</th>
                  <th scope="col" style="width: 180px;">Motif</th>
                  <th scope="col" style="width: 130px;">Déclarant</th>
                  <th scope="col" class="pe-4">Notes / Contexte</th>
                </tr>
              </thead>
              <tbody>
                <% if (movements.length === 0) { %>
                  <tr>
                    <td colspan="7" class="text-center py-5 text-muted">
                      <i class="fa-solid fa-clipboard-check fa-2x mb-2 d-block opacity-50" aria-hidden="true"></i>
                      Aucun mouvement d'inventaire enregistré pour ces critères.
                    </td>
                  </tr>
                <% } else { %>
                  <% movements.forEach(function(m) { 
                       const d = new Date(m.createdAt);
                       const dateFmt = d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
                       const timeFmt = d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
                  %>
                  <tr>
                    <td class="ps-4">
                      <div class="fw-semibold small"><%= dateFmt %></div>
                      <div class="text-muted" style="font-size: 0.72rem;"><%= timeFmt %></div>
                    </td>

                    <td>
                      <% if (m.itemType === 'CONSUMABLE') { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                          <i class="fa-solid fa-boxes-stacked me-1" aria-hidden="true"></i>Consommable
                        </span>
                      <% } else { %>
                        <span class="badge bg-body-secondary text-secondary-emphasis border">
                          <i class="fa-solid fa-toolbox me-1" aria-hidden="true"></i>Équipement
                        </span>
                      <% } %>
                    </td>

                    <td>
                      <div class="fw-semibold text-body"><%= m.itemName %></div>
                      <div class="text-muted small">Réf. : #<%= m.itemId %></div>
                    </td>

                    <td class="text-center">
                      <% if (m.itemType === 'CONSUMABLE') { %>
                        <div class="fw-bold text-danger">-<%= m.quantity %> <%= m.unit %></div>
                        <% if (m.stockBefore !== null && m.stockAfter !== null) { %>
                          <div class="text-muted" style="font-size: 0.72rem;">Stock : <%= m.stockBefore %> &rarr; <strong><%= m.stockAfter %></strong></div>
                        <% } %>
                      <% } else { %>
                        <% if (m.equipmentStatusAfter === 'DECOMMISSIONED') { %>
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                            <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>Au rebut
                          </span>
                        <% } else if (m.equipmentStatusAfter === 'OUT_OF_SERVICE') { %>
                          <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                            <i class="fa-solid fa-screwdriver-wrench me-1" aria-hidden="true"></i>Hors service
                          </span>
                        <% } else { %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>En service
                          </span>
                        <% } %>
                      <% } %>
                    </td>

                    <td>
                      <% 
                        let badgeClass = 'bg-body-secondary text-secondary-emphasis border';
                        let iconClass = 'fa-tag';
                        if (m.reason.includes('Casse')) {
                          badgeClass = 'bg-danger-subtle text-danger border border-danger-subtle';
                          iconClass = 'fa-triangle-exclamation';
                        } else if (m.reason.includes('Rebut')) {
                          badgeClass = 'bg-warning-subtle text-warning-emphasis border border-warning-subtle';
                          iconClass = 'fa-trash-can';
                        } else if (m.reason.includes('Maintenance') || m.reason.includes('Panne')) {
                          badgeClass = 'bg-warning-subtle text-warning-emphasis border border-warning-subtle';
                          iconClass = 'fa-screwdriver-wrench';
                        } else if (m.reason.includes('Remise')) {
                          badgeClass = 'bg-success-subtle text-success border border-success-subtle';
                          iconClass = 'fa-rotate-left';
                        }
                      %>
                      <span class="badge <%= badgeClass %>">
                        <i class="fa-solid <%= iconClass %> me-1" aria-hidden="true"></i><%= m.reason %>
                      </span>
                    </td>

                    <td>
                      <span class="badge bg-body-secondary text-secondary-emphasis border">
                        <i class="fa-solid fa-user-shield me-1 text-muted" aria-hidden="true"></i><%= m.author %>
                      </span>
                    </td>

                    <td class="pe-4">
                      <% if (m.notes) { %>
                        <span class="small text-secondary"><%= m.notes %></span>
                      <% } else { %>
                        <span class="text-muted small fst-italic">Aucune note</span>
                      <% } %>
                    </td>
                  </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <% if (totalPages > 1) { %>
          <div class="card-footer bg-transparent py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="small text-muted">Page <%= currentPage %> sur <%= totalPages %> (<%= total %> mouvements)</span>
            <nav aria-label="Pagination des mouvements d'inventaire">
              <ul class="pagination pagination-sm mb-0">
                <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="<%= currentPage > 1 ? (typeof baseUrl !== 'undefined' ? baseUrl : '/') + 'admin/inventory/movements?page=' + (currentPage - 1) + '&itemType=' + itemType + '&reason=' + reason + '&search=' + search : '#' %>" aria-label="Précédent">
                    &laquo; Précédent
                  </a>
                </li>
                <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
                  <li class="page-item <%= i === currentPage ? 'active' : '' %>" <%= i === currentPage ? 'aria-current="page"' : '' %>>
                    <a class="page-link" href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/inventory/movements?page=<%= i %>&itemType=<%= itemType %>&reason=<%= reason %>&search=<%= search %>">
                      <%= i %>
                    </a>
                  </li>
                <% } %>
                <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="<%= currentPage < totalPages ? (typeof baseUrl !== 'undefined' ? baseUrl : '/') + 'admin/inventory/movements?page=' + (currentPage + 1) + '&itemType=' + itemType + '&reason=' + reason + '&search=' + search : '#' %>" aria-label="Suivant">
                    Suivant &raquo;
                  </a>
                </li>
              </ul>
            </nav>
          </div>
        <% } %>
      </div>

      <%- include('../includes/footer.html') %>
  </body>
</html>
