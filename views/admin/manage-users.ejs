<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="" />
        <meta name="author" content="Stéphane Muller" />
        <title>Fabtrack - Gestion des contributeurs</title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <%
                const safeBaseUrl = typeof baseUrl !== 'undefined' ? baseUrl : '/';
                const safeUsers = Array.isArray(users) ? users : [];
                const safeTotalActive = typeof totalActiveUsers !== 'undefined' ? Number(totalActiveUsers) : safeUsers.length;
                const safeSignedCount = typeof signedCount !== 'undefined' ? Number(signedCount) : safeUsers.filter(u => u.termsAccepted).length;
                const safePendingCount = typeof pendingCount !== 'undefined' ? Number(pendingCount) : Math.max(0, safeTotalActive - safeSignedCount);
                const safeTotalFiltered = typeof totalFiltered !== 'undefined' ? Number(totalFiltered) : safeUsers.length;
                const safeCurrentPage = typeof currentPage !== 'undefined' ? Number(currentPage) : 1;
                const safeTotalPages = typeof totalPages !== 'undefined' ? Math.max(1, Number(totalPages)) : 1;
                const safeLimit = typeof limit !== 'undefined' ? Number(limit) : 50;
                const safeFilters = typeof filters !== 'undefined' && filters ? filters : { search: '', charter: 'all' };
                const activeCharter = safeFilters.charter ? String(safeFilters.charter) : 'all';

                function buildUsersUrl(overrides) {
                    const opts = overrides || {};
                    const params = new URLSearchParams();
                    const q = opts.search !== undefined ? opts.search : (safeFilters.search || '');
                    const ch = opts.charter !== undefined ? opts.charter : activeCharter;
                    const p = opts.page !== undefined ? opts.page : safeCurrentPage;
                    const lim = opts.limit !== undefined ? opts.limit : safeLimit;

                    if (q) params.set('search', q);
                    if (ch && ch !== 'all') params.set('charter', ch);
                    if (lim) params.set('limit', String(lim));
                    if (p) params.set('page', String(p));
                    const qs = params.toString();
                    return safeBaseUrl + 'users/manage' + (qs ? '?' + qs : '');
                }

                const pageWindow = [];
                const windowRadius = 2;
                for (let p = 1; p <= safeTotalPages; p++) {
                    if (
                        p === 1 ||
                        p === safeTotalPages ||
                        (p >= safeCurrentPage - windowRadius && p <= safeCurrentPage + windowRadius)
                    ) {
                        pageWindow.push(p);
                    }
                }
                const hasActiveFilters = Boolean(safeFilters.search || (activeCharter && activeCharter !== 'all'));
            %>

            <!-- Page Header -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.25rem;">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <h4 class="fw-bold mb-0">Gestion des contributeurs</h4>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" style="font-size: 0.72rem;">
                                    <%= safeTotalActive %> inscrits
                                </span>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border rounded-pill" style="font-size: 0.72rem;">
                                    Page <%= safeCurrentPage %> / <%= safeTotalPages %>
                                </span>
                            </div>
                            <p class="text-muted small mb-0">Adhérents, contributeurs réguliers et chartes d'utilisation</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="<%= safeBaseUrl %>admin" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            <i class="fa-solid fa-arrow-left me-1"></i> Retour panneau admin
                        </a>
                    </div>
                </div>
            </div>

            <!-- KPI Row -->
            <div class="row g-3 mb-4">
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-secondary">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Total contributeurs</small>
                                <div class="fs-4 fw-bold mt-1"><%= safeTotalActive %></div>
                            </div>
                            <div class="icon-box bg-primary-subtle text-primary">
                                <i class="fa-solid fa-users"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-secondary">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Chartes signées</small>
                                <div class="fs-4 fw-bold mt-1 text-success"><%= safeSignedCount %></div>
                            </div>
                            <div class="icon-box bg-success-subtle text-success">
                                <i class="fa-solid fa-user-check"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="card h-100 shadow-sm border-0 bg-body-secondary">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">En attente de signature</small>
                                <div class="fs-4 fw-bold mt-1 text-warning"><%= safePendingCount %></div>
                            </div>
                            <div class="icon-box bg-warning-subtle text-warning-emphasis">
                                <i class="fa-solid fa-user-clock"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search & Charter Filter Form -->
            <div class="card shadow-sm border-0 mb-4 bg-body-secondary">
                <div class="card-body p-3">
                    <form method="GET" action="<%= safeBaseUrl %>users/manage" class="row g-2 align-items-center">
                        <input type="hidden" name="limit" value="<%= safeLimit %>" />
                        <div class="col-md-6 col-sm-12">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-magnifying-glass"></i></span>
                                <input
                                    type="text"
                                    id="searchUserInput"
                                    name="search"
                                    value="<%= safeFilters.search || '' %>"
                                    class="form-control"
                                    placeholder="Rechercher par nom, prénom, e-mail ou profil..."
                                    aria-label="Rechercher un contributeur par nom, prénom, e-mail ou profil"
                                />
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <select name="charter" id="charterFilterSelect" class="form-select form-select-sm" aria-label="Filtrer par statut de charte">
                                <option value="all" <%= activeCharter === 'all' ? 'selected' : '' %>>Toutes les chartes</option>
                                <option value="signed" <%= activeCharter === 'signed' ? 'selected' : '' %>>Charte signée</option>
                                <option value="pending" <%= activeCharter === 'pending' ? 'selected' : '' %>>En attente de signature</option>
                            </select>
                        </div>
                        <div class="col-md-3 col-sm-6 d-flex gap-2 justify-content-md-end">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fa-solid fa-filter me-1"></i> Filtrer
                            </button>
                            <% if (hasActiveFilters) { %>
                                <a href="<%= safeBaseUrl %>users/manage" class="btn btn-outline-secondary btn-sm">
                                    <i class="fa-solid fa-rotate-left me-1"></i> Réinitialiser
                                </a>
                            <% } %>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="usersTable">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3">#</th>
                                    <th scope="col"><%= typeof __ !== 'undefined' ? __('users_manage.col_username') : 'Nom & Prénom' %></th>
                                    <th scope="col"><%= typeof __ !== 'undefined' ? __('users_manage.col_email') : 'Email' %></th>
                                    <th scope="col"><%= typeof __ !== 'undefined' ? __('users_manage.col_type') : 'Type' %></th>
                                    <th scope="col" class="text-center"><%= typeof __ !== 'undefined' ? __('users_manage.col_charter') : 'Charte' %></th>
                                    <th scope="col" class="text-end pe-3"><%= typeof __ !== 'undefined' ? __('users_manage.col_actions') : 'Actions' %></th>
                                </tr>
                            </thead>
                            <tbody id="table-content">
                                <% if (safeUsers.length === 0) { %>
                                <tr id="noUsersRow">
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        <i class="fa-solid fa-circle-info me-1"></i> Aucun contributeur ne correspond à la recherche.
                                    </td>
                                </tr>
                                <% } else { %>
                                    <% safeUsers.forEach(function(user) { %>
                                    <tr class="user-row">
                                        <td scope="row" class="ps-3 text-muted">#<%= user.id %></td>
                                        <td>
                                            <div class="fw-semibold"><%= user.name %> <%= user.surname %></div>
                                        </td>
                                        <td>
                                            <div><a href="mailto:<%= user.email %>" class="text-decoration-none"><%= user.email %></a></div>
                                            <% if (user.newsletter) { %>
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill" style="font-size: 0.7rem;" title="Inscrit à la newsletter">
                                                    <i class="fa-solid fa-paper-plane me-1"></i>Newsletter
                                                </span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis border rounded-pill">
                                                <%= user.usertype ? user.usertype.name : '-' %>
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <% if(user.termsAccepted) { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                                <i class="fa-solid fa-check me-1"></i>Signée
                                            </span>
                                            <% } else { %>
                                            <form method="POST" action="<%= safeBaseUrl %>users/resend/<%= user.id %>" class="d-inline">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                                                <button type="submit" class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1" title="Renvoyer l'e-mail de confirmation" style="cursor: pointer;">
                                                    <i class="fa-solid fa-rotate-right me-1"></i>En attente
                                                </button>
                                            </form>
                                            <% } %>
                                        </td>
                                        <td class="text-end pe-3">
                                            <div class="fab-row-actions">
                                                <a href="<%= safeBaseUrl %>users/edit/<%= user.id %>" class="btn btn-outline-primary btn-sm" data-bs-toggle="tooltip" title="Modifier le profil" aria-label="Modifier le profil de <%= user.name %> <%= user.surname %>">
                                                    <i class="fa-solid fa-user-pen" aria-hidden="true"></i>
                                                </a>
                                                <form method="POST" action="<%= safeBaseUrl %>users/delete/<%= user.id %>" class="d-inline" data-confirm="Supprimer le compte de <%= user.name %> <%= user.surname %> ?">
                                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip" title="Supprimer le compte" aria-label="Supprimer le compte de <%= user.name %> <%= user.surname %>">
                                                        <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Pagination Controls -->
            <nav aria-label="Pagination contributeurs" class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-5">
                <div class="small text-muted">
                    Page <strong><%= safeCurrentPage %></strong> / <strong><%= safeTotalPages %></strong>
                    — <strong><%= safeTotalFiltered %></strong> contributeurs affichés
                </div>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item <%= safeCurrentPage <= 1 ? 'disabled' : '' %>">
                        <a
                            class="page-link"
                            href="<%= safeCurrentPage > 1 ? buildUsersUrl({ page: safeCurrentPage - 1 }) : '#' %>"
                            aria-label="Précédent"
                        >
                            &laquo; Précédent
                        </a>
                    </li>
                    <% let prevPageNum = null; %>
                    <% pageWindow.forEach(function(p) { %>
                        <% if (prevPageNum !== null && p - prevPageNum > 1) { %>
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        <% } %>
                        <li class="page-item <%= p === safeCurrentPage ? 'active' : '' %>" <%= p === safeCurrentPage ? 'aria-current="page"' : '' %>>
                            <a class="page-link" href="<%= buildUsersUrl({ page: p }) %>"><%= p %></a>
                        </li>
                        <% prevPageNum = p; %>
                    <% }); %>
                    <li class="page-item <%= safeCurrentPage >= safeTotalPages ? 'disabled' : '' %>">
                        <a
                            class="page-link"
                            href="<%= safeCurrentPage < safeTotalPages ? buildUsersUrl({ page: safeCurrentPage + 1 }) : '#' %>"
                            aria-label="Suivant"
                        >
                            Suivant &raquo;
                        </a>
                    </li>
                </ul>
            </nav>

            <%- include('../includes/footer.html') %>
        </main>

    </body>
</html>
