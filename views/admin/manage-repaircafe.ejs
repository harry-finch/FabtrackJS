<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Repair Café &amp; Réparations • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>
        <%- include('../includes/pagehead.html') %>
    </head>
    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <%
                const safeBaseUrl = typeof baseUrl !== 'undefined' ? baseUrl : '/';
                const safeFilters = (typeof filters !== 'undefined' && filters)
                    ? filters
                    : (stats && stats.filters ? stats.filters : { search: '', status: 'all' });
                const safePagination = (typeof pagination !== 'undefined' && pagination)
                    ? pagination
                    : (stats && stats.pagination ? stats.pagination : { page: 1, pageSize: 25, totalCount: (stats.records || []).length, totalPages: 1, hasPrev: false, hasNext: false });
                const safeStatuses = (typeof statuses !== 'undefined' && statuses) ? statuses : {};
                const statsYear = (stats && stats.statsYear) ? stats.statsYear : new Date().getFullYear();
                const hasActiveFilters = Boolean(
                    (safeFilters.search && safeFilters.search.trim()) ||
                    (safeFilters.status && safeFilters.status !== 'all')
                );

                function buildRepairUrl(overrides) {
                    const opts = overrides || {};
                    const params = new URLSearchParams();
                    const q = opts.search !== undefined ? opts.search : (safeFilters.search || '');
                    const st = opts.status !== undefined ? opts.status : (safeFilters.status || 'all');
                    const p = opts.page !== undefined ? opts.page : safePagination.page;

                    if (q) params.set('search', q);
                    if (st && st !== 'all') params.set('status', st);
                    if (p && Number(p) > 1) params.set('page', String(p));
                    const qs = params.toString();
                    return safeBaseUrl + 'admin/repair-cafe' + (qs ? '?' + qs : '');
                }

                const pageWindow = [];
                const windowRadius = 2;
                for (let p = 1; p <= safePagination.totalPages; p++) {
                    if (
                        p === 1 ||
                        p === safePagination.totalPages ||
                        (p >= safePagination.page - windowRadius && p <= safePagination.page + windowRadius)
                    ) {
                        pageWindow.push(p);
                    }
                }
            %>

            <!-- Page Header -->
            <div class="fab-page-header">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h1 class="fab-page-title">Repair Café</h1>
                        <% if (settings.plugin_repaircafe_enabled === 'false') { %>
                            <span class="badge bg-body-secondary text-secondary-emphasis border">
                                <i class="fa-solid fa-power-off me-1" aria-hidden="true"></i>Plugin désactivé
                            </span>
                        <% } else { %>
                            <span class="badge bg-body-secondary text-secondary-emphasis border">Atelier</span>
                        <% } %>
                    </div>
                    <p class="fab-page-subtitle">Suivi des ateliers de co-réparation, statistiques annuelles et historique complet des interventions</p>
                </div>
            </div>

            <!-- Disabled notice banner -->
            <% if (settings.plugin_repaircafe_enabled === 'false') { %>
            <div class="alert alert-secondary border d-flex align-items-center justify-content-between mb-4 px-3 py-2">
                <div class="d-flex align-items-center gap-3">
                    <span class="fab-kpi-icon" aria-hidden="true">
                        <i class="fa-solid fa-power-off"></i>
                    </span>
                    <div>
                        <div class="fw-semibold small">Plugin Repair Café actuellement désactivé</div>
                        <div class="text-muted small">Les formulaires et bilans Repair Café sont désactivés lors du check-in et check-out. Vous pouvez réactiver le plugin ci-dessous ou dans la <a href="<%= safeBaseUrl %>admin/settings" class="alert-link">configuration générale</a>.</div>
                    </div>
                </div>
                <span class="badge bg-body-secondary text-secondary-emphasis border">Inactif</span>
            </div>
            <% } %>

            <!-- Notification banner -->
            <% if (typeof notification !== 'undefined' && notification) {
                const isError = notification.toLowerCase().includes('error');
                const isSuccess = notification.toLowerCase().includes('success');
            %>
            <div class="alert <%= isError ? 'alert-danger' : isSuccess ? 'alert-success' : 'alert-info' %> alert-dismissible fade show border mb-4" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid <%= isError ? 'fa-triangle-exclamation' : isSuccess ? 'fa-circle-check' : 'fa-circle-info' %>" aria-hidden="true"></i>
                    <div><%= notification.replace(/^(Success:|Error:|Warning:)\s*/i, '') %></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
            <% } %>

            <!-- SECTION 1: Annual KPI Cards (Current Calendar Year in Fablab Timezone) -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2" id="repairAnnualKpiHeader">
                <h2 class="h6 fw-bold mb-0 d-flex align-items-center gap-2">
                    <i class="fa-solid fa-calendar-check text-muted" aria-hidden="true"></i>
                    <span>Indicateurs de l'année <%= statsYear %></span>
                </h2>
                <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
                    Année civile <%= statsYear %>
                </span>
            </div>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-4">
                <div class="col">
                    <div class="card h-100 fab-kpi-card">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                <div class="small text-muted fw-semibold">Taux de réparation (<%= statsYear %>)</div>
                                <span class="fab-kpi-icon" aria-hidden="true">
                                    <i class="fa-solid fa-percent"></i>
                                </span>
                            </div>
                            <div class="d-flex align-items-baseline gap-2 mb-2">
                                <span class="kpi-value tabular-nums <%= stats.globalSuccessRate >= 60 ? 'text-success' : stats.globalSuccessRate >= 30 ? 'text-warning-emphasis' : (stats.decidedTotal > 0 ? 'text-danger' : 'text-body') %>">
                                    <%= stats.globalSuccessRate %>%
                                </span>
                                <span class="text-muted small tabular-nums">(<%= stats.strictSuccessRate %>% strict)</span>
                            </div>
                            <div class="progress" style="height: 5px;">
                                <div class="progress-bar <%= stats.globalSuccessRate >= 60 ? 'bg-success' : stats.globalSuccessRate >= 30 ? 'bg-warning' : 'bg-danger' %>" role="progressbar" style="width: <%= stats.globalSuccessRate %>%;" aria-valuenow="<%= stats.globalSuccessRate %>" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100 fab-kpi-card">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                            <div>
                                <div class="small text-muted fw-semibold">Objets sauvés</div>
                                <div class="kpi-value tabular-nums text-success mt-1"><%= stats.repairedCount %></div>
                                <div class="small text-muted mt-1">+ <%= stats.partiallyRepairedCount %> partiellement réparé(s)</div>
                            </div>
                            <span class="fab-kpi-icon" aria-hidden="true">
                                <i class="fa-solid fa-circle-check"></i>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100 fab-kpi-card <%= stats.needsReturnCount > 0 ? 'border-warning' : '' %>">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                            <div>
                                <div class="small text-muted fw-semibold">À poursuivre / Échecs</div>
                                <div class="kpi-value tabular-nums <%= stats.needsReturnCount > 0 ? 'text-warning-emphasis' : 'text-body' %> mt-1"><%= stats.needsReturnCount %></div>
                                <div class="small text-muted mt-1">Doivent revenir (<%= stats.notRepairedCount %> non réparé(s))</div>
                            </div>
                            <span class="fab-kpi-icon <%= stats.needsReturnCount > 0 ? 'bg-warning-subtle text-warning-emphasis border-warning-subtle' : '' %>" aria-hidden="true">
                                <i class="fa-solid fa-rotate-right"></i>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100 fab-kpi-card">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                            <div>
                                <div class="small text-muted fw-semibold">Visiteurs (<%= statsYear %>)</div>
                                <div class="kpi-value tabular-nums mt-1"><%= stats.uniqueVisitors %></div>
                                <div class="small text-muted mt-1"><%= stats.totalVisits %> visite(s) enregistrée(s)</div>
                            </div>
                            <span class="fab-kpi-icon" aria-hidden="true">
                                <i class="fa-solid fa-users"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: Server-Filtered & Paginated Repair History (All Years) -->
            <div class="fab-filter-bar">
                <form method="GET" action="<%= safeBaseUrl %>admin/repair-cafe" class="row g-2 align-items-center" id="repairFilterForm">
                    <div class="col-md-5 col-sm-12">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="fa-solid fa-magnifying-glass text-muted" aria-hidden="true"></i></span>
                            <input
                                type="text"
                                id="repairSearchInput"
                                name="search"
                                value="<%= safeFilters.search || '' %>"
                                class="form-control"
                                placeholder="Rechercher un objet ou un contributeur (toutes années)…"
                                aria-label="Rechercher par objet ou contributeur dans tout l'historique Repair Café"
                            />
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <select name="status" id="repairStatusFilter" class="form-select form-select-sm" aria-label="Filtrer par statut de réparation">
                            <option value="all" <%= (!safeFilters.status || safeFilters.status === 'all') ? 'selected' : '' %>>Tous les statuts</option>
                            <% Object.entries(safeStatuses).forEach(function([code, meta]) { %>
                                <option value="<%= code %>" <%= safeFilters.status === code ? 'selected' : '' %>><%= meta.label %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-3 col-sm-6 d-flex gap-2 justify-content-md-end">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fa-solid fa-filter me-1" aria-hidden="true"></i> Filtrer
                        </button>
                        <% if (hasActiveFilters) { %>
                            <a href="<%= safeBaseUrl %>admin/repair-cafe" class="btn btn-outline-secondary btn-sm">
                                <i class="fa-solid fa-rotate-left me-1" aria-hidden="true"></i> Réinitialiser
                            </a>
                        <% } %>
                    </div>
                </form>
            </div>

            <div class="card border mb-3">
                <div class="card-header bg-body-tertiary d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <h2 class="h6 fw-bold mb-0">
                        <i class="fa-solid fa-clock-rotate-left text-muted me-2" aria-hidden="true"></i>Historique des interventions
                    </h2>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
                            <%= safePagination.totalCount %> intervention(s)
                        </span>
                        <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
                            Page <%= safePagination.page %> / <%= safePagination.totalPages %>
                        </span>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="repairHistoryTable">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3">Date / Heure</th>
                                    <th scope="col">Contributeur</th>
                                    <th scope="col">Objet à réparer</th>
                                    <th scope="col" class="text-center">Résultat du diagnostic</th>
                                    <th scope="col">Notes &amp; Remarques</th>
                                    <th scope="col" class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!stats.records || stats.records.length === 0) { %>
                                <tr id="repairEmptyStateRow">
                                    <td colspan="6" class="text-center text-muted py-5">
                                        <i class="fa-solid fa-screwdriver-wrench fa-2x d-block mb-2 opacity-50" aria-hidden="true"></i>
                                        <% if (hasActiveFilters) { %>
                                            <div class="fw-semibold mb-1">Aucune intervention ne correspond aux critères sélectionnés.</div>
                                            <a href="<%= safeBaseUrl %>admin/repair-cafe" class="btn btn-outline-secondary btn-sm mt-2">
                                                <i class="fa-solid fa-rotate-left me-1" aria-hidden="true"></i> Afficher tout l'historique
                                            </a>
                                        <% } else { %>
                                            Aucune visite Repair Café enregistrée pour l'instant.
                                        <% } %>
                                    </td>
                                </tr>
                                <% } else { %>
                                <% stats.records.forEach(function(rec) {
                                    const arrivalDate = new Date(rec.arrival);
                                    const formattedDate = arrivalDate.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
                                    const formattedTime = arrivalDate.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
                                    const stInfo = rec.statusInfo || { label: rec.repairStatus, color: 'secondary', icon: 'fa-question' };
                                    const textClass = stInfo.color === 'warning' || stInfo.color === 'secondary' || stInfo.color === 'info'
                                        ? 'text-' + stInfo.color + '-emphasis'
                                        : 'text-' + stInfo.color;
                                %>
                                <tr>
                                    <td class="ps-3 text-nowrap">
                                        <div class="fw-semibold tabular-nums"><%= formattedDate %></div>
                                        <small class="text-muted tabular-nums"><i class="fa-regular fa-clock fa-xs me-1" aria-hidden="true"></i><%= formattedTime %></small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold"><%= rec.userFullName %></div>
                                        <% if (rec.userEmail) { %>
                                        <small class="text-muted"><%= rec.userEmail %></small>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="badge bg-body-secondary text-secondary-emphasis border">
                                            <i class="fa-solid fa-screwdriver-wrench fa-xs me-1" aria-hidden="true"></i><%= rec.repairObject %>
                                        </span>
                                    </td>
                                    <td class="text-center text-nowrap">
                                        <span class="badge bg-<%= stInfo.color %>-subtle <%= textClass %> border border-<%= stInfo.color %>-subtle">
                                            <i class="fa-solid <%= stInfo.icon %> me-1" aria-hidden="true"></i><%= stInfo.label %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (rec.repairNotes) { %>
                                        <span class="small text-secondary" title="<%= rec.repairNotes %>"><%= rec.repairNotes %></span>
                                        <% } else { %>
                                        <span class="text-muted small fst-italic">—</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end pe-3 text-nowrap">
                                        <div class="fab-row-actions">
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-outline-primary btn-edit-repair"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editRepairModal"
                                                data-historyid="<%= rec.id %>"
                                                data-username="<%= rec.userFullName %>"
                                                data-repairobject="<%= rec.repairObject %>"
                                                data-repairstatus="<%= rec.repairStatus %>"
                                                data-repairnotes="<%= rec.repairNotes %>"
                                                title="Modifier cette fiche"
                                                aria-label="Modifier la fiche de réparation de <%= rec.userFullName %>"
                                            >
                                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Pagination Controls -->
            <nav aria-label="Pagination historique Repair Café" class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
                <div class="small text-muted tabular-nums">
                    Page <strong><%= safePagination.page %></strong> / <strong><%= safePagination.totalPages %></strong>
                    — <strong><%= safePagination.totalCount %></strong> intervention(s)
                    (25 par page)
                </div>
                <% if (safePagination.totalPages > 1) { %>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item <%= !safePagination.hasPrev ? 'disabled' : '' %>">
                        <a
                            class="page-link"
                            href="<%= safePagination.hasPrev ? buildRepairUrl({ page: safePagination.page - 1 }) : '#' %>"
                            aria-label="Page précédente"
                        >
                            &laquo; Précédent
                        </a>
                    </li>
                    <% let prevPageNum = null; %>
                    <% pageWindow.forEach(function(p) { %>
                        <% if (prevPageNum !== null && p - prevPageNum > 1) { %>
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        <% } %>
                        <li class="page-item <%= p === safePagination.page ? 'active' : '' %>" <%- p === safePagination.page ? 'aria-current="page"' : '' %>>
                            <a class="page-link tabular-nums" href="<%= buildRepairUrl({ page: p }) %>"><%= p %></a>
                        </li>
                        <% prevPageNum = p; %>
                    <% }); %>
                    <li class="page-item <%= !safePagination.hasNext ? 'disabled' : '' %>">
                        <a
                            class="page-link"
                            href="<%= safePagination.hasNext ? buildRepairUrl({ page: safePagination.page + 1 }) : '#' %>"
                            aria-label="Page suivante"
                        >
                            Suivant &raquo;
                        </a>
                    </li>
                </ul>
                <% } %>
            </nav>

            <!-- SECTION 3: Plugin Configuration Card -->
            <div class="card border mb-4">
                <div class="card-header bg-body-tertiary">
                    <h2 class="h6 fw-bold mb-0">
                        <i class="fa-solid fa-gear text-muted me-2" aria-hidden="true"></i>Paramètres du Plugin Repair Café
                    </h2>
                </div>
                <form action="<%= safeBaseUrl %>admin/repair-cafe/settings" method="POST">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="p-3 border rounded bg-body-tertiary d-flex flex-wrap align-items-center justify-content-between gap-3">
                                    <div>
                                        <div class="fw-semibold small"><label class="form-check-label" for="plugin_repaircafe_enabled">Activer les fonctionnalités Repair Café</label></div>
                                        <p class="text-muted small mb-0 mt-1">
                                            Affiche le champ « Objet à réparer » lors de la sélection du motif de la visite et ouvre la fenêtre de bilan lors de la sortie.
                                        </p>
                                    </div>
                                    <div class="form-check form-switch fs-5 mb-0">
                                        <input
                                            class="form-check-input"
                                            type="checkbox"
                                            role="switch"
                                            id="plugin_repaircafe_enabled"
                                            name="plugin_repaircafe_enabled"
                                            value="true"
                                            <%= (settings.plugin_repaircafe_enabled !== 'false') ? 'checked' : '' %>
                                        >
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="repaircafe_projecttype_name" class="form-label fw-semibold small">
                                    <i class="fa-solid fa-tag text-muted me-1" aria-hidden="true"></i> Intitulé du Motif de la Visite associé
                                </label>
                                <input
                                    type="text"
                                    class="form-control"
                                    id="repaircafe_projecttype_name"
                                    name="repaircafe_projecttype_name"
                                    placeholder="Repair Café"
                                    value="<%= settings.repaircafe_projecttype_name || 'Repair Café' %>"
                                    required
                                >
                                <div class="form-text small text-muted">
                                    Nom exact du motif de visite dans Fabtrack qui déclenche le formulaire d'objet à réparer.
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-body-tertiary py-3 px-4 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary btn-sm px-3">
                            <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i> Enregistrer les paramètres
                        </button>
                    </div>
                </form>
            </div>

            <!-- Modal to Edit a Repair Record -->
            <div class="modal fade" id="editRepairModal" tabindex="-1" aria-labelledby="editRepairModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form action="<%= safeBaseUrl %>admin/repair-cafe/update-entry" method="POST">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                            <input type="hidden" name="historyid" id="editHistoryId" value="" />
                            <div class="modal-header">
                                <h5 class="modal-title" id="editRepairModalLabel">
                                    <i class="fa-solid fa-wrench text-muted me-2" aria-hidden="true"></i>Modifier la fiche de réparation
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label for="editUserName" class="form-label small fw-semibold">Contributeur</label>
                                    <input type="text" class="form-control bg-body-tertiary" id="editUserName" readonly />
                                </div>

                                <div class="mb-3">
                                    <label for="editRepairObject" class="form-label small fw-semibold">Objet à réparer</label>
                                    <input type="text" class="form-control" id="editRepairObject" name="repairObject" placeholder="Objet à réparer" required />
                                </div>

                                <div class="mb-3">
                                    <label for="editRepairStatus" class="form-label small fw-semibold">Statut du diagnostic</label>
                                    <select class="form-select" id="editRepairStatus" name="repairStatus" required>
                                        <option value="REPAIRED">Réparé (Succès)</option>
                                        <option value="PARTIALLY_REPAIRED">Partiellement réparé</option>
                                        <option value="NOT_REPAIRED">Non réparé</option>
                                        <option value="NEEDS_RETURN">Doit revenir pour finir</option>
                                        <option value="PENDING">En cours de réparation</option>
                                    </select>
                                </div>

                                <div>
                                    <label for="editRepairNotes" class="form-label small fw-semibold">Notes / Remarques</label>
                                    <textarea class="form-control" placeholder="Notes optionnelles" id="editRepairNotes" name="repairNotes" rows="3"></textarea>
                                </div>
                            </div>
                            <div class="modal-footer bg-body-tertiary">
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i> Enregistrer
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <%- include('../includes/footer.html') %>

        <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
            // Populate edit modal
            const editModal = document.getElementById("editRepairModal");
            if (editModal) {
                editModal.addEventListener("show.bs.modal", function(event) {
                    const btn = event.relatedTarget;
                    if (!btn) return;
                    document.getElementById("editHistoryId").value = btn.getAttribute("data-historyid") || "";
                    document.getElementById("editUserName").value = btn.getAttribute("data-username") || "";
                    document.getElementById("editRepairObject").value = btn.getAttribute("data-repairobject") || "";
                    document.getElementById("editRepairStatus").value = btn.getAttribute("data-repairstatus") || "REPAIRED";
                    document.getElementById("editRepairNotes").value = btn.getAttribute("data-repairnotes") || "";
                });
            }
        </script>
    </body>
</html>
