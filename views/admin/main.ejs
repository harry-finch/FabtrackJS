<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Cockpit d'administration FabtrackJS" />
        <meta name="author" content="Stéphane Muller" />
        <title>Cockpit d'administration • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <%
                const _base = typeof baseUrl !== 'undefined' ? baseUrl : '/';
                const _cockpit = (typeof cockpit !== 'undefined' && cockpit) ? cockpit : { counters: {}, todoItems: [] };
                const _c = _cockpit.counters || {};
                const _todos = Array.isArray(_cockpit.todoItems) ? _cockpit.todoItems : [];
            %>

            <!-- Cockpit Header -->
            <div class="fab-page-header">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h1 class="fab-page-title">Cockpit d'administration</h1>
                    </div>
                    <p class="fab-page-subtitle">Vue synthétique du jour et points d'attention opérationnels du fablab</p>
                </div>
                <div class="fab-page-actions">
                    <a href="<%= _base %>fabtrack" class="btn btn-outline-secondary btn-sm">
                        <i class="fa-solid fa-desktop me-1" aria-hidden="true"></i> Kiosque
                    </a>
                    <a href="<%= _base %>admin/settings" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-sliders me-1" aria-hidden="true"></i> Configuration
                    </a>
                </div>
            </div>

            <!-- 4 Clickable Daily KPI Cards -->
            <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
                <div class="col">
                    <a href="<%= _base %>fabtrack" class="card h-100 text-decoration-none text-body fab-kpi-card">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                            <div>
                                <div class="small text-muted fw-semibold">Présents au lab</div>
                                <div class="kpi-value tabular-nums mt-1"><%= _c.presentCount || 0 %></div>
                                <div class="small text-muted mt-1">Aujourd'hui</div>
                            </div>
                            <span class="fab-kpi-icon" aria-hidden="true">
                                <i class="fa-solid fa-users"></i>
                            </span>
                        </div>
                    </a>
                </div>

                <div class="col">
                    <a href="<%= _base %>admin/equipment/manage" class="card h-100 text-decoration-none text-body fab-kpi-card <%= (_c.overdueLoansCount || 0) > 0 ? 'border-danger' : '' %>">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                            <div>
                                <div class="small text-muted fw-semibold">Emprunts en retard</div>
                                <div class="kpi-value tabular-nums <%= (_c.overdueLoansCount || 0) > 0 ? 'text-danger' : '' %> mt-1"><%= _c.overdueLoansCount || 0 %></div>
                                <div class="small text-muted mt-1">Équipements à relancer</div>
                            </div>
                            <span class="fab-kpi-icon <%= (_c.overdueLoansCount || 0) > 0 ? 'bg-danger-subtle text-danger border-danger-subtle' : '' %>" aria-hidden="true">
                                <i class="fa-solid fa-toolbox"></i>
                            </span>
                        </div>
                    </a>
                </div>

                <div class="col">
                    <a href="<%= _base %>admin/consumables/manage" class="card h-100 text-decoration-none text-body fab-kpi-card <%= (_c.lowStockCount || 0) > 0 ? 'border-warning' : '' %>">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                            <div>
                                <div class="small text-muted fw-semibold">Stocks sous seuil</div>
                                <div class="kpi-value tabular-nums <%= (_c.lowStockCount || 0) > 0 ? 'text-warning-emphasis' : '' %> mt-1"><%= _c.lowStockCount || 0 %></div>
                                <div class="small text-muted mt-1">Consommables à réapprovisionner</div>
                            </div>
                            <span class="fab-kpi-icon <%= (_c.lowStockCount || 0) > 0 ? 'bg-warning-subtle text-warning-emphasis border-warning-subtle' : '' %>" aria-hidden="true">
                                <i class="fa-solid fa-boxes-stacked"></i>
                            </span>
                        </div>
                    </a>
                </div>

                <div class="col">
                    <a href="<%= _base %>admin/machines/manage" class="card h-100 text-decoration-none text-body fab-kpi-card <%= (_c.openIssuesCount || 0) > 0 ? 'border-danger' : '' %>">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
                            <div>
                                <div class="small text-muted fw-semibold">Parc machines</div>
                                <div class="kpi-value tabular-nums mt-1"><%= _c.machinesCount || 0 %></div>
                                <div class="small mt-1 <%= (_c.openIssuesCount || 0) > 0 ? 'text-danger fw-semibold' : 'text-muted' %>">
                                    <%= (_c.openIssuesCount || 0) > 0 ? `${_c.openIssuesCount} panne(s) ouverte(s)` : 'Aucune panne ouverte' %>
                                </div>
                            </div>
                            <span class="fab-kpi-icon <%= (_c.openIssuesCount || 0) > 0 ? 'bg-danger-subtle text-danger border-danger-subtle' : '' %>" aria-hidden="true">
                                <i class="fa-solid fa-gears"></i>
                            </span>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Actionable "À traiter aujourd'hui" List -->
            <section class="card border mb-4" aria-labelledby="cockpitTodoHeading">
                <div class="card-header bg-transparent d-flex align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-list-check text-secondary" aria-hidden="true"></i>
                        <h2 class="h6 fw-bold mb-0" id="cockpitTodoHeading">À traiter aujourd'hui</h2>
                    </div>
                    <span class="badge <%= _todos.length > 0 ? 'bg-danger-subtle text-danger border border-danger-subtle' : 'bg-success-subtle text-success border border-success-subtle' %> tabular-nums">
                        <%= _todos.length %> élément(s)
                    </span>
                </div>

                <div class="card-body p-0">
                    <% if (_todos.length === 0) { %>
                        <div class="p-4 text-center">
                            <span class="fab-kpi-icon bg-success-subtle text-success border-success-subtle mb-2" aria-hidden="true">
                                <i class="fa-solid fa-circle-check"></i>
                            </span>
                            <div class="fw-semibold">Tout est à jour</div>
                            <p class="text-muted small mb-0">Aucun emprunt en retard, aucune rupture de consommable et aucune panne machine ouverte.</p>
                        </div>
                    <% } else { %>
                        <div class="list-group list-group-flush">
                            <% _todos.forEach(function(item) {
                                const badgeClass =
                                    item.severity === 'danger'
                                        ? 'bg-danger-subtle text-danger border border-danger-subtle'
                                        : item.severity === 'warning'
                                          ? 'bg-warning-subtle text-warning-emphasis border border-warning-subtle'
                                          : 'bg-body-secondary text-secondary-emphasis border';
                            %>
                            <div class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 px-3 bg-transparent">
                                <div class="d-flex align-items-center gap-3 min-w-0">
                                    <span class="badge <%= badgeClass %> d-inline-flex align-items-center gap-1 flex-shrink-0">
                                        <i class="<%= item.icon %> fa-xs" aria-hidden="true"></i>
                                        <span><%= item.badge %></span>
                                    </span>
                                    <div class="min-w-0">
                                        <div class="fw-semibold small text-truncate"><%= item.title %></div>
                                        <% if (item.subtitle) { %>
                                        <div class="text-muted small text-truncate"><%= item.subtitle %></div>
                                        <% } %>
                                    </div>
                                </div>
                                <a href="<%= _base %><%= item.href %>" class="btn btn-outline-secondary btn-sm flex-shrink-0">
                                    <%= item.actionLabel %> <i class="fa-solid fa-arrow-right fa-xs ms-1" aria-hidden="true"></i>
                                </a>
                            </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </section>

            <!-- 4 Quick Action Shortcuts -->
            <section aria-labelledby="cockpitShortcutsHeading">
                <h2 class="h6 fw-bold text-uppercase text-muted mb-2" id="cockpitShortcutsHeading" style="font-size: 0.74rem; letter-spacing: 0.05em;">
                    Raccourcis rapides
                </h2>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3">
                    <div class="col">
                        <a href="<%= _base %>fabtrack" class="card h-100 text-decoration-none text-body fab-kpi-card">
                            <div class="card-body p-3 d-flex align-items-center gap-3">
                                <span class="fab-kpi-icon" aria-hidden="true">
                                    <i class="fa-solid fa-desktop"></i>
                                </span>
                                <div class="min-w-0">
                                    <div class="fw-semibold small">Kiosque Fabtrack</div>
                                    <div class="text-muted small text-truncate">Pointage &amp; présents</div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="col">
                        <a href="<%= _base %>admin/statistics" class="card h-100 text-decoration-none text-body fab-kpi-card">
                            <div class="card-body p-3 d-flex align-items-center gap-3">
                                <span class="fab-kpi-icon" aria-hidden="true">
                                    <i class="fa-solid fa-chart-line"></i>
                                </span>
                                <div class="min-w-0">
                                    <div class="fw-semibold small">Statistiques &amp; IA</div>
                                    <div class="text-muted small text-truncate">Fréquentation &amp; NL2SQL</div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="col">
                        <a href="<%= _base %>admin/history/import" class="card h-100 text-decoration-none text-body fab-kpi-card">
                            <div class="card-body p-3 d-flex align-items-center gap-3">
                                <span class="fab-kpi-icon" aria-hidden="true">
                                    <i class="fa-solid fa-file-import"></i>
                                </span>
                                <div class="min-w-0">
                                    <div class="fw-semibold small">Import historique CSV</div>
                                    <div class="text-muted small text-truncate">Visites &amp; réconciliation</div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="col">
                        <a href="<%= _base %>admin/settings" class="card h-100 text-decoration-none text-body fab-kpi-card">
                            <div class="card-body p-3 d-flex align-items-center gap-3">
                                <span class="fab-kpi-icon" aria-hidden="true">
                                    <i class="fa-solid fa-sliders"></i>
                                </span>
                                <div class="min-w-0">
                                    <div class="fw-semibold small">Configuration &amp; Plugins</div>
                                    <div class="text-muted small text-truncate">Marque, extensions, i18n</div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </section>

            <%- include('../includes/footer.html') %>
    </body>
</html>
