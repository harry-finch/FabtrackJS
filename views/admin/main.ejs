<!doctype html>
<html lang="en" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="" />
        <meta name="author" content="Stéphane Muller" />
        <title>Fabtrack administration panel</title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Dashboard Title Banner -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box bg-primary text-white shadow-sm">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Administration panel</h4>
                        <small class="text-muted">Pilotage central et configuration de Fabtrack</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                    <a href="/admin/settings" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-sliders me-1"></i> Configuration
                    </a>
                    <a href="/fabtrack" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-desktop me-1"></i> Kiosque Fabtrack
                    </a>
                </div>
            </div>

            <!-- SECTION 1: Activité & Suivi -->
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle section-badge-header px-2 py-1">Activité & Suivi</span>
                    <hr class="flex-grow-1 my-0 opacity-25">
                </div>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-primary-subtle text-primary me-3">
                                        <i class="fa-solid fa-clipboard-list"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">View history</h6>
                                        <small class="text-muted">Passages & sessions</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Consulter, filtrer et gérer l'historique de fréquentation du fablab</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/view-history" class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                                        Ouvrir l'historique <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-success-subtle text-success me-3">
                                        <i class="fa-solid fa-chart-pie"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">Project consumption</h6>
                                        <small class="text-muted">Consommables & Projets</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Historique détaillé de consommation des matières par projet ou utilisateur</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/project-consumption" class="btn btn-outline-success btn-sm w-100 rounded-pill">
                                        Consommations <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% if (typeof isPluginUeEnabled !== 'undefined' && isPluginUeEnabled) { %>
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-danger-subtle text-danger me-3">
                                        <i class="fa-solid fa-graduation-cap"></i>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-1">
                                            <h6 class="fw-bold mb-0">Unités d'Enseignement</h6>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 0.65rem;">Sorbonne</span>
                                        </div>
                                        <small class="text-muted">Projets académiques</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Gérer les codes UE, habilitations et exports de refacturation académique</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/ue" class="btn btn-outline-danger btn-sm w-100 rounded-pill">
                                        Gérer les UE <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- SECTION 2: Parc Machines & Équipements -->
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle section-badge-header px-2 py-1">Machines & Équipements</span>
                    <hr class="flex-grow-1 my-0 opacity-25">
                </div>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-primary-subtle text-primary me-3">
                                        <i class="fa-solid fa-screwdriver-wrench"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">Manage machines</h6>
                                        <small class="text-muted">Parc machines</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Créer, modifier ou désactiver les machines de l'atelier</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/machines/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Machines <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-secondary-subtle text-secondary me-3">
                                        <i class="fa-solid fa-gears"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">Machine types</h6>
                                        <small class="text-muted">Catégories d'outils</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Définir les types de machines (FDM, SLA, Laser, CNC...)</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/machines/manage-types" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Types <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-warning-subtle text-warning-emphasis me-3">
                                        <i class="fa-solid fa-lock-keyhole"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">Access levels</h6>
                                        <small class="text-muted">Habilitations</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Niveaux requis pour réserver et utiliser chaque équipement</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/accesslevels/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Accès <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-info-subtle text-info-emphasis me-3">
                                        <i class="fa-solid fa-location-dot"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">Locations</h6>
                                        <small class="text-muted">Salles & Zones</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Emplacements physiques et zones de travail du fablab</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/locations/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Emplacements <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 3: Matières & Ressources -->
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle section-badge-header px-2 py-1">Matières & Ressources</span>
                    <hr class="flex-grow-1 my-0 opacity-25">
                </div>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-success-subtle text-success me-3">
                                        <i class="fa-solid fa-boxes-stacked"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">Consumables</h6>
                                        <small class="text-muted">Stocks & Tarifs</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Inventaire, stocks en unités/grammes et livraisons</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/consumables/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Consommables <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-secondary-subtle text-secondary me-3">
                                        <i class="fa-solid fa-layer-group"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">Categories</h6>
                                        <small class="text-muted">Rayons & Types</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Classer les consommables (Filaments, Résines, Plaques...)</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/categories/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Catégories <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-info-subtle text-info-emphasis me-3">
                                        <i class="fa-solid fa-diagram-project"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">Project types</h6>
                                        <small class="text-muted">Typologies</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Types de projets (Académique, Personnel, Recherche, Pro...)</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/projecttypes/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Types projets <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% if( workspaces ) { %>
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-dark-subtle text-body me-3">
                                        <i class="fa-solid fa-building"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">Workspaces</h6>
                                        <small class="text-muted">Espaces Fablab</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Gérer les différents espaces ou fablabs rattachés</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/workspaces/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Workspaces <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- SECTION 4: Membres & Communauté -->
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle section-badge-header px-2 py-1">Membres & Communauté</span>
                    <hr class="flex-grow-1 my-0 opacity-25">
                </div>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-5 g-3">
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-primary-subtle text-primary me-3">
                                        <i class="fa-solid fa-users"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">Fablab users</h6>
                                        <small class="text-muted">Adhérents & Visiteurs</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Gérer les comptes usagers, soldes et abonnements</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/users/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Utilisateurs <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-primary-subtle text-primary me-3">
                                        <i class="fa-solid fa-graduation-cap"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">Workshops</h6>
                                        <small class="text-muted">Formations & Badges</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Gestion des ateliers, liste d'intérêt et badges d'habilitation</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/workshops/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Ateliers <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-danger-subtle text-danger me-3">
                                        <i class="fa-solid fa-users-gear"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">Staff accounts</h6>
                                        <small class="text-muted">Équipe & Admins</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Droits d'accès et comptes administrateurs / animateurs</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/staff/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Staff <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-secondary-subtle text-secondary me-3">
                                        <i class="fa-solid fa-user-tag"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">User types</h6>
                                        <small class="text-muted">Profils & Statuts</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Profils (Étudiant, Chercheur, Particulier, Fabmanager...)</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/usertypes/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Types usagers <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-warning-subtle text-warning-emphasis me-3">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">Warning types</h6>
                                        <small class="text-muted">Sanctions & Sécurité</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Définir les motifs d'avertissement et règles de sécurité</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/warningtypes/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Avertissements <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 5: Plateforme & Configuration -->
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle section-badge-header px-2 py-1">Plateforme & Configuration</span>
                    <hr class="flex-grow-1 my-0 opacity-25">
                </div>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm border-start border-primary border-3">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-primary-subtle text-primary me-3">
                                        <i class="fa-solid fa-sliders"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">General settings</h6>
                                        <small class="text-muted">Configuration globale</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Personnaliser le logo, le nom, le favicon, les plugins, et la durée des sessions</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/settings" class="btn btn-primary btn-sm w-100 rounded-pill shadow-sm">
                                        Paramètres de la plateforme <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 6: Modules avancés -->
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-body-secondary text-body-secondary border section-badge-header px-2 py-1">Outils & Modules futurs</span>
                    <hr class="flex-grow-1 my-0 opacity-25">
                </div>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm opacity-75">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="icon-box bg-body-secondary text-secondary">
                                        <i class="fa-solid fa-chart-line"></i>
                                    </div>
                                    <span class="badge bg-body-secondary text-body-secondary border">Bientôt</span>
                                </div>
                                <h6 class="fw-bold mb-1">Statistics</h6>
                                <p class="card-text text-secondary small flex-grow-1">Analyses avancées d'utilisation du matériel et affluence</p>
                                <div class="pt-2 mt-auto">
                                    <button class="btn btn-sm btn-outline-secondary w-100 rounded-pill" disabled>Indisponible</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm opacity-75">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="icon-box bg-body-secondary text-secondary">
                                        <i class="fa-regular fa-envelope-open-text"></i>
                                    </div>
                                    <span class="badge bg-body-secondary text-body-secondary border">Bientôt</span>
                                </div>
                                <h6 class="fw-bold mb-1">Communication</h6>
                                <p class="card-text text-secondary small flex-grow-1">Envoi d'e-mails groupés et newsletters aux membres</p>
                                <div class="pt-2 mt-auto">
                                    <button class="btn btn-sm btn-outline-secondary w-100 rounded-pill" disabled>Indisponible</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm opacity-75">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="icon-box bg-body-secondary text-secondary">
                                        <i class="fa-regular fa-clipboard-list"></i>
                                    </div>
                                    <span class="badge bg-body-secondary text-body-secondary border">Bientôt</span>
