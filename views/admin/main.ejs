<!doctype html>
<html lang="en" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="" />
        <meta name="author" content="Stéphane Muller" />
        <title>Fabtrack administration panel</title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Dashboard Title Banner -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box bg-primary text-white shadow-sm">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Administration panel</h4>
                        <small class="text-muted">Pilotage central et configuration de Fabtrack</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                    <a href="/admin/settings" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-sliders me-1"></i> Configuration
                    </a>
                    <a href="/fabtrack" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-desktop me-1"></i> Kiosque Fabtrack
                    </a>
                </div>
            </div>

            <!-- SECTION 1: Activité & Suivi -->
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle section-badge-header px-2 py-1">Activité & Suivi</span>
                    <hr class="flex-grow-1 my-0 opacity-25">
                </div>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm border-start border-primary border-3">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-primary-subtle text-primary me-2">
                                        <i class="fa-solid fa-chart-line"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h6 class="fw-bold mb-0 text-truncate">Statistiques</h6>
                                        <small class="text-muted text-truncate">Tableau de bord</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Affluence, KPIs d'activité et consommations globales</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/statistics" class="btn btn-primary btn-sm w-100 rounded-pill shadow-sm">
                                        Statistiques <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-primary-subtle text-primary me-2">
                                        <i class="fa-solid fa-clipboard-list"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h6 class="fw-bold mb-0 text-truncate">Historique</h6>
                                        <small class="text-muted text-truncate">Visites & passages</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Registre chronologique des présences et sessions</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/view-history" class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                                        Historique <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-success-subtle text-success me-2">
                                        <i class="fa-solid fa-chart-pie"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h6 class="fw-bold mb-0 text-truncate">Consommation</h6>
                                        <small class="text-muted text-truncate">Matières & projets</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Suivi des matières débitées par projet et usager</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/project-consumption" class="btn btn-outline-success btn-sm w-100 rounded-pill">
                                        Consommations <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-primary-subtle text-primary me-2">
                                        <i class="fa-solid fa-envelope-open-text"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h6 class="fw-bold mb-0 text-truncate">Communication</h6>
                                        <small class="text-muted text-truncate">Listes de diffusion</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Listes d'e-mails pour la newsletter et les ateliers</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/communication" class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                                        Communication <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- UE Plugin Card -->
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm <%= (typeof isPluginUeEnabled !== 'undefined' && isPluginUeEnabled) ? '' : 'plugin-disabled' %>">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box <%= (typeof isPluginUeEnabled !== 'undefined' && isPluginUeEnabled) ? 'bg-danger-subtle text-danger' : 'bg-body-secondary text-secondary-emphasis' %> me-2">
                                        <i class="fa-solid fa-graduation-cap"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="d-flex align-items-center gap-1">
                                            <h6 class="fw-bold mb-0 text-truncate">Unités d'Ens.</h6>
                                            <% if (typeof isPluginUeEnabled !== 'undefined' && isPluginUeEnabled) { %>
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 0.65rem;">UE</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size: 0.65rem;"><i class="fa-solid fa-power-off me-1"></i>Désactivé</span>
                                            <% } %>
                                        </div>
                                        <small class="text-muted text-truncate">Projets académiques</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Codes UE et exports de refacturation Sorbonne</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/ue" class="btn <%= (typeof isPluginUeEnabled !== 'undefined' && isPluginUeEnabled) ? 'btn-outline-danger' : 'btn-outline-secondary' %> btn-sm w-100 rounded-pill">
                                        <%= (typeof isPluginUeEnabled !== 'undefined' && isPluginUeEnabled) ? 'Gérer les UE' : 'Gérer les UE (Désactivé)' %> <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- BookStack Plugin Card -->
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm <%= (typeof isPluginBookstackEnabled !== 'undefined' && isPluginBookstackEnabled) ? '' : 'plugin-disabled' %>">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box <%= (typeof isPluginBookstackEnabled !== 'undefined' && isPluginBookstackEnabled) ? 'bg-primary-subtle text-primary' : 'bg-body-secondary text-secondary-emphasis' %> me-2">
                                        <i class="fa-solid fa-book"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="d-flex align-items-center gap-1">
                                            <h6 class="fw-bold mb-0 text-truncate">BookStack</h6>
                                            <% if (typeof isPluginBookstackEnabled !== 'undefined' && isPluginBookstackEnabled) { %>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.65rem;">Wiki</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size: 0.65rem;"><i class="fa-solid fa-power-off me-1"></i>Désactivé</span>
                                            <% } %>
                                        </div>
                                        <small class="text-muted text-truncate">Documentation</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Suivi de fraîcheur documentaire et clés API du wiki</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/bookstack" class="btn <%= (typeof isPluginBookstackEnabled !== 'undefined' && isPluginBookstackEnabled) ? 'btn-outline-primary' : 'btn-outline-secondary' %> btn-sm w-100 rounded-pill">
                                        <%= (typeof isPluginBookstackEnabled !== 'undefined' && isPluginBookstackEnabled) ? 'BookStack' : 'BookStack (Désactivé)' %> <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Repair Café Plugin Card -->
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm <%= (typeof isPluginRepairCafeEnabled !== 'undefined' && isPluginRepairCafeEnabled) ? '' : 'plugin-disabled' %>">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box <%= (typeof isPluginRepairCafeEnabled !== 'undefined' && isPluginRepairCafeEnabled) ? 'bg-warning-subtle text-warning-emphasis' : 'bg-body-secondary text-secondary-emphasis' %> me-2">
                                        <i class="fa-solid fa-wrench"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="d-flex align-items-center gap-1">
                                            <h6 class="fw-bold mb-0 text-truncate">Repair Café</h6>
                                            <% if (typeof isPluginRepairCafeEnabled !== 'undefined' && isPluginRepairCafeEnabled) { %>
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size: 0.65rem;">Atelier</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size: 0.65rem;"><i class="fa-solid fa-power-off me-1"></i>Désactivé</span>
                                            <% } %>
                                        </div>
                                        <small class="text-muted text-truncate">Réparations & bilans</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Historique des réparations, taux de succès et visiteurs</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/repair-cafe" class="btn <%= (typeof isPluginRepairCafeEnabled !== 'undefined' && isPluginRepairCafeEnabled) ? 'btn-outline-warning' : 'btn-outline-secondary' %> btn-sm w-100 rounded-pill">
                                        <%= (typeof isPluginRepairCafeEnabled !== 'undefined' && isPluginRepairCafeEnabled) ? 'Repair Café' : 'Repair Café (Désactivé)' %> <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: Membres & Communauté -->
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle section-badge-header px-2 py-1">Membres & Communauté</span>
                    <hr class="flex-grow-1 my-0 opacity-25">
                </div>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-primary-subtle text-primary me-2">
                                        <i class="fa-solid fa-users"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h6 class="fw-bold mb-0 text-truncate">Utilisateurs</h6>
                                        <small class="text-muted text-truncate">Adhérents & soldes</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Comptes usagers, soldes et chartes d'accès</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/users/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Utilisateurs <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-secondary-subtle text-secondary me-2">
                                        <i class="fa-solid fa-user-tag"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h6 class="fw-bold mb-0 text-truncate">Types usagers</h6>
                                        <small class="text-muted text-truncate">Profils & statuts</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Statuts (étudiant, chercheur, pro...)</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/usertypes/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Types usagers <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Workshops (Ateliers) Plugin Card -->
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm <%= (typeof isPluginWorkshopEnabled !== 'undefined' && isPluginWorkshopEnabled) ? '' : 'plugin-disabled' %>">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box <%= (typeof isPluginWorkshopEnabled !== 'undefined' && isPluginWorkshopEnabled) ? 'bg-primary-subtle text-primary' : 'bg-body-secondary text-secondary-emphasis' %> me-2">
                                        <i class="fa-solid fa-chalkboard-user"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="d-flex align-items-center gap-1">
                                            <h6 class="fw-bold mb-0 text-truncate">Ateliers</h6>
                                            <% if (typeof isPluginWorkshopEnabled !== 'undefined' && isPluginWorkshopEnabled) { %>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.65rem;">Plugin</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size: 0.65rem;"><i class="fa-solid fa-power-off me-1"></i>Désactivé</span>
                                            <% } %>
                                        </div>
                                        <small class="text-muted text-truncate">Formations & badges</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Gestion des ateliers, intérêts et initiations</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/workshops/manage" class="btn <%= (typeof isPluginWorkshopEnabled !== 'undefined' && isPluginWorkshopEnabled) ? 'btn-outline-secondary' : 'btn-outline-secondary' %> btn-sm w-100 rounded-pill">
                                        <%= (typeof isPluginWorkshopEnabled !== 'undefined' && isPluginWorkshopEnabled) ? 'Ateliers' : 'Ateliers (Désactivé)' %> <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-warning-subtle text-warning-emphasis me-2">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h6 class="fw-bold mb-0 text-truncate">Avertissements</h6>
                                        <small class="text-muted text-truncate">Règles & sécurité</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Motifs d'avertissement et consignes du lab</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/warningtypes/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Avertissements <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 3: Parc Machines & Accès -->
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle section-badge-header px-2 py-1">Parc Machines & Accès</span>
                    <hr class="flex-grow-1 my-0 opacity-25">
                </div>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-primary-subtle text-primary me-2">
                                        <i class="fa-solid fa-screwdriver-wrench"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h6 class="fw-bold mb-0 text-truncate">Machines</h6>
                                        <small class="text-muted text-truncate">Parc & statuts</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Créer, éditer ou réviser les machines du fablab</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/machines/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Machines <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-secondary-subtle text-secondary me-2">
                                        <i class="fa-solid fa-gears"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h6 class="fw-bold mb-0 text-truncate">Types machines</h6>
                                        <small class="text-muted text-truncate">Familles d'outils</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Classification (FDM, SLA, Laser, CNC...)</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/machines/manage-types" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Types <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-primary-subtle text-primary me-2">
                                        <i class="fa-solid fa-toolbox"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h6 class="fw-bold mb-0 text-truncate">Outillage</h6>
                                        <small class="text-muted text-truncate">Équipements & prêt</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Outils à main, mesure et matériels empruntables</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/equipment/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Équipements <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-warning-subtle text-warning-emphasis me-2">
                                        <i class="fa-solid fa-lock-keyhole"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h6 class="fw-bold mb-0 text-truncate">Niveaux d'accès</h6>
                                        <small class="text-muted text-truncate">Habilitations</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Prérequis d'accès pour réserver chaque ressource</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/accesslevels/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Accès <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 4: Matières & Projets -->
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle section-badge-header px-2 py-1">Matières & Projets</span>
                    <hr class="flex-grow-1 my-0 opacity-25">
                </div>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="icon-box bg-success-subtle text-success me-2">
                                        <i class="fa-solid fa-boxes-stacked"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <h6 class="fw-bold mb-0 text-truncate">Consommables</h6>
                                        <small class="text-muted text-truncate">Stocks & matières</small>
                                    </div>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">Inventaire, stocks en unités/grammes et tarifs</p>
                                <div class="pt-2 mt-auto">
                                    <a href="/admin/consumables/manage" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                                        Consommables <i class="fa-solid fa-arrow-right fa-xs ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card card-dashboard h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex align-items-center mb-2">
