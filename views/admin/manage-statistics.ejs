<!doctype html>
<html lang="en" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Tableau de bord statistique et fréquentation du Fablab" />
        <meta name="author" content="FabtrackJS" />
        <title>Statistiques & Fréquentation - <%= platformName %></title>

        <%- include('../includes/pagehead.html') %>
        <!-- Chart.js CDN -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <div class="mb-3">
                <a href="/admin" class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="fa-solid fa-arrow-left me-1"></i> Panneau d'administration
                </a>
            </div>

            <!-- En-tête de la page -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                <div>
                    <h4 class="fw-bold mb-0">
                        <i class="fa-solid fa-chart-line text-primary me-2"></i>Statistiques & Fréquentation
                    </h4>
                    <small class="text-muted">Tableau de bord analytique de l'activité du Fablab, affluence, typologies et consommations</small>
                </div>
                <div class="d-flex gap-2">
                    <a href="/admin/statistics/export?workspaceId=<%= selectedWorkspaceId || '' %>&startDate=<%= filterStartDate %>&endDate=<%= filterEndDate %>" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-file-csv me-1"></i> Exporter CSV
                    </a>
                </div>
            </div>

            <!-- BANDEAU DES FILTRES (ESPACE ET PÉRIODE) -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <form action="/admin/statistics" method="get" id="statsFilterForm" class="row g-2 align-items-end">
                        <!-- Filtre Espace -->
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-muted mb-1">
                                <i class="fa-solid fa-cubes-stacked me-1"></i> Espace du Fablab
                            </label>
                            <select class="form-select form-select-sm" name="workspaceId" id="workspaceSelect">
                                <option value="" <%= !selectedWorkspaceId ? 'selected' : '' %>>Tous les espaces (Global)</option>
                                <% workspaces.forEach(function(ws) { %>
                                    <option value="<%= ws.id %>" <%= selectedWorkspaceId == ws.id ? 'selected' : '' %>><%= ws.name %></option>
                                <% }); %>
                            </select>
                        </div>

                        <!-- Filtre Période Prédéfinie -->
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-muted mb-1">
                                <i class="fa-solid fa-calendar-days me-1"></i> Période
                            </label>
                            <select class="form-select form-select-sm" name="period" id="periodSelect">
                                <option value="this_month" <%= period === 'this_month' ? 'selected' : '' %>>Ce mois-ci</option>
                                <option value="7d" <%= period === '7d' ? 'selected' : '' %>>7 derniers jours</option>
                                <option value="30d" <%= period === '30d' ? 'selected' : '' %>>30 derniers jours</option>
                                <option value="last_month" <%= period === 'last_month' ? 'selected' : '' %>>Mois dernier</option>
                                <option value="this_year" <%= period === 'this_year' ? 'selected' : '' %>>Cette année civile</option>
                                <option value="academic_year" <%= period === 'academic_year' ? 'selected' : '' %>>Année universitaire</option>
                                <option value="all" <%= period === 'all' ? 'selected' : '' %>>Tout l'historique</option>
                                <option value="custom" <%= period === 'custom' ? 'selected' : '' %>>Personnalisée...</option>
                            </select>
                        </div>

                        <!-- Date début -->
                        <div class="col-md-2 col-6">
                            <label class="form-label small fw-semibold text-muted mb-1">Date début</label>
                            <input type="date" class="form-control form-control-sm" name="startDate" id="startDateInput" value="<%= filterStartDate %>">
                        </div>

                        <!-- Date fin -->
                        <div class="col-md-2 col-6">
                            <label class="form-label small fw-semibold text-muted mb-1">Date fin</label>
                            <input type="date" class="form-control form-control-sm" name="endDate" id="endDateInput" value="<%= filterEndDate %>">
                        </div>

                        <!-- Boutons actions -->
                        <div class="col-md-2 d-flex gap-1">
                            <button type="submit" class="btn btn-primary btn-sm w-100 rounded-pill">
                                <i class="fa-solid fa-arrows-rotate me-1"></i> Filtrer
                            </button>
                            <a href="/admin/statistics" class="btn btn-outline-secondary btn-sm rounded-pill px-2" title="Réinitialiser les filtres">
                                <i class="fa-solid fa-rotate-left"></i>
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- CARTES DE CHIFFRES CLÉS (KPIS) -->
            <div class="row g-3 mb-4">
                <!-- Visites Totales -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Visites totales</span>
                                <i class="fa-solid fa-door-open fs-5 text-primary"></i>
                            </div>
                            <div class="fs-3 fw-bold text-primary mb-1">
                                <%= kpis.totalVisits %>
                            </div>
                            <div class="small text-muted">
                                <i class="fa-solid fa-clock-rotate-left me-1"></i> <%= kpis.totalHoursFormatted %> heures cumulées (<%= kpis.avgDurationFormatted %> en moy.)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Visiteurs Uniques -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Visiteurs uniques</span>
                                <i class="fa-solid fa-users fs-5 text-success"></i>
                            </div>
                            <div class="fs-3 fw-bold text-success mb-1">
                                <%= kpis.uniqueVisitors %>
                            </div>
                            <div class="small text-muted">
                                Individus différents accueillis sur la période
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Jour le plus actif -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary border-start border-warning border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Jour le plus actif</span>
                                <i class="fa-solid fa-fire-flame-curved fs-5 text-warning"></i>
                            </div>
                            <div class="fs-3 fw-bold text-warning mb-1">
                                <%= kpis.peakDayName %>
                            </div>
                            <div class="small text-muted">
                                <% if (kpis.peakDayAvg !== undefined && kpis.peakDayAvg > 0) { %>
                                    Moyenne : <strong><%= kpis.peakDayAvg %></strong> visites/j (<%= kpis.peakDayTotal %> au total)
                                <% } else { %>
                                    Aucune visite sur la période
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Projets Suivis -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Projets suivis</span>
                                <i class="fa-solid fa-folder-open fs-5 text-info"></i>
                            </div>
                            <div class="fs-3 fw-bold text-info mb-1">
                                <%= kpis.activeProjectsCount %>
                            </div>
                            <div class="small text-muted">
                                <i class="fa-solid fa-folder-tree me-1"></i> Projets actifs sur la période (<%= kpis.totalActiveProjectsInDb %> non archivés au total)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Utilisation Machines -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Parc machines</span>
                                <i class="fa-solid fa-gears fs-5 text-secondary"></i>
                            </div>
                            <div class="fs-3 fw-bold text-secondary mb-1">
                                <%= kpis.totalMachineSessions %> session(s)
                            </div>
                            <div class="small text-muted">
                                Sur <%= kpis.uniqueMachinesOperated %> machine(s) différentes opérées
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Consommables & Matières -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Consommables</span>
                                <i class="fa-solid fa-boxes-stacked fs-5 text-danger"></i>
                            </div>
                            <div class="fs-3 fw-bold text-danger mb-1">
                                <%= kpis.totalConsumablesCost %> <%= currencySymbol %>
                            </div>
                            <div class="small text-muted">
                                <%= kpis.totalConsumablesQuantity %> unité(s) de matière débitée(s)
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- GRAPHIQUES SECTION 1: ÉVOLUTION TEMPORELLE & JOURS DE LA SEMAINE -->
            <div class="row g-3 mb-4">
                <!-- Fréquentation dans le temps -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-chart-area text-primary me-2"></i>Fréquentation par semaine
                            </h6>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">Évolution</span>
                        </div>
                        <div class="card-body">
                            <div style="height: 280px; position: relative;">
                                <canvas id="timelineChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Affluence par jour de la semaine -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-calendar-week text-warning me-2"></i>Activité par jour
                            </h6>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle small">Moyenne / jour</span>
                        </div>
                        <div class="card-body">
                            <div style="height: 280px; position: relative;">
                                <canvas id="daysOfWeekChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- GRAPHIQUES SECTION 2: RÉPARTITIONS TYPES D'USAGERS ET DE PROJETS -->
            <div class="row g-3 mb-4">
                <!-- Typologie d'utilisateurs -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-users text-success me-2"></i>Répartition par type d'usagers
                            </h6>
                            <span class="badge bg-secondary-subtle text-secondary small">Profils</span>
                        </div>
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <div style="height: 260px; width: 100%; position: relative;">
                                <canvas id="userTypesChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Typologie de projets -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-folder-tree text-info me-2"></i>Répartition par type de projets
                            </h6>
                            <span class="badge bg-secondary-subtle text-secondary small">Projets</span>
                        </div>
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <div style="height: 260px; width: 100%; position: relative;">
                                <canvas id="projectTypesChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- GRAPHIQUES SECTION 3: TOP MACHINES & TOP CONSOMMABLES -->
            <div class="row g-3 mb-4">
                <!-- Top Machines -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-wrench text-secondary me-2"></i>Machines les plus sollicitées
                            </h6>
                            <span class="badge bg-secondary-subtle text-secondary small">Top 5</span>
                        </div>
                        <div class="card-body">
                            <div style="height: 240px; position: relative;">
                                <canvas id="topMachinesChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Top Consommables -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-box text-danger me-2"></i>Consommables les plus débités
                            </h6>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">Unités de stockage</span>
                        </div>
                        <div class="card-body">
                            <div style="height: 240px; position: relative;">
                                <canvas id="topConsumablesChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABLEAU RÉCAPITULATIF PAR ESPACE -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-0 pt-3 pb-2">
                    <h6 class="fw-bold mb-0">
                        <i class="fa-solid fa-table-list text-primary me-2"></i>Activité détaillée par espace
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3">Espace</th>
                                    <th scope="col">Localisation</th>
                                    <th scope="col" class="text-center">Visites enregistrées</th>
                                    <th scope="col" class="text-center">Visiteurs uniques</th>
                                    <th scope="col" style="width: 250px;">Part du trafic</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% workspaceStats.forEach(function(ws) { %>
                                    <tr>
                                        <td class="ps-3 fw-semibold text-primary">
                                            <%= ws.name %>
                                        </td>
                                        <td class="text-muted small"><%= ws.location %></td>
                                        <td class="text-center fw-bold"><%= ws.totalVisits %></td>
                                        <td class="text-center"><%= ws.uniqueVisitors %></td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height: 8px;">
                                                    <div class="progress-bar bg-primary" role="progressbar" style="width: <%= ws.percentage %>%;" aria-valuenow="<%= ws.percentage %>" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                                <span class="small text-muted" style="min-width: 35px;"><%= ws.percentage %>%</span>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <%- include('../includes/footer.html') %>

        <!-- SCRIPTS CHART.JS & INTERACTIONS -->
        <script>
            // Données transmises depuis le serveur
            const chartData = <%- JSON.stringify(chartData) %>;

            // Détection du thème clair/sombre pour adapter Chart.js
            const isDark = document.documentElement.getAttribute("data-bs-theme") === "dark" ||
                           (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches && document.documentElement.getAttribute("data-bs-theme") === "auto");

            const textColor = isDark ? "#adb5bd" : "#495057";
            const gridColor = isDark ? "rgba(255, 255, 255, 0.08)" : "rgba(0, 0, 0, 0.05)";

            Chart.defaults.color = textColor;
            Chart.defaults.font.family = 'system-ui, -apple-system, "Segoe UI", Roboto, sans-serif';

            // Palette de couleurs harmonieuse
            const colors = [
                '#0d6efd', '#198754', '#ffc107', '#0dcaf0', '#6f42c1', 
                '#d63384', '#fd7e14', '#20c997', '#6c757d', '#dc3545'
            ];

            // 1. Graphique Évolution temporelle
            const ctxTimeline = document.getElementById("timelineChart").getContext("2d");
            new Chart(ctxTimeline, {
                type: 'line',
                data: {
                    labels: chartData.timelineLabels.length ? chartData.timelineLabels : ['Aucune donnée'],
                    datasets: [{
                        label: 'Visites',
                        data: chartData.timelineValues.length ? chartData.timelineValues : [0],
                        borderColor: '#0d6efd',
                        backgroundColor: isDark ? 'rgba(13, 110, 253, 0.15)' : 'rgba(13, 110, 253, 0.08)',
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2.5,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#0d6efd',
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: gridColor }, ticks: { color: textColor } },
                        y: { beginAtZero: true, grid: { color: gridColor }, ticks: { stepSize: 1, color: textColor } }
                    }
                }
            });

            // 2. Graphique Affluence par jour de la semaine (Moyenne par jour)
            const ctxDays = document.getElementById("daysOfWeekChart").getContext("2d");
            const dayValues = chartData.dayAverages || chartData.dayCounts;
            const maxVal = Math.max(...dayValues);
            const dayColors = dayValues.map(v => (v > 0 && v === maxVal) ? '#ffc107' : '#0d6efd');

            new Chart(ctxDays, {
                type: 'bar',
                data: {
                    labels: chartData.dayNames,
                    datasets: [{
                        label: 'Moyenne de visites',
                        data: dayValues,
                        backgroundColor: dayColors,
                        borderRadius: 6,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { 
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const idx = context.dataIndex;
                                    const avg = context.parsed.y;
                                    const total = (chartData.dayCounts && chartData.dayCounts[idx] !== undefined) ? chartData.dayCounts[idx] : avg;
                                    const occ = (chartData.dayOccurrences && chartData.dayOccurrences[idx]) ? chartData.dayOccurrences[idx] : 1;
                                    const dayName = chartData.dayNames[idx];
                                    return `Moyenne : ${avg} visites/j (${total} au total sur ${occ} ${dayName.toLowerCase()}s)`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: textColor } },
                        y: { 
                            beginAtZero: true, 
                            grid: { color: gridColor }, 
                            ticks: { color: textColor },
                            title: { display: true, text: 'Visites en moyenne / jour', color: textColor, font: { size: 11 } }
                        }
                    }
                }
            });

            // 3. Graphique Répartition Types d'Usagers
            const ctxUserTypes = document.getElementById("userTypesChart").getContext("2d");
            new Chart(ctxUserTypes, {
                type: 'doughnut',
                data: {
                    labels: chartData.userTypeLabels.length ? chartData.userTypeLabels : ['Aucun usager'],
                    datasets: [{
                        data: chartData.userTypeCounts.length ? chartData.userTypeCounts : [1],
                        backgroundColor: colors.slice(0, Math.max(1, chartData.userTypeLabels.length)),
                        borderWidth: isDark ? 0 : 2,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12, padding: 15, color: textColor }
                        }
                    },
                    cutout: '65%',
                }
            });

            // 4. Graphique Répartition Types de Projets
            const ctxProjectTypes = document.getElementById("projectTypesChart").getContext("2d");
            new Chart(ctxProjectTypes, {
                type: 'doughnut',
                data: {
                    labels: chartData.projectTypeLabels.length ? chartData.projectTypeLabels : ['Aucun projet'],
                    datasets: [{
                        data: chartData.projectTypeCounts.length ? chartData.projectTypeCounts : [1],
                        backgroundColor: colors.slice(2, 2 + Math.max(1, chartData.projectTypeLabels.length)),
                        borderWidth: isDark ? 0 : 2,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12, padding: 15, color: textColor }
                        }
                    },
                    cutout: '65%',
                }
            });

            // 5. Graphique Top Machines
            const ctxMachines = document.getElementById("topMachinesChart").getContext("2d");
            new Chart(ctxMachines, {
                type: 'bar',
                data: {
                    labels: chartData.topMachineLabels.length ? chartData.topMachineLabels : ['Aucune session machine'],
                    datasets: [{
                        label: 'Sessions',
                        data: chartData.topMachineCounts.length ? chartData.topMachineCounts : [0],
                        backgroundColor: '#6f42c1',
                        borderRadius: 4,
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, grid: { color: gridColor }, ticks: { stepSize: 1, color: textColor } },
                        y: { grid: { display: false }, ticks: { color: textColor } }
                    }
                }
            });

            // 6. Graphique Top Consommables (ramenés aux unités de stockage)
            const ctxConsumables = document.getElementById("topConsumablesChart").getContext("2d");
            const consumableDetails = chartData.topConsumableDetails || [];
            new Chart(ctxConsumables, {
                type: 'bar',
                data: {
                    labels: chartData.topConsumableLabels.length ? chartData.topConsumableLabels : ['Aucune consommation'],
                    datasets: [{
                        label: 'Quantité (unités de stockage)',
                        data: chartData.topConsumableCounts.length ? chartData.topConsumableCounts : [0],
                        backgroundColor: '#dc3545',
                        borderRadius: 4,
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { 
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const idx = context.dataIndex;
                                    const item = consumableDetails[idx];
                                    if (item) {
                                        return `${item.stockQty} ${item.stockUnit} (soit ${item.usageQty} ${item.usageUnit})`;
                                    }
                                    return `${context.parsed.x} unité(s)`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: { 
                            beginAtZero: true, 
                            grid: { color: gridColor }, 
                            ticks: { color: textColor },
                            title: { display: true, text: 'Unités de stockage (bobines, packs, rouleaux...)', color: textColor, font: { size: 11 } }
                        },
                        y: { grid: { display: false }, ticks: { color: textColor } }
                    }
                }
            });

            // Synchronisation dynamique du sélecteur de période avec les inputs de date
            document.getElementById("periodSelect").addEventListener("change", function() {
                const now = new Date();
                const formatDate = (d) => {
                    const y = d.getFullYear();
                    const m = String(d.getMonth() + 1).padStart(2, "0");
                    const day = String(d.getDate()).padStart(2, "0");
                    return `${y}-${m}-${day}`;
                };

                let start = "";
                let end = formatDate(now);

                if (this.value === "7d") {
                    const d = new Date();
                    d.setDate(d.getDate() - 6);
                    start = formatDate(d);
                } else if (this.value === "30d") {
                    const d = new Date();
                    d.setDate(d.getDate() - 29);
                    start = formatDate(d);
                } else if (this.value === "this_month") {
                    const d = new Date(now.getFullYear(), now.getMonth(), 1);
                    start = formatDate(d);
                } else if (this.value === "last_month") {
                    const dStart = new Date(now.getFullYear(), now.getMonth() - 1, 1);
                    const dEnd = new Date(now.getFullYear(), now.getMonth(), 0);
                    start = formatDate(dStart);
                    end = formatDate(dEnd);
                } else if (this.value === "this_year") {
                    start = `${now.getFullYear()}-01-01`;
                } else if (this.value === "academic_year") {
                    const startYear = now.getMonth() >= 8 ? now.getFullYear() : now.getFullYear() - 1;
                    start = `${startYear}-09-01`;
                } else if (this.value === "all") {
                    start = "";
                    end = "";
                }

                if (this.value !== "custom") {
                    document.getElementById("startDateInput").value = start;
                    document.getElementById("endDateInput").value = end;
                }
            });
        </script>
    </body>
</html>
