<!doctype html>
<html lang="en" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Tableau de bord statistique et fréquentation du Fablab" />
        <meta name="author" content="FabtrackJS" />
        <title>Statistiques & Fréquentation - <%= platformName %></title>

        <%- include('../includes/pagehead.html') %>
        <!-- Chart.js CDN -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Page Header -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.25rem;">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h4 class="fw-bold mb-0">Statistiques & Fréquentation</h4>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" style="font-size: 0.72rem;">Analytique</span>
                            </div>
                            <p class="text-muted small mb-0">Tableau de bord de l'activité du Fablab, affluence, typologies et consommations</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="/admin" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            <i class="fa-solid fa-arrow-left me-1"></i> Retour panneau admin
                        </a>
                        <a href="/admin/statistics/export?workspaceId=<%= selectedWorkspaceId || '' %>&startDate=<%= filterStartDate %>&endDate=<%= filterEndDate %>" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm">
                            <i class="fa-solid fa-file-csv me-1"></i> Exporter CSV
                        </a>
                    </div>
                </div>
            </div>

            <!-- BANDEAU DES FILTRES (ESPACE ET PÉRIODE) -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <form action="/admin/statistics" method="get" id="statsFilterForm" class="row g-2 align-items-end">
                        <!-- Filtre Espace -->
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-muted mb-1">
                                <i class="fa-solid fa-cubes-stacked me-1"></i> Espace du Fablab
                            </label>
                            <select class="form-select form-select-sm" name="workspaceId" id="workspaceSelect">
                                <option value="" <%= !selectedWorkspaceId ? 'selected' : '' %>>Tous les espaces (Global)</option>
                                <% workspaces.forEach(function(ws) { %>
                                    <option value="<%= ws.id %>" <%= selectedWorkspaceId == ws.id ? 'selected' : '' %>><%= ws.name %></option>
                                <% }); %>
                            </select>
                        </div>

                        <!-- Filtre Période Prédéfinie -->
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-muted mb-1">
                                <i class="fa-solid fa-calendar-days me-1"></i> Période
                            </label>
                            <select class="form-select form-select-sm" name="period" id="periodSelect">
                                <option value="this_month" <%= period === 'this_month' ? 'selected' : '' %>>Ce mois-ci</option>
                                <option value="7d" <%= period === '7d' ? 'selected' : '' %>>7 derniers jours</option>
                                <option value="30d" <%= period === '30d' ? 'selected' : '' %>>30 derniers jours</option>
                                <option value="last_month" <%= period === 'last_month' ? 'selected' : '' %>>Mois dernier</option>
                                <option value="this_year" <%= period === 'this_year' ? 'selected' : '' %>>Cette année civile</option>
                                <option value="academic_year" <%= period === 'academic_year' ? 'selected' : '' %>>Année universitaire</option>
                                <option value="all" <%= period === 'all' ? 'selected' : '' %>>Tout l'historique</option>
                                <option value="custom" <%= period === 'custom' ? 'selected' : '' %>>Personnalisée...</option>
                            </select>
                        </div>

                        <!-- Date début -->
                        <div class="col-md-2 col-6">
                            <label class="form-label small fw-semibold text-muted mb-1">Date début</label>
                            <input type="date" class="form-control form-control-sm" name="startDate" id="startDateInput" value="<%= filterStartDate %>">
                        </div>

                        <!-- Date fin -->
                        <div class="col-md-2 col-6">
                            <label class="form-label small fw-semibold text-muted mb-1">Date fin</label>
                            <input type="date" class="form-control form-control-sm" name="endDate" id="endDateInput" value="<%= filterEndDate %>">
                        </div>

                        <!-- Boutons actions -->
                        <div class="col-md-2 d-flex gap-1">
                            <button type="submit" class="btn btn-primary btn-sm w-100 rounded-pill">
                                <i class="fa-solid fa-arrows-rotate me-1"></i> Filtrer
                            </button>
                            <a href="/admin/statistics" class="btn btn-outline-secondary btn-sm rounded-pill px-2" title="Réinitialiser les filtres">
                                <i class="fa-solid fa-rotate-left"></i>
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- MODULE D'INTERROGATION EN LANGAGE NATUREL (NL2SQL) -->
            <div class="card border-0 shadow-sm mb-4" id="aiQueryCard">
                <div class="card-header bg-transparent border-0 pt-3 pb-2 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="icon-box bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px; font-size: 1.1rem;">
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="fw-bold mb-0">Assistant de requêtes en langage naturel</h5>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" style="font-size: 0.7rem;">IA & Base de données</span>
                            </div>
                            <small class="text-muted">Interrogez les données du Fablab en posant vos questions en français</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <% if (isAiConfigured) { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 d-inline-flex align-items-center gap-1">
                                <i class="fa-solid fa-circle-check"></i>
                                <span><%= aiProviderLabel %></span>
                            </span>
                        <% } else { %>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 d-inline-flex align-items-center gap-1">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <span>Moteur IA non configuré</span>
                            </span>
                        <% } %>
                        <a href="/admin/settings" class="btn btn-outline-secondary btn-sm rounded-pill px-3" title="Configurer les clés d'API dans les paramètres">
                            <i class="fa-solid fa-gear me-1"></i> Configurer l'IA
                        </a>
                    </div>
                </div>

                <div class="card-body px-4 pt-2 pb-4">
                    <% if (!isAiConfigured) { %>
                        <div class="p-4 rounded-3 bg-body-tertiary border text-center my-2">
                            <i class="fa-solid fa-robot fs-1 text-secondary mb-3 d-block"></i>
                            <h6 class="fw-bold mb-1">Activez un moteur d'IA pour interroger votre base</h6>
                            <p class="text-muted small mb-3 mx-auto" style="max-width: 550px;">
                                Connectez votre compte OpenAI (ChatGPT), Google Gemini, Anthropic Claude ou un LLM local (Ollama) pour poser des questions comme <em>« Combien d'usagers ne sont venus qu'une seule fois ? »</em> ou <em>« Top 5 des machines les plus utilisées »</em>.
                            </p>
                            <a href="/admin/settings" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm">
                                <i class="fa-solid fa-gear me-1"></i> Configurer l'IA dans les paramètres
                            </a>
                        </div>
                    <% } else { %>
                        <!-- Barre de saisie de question -->
                        <form id="aiQueryForm" class="mb-3" onsubmit="return false;">
                            <div class="input-group shadow-sm rounded-pill border bg-body p-1">
                                <span class="input-group-text bg-transparent border-0 ps-3 text-primary">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                </span>
                                <input type="text" id="aiQuestionInput" class="form-control bg-transparent border-0 py-2 fs-6" placeholder="Ex : Combien d'utilisateurs enregistrés ne sont venus au fablab qu'une seule fois ?" autocomplete="off">
                                <button class="btn btn-primary rounded-pill px-3 py-2 d-flex align-items-center gap-2 fw-medium shadow-none" id="btnSubmitAiQuery" type="button">
                                    <i class="fa-solid fa-paper-plane"></i>
                                    <span>Poser la question</span>
                                </button>
                            </div>
                        </form>

                        <!-- Puces de suggestions de questions -->
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            <span class="small text-muted fw-semibold me-1"><i class="fa-regular fa-lightbulb me-1"></i> Suggestions :</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 ai-suggestion-chip" data-question="Combien d'utilisateurs enregistrés ne sont venus au fablab qu'une seule fois ?">
                                Usagers venus 1 seule fois
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 ai-suggestion-chip" data-question="Quelles sont les 5 machines les plus utilisées de l'histoire du fablab ?">
                                Top 5 machines
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 ai-suggestion-chip" data-question="Quelle est la répartition des projets par type de projet ?">
                                Projets par type
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 ai-suggestion-chip" data-question="Quel est le montant total des consommations par entité ou UFR Sorbonne ?">
                                Consommations Sorbonne
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 ai-suggestion-chip" data-question="Combien d'usagers ont été enregistrés par typologie d'utilisateur ?">
                                Usagers par typologie
                            </button>
                        </div>

                        <!-- État de chargement animé -->
                        <div id="aiLoadingContainer" class="p-4 text-center rounded-3 bg-body-tertiary border my-3" style="display: none;">
                            <div class="spinner-border text-primary mb-2" role="status" style="width: 2.5rem; height: 2.5rem;">
                                <span class="visually-hidden">Chargement...</span>
                            </div>
                            <div class="fw-semibold text-primary">Analyse de la question & génération de la requête SQL...</div>
                            <small class="text-muted">Interrogation sécurisée de la base MariaDB et mise en forme des données...</small>
                        </div>

                        <!-- État d'erreur -->
                        <div id="aiErrorContainer" class="alert alert-danger border-danger-subtle align-items-center gap-3 my-3 d-none">
                            <i class="fa-solid fa-triangle-exclamation fs-3"></i>
                            <div class="flex-grow-1">
                                <strong class="d-block mb-1">Impossible de traiter la requête</strong>
                                <span id="aiErrorMessage" class="small"></span>
                            </div>
                        </div>

                        <!-- Conteneur des Résultats -->
                        <div id="aiResultContainer" class="mt-3 p-3 rounded-3 bg-body border shadow-sm" style="display: none;">
                            <!-- En-tête des résultats -->
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pb-3 mb-3 border-bottom">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="fw-bold mb-0 text-primary" id="aiResultTitle">Résultat de la requête</h6>
                                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill" id="aiResultCountBadge">0 ligne(s)</span>
                                        <span class="badge bg-body-secondary text-muted rounded-pill" id="aiResultDurationBadge">0 ms</span>
                                    </div>
                                    <p class="small text-muted mb-0 mt-1" id="aiResultExplanation"></p>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <!-- Bascule Graphique / Tableau -->
                                    <div class="btn-group btn-group-sm" role="group" id="aiViewToggleGroup" style="display: none;">
                                        <button type="button" class="btn btn-outline-primary active" id="btnShowChart">
                                            <i class="fa-solid fa-chart-column me-1"></i> Graphique
                                        </button>
                                        <button type="button" class="btn btn-outline-primary" id="btnShowTable">
                                            <i class="fa-solid fa-table me-1"></i> Tableau
                                        </button>
                                    </div>
                                    <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3" id="btnExportAiCsv">
                                        <i class="fa-solid fa-download me-1"></i> Exporter CSV
                                    </button>
                                </div>
                            </div>

                            <!-- Affichage Mode KPI (Valeur unique) -->
                            <div id="aiKpiView" class="py-4 text-center" style="display: none;">
                                <div class="icon-box bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                                    <i class="fa-solid fa-calculator"></i>
                                </div>
                                <div class="display-3 fw-bold text-primary mb-1" id="aiKpiValue">0</div>
                                <div class="fs-6 text-muted fw-semibold" id="aiKpiLabel">Total</div>
                            </div>

                            <!-- Affichage Mode Graphique Chart.js -->
                            <div id="aiChartView" class="py-2" style="display: none;">
                                <div style="height: 320px; position: relative;">
                                    <canvas id="aiQueryChart"></canvas>
                                </div>
                            </div>

                            <!-- Affichage Mode Tableau -->
                            <div id="aiTableView" class="table-responsive my-2" style="display: none; max-height: 400px;">
                                <table class="table table-hover table-sm align-middle mb-0" id="aiDataTable">
                                    <thead class="table-light sticky-top" id="aiTableHead"></thead>
                                    <tbody id="aiTableBody"></tbody>
                                </table>
                            </div>

                            <!-- Accordéon détails techniques (SQL exécuté) -->
                            <div class="mt-3 pt-2 border-top">
                                <div class="d-flex justify-content-between align-items-center">
                                    <a class="text-decoration-none small text-muted d-flex align-items-center gap-1" data-bs-toggle="collapse" href="#aiSqlCollapse" role="button" aria-expanded="false">
                                        <i class="fa-solid fa-code text-primary"></i>
                                        <span>Afficher la requête SQL générée</span>
                                        <i class="fa-solid fa-chevron-down ms-1 small"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-pill" id="btnCopySql" style="font-size: 0.75rem;">
                                        <i class="fa-regular fa-copy me-1"></i> Copier SQL
                                    </button>
                                </div>
                                <div class="collapse mt-2" id="aiSqlCollapse">
                                    <div class="p-3 bg-dark text-light rounded-3 small font-monospace overflow-auto" style="max-height: 180px;">
                                        <pre class="mb-0"><code id="aiSqlCode" class="text-info"></code></pre>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- CARTES DE CHIFFRES CLÉS (KPIS) -->
            <div class="row g-3 mb-4">
                <!-- Visites Totales -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Visites totales</span>
                                <i class="fa-solid fa-door-open fs-5 text-primary"></i>
                            </div>
                            <div class="fs-3 fw-bold text-primary mb-1">
                                <%= kpis.totalVisits %>
                            </div>
                            <div class="small text-muted">
                                <i class="fa-solid fa-clock-rotate-left me-1"></i> <%= kpis.totalHoursFormatted %> heures cumulées (<%= kpis.avgDurationFormatted %> en moy.)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Visiteurs Uniques -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Visiteurs uniques</span>
                                <i class="fa-solid fa-users fs-5 text-success"></i>
                            </div>
                            <div class="fs-3 fw-bold text-success mb-1">
                                <%= kpis.uniqueVisitors %>
                            </div>
                            <div class="small text-muted">
                                Individus différents accueillis sur la période
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Jour le plus actif -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary border-start border-warning border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Jour le plus actif</span>
                                <i class="fa-solid fa-fire-flame-curved fs-5 text-warning"></i>
                            </div>
                            <div class="fs-3 fw-bold text-warning mb-1">
                                <%= kpis.peakDayName %>
                            </div>
                            <div class="small text-muted">
                                <% if (kpis.peakDayAvg !== undefined && kpis.peakDayAvg > 0) { %>
                                    Moyenne : <strong><%= kpis.peakDayAvg %></strong> visites/j (<%= kpis.peakDayTotal %> au total)
                                <% } else { %>
                                    Aucune visite sur la période
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Projets Suivis -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Projets suivis</span>
                                <i class="fa-solid fa-folder-open fs-5 text-info"></i>
                            </div>
                            <div class="fs-3 fw-bold text-info mb-1">
                                <%= kpis.activeProjectsCount %>
                            </div>
                            <div class="small text-muted">
                                <i class="fa-solid fa-folder-tree me-1"></i> Projets actifs sur la période (<%= kpis.totalActiveProjectsInDb %> non archivés au total)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Utilisation Machines -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Parc machines</span>
                                <i class="fa-solid fa-gears fs-5 text-secondary"></i>
                            </div>
                            <div class="fs-3 fw-bold text-secondary mb-1">
                                <%= kpis.totalMachineSessions %> session(s)
                            </div>
                            <div class="small text-muted">
                                Sur <%= kpis.uniqueMachinesOperated %> machine(s) différentes opérées
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Consommables & Matières -->
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 bg-body-tertiary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small fw-semibold text-uppercase">Consommables</span>
                                <i class="fa-solid fa-boxes-stacked fs-5 text-danger"></i>
                            </div>
                            <div class="fs-3 fw-bold text-danger mb-1">
                                <%= kpis.totalConsumablesCost %> <%= currencySymbol %>
                            </div>
                            <div class="small text-muted">
                                <%= kpis.totalConsumablesQuantity %> unité(s) de matière débitée(s)
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- GRAPHIQUES SECTION 1: ÉVOLUTION TEMPORELLE & JOURS DE LA SEMAINE -->
            <div class="row g-3 mb-4">
                <!-- Fréquentation dans le temps -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-chart-area text-primary me-2"></i>Fréquentation par semaine
                            </h6>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">Évolution</span>
                        </div>
                        <div class="card-body">
                            <div style="height: 280px; position: relative;">
                                <canvas id="timelineChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Affluence par jour de la semaine -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-calendar-week text-warning me-2"></i>Activité par jour
                            </h6>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle small">Moyenne / jour</span>
                        </div>
                        <div class="card-body">
                            <div style="height: 280px; position: relative;">
                                <canvas id="daysOfWeekChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- GRAPHIQUES SECTION 2: RÉPARTITIONS TYPES D'USAGERS ET DE PROJETS -->
            <div class="row g-3 mb-4">
                <!-- Typologie d'utilisateurs -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-users text-success me-2"></i>Répartition par type d'usagers
                            </h6>
                            <span class="badge bg-secondary-subtle text-secondary small">Profils</span>
                        </div>
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <div style="height: 260px; width: 100%; position: relative;">
                                <canvas id="userTypesChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Typologie de projets -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-folder-tree text-info me-2"></i>Répartition par type de projets
                            </h6>
                            <span class="badge bg-secondary-subtle text-secondary small">Projets</span>
                        </div>
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <div style="height: 260px; width: 100%; position: relative;">
                                <canvas id="projectTypesChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- GRAPHIQUES SECTION 3: TOP MACHINES & TOP CONSOMMABLES -->
            <div class="row g-3 mb-4">
                <!-- Top Machines -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-wrench text-secondary me-2"></i>Machines les plus sollicitées
                            </h6>
                            <span class="badge bg-secondary-subtle text-secondary small">Top 5</span>
                        </div>
                        <div class="card-body">
                            <div style="height: 240px; position: relative;">
                                <canvas id="topMachinesChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Top Consommables -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">
                                <i class="fa-solid fa-box text-danger me-2"></i>Consommables les plus débités
                            </h6>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">Unités de stockage</span>
                        </div>
                        <div class="card-body">
                            <div style="height: 240px; position: relative;">
                                <canvas id="topConsumablesChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TABLEAU RÉCAPITULATIF PAR ESPACE -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-0 pt-3 pb-2">
                    <h6 class="fw-bold mb-0">
                        <i class="fa-solid fa-table-list text-primary me-2"></i>Activité détaillée par espace
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3">Espace</th>
                                    <th scope="col">Localisation</th>
                                    <th scope="col" class="text-center">Visites enregistrées</th>
                                    <th scope="col" class="text-center">Visiteurs uniques</th>
                                    <th scope="col" style="width: 250px;">Part du trafic</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% workspaceStats.forEach(function(ws) { %>
                                    <tr>
                                        <td class="ps-3 fw-semibold text-primary">
                                            <%= ws.name %>
                                        </td>
                                        <td class="text-muted small"><%= ws.location %></td>
                                        <td class="text-center fw-bold"><%= ws.totalVisits %></td>
                                        <td class="text-center"><%= ws.uniqueVisitors %></td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height: 8px;">
                                                    <div class="progress-bar bg-primary" role="progressbar" style="width: <%= ws.percentage %>%;" aria-valuenow="<%= ws.percentage %>" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                                <span class="small text-muted" style="min-width: 35px;"><%= ws.percentage %>%</span>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <%- include('../includes/footer.html') %>

        <!-- SCRIPTS CHART.JS & INTERACTIONS -->
        <script>
            // Données transmises depuis le serveur
            const chartData = <%- JSON.stringify(chartData) %>;

            // Détection du thème clair/sombre pour adapter Chart.js
            const isDark = document.documentElement.getAttribute("data-bs-theme") === "dark" ||
                           (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches && document.documentElement.getAttribute("data-bs-theme") === "auto");

            const textColor = isDark ? "#adb5bd" : "#495057";
            const gridColor = isDark ? "rgba(255, 255, 255, 0.08)" : "rgba(0, 0, 0, 0.05)";

            Chart.defaults.color = textColor;
            Chart.defaults.font.family = 'system-ui, -apple-system, "Segoe UI", Roboto, sans-serif';

            // Palette de couleurs harmonieuse
            const colors = [
                '#0d6efd', '#198754', '#ffc107', '#0dcaf0', '#6f42c1', 
                '#d63384', '#fd7e14', '#20c997', '#6c757d', '#dc3545'
            ];

            // 1. Graphique Évolution temporelle
            const ctxTimeline = document.getElementById("timelineChart").getContext("2d");
            new Chart(ctxTimeline, {
                type: 'line',
                data: {
                    labels: chartData.timelineLabels.length ? chartData.timelineLabels : ['Aucune donnée'],
                    datasets: [{
                        label: 'Visites',
                        data: chartData.timelineValues.length ? chartData.timelineValues : [0],
                        borderColor: '#0d6efd',
                        backgroundColor: isDark ? 'rgba(13, 110, 253, 0.15)' : 'rgba(13, 110, 253, 0.08)',
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2.5,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#0d6efd',
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: gridColor }, ticks: { color: textColor } },
                        y: { beginAtZero: true, grid: { color: gridColor }, ticks: { stepSize: 1, color: textColor } }
                    }
                }
            });

            // 2. Graphique Affluence par jour de la semaine (Moyenne par jour)
            const ctxDays = document.getElementById("daysOfWeekChart").getContext("2d");
            const dayValues = chartData.dayAverages || chartData.dayCounts;
            const maxVal = Math.max(...dayValues);
            const dayColors = dayValues.map(v => (v > 0 && v === maxVal) ? '#ffc107' : '#0d6efd');

            new Chart(ctxDays, {
                type: 'bar',
                data: {
                    labels: chartData.dayNames,
                    datasets: [{
                        label: 'Moyenne de visites',
                        data: dayValues,
                        backgroundColor: dayColors,
                        borderRadius: 6,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { 
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const idx = context.dataIndex;
                                    const avg = context.parsed.y;
                                    const total = (chartData.dayCounts && chartData.dayCounts[idx] !== undefined) ? chartData.dayCounts[idx] : avg;
                                    const occ = (chartData.dayOccurrences && chartData.dayOccurrences[idx]) ? chartData.dayOccurrences[idx] : 1;
                                    const dayName = chartData.dayNames[idx];
                                    return `Moyenne : ${avg} visites/j (${total} au total sur ${occ} ${dayName.toLowerCase()}s)`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: textColor } },
                        y: { 
                            beginAtZero: true, 
                            grid: { color: gridColor }, 
                            ticks: { color: textColor },
                            title: { display: true, text: 'Visites en moyenne / jour', color: textColor, font: { size: 11 } }
                        }
                    }
                }
            });

            // 3. Graphique Répartition Types d'Usagers
            const ctxUserTypes = document.getElementById("userTypesChart").getContext("2d");
            new Chart(ctxUserTypes, {
                type: 'doughnut',
                data: {
                    labels: chartData.userTypeLabels.length ? chartData.userTypeLabels : ['Aucun usager'],
                    datasets: [{
                        data: chartData.userTypeCounts.length ? chartData.userTypeCounts : [1],
                        backgroundColor: colors.slice(0, Math.max(1, chartData.userTypeLabels.length)),
                        borderWidth: isDark ? 0 : 2,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12, padding: 15, color: textColor }
                        }
                    },
                    cutout: '65%',
                }
            });

            // 4. Graphique Répartition Types de Projets
            const ctxProjectTypes = document.getElementById("projectTypesChart").getContext("2d");
            new Chart(ctxProjectTypes, {
                type: 'doughnut',
                data: {
                    labels: chartData.projectTypeLabels.length ? chartData.projectTypeLabels : ['Aucun projet'],
                    datasets: [{
                        data: chartData.projectTypeCounts.length ? chartData.projectTypeCounts : [1],
                        backgroundColor: colors.slice(2, 2 + Math.max(1, chartData.projectTypeLabels.length)),
                        borderWidth: isDark ? 0 : 2,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12, padding: 15, color: textColor }
                        }
                    },
                    cutout: '65%',
                }
            });

            // 5. Graphique Top Machines
            const ctxMachines = document.getElementById("topMachinesChart").getContext("2d");
            new Chart(ctxMachines, {
                type: 'bar',
                data: {
                    labels: chartData.topMachineLabels.length ? chartData.topMachineLabels : ['Aucune session machine'],
                    datasets: [{
                        label: 'Sessions',
                        data: chartData.topMachineCounts.length ? chartData.topMachineCounts : [0],
                        backgroundColor: '#6f42c1',
                        borderRadius: 4,
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, grid: { color: gridColor }, ticks: { stepSize: 1, color: textColor } },
                        y: { grid: { display: false }, ticks: { color: textColor } }
                    }
                }
            });

            // 6. Graphique Top Consommables (ramenés aux unités de stockage)
            const ctxConsumables = document.getElementById("topConsumablesChart").getContext("2d");
            const consumableDetails = chartData.topConsumableDetails || [];
            new Chart(ctxConsumables, {
                type: 'bar',
                data: {
                    labels: chartData.topConsumableLabels.length ? chartData.topConsumableLabels : ['Aucune consommation'],
                    datasets: [{
                        label: 'Quantité (unités de stockage)',
                        data: chartData.topConsumableCounts.length ? chartData.topConsumableCounts : [0],
                        backgroundColor: '#dc3545',
                        borderRadius: 4,
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { 
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const idx = context.dataIndex;
                                    const item = consumableDetails[idx];
                                    if (item) {
                                        return `${item.stockQty} ${item.stockUnit} (soit ${item.usageQty} ${item.usageUnit})`;
                                    }
                                    return `${context.parsed.x} unité(s)`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: { 
                            beginAtZero: true, 
                            grid: { color: gridColor }, 
                            ticks: { color: textColor },
                            title: { display: true, text: 'Unités de stockage (bobines, packs, rouleaux...)', color: textColor, font: { size: 11 } }
                        },
                        y: { grid: { display: false }, ticks: { color: textColor } }
                    }
                }
            });

            // Synchronisation dynamique du sélecteur de période avec les inputs de date
            document.getElementById("periodSelect").addEventListener("change", function() {
                const now = new Date();
                const formatDate = (d) => {
                    const y = d.getFullYear();
                    const m = String(d.getMonth() + 1).padStart(2, "0");
                    const day = String(d.getDate()).padStart(2, "0");
                    return `${y}-${m}-${day}`;
                };

                let start = "";
                let end = formatDate(now);

                if (this.value === "7d") {
                    const d = new Date();
                    d.setDate(d.getDate() - 6);
                    start = formatDate(d);
                } else if (this.value === "30d") {
                    const d = new Date();
                    d.setDate(d.getDate() - 29);
                    start = formatDate(d);
                } else if (this.value === "this_month") {
                    const d = new Date(now.getFullYear(), now.getMonth(), 1);
                    start = formatDate(d);
                } else if (this.value === "last_month") {
                    const dStart = new Date(now.getFullYear(), now.getMonth() - 1, 1);
                    const dEnd = new Date(now.getFullYear(), now.getMonth(), 0);
                    start = formatDate(dStart);
                    end = formatDate(dEnd);
                } else if (this.value === "this_year") {
                    start = `${now.getFullYear()}-01-01`;
                } else if (this.value === "academic_year") {
                    const startYear = now.getMonth() >= 8 ? now.getFullYear() : now.getFullYear() - 1;
                    start = `${startYear}-09-01`;
                } else if (this.value === "all") {
                    start = "";
                    end = "";
                }

                if (this.value !== "custom") {
                    document.getElementById("startDateInput").value = start;
                    document.getElementById("endDateInput").value = end;
                }
            });

            // =========================================================================
            // GESTION DU MODULE D'INTERROGATION EN LANGAGE NATUREL (AI QUERY)
            // =========================================================================
            (function() {
                const form = document.getElementById("aiQueryForm");
                const input = document.getElementById("aiQuestionInput");
                const btnSubmit = document.getElementById("btnSubmitAiQuery");
                const loadingContainer = document.getElementById("aiLoadingContainer");
                const errorContainer = document.getElementById("aiErrorContainer");
                const errorMessage = document.getElementById("aiErrorMessage");
                const resultContainer = document.getElementById("aiResultContainer");
                const resultTitle = document.getElementById("aiResultTitle");
                const countBadge = document.getElementById("aiResultCountBadge");
                const durationBadge = document.getElementById("aiResultDurationBadge");
                const explanation = document.getElementById("aiResultExplanation");
                const toggleGroup = document.getElementById("aiViewToggleGroup");
                const btnShowChart = document.getElementById("btnShowChart");
                const btnShowTable = document.getElementById("btnShowTable");
                const btnExportCsv = document.getElementById("btnExportAiCsv");
                const btnCopySql = document.getElementById("btnCopySql");
                const sqlCode = document.getElementById("aiSqlCode");
                const kpiView = document.getElementById("aiKpiView");
                const kpiValue = document.getElementById("aiKpiValue");
                const kpiLabel = document.getElementById("aiKpiLabel");
                const chartView = document.getElementById("aiChartView");
                const tableView = document.getElementById("aiTableView");
                const tableHead = document.getElementById("aiTableHead");
                const tableBody = document.getElementById("aiTableBody");

                if (!input || !btnSubmit) return;

                let currentData = null;
                let aiChartInstance = null;

                // Soumission de la question
                async function submitAiQuestion(questionText) {
                    const q = (questionText || input.value || "").trim();
                    if (!q) {
                        input.focus();
                        return;
                    }

                    // Reset affichages
                    errorContainer.classList.add("d-none");
                    errorContainer.classList.remove("d-flex");
                    resultContainer.style.display = "none";
                    loadingContainer.style.display = "block";
                    btnSubmit.disabled = true;

                    try {
                        let url = "/admin/statistics/ai-query";
                        if (window.location && window.location.pathname) {
                            const currentPath = window.location.pathname.replace(/\/+$/, "");
                            url = `${currentPath}/ai-query`;
                        } else if (window.getAppBaseUrl) {
                            url = window.getAppBaseUrl("admin/statistics/ai-query");
                        }

                        const res = await fetch(url, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "Accept": "application/json",
                                "X-Requested-With": "XMLHttpRequest"
                            },
                            body: JSON.stringify({ question: q }),
                        });

                        let data;
                        const contentType = res.headers.get("content-type") || "";
                        if (contentType.includes("application/json")) {
                            data = await res.json();
                        } else {
                            const rawText = await res.text();
                            const snippet = rawText.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim().slice(0, 160);
                            throw new Error(`Réponse inattendue (${res.status}) : ${snippet || "Page HTML retournée au lieu de JSON"}. Pensez à redémarrer le serveur Node.`);
                        }

                        if (!res.ok || !data.success) {
                            throw new Error(data.error || data.message || "Erreur lors du traitement de votre question.");
                        }

                        renderAiResults(data);
                    } catch (err) {
                        errorMessage.textContent = err.message;
                        errorContainer.classList.remove("d-none");
                        errorContainer.classList.add("d-flex");
                    } finally {
                        loadingContainer.style.display = "none";
                        btnSubmit.disabled = false;
                    }
                }

                // Rendu des résultats
                function renderAiResults(data) {
                    errorContainer.classList.add("d-none");
                    errorContainer.classList.remove("d-flex");
                    currentData = data;
                    resultTitle.textContent = data.title || "Résultats";
                    countBadge.textContent = `${data.rowCount} ligne(s)`;
                    durationBadge.textContent = `${data.durationMs} ms`;
                    explanation.textContent = data.explanation || "";
                    sqlCode.textContent = data.sql || "";

                    // 1. Remplissage du tableau
                    renderTable(data.columns, data.data);

                    // 2. Gestion de la visualisation
                    const viz = data.visualization || {};
                    if (viz.isKpi) {
                        // Mode KPI (Valeur unique)
                        kpiValue.textContent = typeof viz.kpiValue === "number" ? viz.kpiValue.toLocaleString("fr-FR") : viz.kpiValue;
                        kpiLabel.textContent = viz.kpiLabel || data.title;
                        kpiView.style.display = "block";
                        chartView.style.display = "none";
                        tableView.style.display = "none";
                        toggleGroup.style.display = "none";
                    } else if (viz.chartType !== "table" && viz.chartConfig) {
                        // Mode Graphique
                        kpiView.style.display = "none";
                        chartView.style.display = "block";
                        tableView.style.display = "none";
                        toggleGroup.style.display = "inline-flex";
                        btnShowChart.classList.add("active");
                        btnShowTable.classList.remove("active");

                        renderChart(viz.chartConfig);
                    } else {
                        // Mode Tableau pur
                        kpiView.style.display = "none";
                        chartView.style.display = "none";
                        tableView.style.display = "block";
                        toggleGroup.style.display = "none";
                    }

                    resultContainer.style.display = "block";
                    resultContainer.scrollIntoView({ behavior: "smooth", block: "nearest" });
                }

                function renderChart(config) {
                    if (aiChartInstance) {
                        aiChartInstance.destroy();
                        aiChartInstance = null;
                    }

                    const ctx = document.getElementById("aiQueryChart").getContext("2d");
                    const isDark = document.documentElement.getAttribute("data-bs-theme") === "dark";
                    const textColor = isDark ? "#e2e8f0" : "#334155";
                    const gridColor = isDark ? "rgba(255, 255, 255, 0.08)" : "rgba(0, 0, 0, 0.06)";

                    // Adapter axes aux couleurs du thème si échelles présentes
                    if (config.options && config.options.scales) {
                        Object.keys(config.options.scales).forEach((axis) => {
                            config.options.scales[axis].ticks = { color: textColor };
                            config.options.scales[axis].grid = { color: gridColor };
                        });
                    }

                    aiChartInstance = new Chart(ctx, config);
                }

                function renderTable(columns, rows) {
                    tableHead.innerHTML = "";
                    tableBody.innerHTML = "";

                    if (!columns || columns.length === 0 || !rows || rows.length === 0) {
                        tableBody.innerHTML = '<tr><td class="text-center text-muted py-3">Aucun résultat trouvé</td></tr>';
                        return;
                    }

                    // En-têtes
                    const trHead = document.createElement("tr");
                    columns.forEach((col) => {
                        const th = document.createElement("th");
                        th.scope = "col";
                        th.textContent = col;
                        trHead.appendChild(th);
                    });
                    tableHead.appendChild(trHead);

                    // Données
                    rows.forEach((row) => {
                        const tr = document.createElement("tr");
                        columns.forEach((col) => {
                            const td = document.createElement("td");
                            const val = row[col];
                            td.textContent = val === null || val === undefined ? "—" : String(val);
                            tr.appendChild(td);
                        });
                        tableBody.appendChild(tr);
                    });
                }

                // Clics sur les puces de suggestions
                document.querySelectorAll(".ai-suggestion-chip").forEach((chip) => {
                    chip.addEventListener("click", function() {
                        const q = this.getAttribute("data-question");
                        input.value = q;
                        submitAiQuestion(q);
                    });
                });

                // Clic bouton poser la question
                btnSubmit.addEventListener("click", () => submitAiQuestion());

                // Touche Entrée dans l'input
                input.addEventListener("keydown", (e) => {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        submitAiQuestion();
                    }
                });

                // Bascule Graphique / Tableau
                btnShowChart.addEventListener("click", () => {
                    btnShowChart.classList.add("active");
                    btnShowTable.classList.remove("active");
                    chartView.style.display = "block";
                    tableView.style.display = "none";
                });

                btnShowTable.addEventListener("click", () => {
                    btnShowTable.classList.add("active");
                    btnShowChart.classList.remove("active");
                    chartView.style.display = "none";
                    tableView.style.display = "block";
                });

                // Copier la requête SQL
                btnCopySql.addEventListener("click", () => {
                    if (!sqlCode.textContent) return;
                    navigator.clipboard.writeText(sqlCode.textContent).then(() => {
                        const original = btnCopySql.innerHTML;
                        btnCopySql.innerHTML = '<i class="fa-solid fa-check text-success me-1"></i> Copié !';
                        setTimeout(() => (btnCopySql.innerHTML = original), 2000);
                    });
                });

                // Export CSV
                btnExportCsv.addEventListener("click", () => {
                    if (!currentData || !currentData.data || currentData.data.length === 0) {
                        alert("Aucune donnée à exporter.");
                        return;
                    }

                    const cols = currentData.columns;
                    let csv = "\uFEFF" + cols.join(";") + "\r\n";

                    currentData.data.forEach((row) => {
                        const line = cols.map((c) => {
                            let val = row[c] === null || row[c] === undefined ? "" : String(row[c]);
                            if (val.includes(";") || val.includes('"') || val.includes("\n")) {
                                val = `"${val.replace(/"/g, '""')}"`;
                            }
                            return val;
                        });
                        csv += line.join(";") + "\r\n";
                    });

                    const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
                    const url = URL.createObjectURL(blob);
                    const link = document.createElement("a");
                    link.setAttribute("href", url);
                    link.setAttribute("download", `fabtrack_requete_ia_${Date.now()}.csv`);
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                });
            })();
        </script>
    </body>
</html>
