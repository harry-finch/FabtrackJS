<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Gestion des espaces de travail du fablab" />
        <meta name="author" content="Stéphane Muller" />
        <title>Espaces de travail • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>

        <%- include('../includes/pagehead.html') %>
    </head>

    <body class="d-flex justify-content-center bg-body-tertiary py-4">
        <%- include('../includes/light-dark.html') %>

        <main class="main-container">
            <%- include('../includes/header.html') %>

            <!-- Page Header -->
            <div class="fab-page-header">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h1 class="fab-page-title">Espaces de travail</h1>
                        <span class="badge bg-body-secondary text-secondary-emphasis border tabular-nums">
                            <%= workspaces.length %> espace<%= workspaces.length > 1 ? 's' : '' %>
                        </span>
                    </div>
                    <p class="fab-page-subtitle">Espaces fablabs rattachés et sites physiques</p>
                </div>
            </div>

            <div class="card border mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th data-sort="0" scope="col" class="ps-3">#</th>
                                    <th data-sort="1" scope="col">Espace</th>
                                    <th scope="col">Adresse / Emplacement</th>
                                    <th scope="col" class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="table-content">
                                <% if (!workspaces || workspaces.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        <i class="fa-solid fa-building fs-4 d-block mb-2 opacity-50" aria-hidden="true"></i>
                                        Aucun espace de travail enregistré pour le moment.
                                    </td>
                                </tr>
                                <% } else { %>
                                <% workspaces.forEach(function(workspace) { %>
                                <tr>
                                    <td scope="row" class="ps-3 text-muted tabular-nums">#<%= workspace.id %></td>
                                    <td>
                                        <span class="badge bg-body-secondary text-secondary-emphasis border">
                                            <%= workspace.name %>
                                        </span>
                                    </td>
                                    <td><span class="text-muted small"><%= workspace.location || '—' %></span></td>
                                    <td class="text-end pe-3">
                                        <div class="fab-row-actions">
                                            <a
                                                href="#"
                                                class="btn btn-outline-primary"
                                                id="edit-<%= workspace.id %>"
                                                data-id="<%= workspace.id %>"
                                                data-name="<%= workspace.name %>"
                                                data-location="<%= workspace.location %>"
                                                title="Modifier"
                                                aria-label="Modifier l'espace <%= workspace.name %>"
                                            >
                                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                            </a>
                                            <form method="POST" action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/workspaces/delete/<%= workspace.id %>" class="d-inline" data-confirm="Supprimer l'espace <%= workspace.name %> ?">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                                                <button type="submit" class="btn btn-outline-danger" title="Supprimer" aria-label="Supprimer l'espace <%= workspace.name %>">
                                                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border mb-4">
                <div class="card-header bg-body-tertiary">
                    <h2 class="h6 fw-bold mb-0" id="formTitle">
                        <i class="fa-solid fa-building text-secondary me-2" aria-hidden="true"></i>Nouvel espace de travail
                    </h2>
                </div>
                <form action="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin/workspaces/create" method="post" id="workspaceForm">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                    <input type="hidden" id="workspaceid" name="workspaceid" value="" />

                    <div class="card-body">
                        <div class="mb-3">
                            <label for="name" class="form-label fw-semibold small">Nom de l'espace</label>
                            <input type="text" class="form-control" id="name" name="name" placeholder="Ex. : Fablab principal" required />
                        </div>
                        <div class="mb-0">
                            <label for="location" class="form-label fw-semibold small">Adresse / Emplacement</label>
                            <textarea class="form-control" id="location" name="location" rows="3" placeholder="Bâtiment, salle ou adresse physique"></textarea>
                        </div>
                    </div>

                    <div class="card-footer bg-body-tertiary d-flex flex-wrap gap-2">
                        <button class="btn btn-primary" type="submit" id="submitBtn">
                            Créer l'espace
                        </button>
                        <button type="button" id="cancelEditBtn" class="btn btn-outline-secondary" style="display: none;" data-action="cancel-edit">
                            Annuler
                        </button>
                    </div>
                </form>
            </div>

            <%- include('../includes/footer.html') %>

        <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
          const elements = document.querySelectorAll('[id^="edit-"]');
          elements.forEach(function(element) {
            element.addEventListener("click", editItem);
          });

          function editItem(event) {
            if (event) event.preventDefault();

            document.getElementById("formTitle").innerHTML = "<i class='fa-solid fa-pen-to-square text-primary me-2' aria-hidden='true'></i>Modifier l'espace de travail";
            document.getElementById("workspaceForm").action = (window.getAppBaseUrl ? window.getAppBaseUrl("admin/workspaces/update") : "/admin/workspaces/update");
            document.getElementById("workspaceid").value = this.dataset.id;
            document.getElementById("name").value = this.dataset.name;
            document.getElementById("location").value = this.dataset.location || '';
            document.getElementById("submitBtn").innerText = "Enregistrer les modifications";
            document.getElementById("cancelEditBtn").style.display = "inline-block";

            document.getElementById("workspaceForm").scrollIntoView({ behavior: 'smooth' });
            return false;
          }

          function cancelEdit() {
            document.getElementById("formTitle").innerHTML = "<i class='fa-solid fa-building text-secondary me-2' aria-hidden='true'></i>Nouvel espace de travail";
            document.getElementById("workspaceForm").action = (window.getAppBaseUrl ? window.getAppBaseUrl("admin/workspaces/create") : "/admin/workspaces/create");
            document.getElementById("workspaceid").value = "";
            document.getElementById("name").value = "";
            document.getElementById("location").value = "";
            document.getElementById("submitBtn").innerText = "Créer l'espace";
            document.getElementById("cancelEditBtn").style.display = "none";
          }
        </script>
    </body>
</html>
