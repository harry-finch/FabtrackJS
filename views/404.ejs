<!doctype html>
<html lang="<%= typeof currentLocale !== 'undefined' ? currentLocale : 'fr' %>" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>404 - Page introuvable • <%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %></title>
        <%- include('includes/pagehead.html') %>
        <style>
            .gif-container {
                position: relative;
                max-width: 440px;
                margin: 0 auto;
                border-radius: 6px;
                overflow: hidden;
                border: 1px solid var(--fab-border);
            }
            .gif-container img {
                display: block;
                width: 100%;
                height: auto;
                object-fit: cover;
            }
            .path-badge {
                font-family: SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
                font-size: 0.85rem;
                word-break: break-all;
            }
        </style>
    </head>
    <body class="d-flex justify-content-center align-items-center min-vh-100 bg-body-tertiary py-4">
        <%- include('includes/light-dark.html') %>

        <main class="main-container w-100 px-3" style="max-width: 680px;">
            <!-- Top Branding -->
            <div class="text-center mb-3">
                <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>" class="text-decoration-none">
                    <% if (typeof platformLogoType !== 'undefined' && platformLogoType === 'custom' && platformLogoPath) { %>
                        <img src="<%= platformLogoPath %>" alt="<%= typeof platformName !== 'undefined' && platformName ? platformName : 'FabtrackJS' %>" style="max-height: 48px; max-width: 180px; object-fit: contain;" />
                    <% } else { %>
                        <img src="images/logo-fabtrack.svg" alt="FabtrackJS" width="60" height="46" class="app-auth-logo" />
                    <% } %>
                </a>
            </div>

            <!-- 404 Hero Card -->
            <div class="card border bg-body overflow-hidden">
                <div class="card-body p-4 p-md-5 text-center">
                    
                    <!-- Status Badge -->
                    <div class="mb-3">
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold">
                            <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i> Erreur 404 • Page introuvable
                        </span>
                    </div>

                    <!-- Lightweight offline-ready 404 SVG illustration -->
                    <div class="gif-container mb-4">
                        <img src="images/404-fablab.svg" alt="Erreur 404 — Page introuvable" width="420" height="220" />
                    </div>

                    <!-- Title & Explanation -->
                    <h1 class="h4 fw-bold mb-2 text-body">
                        Oups ! Cette page s'est égarée...
                    </h1>
                    <p class="text-secondary mb-3" style="font-size: 0.98rem; line-height: 1.5;">
                        La page que vous recherchez n'existe pas, a été déplacée ou son lien est incorrect.
                    </p>

                    <% if (typeof requestedPath !== 'undefined' && requestedPath) { %>
                    <div class="mb-4">
                        <span class="path-badge bg-body-secondary text-secondary-emphasis px-2 py-1 rounded-2 border">
                            <i class="fa-solid fa-link me-1 text-muted" aria-hidden="true"></i> <%= requestedPath %>
                        </span>
                    </div>
                    <% } %>

                    <!-- Action Navigation Buttons -->
                    <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 pt-2">
                        <button type="button" data-action="history-back" class="btn btn-outline-secondary btn-sm px-3 py-2">
                            <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Page précédente
                        </button>

                        <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>fabtrack" class="btn btn-outline-primary btn-sm px-3 py-2">
                            <i class="fa-solid fa-desktop me-1" aria-hidden="true"></i> Kiosque Fabtrack
                        </a>

                        <% if (typeof role !== 'undefined' && role === 'admin') { %>
                        <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>admin" class="btn btn-outline-secondary btn-sm px-3 py-2">
                            <i class="fa-solid fa-screwdriver-wrench me-1" aria-hidden="true"></i> Panneau admin
                        </a>
                        <% } %>

                        <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>" class="btn btn-primary btn-sm px-4 py-2 fw-semibold">
                            <i class="fa-solid fa-house me-1" aria-hidden="true"></i> Accueil
                        </a>
                    </div>
                </div>

                <!-- Card Footer Help Note -->
                <div class="card-footer bg-body-tertiary border-top py-3 text-center">
                    <small class="text-muted">
                        Un problème avec un équipement ou une machine ? 
                        <a href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '/' %>report-issue" class="text-decoration-none text-primary fw-semibold ms-1">
                            <i class="fa-solid fa-wrench me-1" aria-hidden="true"></i>Signaler un incident
                        </a>
                    </small>
                </div>
            </div>

            <!-- Page Footer -->
            <%- include('includes/footer.html') %>
    </body>
</html>
